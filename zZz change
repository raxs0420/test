-- Function to update count display
local function updateCountDisplay()
    local count = #towers
    CountDisplay.Text = string.format("%d/5", count)
    
    if count > 0 then
        EquipButton.BackgroundColor3 = Color3.fromRGB(60, 100, 200)
        EquipButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        EquipButton.Text = string.format("EQUIP (%d)", count)
        Status.Text = string.format("Selected: %d/5\nClick towers to select/deselect", count)
    else
        EquipButton.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
        EquipButton.TextColor3 = Color3.fromRGB(200, 200, 200)
        EquipButton.Text = "EQUIP (0)"
        Status.Text = "Select up to 5 towers\nClick tower to select/deselect"
    end
end

-- Function to update status with color
local function updateStatus(message, color)
    Status.Text = string.format("Selected: %d/5\n%s", #towers, message)
    if color then
        Status.TextColor3 = color
    else
        Status.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end

-- Function to create tower buttons
local function createTowerButton(towerName, index, isEven)
    local towerBtn = Instance.new("TextButton")
    towerBtn.Name = "TowerBtn_" .. towerName
    towerBtn.Size = UDim2.new(1, -8, 0, 26)
    towerBtn.Position = UDim2.new(0, 4, 0, (index-1) * 28)
    towerBtn.BackgroundColor3 = isEven and Color3.fromRGB(40, 40, 55) or Color3.fromRGB(35, 35, 50)
    towerBtn.Text = towerName
    towerBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    towerBtn.TextSize = 11
    towerBtn.Font = Enum.Font.Gotham
    towerBtn.AutoButtonColor = false
    towerBtn.Parent = TowersScroll
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = towerBtn
    
    local originalColor = towerBtn.BackgroundColor3
    towerButtons[towerName] = towerBtn
    
    -- Check if already selected
    for _, selectedTower in ipairs(towers) do
        if selectedTower == towerName then
            towerBtn.BackgroundColor3 = Color3.fromRGB(70, 130, 70) -- Green for selected
            break
        end
    end
    
    -- Click handler
    towerBtn.MouseButton1Click:Connect(function()
        -- Don't select if we're dragging the UI
        if isDraggingUI then
            return
        end
        
        local alreadySelected = false
        local selectedIndex = 0
        
        for i, selectedTower in ipairs(towers) do
            if selectedTower == towerName then
                alreadySelected = true
                selectedIndex = i
                break
            end
        end
        
        if alreadySelected then
            -- Remove from selection
            table.remove(towers, selectedIndex)
            towerBtn.BackgroundColor3 = originalColor
            updateStatus(towerName .. " removed", Color3.fromRGB(255, 150, 150))
        else
            -- Add to selection
            if #towers >= 5 then
                updateStatus("Max 5 reached! Remove some first", Color3.fromRGB(255, 100, 100))
                towerBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
                task.wait(0.5)
                towerBtn.BackgroundColor3 = originalColor
                return
            end
            
            table.insert(towers, towerName)
            towerBtn.BackgroundColor3 = Color3.fromRGB(70, 130, 70) -- Green for selected
            updateStatus(towerName .. " added", Color3.fromRGB(100, 255, 100))
        end
        
        updateCountDisplay()
    end)
    
    -- Hover effects
    towerBtn.MouseEnter:Connect(function()
        if towerBtn.BackgroundColor3 ~= Color3.fromRGB(70, 130, 70) then
            towerBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
        end
    end)
    
    towerBtn.MouseLeave:Connect(function()
        local isSelected = false
        for _, selectedTower in ipairs(towers) do
            if selectedTower == towerName then
                isSelected = true
                break
            end
        end
        
        if isSelected then
            towerBtn.BackgroundColor3 = Color3.fromRGB(70, 130, 70)
        else
            towerBtn.BackgroundColor3 = originalColor
        end
    end)
end

-- Function to populate towers with search filtering
local function populateTowers(searchText)
    TowersScroll:ClearAllChildren()
    
    local filteredTowers = {}
    if searchText and searchText ~= "" then
        local searchLower = string.lower(searchText)
        for _, tower in ipairs(allTowers) do
            if string.lower(tower):find(searchLower) then
                table.insert(filteredTowers, tower)
            end
        end
    else
        filteredTowers = allTowers
    end
    
    TowersScroll.CanvasSize = UDim2.new(0, 0, 0, #filteredTowers * 28)
    
    for i, towerName in ipairs(filteredTowers) do
        createTowerButton(towerName, i, i % 2 == 0)
    end
end

-- Button events
ClearButton.MouseButton1Click:Connect(function()
    -- Don't clear if we're dragging the UI
    if isDraggingUI then
        return
    end
    
    towers = {}
    for towerName, btn in pairs(towerButtons) do
        if btn and btn:IsA("TextButton") then
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        end
    end
    updateCountDisplay()
    updateStatus("All cleared", Color3.fromRGB(255, 150, 150))
end)

EquipButton.MouseButton1Click:Connect(function()
    -- Don't equip if we're dragging the UI
    if isDraggingUI then
        return
    end
    
    if #towers == 0 then
        updateStatus("No towers selected", Color3.fromRGB(255, 100, 100))
        return
    end
    
    updateStatus("Equipping...", Color3.fromRGB(255, 255, 100))
    
    if TDS and TDS.Loadout then
        local success, errorMsg = TDS:Loadout(towers)
        
        if success then
            updateStatus("Equipped successfully!", Color3.fromRGB(100, 255, 100))
            EquipButton.Text = "✓ DONE"
            EquipButton.BackgroundColor3 = Color3.fromRGB(70, 170, 70)
            task.wait(1.5)
            updateCountDisplay()
        else
            updateStatus("Error: " .. (errorMsg or "unknown"), Color3.fromRGB(255, 100, 100))
            EquipButton.Text = "✗ ERROR"
            EquipButton.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
            task.wait(1.5)
            updateCountDisplay()
        end
    else
        updateStatus("TDS:Loadout() not found!", Color3.fromRGB(255, 100, 100))
    end
end)

