local function callSelectTower(towerName)
    local args = {"Streaming", "SelectTower", towerName, "Default"}
    ReplicatedStorage:WaitForChild("RemoteEvent"):FireServer(unpack(args))
    print("✅ SelectTower called for: " .. towerName)
end

local function setupHotbarDetection()
    local mouse = LocalPlayer:GetMouse()
    local lastClick = 0
    
    mouse.Button1Down:Connect(function()
        if tick() - lastClick < 0.3 then return end
        lastClick = tick()
        
        task.wait(0.05)
        local target = mouse.Target
        if not target then return end
        
        -- Check if it's a tower or hotbar
        local model = target
        while model and not model:IsA("Model") do
            model = model.Parent
        end
        
        if model then
            for _, towerName in ipairs(allTowers) do
                if string.find(model.Name, towerName) or string.find(towerName, model.Name) then
                    task.wait(0.1)
                    callSelectTower(towerName)
                    return
                end
            end
        end
        
        -- Check for hotbar slot clicks
        if target.Name:find("Slot") or (target.Parent and target.Parent.Name:find("Slot")) then
            print("🎮 Hotbar slot clicked - trying to detect tower...")
            -- Add logic here if you track which towers are in which slots
        end
    end)
end

-- Hook into the hotbar remote
local function hookRemote()
    local remote = ReplicatedStorage:WaitForChild("RemoteEvent")
    local original = remote.FireServer
    
    remote.FireServer = function(self, ...)
        local args = {...}
        if #args >= 3 and args[1] == "Hotbar" and args[2] == "Click" then
            print("🎯 Hotbar click on slot: " .. args[3])
            -- Add your logic to determine which tower is in this slot
        end
        return original(self, ...)
    end
end

task.spawn(setupHotbarDetection)
task.spawn(function() task.wait(2) pcall(hookRemote) end)
