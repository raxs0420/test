local function getEnemyPathProgress(npc)
    if #PathNodes < 2 then return 0 end
    local rootPart = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
    if not rootPart then return 0 end
    local closestDist = math.huge
    local bestNodeIndex = 1
    local bestT = 0
    for i = 1, #PathNodes - 1 do
        local startPos = PathNodes[i].Position
        local endPos = PathNodes[i + 1].Position
        local segmentDir = (endPos - startPos).Unit
        local segmentLength = (endPos - startPos).Magnitude
        local toEnemy = rootPart.Position - startPos
        local t = toEnemy:Dot(segmentDir)
        t = math.max(0, math.min(t, segmentLength))
        local pointOnSegment = startPos + segmentDir * t
        local dist = (rootPart.Position - pointOnSegment).Magnitude
        if dist < closestDist then
            closestDist = dist
            bestNodeIndex = i
            bestT = t
        end
    end
    local distanceTraveled = 0
    for i = 1, bestNodeIndex - 1 do
        distanceTraveled = distanceTraveled + (PathNodes[i + 1].Position - PathNodes[i].Position).Magnitude
    end
    distanceTraveled = distanceTraveled + bestT
    return distanceTraveled / MaxPathDistance
end

local function getPathDirection(progress)
    if #PathNodes < 2 then return Vector3.new(0, 0, 0) end
    local distance = progress * MaxPathDistance
    local traveled = 0
    for i = 1, #PathNodes - 1 do
        local segmentLength = (PathNodes[i + 1].Position - PathNodes[i].Position).Magnitude
        if traveled + segmentLength >= distance then
            return (PathNodes[i + 1].Position - PathNodes[i].Position).Unit
        end
        traveled = traveled + segmentLength
    end
    return (PathNodes[#PathNodes].Position - PathNodes[#PathNodes - 1].Position).Unit
end

local function getAllEnemies()
    local enemies = {}
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return {} end
    
    local npcs = WorkspaceNPCs or workspace:FindFirstChild("NPCs")
    if not npcs then return {} end
    
    local currentTime = tick()
    local rootPos = root.Position
    
    for _, npc in pairs(npcs:GetChildren()) do
        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health > 0 then
            local targetPart = npc:FindFirstChild("UpperTorso") or 
                              npc:FindFirstChild("Torso") or
                              npc:FindFirstChild("HumanoidRootPart") or
                              npc:FindFirstChild("Hitbox") or
                              npc.PrimaryPart
            
            if targetPart then
                local currentPos = targetPart.Position
                local dist = (rootPos - currentPos).Magnitude
                if dist <= 500 then
                    local progress = getEnemyPathProgress(npc)
                    if progress > 0 then
                        local speed = 0
                        local pathDir = Vector3.new(0, 0, 0)
                        
                        if PreviousPositions[npc] and PreviousTimes[npc] then
                            local timeDiff = currentTime - PreviousTimes[npc]
                            if timeDiff > 0 then
                                local posDiff = (currentPos - PreviousPositions[npc]).Magnitude
                                speed = posDiff / timeDiff
                                pathDir = getPathDirection(progress)
                            end
                        end
                        
                        PreviousPositions[npc] = currentPos
                        PreviousTimes[npc] = currentTime
                        
                        local predictionTime = 0.05
                        local predictedPos = currentPos + (pathDir * speed * predictionTime)
                        
                        local targetPos = Vector3.new(
                            (currentPos.X * 0.7) + (predictedPos.X * 0.3),
                            currentPos.Y + 1.5,
                            (currentPos.Z * 0.7) + (predictedPos.Z * 0.3)
                        )
                        
                        table.insert(enemies, {
                            pos = targetPos,
                            progress = progress
                        })
                    end
                end
            end
        end
    end
    
    Stats.Enemies = #enemies
    table.sort(enemies, function(a, b) return a.progress > b.progress end)
    return enemies
end

local PreviousPositions = {}
local PreviousTimes = {}

local function cleanupOldData()
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return end
    
    local currentTime = tick()
    
    for npc in pairs(PreviousPositions) do
        if not npc or not npc.Parent or not npcs:FindFirstChild(npc.Name) then
            PreviousPositions[npc] = nil
            PreviousTimes[npc] = nil
        end
    end
    
    for npc, time in pairs(PreviousTimes) do
        if currentTime - time > 5 then
            PreviousPositions[npc] = nil
            PreviousTimes[npc] = nil
        end
    end
end

spawn(function()
