local function applyNoRecoil()
    local replicatedStorage = game:GetService("ReplicatedStorage")
    
    local ggchannel
    local success, result = pcall(function()
        return require(replicatedStorage.Resources.Universal.NewNetwork).Channel("GatlingGun")
    end)
    if success then
        ggchannel = result
    end
    
    success, result = pcall(function()
        return require(replicatedStorage.Content.Tower["Gatling Gun"].Animator)
    end)
    if success then
        local gganim = result
        gganim._fireGun = function(self)
            local camcontroller = require(replicatedStorage.Content.Tower["Gatling Gun"].Animator.CameraController)
            local minigun = self.Replicator:Get("Minigun")
            local canfire = minigun and self.Replicator:Get("CanFire") or false
            
            if (not self.Replicator:Get("Minigun") and true) or canfire then
                local camera = workspace.CurrentCamera
                local targetPos
                if camera then
                    targetPos = camera.CFrame.Position + (camera.CFrame.LookVector * 1000)
                else
                    targetPos = camcontroller.position
                end
                
                self:_fire(camcontroller.position)
                
                if ggchannel then
                    ggchannel:fireServer("Fire", targetPos, workspace:GetAttribute("Sync"), workspace:GetServerTimeNow())
                end
                
                self:Wait(0.01)
            end
        end
    end
    
    success, result = pcall(function()
        return require(replicatedStorage.Content.Tower["Gatling Gun"].Animator.CameraController)
    end)
    if success and result.update then
        local camController = result
        local oldUpdate = camController.update
        camController.update = function(self, ...)
            if self.recoil then
                self.recoil = Vector3.new(0, 0, 0)
            end
            if self.shake then
                self.shake = Vector3.new(0, 0, 0)
            end
            return oldUpdate(self, ...)
        end
    end
end

spawn(function()
    task.wait(1)
    applyNoRecoil()
end)

