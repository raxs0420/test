end)

local function selectTargets()
    local enemies = getAllEnemies()
    if #enemies == 0 then return {} end
    local targetCount = #enemies > 40 and 25 or math.min(10, #enemies)
    local targets = {}
    for i = 1, targetCount do
        table.insert(targets, enemies[i])
    end
    return targets
end

local LastTargets = {}
local LastFireTime = 0

local function fireAtTargets(targets)
    if not targets or #targets == 0 or not GatlingGunRemote then return end
    local sync = workspace:GetAttribute("Sync") or 0
    local time = workspace:GetServerTimeNow() or tick()
    local currentTime = tick()
    
    if currentTime - LastFireTime >= Settings.Cooldown then
        for _, target in ipairs(targets) do
            local burstCount = Settings.Burst
            for burst = 1, burstCount do
                pcall(function()
                    GatlingGunRemote:FireServer(target.pos, sync, time)
                end)
            end
        end
        LastFireTime = currentTime
    end
end

spawn(function()
    while true do
        if Settings.On and Stats.TowerFound and Stats.CanFire and GatlingGunRemote then
            local targets = selectTargets()
            if #targets > 0 then
                fireAtTargets(targets)
            end
        end
        task.wait(0.01)
    end
end)

