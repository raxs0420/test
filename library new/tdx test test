local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local macroToTowerId = {}
local pendingPlacements = {}

local function getRemote(name)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild(name)
end

function TDX:Place(towerName, x, y, z, macroId)
    local remote = getRemote("PlaceTower")
    if not remote then 
        print("[TDX] PlaceTower remote not found")
        return false 
    end

    local pos = Vector3.new(x, y, z)

    local success, result = pcall(function()
        return remote:InvokeServer(0, towerName, pos, 0)
    end)

    if success and result == true then
        pendingPlacements[macroId] = {
            name = towerName,
            pos = pos,
            time = tick()
        }
        print(string.format("[TDX] Place command sent for Macro %d (%s)", macroId, towerName))
        return true
    end

    return false
end

function TDX:Upgrade(macroId, path, level)
    -- Wait a bit for the event to register the tower
    for i = 1, 30 do
        local towerId = macroToTowerId[macroId]
        if towerId then
            local remote = getRemote("TowerUpgradeRequest")
            if remote then
                pcall(function()
                    remote:FireServer(towerId, path, level)
                end)
                print(string.format("[TDX] Upgrade sent for Macro %d (ID: %d) - Path %s Lv%d", macroId, towerId, path, level))
                return true
            end
        end
        task.wait(0.1)
    end
    
    print(string.format("[TDX] Macro %d not found after 3 seconds, cannot upgrade", macroId))
    return false
end

function TDX:Sell(macroId)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        print(string.format("[TDX] Macro %d not found, cannot sell", macroId))
        return false
    end

    local remote = getRemote("SellTower")
    if not remote then
        print("[TDX] SellTower remote not found")
        return false
    end

    pcall(function()
        remote:FireServer(towerId)
    end)

    print(string.format("[TDX] Sell sent for Macro %d (ID: %d)", macroId, towerId))
    return true
end

function TDX:SetupUpgradeListener()
    local queueRemote = getRemote("TowerFactoryQueueUpdated")
    if not queueRemote then
        print("[TDX] TowerFactoryQueueUpdated not found")
        return
    end

    queueRemote.OnClientEvent:Connect(function(...)
        local args = {...}
        
        local towerData = nil
        
        if args[1] and args[1][1] and args[1][1].Data and args[1][1].Data[1] then
            towerData = args[1][1].Data[1]
        elseif args[1] and args[1].Data and args[1].Data[1] then
            towerData = args[1].Data[1]
        elseif args[1] and args[1][1] and args[1][1][1] then
            towerData = args[1][1][1]
        end
        
        if towerData then
            local towerId = towerData[1]
            local towerName = towerData[2]
            local ownerId = towerData[7]
            local pos = towerData[4]
            
            print(string.format("[TDX] Detected: %s (ID: %s) owned by %s", towerName, towerId, ownerId))
            
            if tostring(ownerId) == player.Name then
                for macroId, pending in pairs(pendingPlacements) do
                    if pending.name == towerName then
                        local dist = (pending.pos - pos).Magnitude
                        if dist < 5 then
                            macroToTowerId[macroId] = towerId
                            print(string.format("[TDX] ✓ Macro %d → ID: %s (%s)", macroId, towerId, towerName))
                            pendingPlacements[macroId] = nil
                            break
                        end
                    end
                end
            end
        end
    end)
    
    print("[TDX] SetupUpgradeListener ready")
end

return TDX