local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local macroToTowerId = {}
local pendingPlacements = {}

local function getRemote(name)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild(name)
end

function TDX:Place(towerName, x, y, z, macroId)
    local remote = getRemote("PlaceTower")
    if not remote then 
        print("[TDX] PlaceTower remote not found")
        return false 
    end

    local pos = Vector3.new(x, y, z)

    local success, result = pcall(function()
        return remote:InvokeServer(0, towerName, pos, 0)
    end)

    if success and result == true then
        pendingPlacements[macroId] = {
            name = towerName,
            pos = pos,
            time = tick()
        }
        print(string.format("[TDX] Place command sent for Macro %d (%s)", macroId, towerName))
        return true
    end

    return false
end

function TDX:Upgrade(macroId, path, level)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        print(string.format("[TDX] Macro %d not found, cannot upgrade", macroId))
        return false
    end

    local remote = getRemote("TowerUpgradeRequest")
    if not remote then
        print("[TDX] TowerUpgradeRequest remote not found")
        return false
    end

    pcall(function()
        remote:FireServer(towerId, path, level)
    end)

    print(string.format("[TDX] Upgrade sent for Macro %d (ID: %d) - Path %s Lv%d", macroId, towerId, path, level))
    return true
end

function TDX:Sell(macroId)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        print(string.format("[TDX] Macro %d not found, cannot sell", macroId))
        return false
    end

    local remote = getRemote("SellTower")
    if not remote then
        print("[TDX] SellTower remote not found")
        return false
    end

    pcall(function()
        remote:FireServer(towerId)
    end)

    print(string.format("[TDX] Sell sent for Macro %d (ID: %d)", macroId, towerId))
    return true
end

function TDX:SetupUpgradeListener()
    local queueRemote = getRemote("TowerFactoryQueueUpdated")
    if not queueRemote then
        print("[TDX] TowerFactoryQueueUpdated not found")
        return
    end
    
    print("[TDX] TowerFactoryQueueUpdated found, connecting...")

    queueRemote.OnClientEvent:Connect(function(data)
        print("[TDX] Event FIRED!")
        
        -- Try to parse the data structure
        local towerData = data[1]
        if towerData and towerData[1] then
            towerData = towerData[1]
        end
        
        if towerData and towerData.Data then
            local info = towerData.Data[1]
            if info then
                local towerId = info[1]
                local towerName = info[2]
                local ownerId = info[7]
                local pos = info[4]
                
                print(string.format("[TDX] Tower: %s, ID: %s, Owner: %s", towerName, towerId, ownerId))
                
                if tostring(ownerId) == player.Name then
                    for macroId, pending in pairs(pendingPlacements) do
                        if pending.name == towerName then
                            local dist = (pending.pos - pos).Magnitude
                            print(string.format("[TDX] Distance to Macro %d: %.2f", macroId, dist))
                            if dist < 5 then
                                macroToTowerId[macroId] = towerId
                                print(string.format("[TDX] ✓ Macro %d → ID: %s (%s)", macroId, towerId, towerName))
                                pendingPlacements[macroId] = nil
                                break
                            end
                        end
                    end
                end
            end
        else
            print("[TDX] Could not parse data structure")
            -- Print what we actually have
            if towerData then
                print("[TDX] towerData keys:", GetKeys(towerData))
            end
        end
    end)
    
    print("[TDX] SetupUpgradeListener ready - waiting for tower placements")
end

function GetKeys(t)
    local keys = {}
    for k in pairs(t) do
        table.insert(keys, k)
    end
    return table.concat(keys, ", ")
end

return TDX