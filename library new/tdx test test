local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local Remotes = nil
local CurrentSpeed = 1

local towers = {}
local partToId = {}
local expectedIdToActualId = {}
local actualIdToMacroId = {}

local nextId = 1
local freeIds = {}
local pendingPlacements = {} -- [expectedId] = { name = string, pos = Vector3, time = number }

-- Tune this for your tower size: 0.5 works for 0.2-0.5 stud towers
local MATCH_TOLERANCE = 0.5
local PENDING_TIMEOUT = 10 -- seconds

local function ensureRemotes()
    if Remotes then return Remotes end
    Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not Remotes then
        for i = 1, 10 do
            task.wait(0.5)
            Remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if Remotes then break end
        end
    end
    return Remotes
end

local function getRemote(name)
    local r = ensureRemotes()
    return r and r:FindFirstChild(name)
end

local function getCash()
    local plr = Players.LocalPlayer
    if not plr or not plr.leaderstats then return 0 end
    local cash = plr.leaderstats:FindFirstChild("Cash")
    return cash and cash.Value or 0
end

local function getTowerBeamColor(towerPart)
    local ring = towerPart:FindFirstChild("Ring")
    if not ring then return nil end
    local beam = ring:FindFirstChildWhichIsA("Beam")
    if not beam then return nil end
    local seq = beam.Color
    if seq and seq.Keypoints and #seq.Keypoints > 0 then
        return seq.Keypoints[1].Value
    end
    return nil
end

local function isDeadColor(color)
    return color.R < 0.1 and color.G < 0.1 and color.B < 0.1
end

local function isPartAlive(part)
    if not part or not part.Parent then return false end
    local color = getTowerBeamColor(part)
    return color and not isDeadColor(color)
end

local function allocateId()
    if #freeIds > 0 then
        return table.remove(freeIds, #freeIds)
    else
        local id = nextId
        nextId = nextId + 1
        return id
    end
end

local function freeId(id)
    if not id or id == 0 then return end
    table.insert(freeIds, id)
    local data = towers[id]
    if data and data.part then
        partToId[data.part] = nil
    end
    local macroId = actualIdToMacroId[id]
    if macroId then
        expectedIdToActualId[macroId] = nil
        actualIdToMacroId[id] = nil
    end
    towers[id] = nil
end

-- Match pending placement by name + position
local function matchPendingPlacement(partName, partPos)
    local bestId = nil
    local bestDist = MATCH_TOLERANCE
    for expectedId, data in pairs(pendingPlacements) do
        -- Name must match (case‑insensitive)
        if data.name:lower() == partName:lower() then
            local dist = (partPos - data.pos).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestId = expectedId
            end
        end
    end
    if bestId then
        print(string.format("[TDX] 🔗 Matched pending macro %d (name: %s, dist: %.2f)", bestId, partName, bestDist))
    end
    return bestId
end

local function addTower(part, expectedMacroId)
    if partToId[part] then
        -- Already mapped, but maybe it was a stale mapping? Force remap?
        if expectedMacroId then
            local existingId = partToId[part]
            local existingMacro = actualIdToMacroId[existingId]
            if existingMacro and existingMacro ~= expectedMacroId then
                print(string.format("[TDX] ⚠️ Part already mapped to macro %d, remapping to macro %d", existingMacro, expectedMacroId))
                freeId(existingId)
                partToId[part] = nil
            else
                return
            end
        else
            return
        end
    end

    local actualId = allocateId()
    partToId[part] = actualId
    towers[actualId] = {
        part = part,
        name = part.Name,
        position = part.Position,
        macroId = expectedMacroId
    }

    if expectedMacroId then
        -- Clear any existing mapping for this macroId (safety)
        local oldActual = expectedIdToActualId[expectedMacroId]
        if oldActual and oldActual ~= actualId then
            print(string.format("[TDX] ⚠️ Macro %d was already mapped to actual %d, replacing", expectedMacroId, oldActual))
            freeId(oldActual)
        end
        expectedIdToActualId[expectedMacroId] = actualId
        actualIdToMacroId[actualId] = expectedMacroId
        print(string.format("[TDX] ✓ Macro %d → Actual ID %d (%s)", expectedMacroId, actualId, part.Name))
    else
        print(string.format("[TDX] ✓ Tower %s → Actual ID %d", part.Name, actualId))
    end
end

local function removeTower(part, reason)
    local actualId = partToId[part]
    if not actualId then return end
    local macroId = actualIdToMacroId[actualId]
    if macroId then
        print(string.format("[TDX] 💀 Macro %d (Actual %d) %s", macroId, actualId, reason or "died"))
    end
    freeId(actualId)
    partToId[part] = nil
end

local function cleanupPendingPlacements()
    local now = os.time()
    for expectedId, data in pairs(pendingPlacements) do
        if now - data.time > PENDING_TIMEOUT then
            pendingPlacements[expectedId] = nil
            print(string.format("[TDX] ⏰ Pending macro %d (name: %s) timed out", expectedId, data.name))
        end
    end
end

local function syncAllTowers()
    local towersFolder = Workspace:FindFirstChild("Game") and Workspace.Game:FindFirstChild("Towers")
    if not towersFolder then return end

    -- Collect alive parts
    local aliveParts = {}
    for _, part in ipairs(towersFolder:GetChildren()) do
        if part:IsA("BasePart") and isPartAlive(part) then
            aliveParts[part] = true
        end
    end

    -- Remove dead / missing towers
    for part, actualId in pairs(partToId) do
        if not aliveParts[part] then
            removeTower(part, "died (beam dark)")
        end
    end

    -- Add new alive towers, matching pending placements by name+position
    for part, _ in pairs(aliveParts) do
        if not partToId[part] then
            local expectedId = matchPendingPlacement(part.Name, part.Position)
            if expectedId then
                pendingPlacements[expectedId] = nil  -- consume
                addTower(part, expectedId)
            else
                addTower(part, nil) -- unknown tower
            end
        end
    end

    cleanupPendingPlacements()
end

RunService.Heartbeat:Connect(syncAllTowers)

-- Public API ----------------------------------------------------------------

function TDX:Place(name, x, y, z, rot, cost, expectedId)
    local remote = getRemote("PlaceTower")
    if not remote then return nil end

    local pos = Vector3.new(x, y, z)
    print(string.format("[TDX] Placing %s (Macro ID: %s)", name, expectedId or "auto"))

    while getCash() < cost do
        task.wait(0.01)
    end
    task.wait(0.01)

    local ok, res = pcall(function()
        return remote:InvokeServer(rot or 0, name, pos, 0)
    end)

    if ok and res == true then
        if expectedId then
            pendingPlacements[expectedId] = {
                name = name,
                pos = pos,
                time = os.time()
            }
            print(string.format("[TDX] 📝 Stored pending macro %d for %s at (%.1f, %.1f, %.1f)", expectedId, name, x, y, z))
        end
        print(string.format("[TDX] ✓ %s placed", name))
        task.wait(0.3)
        return true
    end
    return false
end

function TDX:Upgrade(macroId, path, level, cost)
    -- Helper to retry once if mapping is missing
    local function tryUpgrade()
        local actualId = expectedIdToActualId[macroId]
        if not actualId then
            return false, "no mapping"
        end
        local data = towers[actualId]
        if not data or not data.part or not isPartAlive(data.part) then
            return false, "tower dead"
        end

        local remote = getRemote("TowerUpgradeRequest")
        if not remote then return false, "no remote" end

        while getCash() < cost do
            task.wait(0.01)
        end
        task.wait(0.01)
        pcall(function()
            remote:FireServer(actualId, path, level)
        end)

        print(string.format("[TDX] ↑ Macro %d | Path %d | Lv %d (Actual ID: %d)", macroId, path, level, actualId))
        return true
    end

    local success, reason = tryUpgrade()
    if not success and reason == "no mapping" then
        print(string.format("[TDX] ⏳ Macro %d not found, waiting 0.2s for sync...", macroId))
        task.wait(0.2)
        syncAllTowers() -- force sync
        success, reason = tryUpgrade()
        if not success then
            print(string.format("[TDX] ❌ Macro %d still not found after retry - skipping", macroId))
        end
    elseif not success then
        print(string.format("[TDX] ⏳ Macro %d skipped (%s)", macroId, reason))
    end
    task.wait(0.3)
    return success
end

function TDX:Sell(macroId)
    local actualId = expectedIdToActualId[macroId]
    if not actualId then
        print(string.format("[TDX] ⚠️ Macro %d not found - cannot sell", macroId))
        return false
    end
    local data = towers[actualId]
    if not data or not data.part or not isPartAlive(data.part) then
        print(string.format("[TDX] ⚠️ Macro %d tower is dead - cannot sell", macroId))
        return false
    end

    local remote = getRemote("SellTower")
    if remote then
        task.wait(0.15)
        pcall(function() remote:FireServer(actualId) end)
        print(string.format("[TDX] 💰 Sold Macro %d (Actual ID: %d)", macroId, actualId))
    end
    return true
end

function TDX:Ability(macroId, slot, loop)
    if loop then
        task.spawn(function()
            while true do
                TDX:Ability(macroId, slot, false)
                task.wait(0.5)
            end
        end)
        return
    end

    local actualId = expectedIdToActualId[macroId]
    if not actualId then return end
    local data = towers[actualId]
    if not data or not data.part or not isPartAlive(data.part) then return end

    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        local req = remote:FindFirstChild("TowerUseAbilityRequest")
        if req then
            pcall(function() req:InvokeServer(actualId, slot) end)
        end
    end
end

-- All other functions (TimeScale, AutoSkip, Mode, etc.) remain unchanged from your original.
-- I'll include them for completeness, but they are identical to your previous version.

function TDX:TimeScale(speed)
    if speed == CurrentSpeed then return true end
    local remote = getRemote("SoloToggleSpeedControl")
    if remote then
        if speed == 1 then
            remote:FireServer(false)
        elseif speed == 1.5 then
            remote:FireServer(true, true)
        elseif speed == 0.5 then
            remote:FireServer(true, false)
        else
            return false
        end
        CurrentSpeed = speed
    end
    return true
end

function TDX:AutoSkip(enabled)
    task.spawn(function()
        while enabled do
            local skip = getRemote("SkipWaveVoteCast")
            if skip then
                pcall(function() skip:FireServer(true) end)
            end
            task.wait(0.1)
        end
    end)
    return true
end

function TDX:Mode(mode)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local partyType = net:FindFirstChild("ClientChangePartyTypeRequest")
        local partyMap = net:FindFirstChild("ClientChangePartyMapRequest")
        if partyType and partyMap then
            partyType:FireServer("Party")
            task.wait(0.5)
            partyMap:FireServer(mode)
            task.wait(0.5)
            TDX:StartMatchmaking()
        end
    end
end

function TDX:StartMatchmaking()
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local start = net:FindFirstChild("ClientStartGameRequest")
        if start then
            start:FireServer()
        end
    end
    task.wait(0.5)
end

function TDX:Loadout(id)
    task.wait(2)
    local load = getRemote("LoadoutSelectionChanged")
    if load then
        load:FireServer(id)
    end
    task.wait(0.5)
end

function TDX:VoteDifficulty(diff)
    task.wait(5.5)
    local vote = getRemote("DifficultyVoteCast")
    if vote then
        vote:FireServer(diff)
    end
    task.wait(0.5)
    local ready = getRemote("DifficultyVoteReady")
    if ready then
        ready:FireServer(diff)
    end
    task.wait(1)
end

function TDX:VoteMap(map, attempts)
    attempts = attempts or 10
    for _ = 1, attempts do
        local vote = getRemote("MapVoteCast")
        if vote then
            vote:FireServer(map)
            task.wait(0.5)
            TDX:Ready()
            return true
        end
        local change = getRemote("MapChangeVoteCast")
        if change then
            change:FireServer(true)
        end
        task.wait(1)
    end
    return false
end

function TDX:Ready()
    local ready = getRemote("MapVoteReady")
    if ready then
        ready:FireServer()
    end
    task.wait(0.3)
end

function TDX:Equip(items)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local eq = net:FindFirstChild("UpdateLoadout")
        if eq then
            eq:FireServer(items)
        end
    end
    task.wait(0.5)
end

function TDX:ResetMappings()
    nextId = 1
    freeIds = {}
    partToId = {}
    expectedIdToActualId = {}
    actualIdToMacroId = {}
    pendingPlacements = {}
    for id in pairs(towers) do
        towers[id] = nil
    end
end

function TDX:AbilitySpamRange(startMacroId, endMacroId, slot, loop, cycleDelay)
    cycleDelay = cycleDelay or 1
    if loop then
        local active = true
        task.spawn(function()
            while active do
                for macroId = startMacroId, endMacroId do
                    TDX:Ability(macroId, slot, false)
                end
                task.wait(cycleDelay)
            end
        end)
        return function() active = false end
    else
        for macroId = startMacroId, endMacroId do
            TDX:Ability(macroId, slot, false)
        end
    end
end

function TDX:AbilitySpamList(macroIds, slot, loop)
    if loop then
        local active = true
        task.spawn(function()
            while active do
                for _, macroId in ipairs(macroIds) do
                    TDX:Ability(macroId, slot, false)
                    task.wait(0.05)
                end
                task.wait(0.1)
            end
        end)
        return function() active = false end
    else
        for _, macroId in ipairs(macroIds) do
            TDX:Ability(macroId, slot, false)
            task.wait(0.05)
        end
    end
end

local function startCoinCollector()
    task.spawn(function()
        local remote = nil
        local numbers = {1, 2, 3}
        local idx = 1
        while true do
            if not remote or not remote.Parent then
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes then
                    remote = remotes:FindFirstChild("ClientsideCoinCollectedEvent")
                end
            end
            if remote then
                pcall(function() remote:FireServer(numbers[idx]) end)
                idx = idx % #numbers + 1
            end
            task.wait(1)
        end
    end)
end

startCoinCollector()

return TDX