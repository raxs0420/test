local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local macroToTowerId = {}
local nextMacroId = 1
local pendingUpgrade = nil
local pendingSell = nil

local function getRemote(name)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild(name)
end

function TDX:Place(towerName, x, y, z, macroId)
    local remote = getRemote("PlaceTower")
    if not remote then 
        print("[TDX] PlaceTower remote not found")
        return false 
    end

    local pos = Vector3.new(x, y, z)

    task.wait(0.1)
    
    local success, result = pcall(function()
        return remote:InvokeServer(0, towerName, pos, 0)
    end)

    if success and result == true then
        print(string.format("[TDX] Place sent for Macro %d (%s)", macroId, towerName))
        task.wait(0.2)
        return true
    end

    return false
end

function TDX:Upgrade(macroId, path, level)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        print(string.format("[TDX] Macro %d not mapped yet, will upgrade when ID is received", macroId))
        pendingUpgrade = {macroId = macroId, path = path, level = level}
        return false
    end

    local remote = getRemote("TowerUpgradeRequest")
    if not remote then
        print("[TDX] TowerUpgradeRequest not found")
        return false
    end

    task.wait(0.1)
    
    pcall(function()
        remote:FireServer(towerId, path, level)
    end)
    print(string.format("[TDX] Upgrade sent for Macro %d (ID: %d)", macroId, towerId))
    task.wait(0.2)
    return true
end

function TDX:Sell(macroId)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        print(string.format("[TDX] Macro %d not mapped yet, will sell when ID is received", macroId))
        pendingSell = macroId
        return false
    end

    local remote = getRemote("SellTower")
    if not remote then
        print("[TDX] SellTower not found")
        return false
    end

    task.wait(0.1)
    
    pcall(function()
        remote:FireServer(towerId)
    end)
    print(string.format("[TDX] Sell sent for Macro %d (ID: %d)", macroId, towerId))
    macroToTowerId[macroId] = nil
    task.wait(0.2)
    return true
end

function TDX:SetupUpgradeListener()
    local queueRemote = getRemote("TowerFactoryQueueUpdated")
    if not queueRemote then
        print("[TDX] TowerFactoryQueueUpdated not found")
        return
    end

    queueRemote.OnClientEvent:Connect(function(data)
        -- The data IS the tower info table directly
        if data and data[1] and data[2] and data[7] then
            local realId = data[1]
            local towerName = data[2]
            local owner = data[7]
            
            if tostring(owner) == player.Name then
                local macroId = nextMacroId
                nextMacroId = nextMacroId + 1
                
                macroToTowerId[macroId] = realId
                print(string.format("[TDX] ✓ Tower placed: %s → Macro %d = Real ID %d", towerName, macroId, realId))
                
                if pendingUpgrade and pendingUpgrade.macroId == macroId then
                    task.wait(0.1)
                    TDX:Upgrade(pendingUpgrade.macroId, pendingUpgrade.path, pendingUpgrade.level)
                    pendingUpgrade = nil
                end
                
                if pendingSell == macroId then
                    task.wait(0.1)
                    TDX:Sell(pendingSell)
                    pendingSell = nil
                end
            end
        else
            -- Fallback: maybe wrapped one level
            local wrapped = data[1]
            if wrapped and wrapped[1] and wrapped[2] and wrapped[7] then
                local realId = wrapped[1]
                local towerName = wrapped[2]
                local owner = wrapped[7]
                
                if tostring(owner) == player.Name then
                    local macroId = nextMacroId
                    nextMacroId = nextMacroId + 1
                    
                    macroToTowerId[macroId] = realId
                    print(string.format("[TDX] ✓ Tower placed (wrapped): %s → Macro %d = Real ID %d", towerName, macroId, realId))
                    
                    if pendingUpgrade and pendingUpgrade.macroId == macroId then
                        task.wait(0.1)
                        TDX:Upgrade(pendingUpgrade.macroId, pendingUpgrade.path, pendingUpgrade.level)
                        pendingUpgrade = nil
                    end
                    
                    if pendingSell == macroId then
                        task.wait(0.1)
                        TDX:Sell(pendingSell)
                        pendingSell = nil
                    end
                end
            end
        end
    end)
    
    print("[TDX] SetupUpgradeListener ready - Macro IDs assigned automatically")
end

return TDX