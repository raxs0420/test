function TDX:TowerUpgrade(TowerName, Skill)
    local upgradeQueue = {}
    local isProcessing = false
    table.insert(upgradeQueue, {TowerName = TowerName, Skill = Skill})
    if not isProcessing then
        task.spawn(function()
            isProcessing = true
            while #upgradeQueue > 0 do
                local upgrade = table.remove(upgradeQueue, 1)
                local remote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("UpgradeShopOperationRequest")
                local upgraded = false
                while not upgraded do
                    local success, result = pcall(function()
                        return remote:InvokeServer(upgrade.TowerName, upgrade.Skill)
                    end)
                    if success and result == true then
                        upgraded = true
                        print(string.format("[TDX] Upgraded %s: %s", upgrade.TowerName, upgrade.Skill))
                    else
                        task.wait(1)
                    end
                end
                task.wait(0.5)
            end
            isProcessing = false
        end)
    end
end

function TDX:TimeScale(speed)
    if speed == CurrentSpeed then return true end
    local remote = getRemote("SoloToggleSpeedControl")
    if remote then
        if speed == 1 then
            remote:FireServer(false)
        elseif speed == 1.5 then
            remote:FireServer(true, true)
        elseif speed == 0.5 then
            remote:FireServer(true, false)
        else
            return false
        end
        CurrentSpeed = speed
    end
    return true
end

