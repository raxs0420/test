local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local pendingPlacements = {}
local macroToTowerId = {}
local pendingUpgrade = nil
local pendingSell = nil

local function getRemote(name)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return nil end
    return remotes:FindFirstChild(name)
end

local function parsePositionString(str)
    if type(str) ~= "string" then return nil end
    local parts = {}
    for part in string.gmatch(str, "[^,]+") do
        table.insert(parts, tonumber(part))
    end
    if #parts == 3 then
        return Vector3.new(parts[1], parts[2], parts[3])
    end
    return nil
end

local function deepFindFlatTable(t, depth)
    depth = depth or 0
    if depth > 5 then return nil end
    if type(t) ~= "table" then return nil end
    -- Check if this table has numeric keys 1,2,3...
    if t[1] ~= nil and type(t[1]) ~= "table" and t[2] ~= nil then
        return t
    end
    -- Otherwise search inside each value
    for _, v in pairs(t) do
        if type(v) == "table" then
            local found = deepFindFlatTable(v, depth+1)
            if found then return found end
        end
    end
    return nil
end

local function findMatchingMacroId(towerName, towerPos)
    local bestMatch, bestDist = nil, 0.5
    for macroId, data in pairs(pendingPlacements) do
        if data.towerName == towerName then
            local dist = (data.position - towerPos).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestMatch = macroId
            end
        end
    end
    if bestMatch then pendingPlacements[bestMatch] = nil end
    return bestMatch
end

function TDX:Place(towerName, x, y, z, macroId)
    local remote = getRemote("PlaceTower")
    if not remote then return false end

    local pos = Vector3.new(x, y, z)
    pendingPlacements[macroId] = { towerName = towerName, position = pos }

    task.wait(0.1)
    local success, result = pcall(function()
        return remote:InvokeServer(0, towerName, pos, 0)
    end)

    if success and result == true then
        print("[TDX] Place sent for Macro", macroId, "(", towerName, ")")
        task.wait(0.2)
        return true
    else
        pendingPlacements[macroId] = nil
        return false
    end
end

function TDX:Upgrade(macroId, path, level)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        pendingUpgrade = { macroId = macroId, path = path, level = level }
        print("[TDX] Queued upgrade for Macro", macroId)
        return false
    end
    local remote = getRemote("TowerUpgradeRequest")
    if not remote then return false end
    task.wait(0.1)
    pcall(function() remote:FireServer(towerId, path, level) end)
    print("[TDX] Upgrade sent for Macro", macroId, "(ID:", towerId, ")")
    task.wait(0.2)
    return true
end

function TDX:Sell(macroId)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        pendingSell = macroId
        print("[TDX] Queued sell for Macro", macroId)
        return false
    end
    local remote = getRemote("SellTower")
    if not remote then return false end
    task.wait(0.1)
    pcall(function() remote:FireServer(towerId) end)
    print("[TDX] Sell sent for Macro", macroId, "(ID:", towerId, ")")
    macroToTowerId[macroId] = nil
    task.wait(0.2)
    return true
end

function TDX:SetupUpgradeListener()
    local queueRemote = getRemote("TowerFactoryQueueUpdated")
    if not queueRemote then
        print("[TDX] ERROR: TowerFactoryQueueUpdated not found")
        return
    end

    queueRemote.OnClientEvent:Connect(function(data)
        print("\n[TDX] === EVENT RECEIVED ===")
        -- Automatically find the flat table (with numeric keys 1,2,3...)
        local flat = deepFindFlatTable(data)
        if not flat then
            print("[TDX] Could not find flat table structure in event data")
            return
        end

        local realId = flat[1]
        local towerName = flat[2]
        local owner = flat[7]
        local posString = flat[4]

        print("[TDX] Unwrapped -> ID:", realId, "Name:", towerName, "Owner:", owner, "PosStr:", posString)

        local towerPos = parsePositionString(posString)
        if not towerPos then
            print("[TDX] Failed to parse position")
            return
        end

        if tostring(owner) == player.Name then
            local macroId = findMatchingMacroId(towerName, towerPos)
            if macroId then
                macroToTowerId[macroId] = realId
                print("[TDX] ✓ Mapped Macro", macroId, "→ Tower ID", realId)

                if pendingUpgrade and pendingUpgrade.macroId == macroId then
                    task.wait(0.1)
                    TDX:Upgrade(pendingUpgrade.macroId, pendingUpgrade.path, pendingUpgrade.level)
                    pendingUpgrade = nil
                end
                if pendingSell == macroId then
                    task.wait(0.1)
                    TDX:Sell(pendingSell)
                    pendingSell = nil
                end
            else
                print("[TDX] No matching pending placement for", towerName)
            end
        else
            print("[TDX] Tower owned by", owner, "- ignoring")
        end
        print("[TDX] ===================\n")
    end)

    print("[TDX] Listener ready - will auto-detect nested event data")
end

return TDX