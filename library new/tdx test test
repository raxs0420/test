local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local pendingPlacements = {}
local macroToTowerId = {}
local waitingForId = {}
local resolvedId = {}
local pendingUpgrade = nil
local pendingSell = nil
local eventBuffer = {}

local function getRemote(name)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild(name)
end

-- Parse position string: handles "x, y, z", "x,y,z", "x y z", and even "x, y, z" with extra spaces
local function parsePositionString(str)
    if type(str) ~= "string" then return nil end
    -- Replace commas with spaces, then split by spaces
    local cleaned = str:gsub(",", " ")
    local parts = {}
    for part in string.gmatch(cleaned, "%S+") do
        -- Replace European comma decimal with dot (e.g., "1,000" -> "1.000")
        if part:find(",") then part = part:gsub(",", ".") end
        local num = tonumber(part)
        if not num then return nil end
        table.insert(parts, num)
        if #parts == 3 then break end
    end
    if #parts == 3 then
        return Vector3.new(parts[1], parts[2], parts[3])
    end
    return nil
end

-- Recursively find the table that has numeric keys 1,2,3... (the actual tower data)
local function findFlatTowerTable(t, depth)
    depth = depth or 0
    if depth > 6 then return nil end
    if type(t) ~= "table" then return nil end
    -- Check if this table has key 1 and 2 that are NOT tables (numbers or strings)
    if t[1] ~= nil and type(t[1]) ~= "table" and t[2] ~= nil and type(t[2]) ~= "table" then
        return t
    end
    -- Search all values recursively
    for _, v in pairs(t) do
        if type(v) == "table" then
            local found = findFlatTowerTable(v, depth+1)
            if found then return found end
        end
    end
    return nil
end

-- Find which pending macro matches the tower name and position
local function findMatchingMacroId(towerName, towerPos)
    for macroId, data in pairs(pendingPlacements) do
        if data.towerName == towerName and (data.position - towerPos).Magnitude < 0.5 then
            return macroId
        end
    end
    return nil
end

function TDX:Place(towerName, x, y, z, macroId)
    local remote = getRemote("PlaceTower")
    if not remote then return false end

    local pos = Vector3.new(x, y, z)
    pendingPlacements[macroId] = { towerName = towerName, position = pos }
    waitingForId[macroId] = true
    resolvedId[macroId] = nil

    -- First check if event already buffered for this exact tower
    for _, event in ipairs(eventBuffer) do
        if event.towerName == towerName and (event.towerPos - pos).Magnitude < 0.5 then
            resolvedId[macroId] = event.realId
            print("[TDX] Placed Macro", macroId, "→ Tower ID", event.realId)
            break
        end
    end

    -- Send placement request
    local success, result = pcall(function()
        return remote:InvokeServer(0, towerName, pos, 0)
    end)

    if not success or result ~= true then
        pendingPlacements[macroId] = nil
        waitingForId[macroId] = nil
        return false
    end

    -- If already resolved from buffer, skip waiting
    if resolvedId[macroId] then
        waitingForId[macroId] = nil
        pendingPlacements[macroId] = nil
        macroToTowerId[macroId] = resolvedId[macroId]

        -- Handle queued upgrade/sell for this macro
        if pendingUpgrade and pendingUpgrade.macroId == macroId then
            task.wait(0.1)
            TDX:Upgrade(pendingUpgrade.macroId, pendingUpgrade.path, pendingUpgrade.level)
            pendingUpgrade = nil
        end
        if pendingSell == macroId then
            task.wait(0.1)
            TDX:Sell(pendingSell)
            pendingSell = nil
        end
        return true
    end

    -- Otherwise wait for listener
    while waitingForId[macroId] and resolvedId[macroId] == nil do
        task.wait()
    end

    waitingForId[macroId] = nil
    pendingPlacements[macroId] = nil

    if resolvedId[macroId] then
        macroToTowerId[macroId] = resolvedId[macroId]
        print("[TDX] Placed Macro", macroId, "→ Tower ID", resolvedId[macroId])

        if pendingUpgrade and pendingUpgrade.macroId == macroId then
            task.wait(0.1)
            TDX:Upgrade(pendingUpgrade.macroId, pendingUpgrade.path, pendingUpgrade.level)
            pendingUpgrade = nil
        end
        if pendingSell == macroId then
            task.wait(0.1)
            TDX:Sell(pendingSell)
            pendingSell = nil
        end
        return true
    else
        print("[TDX] Failed to map Macro", macroId)
        return false
    end
end

function TDX:Upgrade(macroId, path, level)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        pendingUpgrade = { macroId = macroId, path = path, level = level }
        print("[TDX] Queued upgrade for Macro", macroId)
        return false
    end
    local remote = getRemote("TowerUpgradeRequest")
    if not remote then return false end
    task.wait(0.1)
    pcall(function() remote:FireServer(towerId, path, level) end)
    print("[TDX] Upgraded Macro", macroId, "(Tower ID", towerId, ")")
    return true
end

function TDX:Sell(macroId)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        pendingSell = macroId
        print("[TDX] Queued sell for Macro", macroId)
        return false
    end
    local remote = getRemote("SellTower")
    if not remote then return false end
    task.wait(0.1)
    pcall(function() remote:FireServer(towerId) end)
    print("[TDX] Sold Macro", macroId, "(Tower ID", towerId, ")")
    macroToTowerId[macroId] = nil
    return true
end

function TDX:SetupUpgradeListener()
    local queueRemote = getRemote("TowerFactoryQueueUpdated")
    if not queueRemote then
        print("[TDX] Remote not found")
        return
    end

    queueRemote.OnClientEvent:Connect(function(data)
        local flat = findFlatTowerTable(data)
        if not flat then return end

        local realId = flat[1]
        local towerName = flat[2]
        local owner = flat[7]
        local posString = flat[4]

        local towerPos = parsePositionString(posString)
        if not towerPos or tostring(owner) ~= player.Name then
            return
        end

        -- Buffer the event
        table.insert(eventBuffer, { realId = realId, towerName = towerName, towerPos = towerPos })
        -- Limit buffer size to avoid memory bloat
        if #eventBuffer > 50 then table.remove(eventBuffer, 1) end

        -- Match with any waiting macro
        local macroId = findMatchingMacroId(towerName, towerPos)
        if macroId then
            resolvedId[macroId] = realId
            -- No print here; Place will print the mapping
        end
    end)

    print("[TDX] Ready")
end

return TDX