local function ensureRemotes()
    if Remotes then return Remotes end
    Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not Remotes then
        for i = 1, 10 do
            task.wait(0.5)
            Remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if Remotes then break end
        end
    end
    return Remotes
end

local function getRemote(name)
    local r = ensureRemotes()
    return r and r:FindFirstChild(name)
end

-- Removed getCash() completely

local function isPartAlive(part)
    if not part or not part.Parent then return false end
    local ring = part:FindFirstChild("Ring")
    if not ring then return false end
    local beam = ring:FindFirstChildWhichIsA("Beam")
    if not beam then return false end
    local seq = beam.Color
    if seq and seq.Keypoints and #seq.Keypoints > 0 then
        local color = seq.Keypoints[1].Value
        return not (color.R < 0.1 and color.G < 0.1 and color.B < 0.1)
    end
    return false
end

local function allocateId()
    -- We don't need freeIds anymore because mapping is via macroId only
    -- But we keep for compatibility with existing code that uses actualId
    local nextId = #towers + 1
    return nextId
end

local function freeId(actualId)
    if not actualId then return end
    local macroId = actualIdToMacroId[actualId]
    if macroId then
        expectedIdToActualId[macroId] = nil
        actualIdToMacroId[actualId] = nil
    end
    local data = towers[actualId]
    if data and data.part then
        partToId[data.part] = nil
    end
    towers[actualId] = nil
end

-- Add a tower part to our tracking (called from syncAllTowers)
local function addTower(part, macroId)
    if partToId[part] then return end
    local actualId = allocateId()
    partToId[part] = actualId
    towers[actualId] = {
        part = part,
        name = part.Name,
        position = part.Position,
        macroId = macroId
    }
    if macroId then
        expectedIdToActualId[macroId] = actualId
        actualIdToMacroId[actualId] = macroId
        print(string.format("[TDX] ✓ Macro %d → ID %d", macroId, actualId))
    end
end

local function removeTower(part)
    local actualId = partToId[part]
    if not actualId then return end
    local macroId = actualIdToMacroId[actualId]
    if macroId then
        print(string.format("[TDX] 💀 Macro %d died", macroId))
    end
    freeId(actualId)
    partToId[part] = nil
end

-- Sync loop (kept from original, but no pending placement matching – just cleanup)
local function syncAllTowers()
    if not towersFolder then
        towersFolder = Workspace:FindFirstChild("Game") and Workspace.Game:FindFirstChild("Towers")
        if not towersFolder then return end
    end

    local aliveParts = {}
    for _, part in ipairs(towersFolder:GetChildren()) do
        if part:IsA("BasePart") and isPartAlive(part) then
            aliveParts[part] = true
        end
    end

    for part in pairs(partToId) do
        if not aliveParts[part] then
            removeTower(part)
        end
    end

    -- New towers that appear without an event? In our FIFO method they shouldn't happen,
    -- but we'll still add them if they have a macroId from a pending placement? No.
    -- Instead we rely on the event to do the mapping. So just cleanup.
end

RunService.Stepped:Connect(syncAllTowers)

-- Process upgrade retries (unchanged)
local function processUpgradeRetries()
    for macroId, data in pairs(upgradeRetryQueue) do
        if data.retries > 0 then
            local actualId = expectedIdToActualId[macroId]
            if actualId and towers[actualId] and isPartAlive(towers[actualId].part) then
                local remote = getRemote("TowerUpgradeRequest")
                if remote then
                    pcall(function()
                        remote:FireServer(actualId, data.path, data.level)
                    end)
                    print(string.format("[TDX] ↑ Macro %d | Lv %d (retry)", macroId, data.level))
                    upgradeRetryQueue[macroId] = nil
                else
                    data.retries = data.retries - 1
                end
            else
                data.retries = data.retries - 1
            end
        else
            upgradeRetryQueue[macroId] = nil
        end
    end
end

-- Call retry processor periodically (added to sync loop)
local oldSync = syncAllTowers
syncAllTowers = function()
    oldSync()
    processUpgradeRetries()
end

-- Game over teleport (unchanged)
local function checkGameOver()
    if gameOverTriggered then return end
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return end
    local interface = playerGui:FindFirstChild("Interface")
    if not interface then return end
    local gameOverScreen = interface:FindFirstChild("GameOverScreen")
    if not gameOverScreen then
        task.spawn(function()
            task.wait(10)
            checkGameOver()
        end)
        return
    end
    task.spawn(function()
        while not gameOverTriggered do
            if gameOverScreen.Visible then
                gameOverTriggered = true
                print("[TDX] Game Over! Teleporting...")
                task.wait(2)
                pcall(function()
                    TeleportService:Teleport(9503261072)
                end)
                break
            end
            task.wait(0.5)
        end
    end)
end

-- ========== NEW FIFO MAPPING LISTENER ==========
function TDX:SetupUpgradeListener()
    local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TowerFactoryQueueUpdated")
    
    remote.OnClientEvent:Connect(function(...)
        local args = {...}
        if args[1] and args[1][1] and args[1][1].Data then
            local towerData = args[1][1].Data[1]
            if towerData and towerData[1] then
                local realId = towerData[1]
                
                if #placementQueue > 0 then
                    local macroId = table.remove(placementQueue, 1)
                    expectedIdToActualId[macroId] = realId
                    actualIdToMacroId[realId] = macroId
                    print("[TDX] Placed Macro", macroId, "→ Tower ID", realId)
                    
                    -- Process queued upgrade/sell for this macro
                    if pendingUpgrade and pendingUpgrade.macroId == macroId then
                        task.wait(0.1)
                        TDX:Upgrade(pendingUpgrade.macroId, pendingUpgrade.path, pendingUpgrade.level)
                        pendingUpgrade = nil
                    end
                    if pendingSell == macroId then
                        task.wait(0.1)
                        TDX:Sell(pendingSell)
                        pendingSell = nil
                    end
                end
            end
        end
    end)
end

-- ========== PUBLIC API ==========

function TDX:Place(name, x, y, z, rot, cost, expectedId)
    -- cost is ignored (no cash needed)
    local remote = getRemote("PlaceTower")
    if not remote then return false end
    local pos = Vector3.new(x, y, z)
    -- Use provided expectedId or auto-generate? For compatibility, if expectedId is nil, we still need a macroId.
    -- The original allowed expectedId to be passed. We'll require it because FIFO needs a macroId.
    if not expectedId then
        error("[TDX] Place requires a macroId (expectedId parameter)")
    end
    -- Add to queue
    table.insert(placementQueue, expectedId)
    local success, result = pcall(function()
        return remote:InvokeServer(rot or 0, name, pos, 0)
    end)
    if success and result == true then
        print(string.format("[TDX] + %s (Macro %d)", name, expectedId))
        task.wait(0.25)
        return true
    else
        -- Remove from queue on failure
        for i, id in ipairs(placementQueue) do
            if id == expectedId then
                table.remove(placementQueue, i)
                break
            end
        end
        return false
    end
end

function TDX:Upgrade(macroId, path, level, cost)
    -- cost ignored
    local actualId = expectedIdToActualId[macroId]
    if actualId then
        local data = towers[actualId]
        if data and data.part and isPartAlive(data.part) then
            local remote = getRemote("TowerUpgradeRequest")
            if remote then
                pcall(function()
                    remote:FireServer(actualId, path, level)
                end)
                print(string.format("[TDX] ↑ Macro %d Lv%d", macroId, level))
                task.wait(0.35)
                return true
            end
        end
    end
    if not upgradeRetryQueue[macroId] then
        upgradeRetryQueue[macroId] = {
            path = path,
            level = level,
            retries = 10
        }
    end
    return false
end

function TDX:Sell(macroId)
    local actualId = expectedIdToActualId[macroId]
    if not actualId then return false end
    local data = towers[actualId]
    if not data or not data.part or not isPartAlive(data.part) then return false end
    local remote = getRemote("SellTower")
    if remote then
        task.wait(0.3)
        pcall(function() remote:FireServer(actualId) end)
        print(string.format("[TDX] 💰 Sold Macro %d", macroId))
        -- Remove mapping
        expectedIdToActualId[macroId] = nil
        actualIdToMacroId[actualId] = nil
    end
    return true
end

function TDX:Ability(macroId, slot, loop)
    if loop then
        task.spawn(function()
            while true do
                TDX:Ability(macroId, slot, false)
                task.wait(0.1)
            end
        end)
        return
    end
    local actualId = expectedIdToActualId[macroId]
    if not actualId then return end
    local data = towers[actualId]
    if not data or not data.part or not isPartAlive(data.part) then return end
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        local req = remote:FindFirstChild("TowerUseAbilityRequest")
        if req then
            pcall(function() req:InvokeServer(actualId, slot) end)
        end
    end
end

