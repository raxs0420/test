local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local pendingQueue = {}
local macroToTowerId = {}
local pendingUpgrade = nil
local pendingSell = nil

local function getRemote(name)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild(name)
end

function TDX:Place(towerName, x, y, z, macroId)
    local remote = getRemote("PlaceTower")
    if not remote then return false end

    table.insert(pendingQueue, macroId)

    local pos = Vector3.new(x, y, z)
    local success, result = pcall(function()
        return remote:InvokeServer(0, towerName, pos, 0)
    end)

    if not success or result ~= true then
        for i, id in ipairs(pendingQueue) do
            if id == macroId then table.remove(pendingQueue, i); break end
        end
        return false
    end

    print("[TDX] Place request sent for Macro", macroId)
    return true
end

function TDX:Upgrade(macroId, path, level)
    -- Convert path and level to numbers if they're strings
    local pathNum = tonumber(path) or path
    local levelNum = tonumber(level) or level
    
    local towerId = macroToTowerId[macroId]
    if not towerId then
        pendingUpgrade = { macroId = macroId, path = pathNum, level = levelNum }
        print("[TDX] Queued upgrade for Macro", macroId)
        return false
    end
    
    local remote = getRemote("TowerUpgradeRequest")
    if not remote then
        print("[TDX] ERROR: TowerUpgradeRequest not found")
        return false
    end
    
    task.wait(0.1)
    -- Fire with three numbers: towerId, path, level
    pcall(function() remote:FireServer(towerId, pathNum, levelNum) end)
    print("[TDX] Upgraded Macro", macroId, "(Tower ID", towerId, ", Path", pathNum, ", Level", levelNum, ")")
    return true
end

function TDX:Sell(macroId)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        pendingSell = macroId
        print("[TDX] Queued sell for Macro", macroId)
        return false
    end
    local remote = getRemote("SellTower")
    if not remote then return false end
    task.wait(0.1)
    pcall(function() remote:FireServer(towerId) end)
    print("[TDX] Sold Macro", macroId, "(Tower ID", towerId, ")")
    macroToTowerId[macroId] = nil
    return true
end

function TDX:SetupUpgradeListener()
    local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TowerFactoryQueueUpdated")
    
    remote.OnClientEvent:Connect(function(...)
        local args = {...}
        if args[1] and args[1][1] and args[1][1].Data then
            local towerData = args[1][1].Data[1]
            if towerData and towerData[1] then
                local realId = towerData[1]
                
                if #pendingQueue > 0 then
                    local macroId = table.remove(pendingQueue, 1)
                    macroToTowerId[macroId] = realId
                    print("[TDX] Placed Macro", macroId, "→ Tower ID", realId)
                    
                    if pendingUpgrade and pendingUpgrade.macroId == macroId then
                        task.wait(0.1)
                        TDX:Upgrade(pendingUpgrade.macroId, pendingUpgrade.path, pendingUpgrade.level)
                        pendingUpgrade = nil
                    end
                    if pendingSell == macroId then
                        task.wait(0.1)
                        TDX:Sell(pendingSell)
                        pendingSell = nil
                    end
                end
            end
        end
    end)

    print("[TDX] Ready (FIFO mapping + numeric upgrade args)")
end

return TDX