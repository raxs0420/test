local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local player = Players.LocalPlayer

local pendingQueue = {}               -- list of macroId (without towerName)
local macroToTowerId = {}
local pendingUpgrade = {}
local upgradeConfirm = {}
local pendingSell = nil
local CurrentSpeed = 1
local gameOverTriggered = false

-- AutoAbility tracking
local towerNameById = {}              -- towerId -> towerName
local towersByName = {}               -- towerName -> list of towerIds

local function getRemote(name)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild(name)
end

function TDX:Place(towerName, x, y, z, macroId)
    local remote = getRemote("PlaceTower")
    if not remote then
        error("[TDX] PlaceTower remote not found")
    end

    for _, id in ipairs(pendingQueue) do
        if id == macroId then
            warn("[TDX] Macro", macroId, "already pending")
            return false
        end
    end

    table.insert(pendingQueue, macroId)   -- only store macroId
    local pos = Vector3.new(x, y, z)

    while true do
        local success, result = pcall(function()
            return remote:InvokeServer(0, towerName, pos, 0)
        end)

        if success and result == true then
            break
        else
            warn("[TDX] Place failed, retrying in 0.2s...", success and result or "error")
            wait(0.2)
        end
    end

    print("[TDX] Place request accepted for Macro", macroId, "waiting for tower ID...")

    while not macroToTowerId[macroId] do
        wait(0.05)
    end

    print("[TDX] Macro", macroId, "successfully placed → Tower ID", macroToTowerId[macroId])
    return true
end

function TDX:Upgrade(macroId, path, level)
    local pathNum = tonumber(path) or path
    local levelNum = tonumber(level) or level

    while not macroToTowerId[macroId] do
        if not pendingUpgrade[macroId] then
            pendingUpgrade[macroId] = { macroId = macroId, path = pathNum, level = levelNum }
            print("[TDX] Queued upgrade for Macro", macroId, "(waiting for tower)")
        end
        wait(0.1)
    end

    local towerId = macroToTowerId[macroId]
    local remote = getRemote("TowerUpgradeRequest")
    if not remote then
        error("[TDX] TowerUpgradeRequest not found")
    end

    while true do
        upgradeConfirm[towerId] = false
        wait(0.1)
        pcall(function() remote:FireServer(towerId, pathNum, levelNum) end)
        print("[TDX] Upgrade request sent for Macro", macroId, "(Tower ID", towerId, ")")

        local startWait = tick()
        while upgradeConfirm[towerId] == false do
            wait(0.05)
            if tick() - startWait > 2 then
                print("[TDX] Upgrade confirmation timeout, retrying...")
                break
            end
        end

        if upgradeConfirm[towerId] == true then
            break
        end
    end

    print("[TDX] Upgrade confirmed for Macro", macroId, "(Tower ID", towerId, ", Path", pathNum, ", Level", levelNum, ")")
    pendingUpgrade[macroId] = nil
    upgradeConfirm[towerId] = nil
    return true
end

function TDX:Sell(macroId)
    while not macroToTowerId[macroId] do
        pendingSell = macroId
        print("[TDX] Queued sell for Macro", macroId, "(waiting for tower)")
        wait(0.1)
    end
    local towerId = macroToTowerId[macroId]
    local remote = getRemote("SellTower")
    if not remote then return false end

    -- Remove from AutoAbility tracking
    local towerName = towerNameById[towerId]
    if towerName and towersByName[towerName] then
        for i, id in ipairs(towersByName[towerName]) do
            if id == towerId then
                table.remove(towersByName[towerName], i)
                break
            end
        end
        towerNameById[towerId] = nil
    end

    wait(0.1)
    pcall(function() remote:FireServer(towerId) end)
    print("[TDX] Sold Macro", macroId, "(Tower ID", towerId, ")")
    macroToTowerId[macroId] = nil
    pendingSell = nil
    return true
end

function TDX:SetupUpgradeListener()
    -- Placement listener (TowerFactoryQueueUpdated)
    local factoryRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TowerFactoryQueueUpdated")
    factoryRemote.OnClientEvent:Connect(function(...)
        local args = {...}
        if args[1] and args[1][1] and args[1][1].Data then
            local towerData = args[1][1].Data[1]
            if towerData and towerData[1] then
                local realId = towerData[1]          -- ID
                local towerName = towerData[2]       -- Name (from your screenshot)

                if #pendingQueue > 0 then
                    local macroId = table.remove(pendingQueue, 1)
                    macroToTowerId[macroId] = realId
                    print("[TDX] Placed Macro", macroId, "→ Tower ID", realId, "(", towerName, ")")

                    -- Update AutoAbility tracking using the event's name
                    towerNameById[realId] = towerName
                    if not towersByName[towerName] then
                        towersByName[towerName] = {}
                    end
                    table.insert(towersByName[towerName], realId)

                    -- Process queued upgrade
                    local upgrade = pendingUpgrade[macroId]
                    if upgrade then
                        wait(0.1)
                        TDX:Upgrade(upgrade.macroId, upgrade.path, upgrade.level)
                        pendingUpgrade[macroId] = nil
                    end
                    if pendingSell == macroId then
                        wait(0.1)
                        TDX:Sell(pendingSell)
                        pendingSell = nil
                    end
                end
            end
        end
    end)

    -- Upgrade confirmation listener
    local upgradeRemote = ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("TowerUpgradeQueueUpdated")
    if upgradeRemote then
        upgradeRemote.OnClientEvent:Connect(function(data)
            if type(data) ~= "table" then return end
            local entries = (#data > 0) and data or {data}
            for _, entry in ipairs(entries) do
                local hash = entry.Hash or entry.hash or entry.Id or entry.id
                if not hash then continue end
                if type(hash) == "string" then hash = tonumber(hash) end
                if not hash then continue end

                if upgradeConfirm[hash] == false then
                    upgradeConfirm[hash] = true
                    print("[TDX] Upgrade confirmed for tower", hash)
                end
            end
        end)
        print("[TDX] Upgrade listener ready")
    else
        warn("[TDX] TowerUpgradeQueueUpdated not found")
    end

    print("[TDX] SetupUpgradeListener ready")
end

function TDX:AutoAbility(towerName, slot, isLooping)
    if not towersByName[towerName] or #towersByName[towerName] == 0 then
        warn("[TDX] No towers found with name", towerName)
        return false
    end

    local remote = getRemote("TowerUseAbilityRequest")
    if not remote then
        warn("[TDX] TowerUseAbilityRequest not found")
        return false
    end

    local function useOnAll()
        -- Dynamically get fresh list each iteration (towers may be sold or added)
        local ids = towersByName[towerName]
        if not ids then return end
        for _, id in ipairs(ids) do
            pcall(function()
                remote:InvokeServer(id, slot)
            end)
            wait(0.05)
        end
    end

    if isLooping then
        spawn(function()
            while true do
                useOnAll()
            end
        end)
        return true
    else
        useOnAll()
        return true
    end
end

function TDX:Init()
    spawn(function()
        local remote = nil
        local function getRemoteInternal()
            if not remote or not remote.Parent then
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes then
                    remote = remotes:FindFirstChild("ClientsideCoinCollectedEvent")
                end
            end
            return remote
        end

        while true do
            local currentRemote = getRemoteInternal()
            if currentRemote then
                for i = 1, 100 do
                    pcall(function() currentRemote:FireServer(i) end)
                end
            end
            wait(1)
        end
    end)

    delay(13, function()
        local lastCheck = 0
        RunService.Heartbeat:Connect(function(deltaTime)
            lastCheck = lastCheck + deltaTime
            if lastCheck >= 0.5 then
                lastCheck = 0
                local gameFolder = workspace:FindFirstChild("Game")
                if gameFolder then
                    local enemies = gameFolder:FindFirstChild("Enemies")
                    if enemies then
                        enemies:Destroy()
                    end
                end
                local tdxShared = ReplicatedStorage:FindFirstChild("TDX_Shared")
                if tdxShared then
                    local common = tdxShared:FindFirstChild("Common")
                    if common then
                        local resources = common:FindFirstChild("Resources")
                        if resources then
                            local deathEffects = resources:FindFirstChild("DeathEffects")
                            if deathEffects then
                                deathEffects:Destroy()
                            end
                        end
                    end
                end
            end
        end)
    end)

    spawn(function()
        if gameOverTriggered then return end
        local playerGui = player:FindFirstChild("PlayerGui")
        if not playerGui then return end
        local interface = playerGui:FindFirstChild("Interface")
        if not interface then return end
        local gameOverScreen = interface:FindFirstChild("GameOverScreen")
        if not gameOverScreen then
            wait(10)
            TDX:Init()
            return
        end
        while not gameOverTriggered do
            if gameOverScreen.Visible then
                gameOverTriggered = true
                print("[TDX] Game Over! Teleporting...")
                wait(2)
                pcall(function()
                    TeleportService:Teleport(9503261072)
                end)
                break
            end
            wait(0.5)
        end
    end)
end

function TDX:JoinMapViaAPC(mapName)
    local level = 0
    local lvl = player and player.leaderstats and player.leaderstats:FindFirstChild("Level")
    if lvl then level = lvl.Value end

    local startTime = tick()
    local apcsFolder = nil

    while true do
        apcsFolder = workspace:FindFirstChild("APCs")

        if not apcsFolder then
            if tick() - startTime >= 3 then
                return false
            end
            wait()
        else
            for _, slot in ipairs(apcsFolder:GetChildren()) do
                local attr = slot:GetAttribute("MapName") or ""
                if attr == mapName then
                    local detector = slot:FindFirstChild("Detector")
                    if not detector and slot:FindFirstChild("APC") then
                        detector = slot.APC:FindFirstChild("Detector")
                    end
                    if detector then
                        local char = player.Character
                        if char and char:FindFirstChild("HumanoidRootPart") then
                            char.HumanoidRootPart.CFrame = detector.CFrame
                            wait(2)
                            return true
                        end
                    end
                end
            end
        end

        if level >= 31 then
            local apcs2Folder = workspace:FindFirstChild("APCs2")
            if apcs2Folder then
                for _, slot in ipairs(apcs2Folder:GetChildren()) do
                    local attr = slot:GetAttribute("MapName") or ""
                    if attr == mapName then
                        local detector = slot:FindFirstChild("Detector")
                        if not detector and slot:FindFirstChild("APC") then
                            detector = slot.APC:FindFirstChild("Detector")
                        end
                        if detector then
                            local char = player.Character
                            if char and char:FindFirstChild("HumanoidRootPart") then
                                char.HumanoidRootPart.CFrame = detector.CFrame
                                wait(2)
                                return true
                            end
                        end
                    end
                end
            end
        end

        startTime = tick()
        wait()
    end
end

local typeMap = {
    Elite = 0,
    First = 1,
    Last = 2,
    Strong = 3,
    Weak = 4,
    Random = 5
}

local function getTypeValue(t)
    if type(t) == "number" then
        return math.clamp(t, 0, 5)
    elseif type(t) == "string" then
        return typeMap[t]
    end
    return nil
end

function TDX:SetTarget(macroId, targetType)
    while not macroToTowerId[macroId] do
        wait(0.05)
    end
    local towerId = macroToTowerId[macroId]
    local remote = getRemote("ChangeQueryType")
    if not remote then return false end
    local tv = getTypeValue(targetType)
    if tv == nil then return false end
    pcall(function() remote:FireServer(towerId, tv) end)
    return true
end

function TDX:Equip(items)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local eq = net:FindFirstChild("UpdateLoadout")
        if eq then
            eq:FireServer(items)
        end
    end
    wait(0.5)
end

function TDX:VoteAndReady(map, attempts)
    attempts = attempts or 10
    for _ = 1, attempts do
        local vote = getRemote("MapVoteCast")
        if vote then
            vote:FireServer(map)
            wait(0.5)
            local ready = getRemote("MapVoteReady")
            if ready then
                ready:FireServer()
            end
            wait(0.3)
            return true
        end
        local change = getRemote("MapChangeVoteCast")
        if change then
            change:FireServer(true)
        end
        wait(1)
    end
    return false
end

function TDX:SetModeAndStart(mode)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local partyType = net:FindFirstChild("ClientChangePartyTypeRequest")
        local partyMap = net:FindFirstChild("ClientChangePartyMapRequest")
        if partyType and partyMap then
            partyType:FireServer("Party")
            wait(0.5)
            partyMap:FireServer(mode)
            wait(0.5)
            local start = net:FindFirstChild("ClientStartGameRequest")
            if start then
                start:FireServer()
            end
        end
    end
    wait(0.5)
end

function TDX:Loadout(loadoutId)
    wait(2)
    local load = getRemote("LoadoutSelectionChanged")
    if load then
        load:FireServer(loadoutId)
    end
    wait(0.5)
end

function TDX:VoteDifficulty(diff)
    wait(5.5)
    local vote = getRemote("DifficultyVoteCast")
    if vote then
        vote:FireServer(diff)
    end
    wait(0.5)
    local ready = getRemote("DifficultyVoteReady")
    if ready then
        ready:FireServer(diff)
    end
    wait(1)
end

function TDX:TimeScale(speed)
    if speed == CurrentSpeed then return true end
    local remote = getRemote("SoloToggleSpeedControl")
    if remote then
        if speed == 1 then
            remote:FireServer(false)
        elseif speed == 1.5 then
            remote:FireServer(true, true)
        elseif speed == 0.5 then
            remote:FireServer(true, false)
        else
            return false
        end
        CurrentSpeed = speed
    end
    return true
end

function TDX:AutoSkip(enabled)
    spawn(function()
        while enabled do
            local skip = getRemote("SkipWaveVoteCast")
            if skip then
                pcall(function() skip:FireServer(true) end)
            end
            local cutscene = getRemote("CutsceneVoteCast")
            if cutscene then
                pcall(function() cutscene:FireServer(true) end)
            end
            wait(0.1)
        end
    end)
    return true
end

local upgradeSkillQueue = {}
local isProcessing = false
function TDX:TowerSkillUpgrade(TowerName, Skill)
    table.insert(upgradeSkillQueue, {TowerName = TowerName, Skill = Skill})

    if not isProcessing then
        spawn(function()
            isProcessing = true
            while #upgradeSkillQueue > 0 do
                local upgrade = table.remove(upgradeSkillQueue, 1)
                local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("UpgradeShopOperationRequest")
                local upgraded = false
                while not upgraded do
                    local success, result = pcall(function()
                        return remote:InvokeServer(upgrade.TowerName, upgrade.Skill)
                    end)
                    if success and result == true then
                        upgraded = true
                        print(string.format("[TDX] Upgraded %s: %s", upgrade.TowerName, upgrade.Skill))
                    else
                        wait(1)
                    end
                end
                wait(0.5)
            end
            isProcessing = false
        end)
    end
end

-- Legacy single-tower ability (kept for compatibility)
function TDX:Ability(macroId, slot, loop)
    if loop then
        spawn(function()
            while true do
                TDX:Ability(macroId, slot, false)
                wait(0.1)
            end
        end)
        return
    end
    while not macroToTowerId[macroId] do
        wait(0.05)
    end
    local actualId = macroToTowerId[macroId]
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        local req = remote:FindFirstChild("TowerUseAbilityRequest")
        if req then
            pcall(function() req:InvokeServer(actualId, slot) end)
        end
    end
end

return TDX