local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local UserInputService = game:GetService("UserInputService")

local Remotes = nil
local CurrentSpeed = 1
local player = Players.LocalPlayer
local towersFolder = nil
local gameOverTriggered = false

local hashToPart = {}
local partToHash = {}

-- Helper: ensure remotes folder
local function ensureRemotes()
    if Remotes then return Remotes end
    Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not Remotes then
        for i = 1, 10 do
            task.wait(0.5)
            Remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if Remotes then break end
        end
    end
    return Remotes
end

local function getRemote(name)
    local r = ensureRemotes()
    return r and r:FindFirstChild(name)
end

-- Cash
function TDX:GetCash()
    if not player or not player.leaderstats then return 0 end
    local cash = player.leaderstats:FindFirstChild("Cash")
    return cash and cash.Value or 0
end

-- Tower part health check (Ring + Beam color)
local function isPartAlive(part)
    if not part or not part.Parent then return false end
    local ring = part:FindFirstChild("Ring")
    if not ring then return false end
    local beam = ring:FindFirstChildWhichIsA("Beam")
    if not beam then return false end
    local seq = beam.Color
    if seq and seq.Keypoints and #seq.Keypoints > 0 then
        local color = seq.Keypoints[1].Value
        return not (color.R < 0.1 and color.G < 0.1 and color.B < 0.1)
    end
    return false
end

-- Cleanup dead towers
local function cleanupDeadTowers()
    for hash, part in pairs(hashToPart) do
        if not isPartAlive(part) then
            hashToPart[hash] = nil
            partToHash[part] = nil
        end
    end
end

-- Sync towers from workspace, link hash from attribute or child
local function syncTowers()
    if not towersFolder then
        towersFolder = Workspace:FindFirstChild("Game") and Workspace.Game:FindFirstChild("Towers")
        if not towersFolder then return end
    end
    for _, part in ipairs(towersFolder:GetChildren()) do
        if part:IsA("BasePart") and isPartAlive(part) then
            if not partToHash[part] then
                local hash = part:GetAttribute("Hash") or (part:FindFirstChild("Hash") and part.Hash.Value)
                if hash then
                    hashToPart[hash] = part
                    partToHash[part] = hash
                end
            end
        end
    end
    cleanupDeadTowers()
end

RunService.Stepped:Connect(syncTowers)

-- Upgrade detection listener (captures hashes and links to parts)
local upgradeListener = nil
function TDX:ListenForHashes()
    if upgradeListener then return end
    local queueRemote = getRemote("TowerUpgradeQueueUpdated")
    if not queueRemote then
        task.delay(1, function() TDX:ListenForHashes() end)
        return
    end
    upgradeListener = queueRemote.OnClientEvent:Connect(function(data)
        local entries = (#data > 0) and data or {data}
        for _, entry in ipairs(entries) do
            local hash = entry.Hash or entry.hash
            if hash and type(hash) == "number" then
                if not hashToPart[hash] then
                    for _, part in ipairs(towersFolder:GetChildren()) do
                        if part:IsA("BasePart") and isPartAlive(part) and not partToHash[part] then
                            local partHash = part:GetAttribute("Hash") or (part:FindFirstChild("Hash") and part.Hash.Value)
                            if partHash == hash then
                                hashToPart[hash] = part
                                partToHash[part] = hash
                                break
                            end
                        end
                    end
                end
                print(string.format("[TDX] Hash detected: %d", hash))
            end
        end
    end)
end

-- Place tower
function TDX:Place(name, x, y, z, rot, cost)
    local remote = getRemote("PlaceTower")
    if not remote then return false end
    local pos = Vector3.new(x, y, z)
    while TDX:GetCash() < cost do task.wait() end
    local ok, res = pcall(function()
        return remote:InvokeServer(rot or 0, name, pos, 0)
    end)
    if ok and res == true then
        print(string.format("[TDX] Placed %s at (%.1f, %.1f, %.1f)", name, x, y, z))
        task.wait(0.5)
        return true
    end
    return false
end

-- Upgrade tower by hash
function TDX:Upgrade(hash, path, level, cost)
    local part = hashToPart[hash]
    if not part or not isPartAlive(part) then
        print(string.format("[TDX] Tower hash %d not found or dead", hash))
        return false
    end
    local remote = getRemote("TowerUpgradeRequest")
    if not remote then return false end
    while TDX:GetCash() < cost do task.wait() end
    pcall(function()
        remote:FireServer(hash, path, level)
    end)
    print(string.format("[TDX] Upgraded hash %d to Lv%d (path %d)", hash, level, path))
    task.wait(0.35)
    return true
end

-- Utility functions
function TDX:HashExists(hash)
    return hashToPart[hash] ~= nil and isPartAlive(hashToPart[hash])
end

function TDX:GetPart(hash)
    return hashToPart[hash]
end

function TDX:Sell(hash)
    local part = hashToPart[hash]
    if not part or not isPartAlive(part) then return false end
    local remote = getRemote("SellTower")
    if remote then
        pcall(function() remote:FireServer(hash) end)
        print(string.format("[TDX] Sold hash %d", hash))
        hashToPart[hash] = nil
        partToHash[part] = nil
    end
    return true
end

-- Game flow functions
function TDX:Mode(mode)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local partyType = net:FindFirstChild("ClientChangePartyTypeRequest")
        local partyMap = net:FindFirstChild("ClientChangePartyMapRequest")
        if partyType and partyMap then
            partyType:FireServer("Party")
            task.wait(0.5)
            partyMap:FireServer(mode)
            task.wait(0.5)
            TDX:StartMatchmaking()
        end
    end
end

function TDX:StartMatchmaking()
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local start = net:FindFirstChild("ClientStartGameRequest")
        if start then
            start:FireServer()
        end
    end
    task.wait(0.5)
end

function TDX:Loadout(id)
    task.wait(2)
    local load = getRemote("LoadoutSelectionChanged")
    if load then
        load:FireServer(id)
    end
    task.wait(0.5)
end

function TDX:VoteDifficulty(diff)
    task.wait(5.5)
    local vote = getRemote("DifficultyVoteCast")
    if vote then
        vote:FireServer(diff)
    end
    task.wait(0.5)
    local ready = getRemote("DifficultyVoteReady")
    if ready then
        ready:FireServer(diff)
    end
    task.wait(1)
end

function TDX:VoteMap(map, attempts)
    attempts = attempts or 10
    for _ = 1, attempts do
        local vote = getRemote("MapVoteCast")
        if vote then
            vote:FireServer(map)
            task.wait(0.5)
            TDX:Ready()
            return true
        end
        local change = getRemote("MapChangeVoteCast")
        if change then
            change:FireServer(true)
        end
        task.wait(1)
    end
    return false
end

function TDX:Ready()
    local ready = getRemote("MapVoteReady")
    if ready then
        ready:FireServer()
    end
    task.wait(0.3)
end

function TDX:Equip(items)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local eq = net:FindFirstChild("UpdateLoadout")
        if eq then
            eq:FireServer(items)
        end
    end
    task.wait(0.5)
end

function TDX:JoinMapViaAPC(mapName)
    local level = 0
    local lvl = player and player.leaderstats and player.leaderstats:FindFirstChild("Level")
    if lvl then level = lvl.Value end

    local startTime = tick()
    local apcsFolder = nil

    while true do
        apcsFolder = Workspace:FindFirstChild("APCs")
        if not apcsFolder then
            if tick() - startTime >= 3 then return false end
            task.wait()
            continue
        end

        for _, slot in ipairs(apcsFolder:GetChildren()) do
            local attr = slot:GetAttribute("MapName") or ""
            if attr == mapName then
                local detector = slot:FindFirstChild("Detector")
                if not detector and slot:FindFirstChild("APC") then
                    detector = slot.APC:FindFirstChild("Detector")
                end
                if detector then
                    local char = player.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        char.HumanoidRootPart.CFrame = detector.CFrame
                        task.wait(2)
                        return true
                    end
                end
            end
        end

        if level >= 31 then
            local apcs2Folder = Workspace:FindFirstChild("APCs2")
            if apcs2Folder then
                for _, slot in ipairs(apcs2Folder:GetChildren()) do
                    local attr = slot:GetAttribute("MapName") or ""
                    if attr == mapName then
                        local detector = slot:FindFirstChild("Detector")
                        if not detector and slot:FindFirstChild("APC") then
                            detector = slot.APC:FindFirstChild("Detector")
                        end
                        if detector then
                            local char = player.Character
                            if char and char:FindFirstChild("HumanoidRootPart") then
                                char.HumanoidRootPart.CFrame = detector.CFrame
                                task.wait(2)
                                return true
                            end
                        end
                    end
                end
            end
        end
        startTime = tick()
        task.wait()
    end
end

-- Speed control
function TDX:TimeScale(speed)
    if speed == CurrentSpeed then return true end
    local remote = getRemote("SoloToggleSpeedControl")
    if remote then
        if speed == 1 then
            remote:FireServer(false)
        elseif speed == 1.5 then
            remote:FireServer(true, true)
        elseif speed == 0.5 then
            remote:FireServer(true, false)
        else
            return false
        end
        CurrentSpeed = speed
    end
    return true
end

-- Auto skip
function TDX:AutoSkip(enabled)
    task.spawn(function()
        while enabled do
            local skip = getRemote("SkipWaveVoteCast")
            if skip then pcall(function() skip:FireServer(true) end) end
            local cutscene = getRemote("CutsceneVoteCast")
            if cutscene then pcall(function() cutscene:FireServer(true) end) end
            task.wait(0.1)
        end
    end)
end

-- Tower abilities (by hash)
function TDX:Ability(hash, slot, loop)
    if loop then
        task.spawn(function()
            while true do
                TDX:Ability(hash, slot, false)
                task.wait(0.1)
            end
        end)
        return
    end
    local part = hashToPart[hash]
    if not part or not isPartAlive(part) then return end
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        local req = remote:FindFirstChild("TowerUseAbilityRequest")
        if req then
            pcall(function() req:InvokeServer(hash, slot) end)
        end
    end
end

-- Ability spam over a range of hashes (if you have sequential hashes)
function TDX:AbilitySpamRange(startHash, endHash, slot, loop, cycleDelay)
    cycleDelay = cycleDelay or 1
    if loop then
        local active = true
        task.spawn(function()
            while active do
                for hash = startHash, endHash do
                    TDX:Ability(hash, slot, false)
                end
                task.wait(cycleDelay)
            end
        end)
        return function() active = false end
    else
        for hash = startHash, endHash do
            TDX:Ability(hash, slot, false)
        end
    end
end

-- Ability spam over a list of hashes
function TDX:AbilitySpamList(hashes, slot, loop)
    if loop then
        local active = true
        task.spawn(function()
            while active do
                for _, hash in ipairs(hashes) do
                    TDX:Ability(hash, slot, false)
                    task.wait(0.05)
                end
                task.wait(0.1)
            end
        end)
        return function() active = false end
    else
        for _, hash in ipairs(hashes) do
            TDX:Ability(hash, slot, false)
            task.wait(0.05)
        end
    end
end

-- Targeting
local typeMap = {
    Elite = 0, First = 1, Last = 2, Strong = 3, Weak = 4, Random = 5
}
local function getTypeValue(t)
    if type(t) == "number" then
        return math.clamp(t, 0, 5)
    elseif type(t) == "string" then
        return typeMap[t]
    end
    return nil
end

function TDX:SetTarget(hash, targetType)
    local remote = getRemote("ChangeQueryType")
    if not remote then return false end
    local tv = getTypeValue(targetType)
    if tv == nil then return false end
    pcall(function() remote:FireServer(hash, tv) end)
    return true
end

function TDX:TargetRange(startHash, endHash, targetType, interval)
    interval = interval or 1
    local remote = getRemote("ChangeQueryType")
    if not remote then return false end
    local tv = getTypeValue(targetType)
    if tv == nil then return false end
    task.spawn(function()
        while true do
            for hash = startHash, endHash do
                pcall(function() remote:FireServer(hash, tv) end)
            end
            task.wait(interval)
        end
    end)
    return true
end

-- Shop upgrade (tower type global upgrades)
local upgradeQueue = {}
local isProcessing = false
function TDX:TowerUpgrade(TowerName, Skill)
    table.insert(upgradeQueue, {TowerName = TowerName, Skill = Skill})
    if not isProcessing then
        task.spawn(function()
            isProcessing = true
            while #upgradeQueue > 0 do
                local upgrade = table.remove(upgradeQueue, 1)
                local remote = getRemote("UpgradeShopOperationRequest")
                if remote then
                    local upgraded = false
                    while not upgraded do
                        local success, result = pcall(function()
                            return remote:InvokeServer(upgrade.TowerName, upgrade.Skill)
                        end)
                        if success and result == true then
                            upgraded = true
                            print(string.format("[TDX] Upgraded %s: %s", upgrade.TowerName, upgrade.Skill))
                        else
                            task.wait(1)
                        end
                    end
                end
                task.wait(0.5)
            end
            isProcessing = false
        end)
    end
end

-- Teleport
function TDX:TeleportToLobby()
    pcall(function() TeleportService:Teleport(9503261072) end)
end

-- Reset mappings (clear all stored hashes)
function TDX:ResetMappings()
    hashToPart = {}
    partToHash = {}
end

-- Game over detection + auto teleport
local function checkGameOver()
    if gameOverTriggered then return end
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return end
    local interface = playerGui:FindFirstChild("Interface")
    if not interface then return end
    local gameOverScreen = interface:FindFirstChild("GameOverScreen")
    if not gameOverScreen then
        task.delay(10, checkGameOver)
        return
    end
    task.spawn(function()
        while not gameOverTriggered do
            if gameOverScreen.Visible then
                gameOverTriggered = true
                print("[TDX] Game Over! Teleporting...")
                task.wait(2)
                TDX:TeleportToLobby()
                break
            end
            task.wait(0.5)
        end
    end)
end

-- Anti‑lag: remove enemies and projectiles
local function removeFolders()
    local gameFolder = Workspace:FindFirstChild("Game")
    if gameFolder then
        local enemies = gameFolder:FindFirstChild("Enemies")
        if enemies then enemies:Destroy() end
        local projectiles = gameFolder:FindFirstChild("Projectiles")
        if projectiles then projectiles:Destroy() end
    end
    local tdxShared = ReplicatedStorage:FindFirstChild("TDX_Shared")
    if tdxShared then
        local common = tdxShared:FindFirstChild("Common")
        if common then
            local resources = common:FindFirstChild("Resources")
            if resources then
                local deathEffects = resources:FindFirstChild("DeathEffects")
                if deathEffects then deathEffects:Destroy() end
            end
        end
    end
end

-- Anti‑lag loop
task.delay(13, function()
    local lastCheck = 0
    RunService.Heartbeat:Connect(function(dt)
        lastCheck = lastCheck + dt
        if lastCheck >= 0.5 then
            lastCheck = 0
            removeFolders()
        end
    end)
end)

-- Coin collector
local function startCoinCollector()
    task.spawn(function()
        local remote = nil
        while true do
            if not remote or not remote.Parent then
                remote = getRemote("ClientsideCoinCollectedEvent")
            end
            if remote then
                for i = 1, 100 do
                    pcall(function() remote:FireServer(i) end)
                end
            end
            task.wait(1)
        end
    end)
end

