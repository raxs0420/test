local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- Module-level state
local pendingPlacements = {}   -- macroId -> {towerName, position}
local macroToTowerId = {}      -- macroId -> realId
local waitingForId = {}        -- macroId -> true
local resolvedId = {}          -- macroId -> realId (set by listener)
local pendingUpgrade = nil     -- {macroId, path, level}
local pendingSell = nil        -- macroId

local function getRemote(name)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild(name)
end

local function parsePositionString(str)
    if type(str) ~= "string" then return nil end
    local parts = {}
    for part in string.gmatch(str, "[^,]+") do
        local trimmed = part:match("^%s*(.-)%s*$")
        if trimmed:find(",") then trimmed = trimmed:gsub(",", ".") end
        local num = tonumber(trimmed)
        if not num then return nil end
        table.insert(parts, num)
    end
    if #parts == 3 then
        return Vector3.new(parts[1], parts[2], parts[3])
    end
    return nil
end

local function deepFindFlatTable(t, depth)
    depth = depth or 0
    if depth > 5 then return nil end
    if type(t) ~= "table" then return nil end
    if t[1] ~= nil and type(t[1]) ~= "table" and t[2] ~= nil then
        return t
    end
    for _, v in pairs(t) do
        if type(v) == "table" then
            local found = deepFindFlatTable(v, depth+1)
            if found then return found end
        end
    end
    return nil
end

local function findWaitingMacroId(towerName, towerPos)
    for macroId, data in pairs(pendingPlacements) do
        if data.towerName == towerName and (data.position - towerPos).Magnitude < 0.5 then
            return macroId
        end
    end
    return nil
end

function TDX:Place(towerName, x, y, z, macroId)
    local remote = getRemote("PlaceTower")
    if not remote then return false end

    local pos = Vector3.new(x, y, z)
    pendingPlacements[macroId] = { towerName = towerName, position = pos }
    waitingForId[macroId] = true
    resolvedId[macroId] = nil

    local success, result = pcall(function()
        return remote:InvokeServer(0, towerName, pos, 0)
    end)

    if not success or result ~= true then
        pendingPlacements[macroId] = nil
        waitingForId[macroId] = nil
        print("[TDX] Place failed for macro", macroId)
        return false
    end

    print("[TDX] Place sent for Macro", macroId, "– waiting for confirmation")

    -- Wait for event to set resolvedId
    while waitingForId[macroId] and resolvedId[macroId] == nil do
        task.wait()
    end

    waitingForId[macroId] = nil
    pendingPlacements[macroId] = nil

    if resolvedId[macroId] then
        macroToTowerId[macroId] = resolvedId[macroId]
        print("[TDX] ✓ Macro", macroId, "mapped to real ID", resolvedId[macroId])

        -- Process any queued upgrade/sell for this macroId
        if pendingUpgrade and pendingUpgrade.macroId == macroId then
            task.wait(0.1)
            TDX:Upgrade(pendingUpgrade.macroId, pendingUpgrade.path, pendingUpgrade.level)
            pendingUpgrade = nil
        end
        if pendingSell == macroId then
            task.wait(0.1)
            TDX:Sell(pendingSell)
            pendingSell = nil
        end
        return true
    else
        print("[TDX] ERROR: Macro", macroId, "never got real ID")
        return false
    end
end

function TDX:Upgrade(macroId, path, level)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        pendingUpgrade = { macroId = macroId, path = path, level = level }
        print("[TDX] Queued upgrade for Macro", macroId)
        return false
    end
    local remote = getRemote("TowerUpgradeRequest")
    if not remote then return false end
    task.wait(0.1)
    pcall(function() remote:FireServer(towerId, path, level) end)
    print("[TDX] Upgrade sent for Macro", macroId, "(ID:", towerId, ")")
    return true
end

function TDX:Sell(macroId)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        pendingSell = macroId
        print("[TDX] Queued sell for Macro", macroId)
        return false
    end
    local remote = getRemote("SellTower")
    if not remote then return false end
    task.wait(0.1)
    pcall(function() remote:FireServer(towerId) end)
    print("[TDX] Sell sent for Macro", macroId, "(ID:", towerId, ")")
    macroToTowerId[macroId] = nil
    return true
end

function TDX:SetupUpgradeListener()
    local queueRemote = getRemote("TowerFactoryQueueUpdated")
    if not queueRemote then
        print("[TDX] TowerFactoryQueueUpdated not found")
        return
    end

    queueRemote.OnClientEvent:Connect(function(data)
        local flat = deepFindFlatTable(data)
        if not flat then return end

        local realId = flat[1]
        local towerName = flat[2]
        local owner = flat[7]
        local posString = flat[4]
        local towerPos = parsePositionString(posString)

        if not towerPos or tostring(owner) ~= player.Name then
            return
        end

        local macroId = findWaitingMacroId(towerName, towerPos)
        if macroId then
            resolvedId[macroId] = realId
            print("[TDX] Event → Macro", macroId, "got real ID", realId)
        end
    end)

    print("[TDX] Listener ready – placements block until confirmed")
end

return TDX