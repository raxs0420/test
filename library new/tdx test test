local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local pendingPlacements = {}
local macroToTowerId = {}
local pendingUpgrade = nil
local pendingSell = nil

local function getRemote(name)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then
        print("[DEBUG] Remotes folder not found")
        return nil
    end
    local remote = remotes:FindFirstChild(name)
    if not remote then
        print("[DEBUG] Remote not found:", name)
    else
        print("[DEBUG] Found remote:", name)
    end
    return remote
end

local function parsePositionString(str)
    if type(str) ~= "string" then return nil end
    local parts = {}
    for part in string.gmatch(str, "[^,]+") do
        table.insert(parts, tonumber(part))
    end
    if #parts == 3 then
        return Vector3.new(parts[1], parts[2], parts[3])
    end
    return nil
end

local function findMatchingMacroId(towerName, towerPos)
    local bestMatch = nil
    local bestDist = 0.5
    for macroId, data in pairs(pendingPlacements) do
        if data.towerName == towerName then
            local dist = (data.position - towerPos).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestMatch = macroId
            end
        end
    end
    if bestMatch then
        pendingPlacements[bestMatch] = nil
    end
    return bestMatch
end

function TDX:Place(towerName, x, y, z, macroId)
    print("[DEBUG] Place called for macro", macroId, "tower", towerName)
    local remote = getRemote("PlaceTower")
    if not remote then
        print("[ERROR] No PlaceTower remote")
        return false
    end

    local pos = Vector3.new(x, y, z)
    pendingPlacements[macroId] = {
        towerName = towerName,
        position = pos
    }
    print("[DEBUG] Pending placement stored for macro", macroId)

    task.wait(0.1)

    local success, result = pcall(function()
        return remote:InvokeServer(0, towerName, pos, 0)
    end)

    if success and result == true then
        print("[DEBUG] Place InvokeServer succeeded for macro", macroId)
        task.wait(0.2)
        return true
    else
        print("[ERROR] Place failed for macro", macroId, "success:", success, "result:", result)
        pendingPlacements[macroId] = nil
        return false
    end
end

function TDX:Upgrade(macroId, path, level)
    print("[DEBUG] Upgrade requested for macro", macroId, "path", path, "level", level)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        print("[DEBUG] Macro", macroId, "not mapped, queuing upgrade")
        pendingUpgrade = {macroId = macroId, path = path, level = level}
        return false
    end

    local remote = getRemote("TowerUpgradeRequest")
    if not remote then
        print("[ERROR] No TowerUpgradeRequest remote")
        return false
    end

    task.wait(0.1)
    pcall(function()
        remote:FireServer(towerId, path, level)
    end)
    print("[DEBUG] Upgrade fired for macro", macroId, "real ID", towerId)
    task.wait(0.2)
    return true
end

function TDX:Sell(macroId)
    print("[DEBUG] Sell requested for macro", macroId)
    local towerId = macroToTowerId[macroId]
    if not towerId then
        print("[DEBUG] Macro", macroId, "not mapped, queuing sell")
        pendingSell = macroId
        return false
    end

    local remote = getRemote("SellTower")
    if not remote then
        print("[ERROR] No SellTower remote")
        return false
    end

    task.wait(0.1)
    pcall(function()
        remote:FireServer(towerId)
    end)
    print("[DEBUG] Sell fired for macro", macroId, "real ID", towerId)
    macroToTowerId[macroId] = nil
    task.wait(0.2)
    return true
end

function TDX:SetupUpgradeListener()
    print("[DEBUG] Setting up listener for TowerFactoryQueueUpdated")
    local queueRemote = getRemote("TowerFactoryQueueUpdated")
    if not queueRemote then
        print("[ERROR] TowerFactoryQueueUpdated remote not found")
        return
    end

    queueRemote.OnClientEvent:Connect(function(data)
        print("[DEBUG] ========== EVENT RECEIVED ==========")
        print("[DEBUG] Raw data type:", type(data))
        print("[DEBUG] Raw data:", data)

        if type(data) == "table" then
            print("[DEBUG] Table keys:")
            for k, v in pairs(data) do
                print("  ", k, "=", v, "type:", type(v))
            end
        end

        local realId = data[1]
        local towerName = data[2]
        local owner = data[7]
        local posString = data[4]

        print("[DEBUG] Extracted: realId=", realId, "towerName=", towerName, "owner=", owner, "posString=", posString)

        if not realId or not towerName or not owner or not posString then
            print("[DEBUG] Missing fields, trying alternative index structure")
            -- Some games wrap the table
            local wrapped = data[1]
            if type(wrapped) == "table" then
                realId = wrapped[1]
                towerName = wrapped[2]
                owner = wrapped[7]
                posString = wrapped[4]
                print("[DEBUG] Wrapped extraction: realId=", realId, "towerName=", towerName, "owner=", owner, "posString=", posString)
            end
        end

        local towerPos = parsePositionString(posString)
        print("[DEBUG] Parsed position:", towerPos)

        if tostring(owner) == player.Name and towerPos then
            print("[DEBUG] Owner matches player, attempting to match pending placement")
            local macroId = findMatchingMacroId(towerName, towerPos)
            if macroId then
                macroToTowerId[macroId] = realId
                print("[DEBUG] ✓ MAPPED: Macro", macroId, "→ Real ID", realId, "Tower", towerName)

                if pendingUpgrade and pendingUpgrade.macroId == macroId then
                    print("[DEBUG] Found queued upgrade for macro", macroId, "executing now")
                    task.wait(0.1)
                    TDX:Upgrade(pendingUpgrade.macroId, pendingUpgrade.path, pendingUpgrade.level)
                    pendingUpgrade = nil
                end
                if pendingSell == macroId then
                    print("[DEBUG] Found queued sell for macro", macroId, "executing now")
                    task.wait(0.1)
                    TDX:Sell(pendingSell)
                    pendingSell = nil
                end
            else
                print("[DEBUG] No pending macro found for tower", towerName, "at position", posString)
                print("[DEBUG] Current pendingPlacements:")
                for k, v in pairs(pendingPlacements) do
                    print("  Macro", k, ":", v.towerName, v.position)
                end
            end
        else
            print("[DEBUG] Owner mismatch or no position. Owner:", tostring(owner), "Player:", player.Name, "Pos valid:", towerPos ~= nil)
        end
        print("[DEBUG] ===================================")
    end)

    print("[DEBUG] Listener connected successfully")
end

return TDX