local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local Remotes = nil
local CurrentSpeed = 1

local towers = {}
local partToId = {}
local nextId = 1
local freeIds = {}
local expectedIdToActualId = {}
local pendingPlacements = {}

local function ensureRemotes()
    if Remotes then return Remotes end
    Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not Remotes then
        for i = 1, 10 do
            task.wait(0.5)
            Remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if Remotes then break end
        end
    end
    return Remotes
end

local function getRemote(name)
    local r = ensureRemotes()
    return r and r:FindFirstChild(name)
end

local function getCash()
    local plr = Players.LocalPlayer
    if not plr or not plr.leaderstats then return 0 end
    local cash = plr.leaderstats:FindFirstChild("Cash")
    return cash and cash.Value or 0
end

local function getTowerBeamColor(towerPart)
    local ring = towerPart:FindFirstChild("Ring")
    if not ring then return nil end
    local beam = ring:FindFirstChildWhichIsA("Beam")
    if not beam then return nil end
    local seq = beam.Color
    if seq and seq.Keypoints and #seq.Keypoints > 0 then
        return seq.Keypoints[1].Value
    end
    return nil
end

local function isDeadColor(color)
    return color.R < 0.1 and color.G < 0.1 and color.B < 0.1
end

local function allocateId()
    if #freeIds > 0 then
        return table.remove(freeIds, #freeIds)
    else
        local id = nextId
        nextId = nextId + 1
        return id
    end
end

local function freeId(id)
    if id and id > 0 then
        table.insert(freeIds, id)
        if towers[id] then
            if towers[id].part then
                partToId[towers[id].part] = nil
            end
            towers[id] = nil
        end
    end
end

local function addTower(part, expectedMacroId)
    if partToId[part] then return end
    local beamColor = getTowerBeamColor(part)
    if beamColor and isDeadColor(beamColor) then return end
    
    local actualId = allocateId()
    partToId[part] = actualId
    
    towers[actualId] = {
        part = part,
        name = part.Name,
        alive = true,
        position = part.Position,
        macroId = expectedMacroId
    }
    
    if expectedMacroId then
        expectedIdToActualId[expectedMacroId] = actualId
        print(string.format("[TDX] ✓ Macro %d → Actual ID %d (%s)", expectedMacroId, actualId, part.Name))
    else
        print(string.format("[TDX] ✓ Tower %s → Actual ID %d", part.Name, actualId))
    end
end

local function checkDeadTowers()
    for part, id in pairs(partToId) do
        local data = towers[id]
        if data then
            if not part.Parent then
                if data.macroId then
                    print(string.format("[TDX] 💀 Macro %d (Actual %d) died", data.macroId, id))
                end
                freeId(id)
                partToId[part] = nil
            else
                local color = getTowerBeamColor(part)
                if color and isDeadColor(color) then
                    if data.macroId then
                        print(string.format("[TDX] 💀 Macro %d (Actual %d) died", data.macroId, id))
                    end
                    freeId(id)
                    partToId[part] = nil
                end
            end
        end
    end
end

local TowersFolder = Workspace:FindFirstChild("Game") and Workspace.Game:FindFirstChild("Towers")
if not TowersFolder then
    TowersFolder = Instance.new("Folder")
end

local function onTowerAdded(part)
    if not part:IsA("BasePart") then return end
    if partToId[part] then return end
    task.wait(0.05)
    if not part.Parent then return end
    
    local expectedId = nil
    for posStr, pending in pairs(pendingPlacements) do
        local pos = Vector3.new(unpack(string.split(posStr, ",")))
        if (part.Position - pos).Magnitude < 5 and pending.name == part.Name then
            expectedId = pending.expectedId
            pendingPlacements[posStr] = nil
            break
        end
    end
    
    addTower(part, expectedId)
end

local function onTowerRemoved(part)
    local id = partToId[part]
    if not id then return end
    freeId(id)
    partToId[part] = nil
end

if TowersFolder then
    TowersFolder.ChildAdded:Connect(onTowerAdded)
    TowersFolder.ChildRemoved:Connect(onTowerRemoved)
end

RunService.Heartbeat:Connect(function()
    if not TowersFolder then return end
    for _, part in ipairs(TowersFolder:GetChildren()) do
        if part:IsA("BasePart") and not partToId[part] then
            onTowerAdded(part)
        end
    end
    checkDeadTowers()
end)

function TDX:Place(name, x, y, z, rot, cost, expectedId)
    local remote = getRemote("PlaceTower")
    if not remote then return nil end
    
    local pos = Vector3.new(x, y, z)
    local posKey = tostring(pos)
    
    print(string.format("[TDX] Placing %s (Macro ID: %s)", name, expectedId or "auto"))
    
    while getCash() < cost do
        task.wait()
    end
    
    local ok, res = pcall(function()
        return remote:InvokeServer(rot or 0, name, pos, 0)
    end)
    
    if ok and res == true then
        pendingPlacements[posKey] = {name = name, expectedId = expectedId}
        print(string.format("[TDX] ✓ %s placed", name))
        task.wait(0.2)
        return true
    end
    
    return false
end

function TDX:Upgrade(macroId, path, level, cost)
    local actualId = expectedIdToActualId[macroId]
    local data = towers[actualId]
    
    if not data or not data.alive then
        print(string.format("[TDX] ⏳ Macro %d not found - skipping", macroId))
        return false
    end
    
    local part = data.part
    if not part or not part.Parent then
        return false
    end
    
    local container = Workspace:FindFirstChild("Game")
    if container then container = container:FindFirstChild("Towers") end
    
    local serverID = nil
    if container then
        local children = container:GetChildren()
        for idx, p in ipairs(children) do
            if p == part then
                serverID = idx
                break
            end
        end
    end
    
    if not serverID then
        return false
    end
    
    local remote = getRemote("TowerUpgradeRequest")
    if not remote then return false end
    
    while getCash() < cost do
        task.wait()
    end
    
    pcall(function()
        remote:FireServer(serverID, path, level)
    end)
    
    print(string.format("[TDX] ↑ Macro %d | Path %d | Lv %d", macroId, path, level))
    task.wait(0.05)
    return true
end

function TDX:Sell(macroId)
    local actualId = expectedIdToActualId[macroId]
    local data = towers[actualId]
    
    if not data or not data.alive then
        print(string.format("[TDX] ⚠️ Macro %d not found - cannot sell", macroId))
        return false
    end
    
    local part = data.part
    if not part or not part.Parent then
        return false
    end
    
    local container = Workspace:FindFirstChild("Game")
    if container then container = container:FindFirstChild("Towers") end
    
    local serverID = nil
    if container then
        local children = container:GetChildren()
        for idx, p in ipairs(children) do
            if p == part then
                serverID = idx
                break
            end
        end
    end
    
    if serverID then
        local remote = getRemote("SellTower")
        if remote then
            pcall(function() remote:FireServer(serverID) end)
            print(string.format("[TDX] 💰 Sold Macro %d", macroId))
        end
    end
    
    return true
end

function TDX:Ability(macroId, slot, loop)
    if loop then
        task.spawn(function()
            while true do
                TDX:Ability(macroId, slot, false)
                task.wait(0.5)
            end
        end)
        return
    end
    
    local actualId = expectedIdToActualId[macroId]
    local data = towers[actualId]
    
    if not data or not data.alive then
        return
    end
    
    local container = Workspace:FindFirstChild("Game")
    if container then container = container:FindFirstChild("Towers") end
    
    local serverID = nil
    if container then
        local children = container:GetChildren()
        for idx, p in ipairs(children) do
            if p == data.part then
                serverID = idx
                break
            end
        end
    end
    
    if serverID then
        local remote = ReplicatedStorage:FindFirstChild("Remotes")
        if remote then
            local req = remote:FindFirstChild("TowerUseAbilityRequest")
            if req then
                pcall(function() req:InvokeServer(serverID, slot) end)
            end
        end
    end
end

function TDX:TimeScale(speed)
    if speed == CurrentSpeed then return true end
    local remote = getRemote("SoloToggleSpeedControl")
    if remote then
        if speed == 1 then
            remote:FireServer(false)
        elseif speed == 1.5 then
            remote:FireServer(true, true)
        elseif speed == 0.5 then
            remote:FireServer(true, false)
        else
            return false
        end
        CurrentSpeed = speed
    end
    return true
end

function TDX:AutoSkip(enabled)
    task.spawn(function()
        while enabled do
            local skip = getRemote("SkipWaveVoteCast")
            if skip then
                pcall(function() skip:FireServer(true) end)
            end
            task.wait(0.1)
        end
    end)
    return true
end

function TDX:Mode(mode)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local partyType = net:FindFirstChild("ClientChangePartyTypeRequest")
        local partyMap = net:FindFirstChild("ClientChangePartyMapRequest")
        if partyType and partyMap then
            partyType:FireServer("Party")
            task.wait(0.5)
            partyMap:FireServer(mode)
            task.wait(0.5)
            TDX:StartMatchmaking()
        end
    end
end

function TDX:StartMatchmaking()
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local start = net:FindFirstChild("ClientStartGameRequest")
        if start then
            start:FireServer()
        end
    end
    task.wait(0.5)
end

function TDX:Loadout(id)
    task.wait(2)
    local load = getRemote("LoadoutSelectionChanged")
    if load then
        load:FireServer(id)
    end
    task.wait(0.5)
end

function TDX:VoteDifficulty(diff)
    task.wait(5.5)
    local vote = getRemote("DifficultyVoteCast")
    if vote then
        vote:FireServer(diff)
    end
    task.wait(0.5)
    local ready = getRemote("DifficultyVoteReady")
    if ready then
        ready:FireServer(diff)
    end
    task.wait(1)
end

function TDX:VoteMap(map, attempts)
    attempts = attempts or 10
    for _ = 1, attempts do
        local vote = getRemote("MapVoteCast")
        if vote then
            vote:FireServer(map)
            task.wait(0.5)
            TDX:Ready()
            return true
        end
        local change = getRemote("MapChangeVoteCast")
        if change then
            change:FireServer(true)
        end
        task.wait(1)
    end
    return false
end

function TDX:Ready()
    local ready = getRemote("MapVoteReady")
    if ready then
        ready:FireServer()
    end
    task.wait(0.3)
end

function TDX:Equip(items)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local eq = net:FindFirstChild("UpdateLoadout")
        if eq then
            eq:FireServer(items)
        end
    end
    task.wait(0.5)
end

function TDX:ResetMappings()
    nextId = 1
    freeIds = {}
    partToId = {}
    expectedIdToActualId = {}
    pendingPlacements = {}
    for id in pairs(towers) do
        towers[id] = nil
    end
end

return TDX