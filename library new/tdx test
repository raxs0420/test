    freeIds = {}
    partToId = {}
    upgradeBuffer = {}
    upgradeTracker = {}
    for id in pairs(towers) do
        towers[id] = nil
    end
    printToUI("🔄 Tower mappings reset", Color3.fromRGB(255, 200, 100))
end

function TDX:RemapAllTowers()
