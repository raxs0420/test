local upgradeCounter = {}

function TDX:Place(name, x, y, z, rot, cost)
    local remote = getRemote("PlaceTower")
    if not remote then return nil end
    
    while getCash() < cost do task.wait(0.05) end
    task.wait(0.1)
    
    local pos = Vector3.new(x, y, z)
    local ok, res = pcall(function()
        return remote:InvokeServer(rot or 0, name, pos, 0)
    end)
    
    if not (ok and res == true) then return nil end
    task.wait(0.3)
    
    local container = Workspace:FindFirstChild("Game")
    if container then container = container:FindFirstChild("Towers") end
    local part = nil
    if container then
        for _, p in ipairs(container:GetChildren()) do
            if p:IsA("BasePart") and p.Name == name then
                if (p.Position - pos).Magnitude < 5 then
                    part = p
                    break
                end
            end
        end
    end
    
    local id = addTower(name, pos, part)
    towers[id].cost = cost
    upgradeCounter[id] = {top = {}, bottom = {}}
    printToUI(string.format("✓ Placed %s | ID: %d | Cost: $%d", name, id, cost), Color3.fromRGB(100, 255, 100))
    
    if not TDX._ScanConnection then
        startDeathScan()
    end
    
    return id
end

function TDX:Upgrade(logicalID, path, level, cost)
    local data = towers[logicalID]
    if not data then 
        printToUI(string.format("✗ Upgrade failed - Tower ID %d does not exist", logicalID), Color3.fromRGB(255, 100, 100))
        return false 
    end
    
    if not upgradeCounter[logicalID] then
        upgradeCounter[logicalID] = {top = {}, bottom = {}}
    end
    
    local counter = upgradeCounter[logicalID]
    local targetPath = (path == 1) and "top" or "bottom"
    
    table.insert(counter[targetPath], {level = level, cost = cost})
    
    local pathUpgrades = counter[targetPath]
    local uniqueLevels = {}
    local levelCosts = {}
    
    for _, upgrade in ipairs(pathUpgrades) do
        uniqueLevels[upgrade.level] = upgrade.cost
    end
    
    local sortedLevels = {}
    for lvl in pairs(uniqueLevels) do
        table.insert(sortedLevels, lvl)
    end
    table.sort(sortedLevels)
    
    local expectedLevels = {}
    for i = 1, #sortedLevels do
        expectedLevels[i] = i
    end
    
    local canBatch = true
    for i = 1, #sortedLevels do
        if sortedLevels[i] ~= expectedLevels[i] then
            canBatch = false
            break
        end
    end
    
    if canBatch and #sortedLevels >= 2 then
        local targetLevel = #sortedLevels
        local totalCost = 0
        for lvl, cst in pairs(uniqueLevels) do
            totalCost = totalCost + cst
        end
        
        local currentLevel = (path == 1) and data.topLevel or data.bottomLevel
        
        if currentLevel < targetLevel and getCash() >= totalCost then
            if not data.alive or data.rebuilding then
                if path == 1 then
                    for _, upg in ipairs(pathUpgrades) do
                        table.insert(data.pendingTopUpgrades, upg.level)
                    end
                else
                    for _, upg in ipairs(pathUpgrades) do
                        table.insert(data.pendingBottomUpgrades, upg.level)
                    end
                end
                counter[targetPath] = {}
                printToUI(string.format("⏳ Tower ID %d - %d upgrades queued for path %d (will batch after rebuild)", logicalID, #sortedLevels, path), Color3.fromRGB(255, 200, 0))
            else
                addToUpgradeQueue(logicalID, path, targetLevel, currentLevel, uniqueLevels)
                counter[targetPath] = {}
            end
            return true
        elseif currentLevel >= targetLevel then
            counter[targetPath] = {}
            return true
        else
            if path == 1 then
                for _, upg in ipairs(pathUpgrades) do
                    table.insert(data.pendingTopUpgrades, upg.level)
                end
            else
                for _, upg in ipairs(pathUpgrades) do
                    table.insert(data.pendingBottomUpgrades, upg.level)
                end
            end
            counter[targetPath] = {}
            printToUI(string.format("💰 Tower ID %d - Need $%d more for batch upgrade (have $%d)", logicalID, totalCost - getCash(), getCash()), Color3.fromRGB(255, 200, 100))
        end
    else
        local currentLevel = (path == 1) and data.topLevel or data.bottomLevel
        
        if currentLevel >= level then
            return true
        end
        
        if not data.alive or data.rebuilding then
            if path == 1 then
                table.insert(data.pendingTopUpgrades, level)
            else
                table.insert(data.pendingBottomUpgrades, level)
            end
            printToUI(string.format("⏳ Tower ID %d - Upgrade to level %d (path %d) queued", logicalID, level, path), Color3.fromRGB(255, 200, 0))
        else
            if getCash() >= cost then
                local serverID = getServerID(logicalID)
                if serverID then
                    local remote = getRemote("TowerUpgradeRequest")
                    if remote then
                        task.wait(0.1)
                        pcall(function()
                            remote:FireServer(serverID, path, level)
                        end)
                        if path == 1 then
                            data.topLevel = level
                        else
                            data.bottomLevel = level
                        end
                        printToUI(string.format("↑ Upgraded Tower ID %d (%s) | Path %d to level %d | Cost: $%d", logicalID, data.name, path, level, cost), Color3.fromRGB(100, 255, 100))
                    end
                end
            else
                if path == 1 then
                    table.insert(data.pendingTopUpgrades, level)
                else
                    table.insert(data.pendingBottomUpgrades, level)
                end
                printToUI(string.format("💰 Tower ID %d - Need $%d more for upgrade (have $%d)", logicalID, cost - getCash(), getCash()), Color3.fromRGB(255, 200, 100))
            end
        end
    end
    
    task.wait(0.1)
    return true
end

function TDX:Sell(logicalID)
    local data = towers[logicalID]
    if not data then return false end
    
    local serverID = getServerID(logicalID)
    if serverID then
        local remote = getRemote("SellTower")
        if remote then
            pcall(function() remote:FireServer(serverID) end)
        end
    end
    
    printToUI(string.format("💰 Sold Tower ID %d (%s)", logicalID, data.name), Color3.fromRGB(255, 200, 100))
    task.wait(0.3)
    removeTower(logicalID)
    return true
end

function TDX:TimeScale(speed)
    if speed == CurrentSpeed then return true end
    local remote = getRemote("SoloToggleSpeedControl")
    if remote then
        if speed == 1 then
            remote:FireServer(false)
        elseif speed == 1.5 then
            remote:FireServer(true, true)
        elseif speed == 0.5 then
            remote:FireServer(true, false)
        else
            return false
        end
        CurrentSpeed = speed
        printToUI(string.format("⚡ Time scale: %dx", speed), Color3.fromRGB(100, 200, 255))
    end
    task.wait(0.5)
    return true
end

function TDX:AutoSkip(enabled)
    task.spawn(function()
        while enabled do
            local skip = getRemote("SkipWaveVoteCast")
            if skip then
                pcall(function() skip:FireServer(true) end)
            end
            task.wait(0.1)
        end
    end)
    printToUI(string.format("🔄 Auto-skip: %s", enabled and "ON" or "OFF"), Color3.fromRGB(100, 200, 255))
    return true
end

function TDX:GetCurrentSpeed()
    return CurrentSpeed
end

function TDX:WaitForGame()
    local r = ensureRemotes()
    return r and getRemote("PlaceTower") and getRemote("SellTower") and getRemote("TowerUpgradeRequest")
end

function TDX:ResetMappings()
    nextId = 1
    freeIds = {}
    partToId = {}
    pendingUpgrades = {}
    upgradeQueue = {}
    upgradeCounter = {}
    for id in pairs(towers) do
        towers[id] = nil
    end
    printToUI("🔄 Tower mappings reset", Color3.fromRGB(255, 200, 100))
end

function TDX:RemapAllTowers()
    self:ResetMappings()
end

function TDX:JoinMapViaAPC(mapName)
    local player = Players.LocalPlayer
    local level = 0
    local lvl = player and player.leaderstats and player.leaderstats:FindFirstChild("Level")
    if lvl then level = lvl.Value end
    
    for _ = 1, 60 do
        local apcs = Workspace:FindFirstChild("APCs")
        if apcs then
            for _, slot in ipairs(apcs:GetChildren()) do
                local attr = slot:GetAttribute("MapName") or ""
                if attr == mapName then
                    local detector = slot:FindFirstChild("Detector")
                    if not detector and slot:FindFirstChild("APC") then
                        detector = slot.APC:FindFirstChild("Detector")
                    end
                    if detector then
                        local char = player.Character
                        if char and char:FindFirstChild("HumanoidRootPart") then
                            char.HumanoidRootPart.CFrame = detector.CFrame
                            task.wait(2)
                            return true
                        end
                    end
                end
            end
        end
        if level >= 31 then
            local apcs2 = Workspace:FindFirstChild("APCs2")
            if apcs2 then
                for _, slot in ipairs(apcs2:GetChildren()) do
                    local attr = slot:GetAttribute("MapName") or ""
                    if attr == mapName then
                        local detector = slot:FindFirstChild("Detector")
                        if not detector and slot:FindFirstChild("APC") then
                            detector = slot.APC:FindFirstChild("Detector")
                        end
                        if detector then
                            local char = player.Character
                            if char and char:FindFirstChild("HumanoidRootPart") then
                                char.HumanoidRootPart.CFrame = detector.CFrame
                                task.wait(2)
                                return true
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.5)
    end
    return false
end

function TDX:VoteMap(map, attempts)
    attempts = attempts or 10
    for _ = 1, attempts do
        local vote = getRemote("MapVoteCast")
        if vote then
            vote:FireServer(map)
            task.wait(0.5)
            self:Ready()
            return true
        end
        local change = getRemote("MapChangeVoteCast")
        if change then
            change:FireServer(true)
        end
        task.wait(1)
    end
    return self:JoinMapViaAPC(map)
end

function TDX:RerollMaps()
    local change = getRemote("MapChangeVoteCast")
    if change then
        change:FireServer(true)
    end
    task.wait(0.5)
end

function TDX:Ready()
    local ready = getRemote("MapVoteReady")
    if ready then
        ready:FireServer()
    end
    task.wait(0.3)
end

function TDX:VoteDifficulty(diff)
    task.wait(5.5)
    local vote = getRemote("DifficultyVoteCast")
    if vote then
        vote:FireServer(diff)
    end
    task.wait(0.5)
    local ready = getRemote("DifficultyVoteReady")
    if ready then
        ready:FireServer(diff)
    end
    task.wait(1)
end

function TDX:Loadout(id)
    task.wait(2)
    local load = getRemote("LoadoutSelectionChanged")
    if load then
        load:FireServer(id)
    end
    task.wait(0.5)
end

function TDX:Mode(mode)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local partyType = net:FindFirstChild("ClientChangePartyTypeRequest")
        local partyMap = net:FindFirstChild("ClientChangePartyMapRequest")
        if partyType and partyMap then
            partyType:FireServer("Party")
            task.wait(0.5)
            partyMap:FireServer(mode)
            task.wait(0.5)
            self:StartMatchmaking()
        end
    end
end

function TDX:StartMatchmaking()
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local start = net:FindFirstChild("ClientStartGameRequest")
        if start then
            start:FireServer()
        end
    end
    task.wait(0.5)
end

function TDX:Equip(items)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local eq = net:FindFirstChild("UpdateLoadout")
        if eq then
            eq:FireServer(items)
        end
    end
    task.wait(0.5)
end

function TDX:Ability(Id, AbilitySlot, Loop)
    local key = tostring(Id) .. "_" .. tostring(AbilitySlot)
    if AbilityConnections[key] then
        AbilityConnections[key]:Disconnect()
        AbilityConnections[key] = nil
    end
    if Loop == nil then
        local args = {Id, AbilitySlot}
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TowerUseAbilityRequest"):InvokeServer(unpack(args))
        return
    end
    local interval = 0.3
    if type(Loop) == "number" then interval = Loop end
    local connection
    connection = game:GetService("RunService").Heartbeat:Connect(function()
        if not connection then return end
        local args = {Id, AbilitySlot}
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TowerUseAbilityRequest"):InvokeServer(unpack(args))
        end)
        task.wait(interval)
    end)
    AbilityConnections[key] = connection
end

function TDX:Uber(MedicID, AbilitySlot, TowerID, Loop)
    if Loop == nil then
        local args = {MedicID, AbilitySlot, [4] = TowerID}
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TowerUseAbilityRequest"):InvokeServer(unpack(args))
        return
    end
    local interval = 0.3
    if type(Loop) == "number" then interval = Loop end
    local uberKey = "uber_" .. tostring(MedicID) .. "_" .. tostring(AbilitySlot) .. "_" .. tostring(TowerID)
    if AbilityConnections[uberKey] then
        AbilityConnections[uberKey]:Disconnect()
        AbilityConnections[uberKey] = nil
    end
    local connection
    connection = game:GetService("RunService").Heartbeat:Connect(function()
        local args = {MedicID, AbilitySlot, [4] = TowerID}
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TowerUseAbilityRequest"):InvokeServer(unpack(args))
        end)
        task.wait(interval)
    end)
    AbilityConnections[uberKey] = connection
end

function TDX:GetTowerIDs()
    local ids = {}
    for id in pairs(towers) do
        table.insert(ids, id)
    end
    table.sort(ids)
    return ids
end

function TDX:TowerExists(logicalID)
    return towers[logicalID] ~= nil
end

return TDX