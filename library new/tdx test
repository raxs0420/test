end

function TDX:ResetMappings()
    nextId = 1
    freeIds = {}
    partToId = {}
    expectedIdToActualId = {}
    actualIdToMacroId = {}
    pendingPlacements = {}
    upgradeRetryQueue = {}
    for id in pairs(towers) do
        towers[id] = nil
    end
end

function TDX:AbilitySpamRange(startMacroId, endMacroId, slot, loop, cycleDelay)
    cycleDelay = cycleDelay or 1
    if loop then
        local active = true
        task.spawn(function()
            while active do
                for macroId = startMacroId, endMacroId do
                    TDX:Ability(macroId, slot, false)
                end
                task.wait(cycleDelay)
            end
        end)
        return function() active = false end
    else
        for macroId = startMacroId, endMacroId do
            TDX:Ability(macroId, slot, false)
        end
    end
end

function TDX:AbilitySpamList(macroIds, slot, loop)
    if loop then
        local active = true
        task.spawn(function()
            while active do
                for _, macroId in ipairs(macroIds) do
                    TDX:Ability(macroId, slot, false)
                    task.wait(0.05)
                end
                task.wait(0.1)
            end
        end)
        return function() active = false end
    else
        for _, macroId in ipairs(macroIds) do
            TDX:Ability(macroId, slot, false)
            task.wait(0.05)
        end
    end
end

