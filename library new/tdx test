local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local anti_lag_running = false
local Remotes = nil
local NextID = 1
local CurrentSpeed = 1
local AbilityConnections = {}

TDX._Towers = {}
TDX._ScanConnection = nil
TDX._LastScan = 0

local function ensureRemotes()
    if Remotes then return Remotes end
    Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not Remotes then
        for i = 1, 10 do
            task.wait(0.5)
            Remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if Remotes then break end
        end
    end
    return Remotes
end

local function getRemote(name)
    local r = ensureRemotes()
    return r and r:FindFirstChild(name)
end

local function getCash()
    local plr = Players.LocalPlayer
    if not plr or not plr.leaderstats then return 0 end
    local cash = plr.leaderstats:FindFirstChild("Cash")
    return cash and cash.Value or 0
end

local function getTowerColor(tower)
    local ring = tower:FindFirstChild("Ring")
    if not ring then return nil end
    local beam = ring:FindFirstChildWhichIsA("Beam")
    if not beam then return nil end
    local seq = beam.Color
    if seq and seq.Keypoints and #seq.Keypoints > 0 then
        return seq.Keypoints[1].Value
    end
    return nil
end

local function isDeadColor(col)
    return col.R < 0.1 and col.G < 0.1 and col.B < 0.1
end

local function scanAndCompact()
    local container = Workspace:FindFirstChild("Game") and Workspace.Game:FindFirstChild("Towers")
    if not container then return end
    
    local dead = {}
    for id, data in pairs(TDX._Towers) do
        if data.alive then
            local foundModel = nil
            for _, model in ipairs(container:GetChildren()) do
                if model:IsA("Model") then
                    local modelPos = model:GetPivot().Position
                    if (modelPos - data.pos).Magnitude < 5 then
                        foundModel = model
                        break
                    end
                end
            end
            if foundModel then
                local color = getTowerColor(foundModel)
                if color and isDeadColor(color) then
                    data.alive = false
                    table.insert(dead, id)
                end
            end
        else
            table.insert(dead, id)
        end
    end
    
    if #dead == 0 then return end
    
    for _, id in ipairs(dead) do
        TDX._Towers[id] = nil
    end
    
    local new = {}
    local nextNewId = 1
    for id = 1, NextID - 1 do
        if TDX._Towers[id] then
            new[nextNewId] = TDX._Towers[id]
            nextNewId = nextNewId + 1
        end
    end
    TDX._Towers = new
    NextID = nextNewId
end

local function startDeathScan()
    if TDX._ScanConnection then return end
    TDX._ScanConnection = game:GetService("RunService").Heartbeat:Connect(function()
        local now = tick()
        if now - TDX._LastScan >= 0.1 then
            TDX._LastScan = now
            scanAndCompact()
        end
    end)
end

function TDX:Place(name, x, y, z, rot, cost)
    local remote = getRemote("PlaceTower")
    if not remote then return nil end
    while getCash() < cost do task.wait(0.01) end
    task.wait(0.1)
    local ok, res = pcall(function()
        return remote:InvokeServer(rot or 0, name, Vector3.new(x, y, z), 0)
    end)
    if not (ok and res == true) then return nil end
    task.wait(0.2)
    
    local id = NextID
    NextID = NextID + 1
    local position = Vector3.new(x, y, z)
    TDX._Towers[id] = {
        name = name,
        pos = position,
        alive = false   -- start as false, will be set true when beam is detected alive
    }
    
    if not TDX._ScanConnection then
        startDeathScan()
    end
    
    -- Wait until the tower's beam is detected and alive (not dead)
    local timeout = 10  -- seconds
    local startTime = tick()
    repeat
        task.wait(0.1)
        local container = Workspace:FindFirstChild("Game") and Workspace.Game:FindFirstChild("Towers")
        if container then
            for _, model in ipairs(container:GetChildren()) do
                if model:IsA("Model") then
                    if (model:GetPivot().Position - position).Magnitude < 5 then
                        local color = getTowerColor(model)
                        if color and not isDeadColor(color) then
                            TDX._Towers[id].alive = true
                            break
                        end
                    end
                end
            end
        end
        if tick() - startTime > timeout then
            warn("Timeout waiting for tower to become alive, continuing anyway")
            TDX._Towers[id].alive = true
            break
        end
    until TDX._Towers[id].alive == true
    
    return id
end

function TDX:Upgrade(id, path, _, cost)
    if not TDX._Towers[id] or not TDX._Towers[id].alive then
        warn("Tower", id, "is dead or not ready, waiting...")
        -- Wait a moment and try again once
        task.wait(0.5)
        if not TDX._Towers[id] or not TDX._Towers[id].alive then
            warn("Tower", id, "still dead, skipping upgrade")
            return false
        end
    end
    local remote = getRemote("TowerUpgradeRequest")
    if not remote then return false end
    while getCash() < cost do task.wait(0.01) end
    task.wait(0.1)
    pcall(function()
        remote:FireServer(id, path, 1)
    end)
    task.wait(0.2)
    return true
end

function TDX:Sell(id)
    if not TDX._Towers[id] or not TDX._Towers[id].alive then
        warn("Tower", id, "dead, cannot sell")
        return false
    end
    local remote = getRemote("SellTower")
    if remote then
        pcall(function() remote:FireServer(id) end)
    end
    task.wait(0.3)
    TDX._Towers[id] = nil
    return true
end

function TDX:TimeScale(speed)
    if speed == CurrentSpeed then return true end
    local remote = getRemote("SoloToggleSpeedControl")
    if remote then
        if speed == 1 then
            remote:FireServer(false)
        elseif speed == 1.5 then
            remote:FireServer(true, true)
        elseif speed == 0.5 then
            remote:FireServer(true, false)
        else
            return false
        end
        CurrentSpeed = speed
    end
    task.wait(0.5)
    return true
end

function TDX:AutoSkip(enabled)
    task.spawn(function()
        while enabled do
            local skip = getRemote("SkipWaveVoteCast")
            if skip then
                pcall(function() skip:FireServer(true) end)
            end
            task.wait(0.1)
        end
    end)
    return true
end

function TDX:GetCurrentSpeed()
    return CurrentSpeed
end

function TDX:WaitForGame()
    local r = ensureRemotes()
    return r and getRemote("PlaceTower") and getRemote("SellTower") and getRemote("TowerUpgradeRequest")
end

function TDX:ResetMappings()
    NextID = 1
    TDX._Towers = {}
end

function TDX:RemapAllTowers()
    self:ResetMappings()
end

function TDX:JoinMapViaAPC(mapName)
    local player = Players.LocalPlayer
    local level = 0
    local lvl = player and player.leaderstats and player.leaderstats:FindFirstChild("Level")
    if lvl then level = lvl.Value end

    for _ = 1, 60 do
        local apcs = Workspace:FindFirstChild("APCs")
        if apcs then
            for _, slot in ipairs(apcs:GetChildren()) do
                local attr = slot:GetAttribute("MapName") or ""
                if attr == mapName then
                    local detector = slot:FindFirstChild("Detector")
                    if not detector and slot:FindFirstChild("APC") then
                        detector = slot.APC:FindFirstChild("Detector")
                    end
                    if detector then
                        local char = player.Character
                        if char and char:FindFirstChild("HumanoidRootPart") then
                            char.HumanoidRootPart.CFrame = detector.CFrame
                            task.wait(2)
                            return true
                        end
                    end
                end
            end
        end
        if level >= 31 then
            local apcs2 = Workspace:FindFirstChild("APCs2")
            if apcs2 then
                for _, slot in ipairs(apcs2:GetChildren()) do
                    local attr = slot:GetAttribute("MapName") or ""
                    if attr == mapName then
                        local detector = slot:FindFirstChild("Detector")
                        if not detector and slot:FindFirstChild("APC") then
                            detector = slot.APC:FindFirstChild("Detector")
                        end
                        if detector then
                            local char = player.Character
                            if char and char:FindFirstChild("HumanoidRootPart") then
                                char.HumanoidRootPart.CFrame = detector.CFrame
                                task.wait(2)
                                return true
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.5)
    end
    return false
end

function TDX:VoteMap(map, attempts)
    attempts = attempts or 10
    for _ = 1, attempts do
        local vote = getRemote("MapVoteCast")
        if vote then
            vote:FireServer(map)
            task.wait(0.5)
            self:Ready()
            return true
        end
        local change = getRemote("MapChangeVoteCast")
        if change then
            change:FireServer(true)
        end
        task.wait(1)
    end
    return self:JoinMapViaAPC(map)
end

function TDX:RerollMaps()
    local change = getRemote("MapChangeVoteCast")
    if change then
        change:FireServer(true)
    end
    task.wait(0.5)
end

function TDX:Ready()
    local ready = getRemote("MapVoteReady")
    if ready then
        ready:FireServer()
    end
    task.wait(0.3)
end

function TDX:VoteDifficulty(diff)
    task.wait(5.5)
    local vote = getRemote("DifficultyVoteCast")
    if vote then
        vote:FireServer(diff)
    end
    task.wait(0.5)
    local ready = getRemote("DifficultyVoteReady")
    if ready then
        ready:FireServer(diff)
    end
    task.wait(1)
end

function TDX:Loadout(id)
    task.wait(2)
    local load = getRemote("LoadoutSelectionChanged")
    if load then
        load:FireServer(id)
    end
    task.wait(0.5)
end

function TDX:Mode(mode)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local partyType = net:FindFirstChild("ClientChangePartyTypeRequest")
        local partyMap = net:FindFirstChild("ClientChangePartyMapRequest")
        if partyType and partyMap then
            partyType:FireServer("Party")
            task.wait(0.5)
            partyMap:FireServer(mode)
            task.wait(0.5)
            self:StartMatchmaking()
        end
    end
end

function TDX:StartMatchmaking()
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local start = net:FindFirstChild("ClientStartGameRequest")
        if start then
            start:FireServer()
        end
    end
    task.wait(0.5)
end

function TDX:Equip(items)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local eq = net:FindFirstChild("UpdateLoadout")
        if eq then
            eq:FireServer(items)
        end
    end
    task.wait(0.5)
end

function TDX:Ability(Id, AbilitySlot, Loop)
    local key = tostring(Id) .. "_" .. tostring(AbilitySlot)
    if AbilityConnections[key] then
        AbilityConnections[key]:Disconnect()
        AbilityConnections[key] = nil
    end
    if Loop == nil then
        local args = {Id, AbilitySlot}
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TowerUseAbilityRequest"):InvokeServer(unpack(args))
        return
    end
    local interval = 0.3
    if type(Loop) == "number" then interval = Loop end
    local connection
    connection = game:GetService("RunService").Heartbeat:Connect(function()
        if not connection then return end
        local args = {Id, AbilitySlot}
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TowerUseAbilityRequest"):InvokeServer(unpack(args))
        end)
        task.wait(interval)
    end)
    AbilityConnections[key] = connection
end

function TDX:Uber(MedicID, AbilitySlot, TowerID, Loop)
    if Loop == nil then
        local args = {MedicID, AbilitySlot, [4] = TowerID}
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TowerUseAbilityRequest"):InvokeServer(unpack(args))
        return
    end
    local interval = 0.3
    if type(Loop) == "number" then interval = Loop end
    local uberKey = "uber_" .. tostring(MedicID) .. "_" .. tostring(AbilitySlot) .. "_" .. tostring(TowerID)
    if AbilityConnections[uberKey] then
        AbilityConnections[uberKey]:Disconnect()
        AbilityConnections[uberKey] = nil
    end
    local connection
    connection = game:GetService("RunService").Heartbeat:Connect(function()
        local args = {MedicID, AbilitySlot, [4] = TowerID}
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TowerUseAbilityRequest"):InvokeServer(unpack(args))
        end)
        task.wait(interval)
    end)
    AbilityConnections[uberKey] = connection
end

return TDX