local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local Remotes = nil
local CurrentSpeed = 1
local AbilityConnections = {}

local towers = {}
local nextId = 1
local freeIds = {}
local partToId = {}

local function ensureRemotes()
    if Remotes then return Remotes end
    Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not Remotes then
        for i = 1, 10 do
            task.wait(0.5)
            Remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if Remotes then break end
        end
    end
    return Remotes
end

local function getRemote(name)
    local r = ensureRemotes()
    return r and r:FindFirstChild(name)
end

local function getCash()
    local plr = Players.LocalPlayer
    if not plr or not plr.leaderstats then return 0 end
    local cash = plr.leaderstats:FindFirstChild("Cash")
    return cash and cash.Value or 0
end

local function getTowerBeamColor(towerPart)
    local ring = towerPart:FindFirstChild("Ring")
    if not ring then return nil end
    local beam = ring:FindFirstChildWhichIsA("Beam")
    if not beam then return nil end
    local seq = beam.Color
    if seq and seq.Keypoints and #seq.Keypoints > 0 then
        return seq.Keypoints[1].Value
    end
    return nil
end

local function isDeadColor(color)
    return color.R < 0.1 and color.G < 0.1 and color.B < 0.1
end

local function allocateId()
    if #freeIds > 0 then
        return table.remove(freeIds)
    else
        local id = nextId
        nextId = nextId + 1
        return id
    end
end

local function freeId(id)
    if id and id > 0 then
        if not towers[id] then return end
        table.insert(freeIds, id)
        towers[id] = nil
    end
end

local function removeTower(part)
    local id = partToId[part]
    if not id then return end
    local data = towers[id]
    if data and data.removed then return end
    if data then data.removed = true end
    freeId(id)
    partToId[part] = nil
end

local function addTower(part)
    if partToId[part] then return end
    local beamColor = getTowerBeamColor(part)
    if beamColor and isDeadColor(beamColor) then return end
    local id = allocateId()
    partToId[part] = id
    towers[id] = {
        part = part,
        name = part.Name,
        removed = false
    }
    print(string.format("[TDX] Tower detected: %s | Assigned Logical ID: %d", part.Name, id))
end

local function checkDeadTowers()
    for part, id in pairs(partToId) do
        local data = towers[id]
        if data and data.removed then
            removeTower(part)
        elseif part and part.Parent then
            local color = getTowerBeamColor(part)
            if color and isDeadColor(color) then
                if data then data.removed = true end
                print(string.format("[TDX] Tower ID %d (%s) died, freeing ID", id, data and data.name or "Unknown"))
                removeTower(part)
            end
        else
            if data then data.removed = true end
            removeTower(part)
        end
    end
end

local TowersFolder = Workspace:FindFirstChild("Game") and Workspace.Game:FindFirstChild("Towers")
if not TowersFolder then
    TowersFolder = Instance.new("Folder")
end

local function onTowerAdded(part)
    if not part:IsA("BasePart") then return end
    if partToId[part] then return end
    task.wait(0.05)
    if not part.Parent then return end
    addTower(part)
end

local function onTowerRemoved(part)
    local id = partToId[part]
    if not id then return end
    local data = towers[id]
    if data and data.removed then return end
    removeTower(part)
end

if TowersFolder then
    TowersFolder.ChildAdded:Connect(onTowerAdded)
    TowersFolder.ChildRemoved:Connect(onTowerRemoved)
end

local deathLoop = nil
local function startDeathLoop()
    if deathLoop then return end
    deathLoop = RunService.Heartbeat:Connect(function()
        checkDeadTowers()
    end)
end
startDeathLoop()

local scanLoop = RunService.Heartbeat:Connect(function()
    if not TowersFolder then return end
    for _, part in ipairs(TowersFolder:GetChildren()) do
        if part:IsA("BasePart") and not partToId[part] then
            addTower(part)
        end
    end
end)

local function createUI()
    local player = Players.LocalPlayer
    local gui = Instance.new("ScreenGui")
    gui.Name = "TDX_ID_Display"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = player:WaitForChild("PlayerGui")
    
    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(0, 250, 0, 300)
    mainFrame.Position = UDim2.new(1, -260, 0, 10)
    mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    mainFrame.BackgroundTransparency = 0.1
    mainFrame.BorderSizePixel = 0
    mainFrame.Parent = gui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = mainFrame
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 30)
    title.Position = UDim2.new(0, 0, 0, 0)
    title.Text = "TDX Towers"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14
    title.Parent = mainFrame
    
    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Size = UDim2.new(1, -10, 1, -40)
    scrollFrame.Position = UDim2.new(0, 5, 0, 35)
    scrollFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    scrollFrame.BackgroundTransparency = 0
    scrollFrame.BorderSizePixel = 0
    scrollFrame.ScrollBarThickness = 6
    scrollFrame.Parent = mainFrame
    
    local scrollCorner = Instance.new("UICorner")
    scrollCorner.Parent = scrollFrame
    
    local function updateUI()
        for _, child in ipairs(scrollFrame:GetChildren()) do
            if child:IsA("TextLabel") then
                child:Destroy()
            end
        end
        
        local sortedIds = {}
        for id in pairs(towers) do
            table.insert(sortedIds, id)
        end
        table.sort(sortedIds)
        
        local yOffset = 0
        for _, id in ipairs(sortedIds) do
            local data = towers[id]
            if data then
                local towerLabel = Instance.new("TextLabel")
                towerLabel.Size = UDim2.new(1, -10, 0, 30)
                towerLabel.Position = UDim2.new(0, 5, 0, yOffset)
                towerLabel.Text = string.format("ID: %d | %s", id, data.name)
                towerLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                towerLabel.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                towerLabel.Font = Enum.Font.Gotham
                towerLabel.TextSize = 12
                towerLabel.TextXAlignment = Enum.TextXAlignment.Left
                towerLabel.Parent = scrollFrame
                
                local labelCorner = Instance.new("UICorner")
                labelCorner.CornerRadius = UDim.new(0, 4)
                labelCorner.Parent = towerLabel
                
                yOffset = yOffset + 35
            end
        end
        
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, yOffset + 10)
    end
    
    game:GetService("RunService").Heartbeat:Connect(function()
        updateUI()
    end)
    
    updateUI()
end

task.spawn(function()
    task.wait(2)
    createUI()
end)

function TDX:Place(name, x, y, z, rot, cost)
    local remote = getRemote("PlaceTower")
    if not remote then return nil end
    
    print(string.format("[TDX] Placing %s at (%.1f, %.1f, %.1f) waiting for $%d...", name, x, y, z, cost))
    
    while getCash() < cost do task.wait(0.1) end
    task.wait(0.1)
    
    local pos = Vector3.new(x, y, z)
    local ok, res = pcall(function()
        return remote:InvokeServer(rot or 0, name, pos, 0)
    end)
    
    if not (ok and res == true) then 
        print(string.format("[TDX] Failed to place %s", name))
        return nil 
    end
    
    print(string.format("[TDX] %s placed, waiting for tower detection...", name))
    return true
end

function TDX:Upgrade(logicalID, path, level, cost)
    local data = towers[logicalID]
    if not data then
        print(string.format("[TDX] ✗ Upgrade failed - Logical ID %d does not exist (tower not detected yet or dead)", logicalID))
        return false
    end
    
    local part = data.part
    if not part or not part.Parent then
        print(string.format("[TDX] ✗ Upgrade failed - Tower ID %d has no valid part", logicalID))
        return false
    end
    
    local color = getTowerBeamColor(part)
    if color and isDeadColor(color) then
        print(string.format("[TDX] ✗ Upgrade failed - Tower ID %d is dead", logicalID))
        return false
    end
    
    local container = Workspace:FindFirstChild("Game")
    if container then container = container:FindFirstChild("Towers") end
    if not container then
        print(string.format("[TDX] ✗ Upgrade failed - Cannot find Towers container"))
        return false
    end
    
    local serverID = nil
    local children = container:GetChildren()
    for idx, p in ipairs(children) do
        if p == part then
            serverID = idx
            break
        end
    end
    
    if not serverID then
        print(string.format("[TDX] ✗ Upgrade failed - Cannot find server ID for logical ID %d", logicalID))
        return false
    end
    
    local remote = getRemote("TowerUpgradeRequest")
    if not remote then return false end
    
    print(string.format("[TDX] Upgrading Logical ID %d (Server ID: %d) | Path: %d | Level: %d | Cost: $%d", logicalID, serverID, path, level, cost))
    
    while getCash() < cost do task.wait(0.1) end
    task.wait(0.1)
    
    pcall(function()
        remote:FireServer(serverID, path, level)
    end)
    
    print(string.format("[TDX] ↑ Upgraded Logical ID %d (Server ID: %d) | Path: %d | Level: %d", logicalID, serverID, path, level))
    
    task.wait(0.2)
    return true
end

function TDX:Sell(logicalID)
    local data = towers[logicalID]
    if not data then return false end
    
    local part = data.part
    if not part or not part.Parent then return false end
    
    local container = Workspace:FindFirstChild("Game")
    if container then container = container:FindFirstChild("Towers") end
    if not container then return false end
    
    local serverID = nil
    local children = container:GetChildren()
    for idx, p in ipairs(children) do
        if p == part then
            serverID = idx
            break
        end
    end
    
    if serverID then
        local remote = getRemote("SellTower")
        if remote then
            pcall(function() remote:FireServer(serverID) end)
        end
    end
    
    print(string.format("[TDX] 💰 Sold Logical ID %d (Server ID: %d)", logicalID, serverID or 0))
    task.wait(0.3)
    return true
end

function TDX:TimeScale(speed)
    if speed == CurrentSpeed then return true end
    local remote = getRemote("SoloToggleSpeedControl")
    if remote then
        if speed == 1 then
            remote:FireServer(false)
        elseif speed == 1.5 then
            remote:FireServer(true, true)
        elseif speed == 0.5 then
            remote:FireServer(true, false)
        else
            return false
        end
        CurrentSpeed = speed
        print(string.format("[TDX] ⚡ Time scale: %dx", speed))
    end
    task.wait(0.5)
    return true
end

function TDX:AutoSkip(enabled)
    task.spawn(function()
        while enabled do
            local skip = getRemote("SkipWaveVoteCast")
            if skip then
                pcall(function() skip:FireServer(true) end)
            end
            task.wait(0.1)
        end
    end)
    print(string.format("[TDX] 🔄 Auto-skip: %s", enabled and "ON" or "OFF"))
    return true
end

function TDX:GetCurrentSpeed()
    return CurrentSpeed
end

function TDX:WaitForGame()
    local r = ensureRemotes()
    return r and getRemote("PlaceTower") and getRemote("SellTower") and getRemote("TowerUpgradeRequest")
end

function TDX:ResetMappings()
    nextId = 1
    freeIds = {}
    partToId = {}
    for id in pairs(towers) do
        towers[id] = nil
    end
    print("[TDX] 🔄 Tower mappings reset")
end

function TDX:GetTowerIDs()
    local ids = {}
    for id in pairs(towers) do
        table.insert(ids, id)
    end
    table.sort(ids)
    return ids
end

function TDX:TowerExists(logicalID)
    return towers[logicalID] ~= nil
end

function TDX:JoinMapViaAPC(mapName)
    local player = Players.LocalPlayer
    local level = 0
    local lvl = player and player.leaderstats and player.leaderstats:FindFirstChild("Level")
    if lvl then level = lvl.Value end
    
    for _ = 1, 60 do
        local apcs = Workspace:FindFirstChild("APCs")
        if apcs then
            for _, slot in ipairs(apcs:GetChildren()) do
                local attr = slot:GetAttribute("MapName") or ""
                if attr == mapName then
                    local detector = slot:FindFirstChild("Detector")
                    if not detector and slot:FindFirstChild("APC") then
                        detector = slot.APC:FindFirstChild("Detector")
                    end
                    if detector then
                        local char = player.Character
                        if char and char:FindFirstChild("HumanoidRootPart") then
                            char.HumanoidRootPart.CFrame = detector.CFrame
                            task.wait(2)
                            return true
                        end
                    end
                end
            end
        end
        if level >= 31 then
            local apcs2 = Workspace:FindFirstChild("APCs2")
            if apcs2 then
                for _, slot in ipairs(apcs2:GetChildren()) do
                    local attr = slot:GetAttribute("MapName") or ""
                    if attr == mapName then
                        local detector = slot:FindFirstChild("Detector")
                        if not detector and slot:FindFirstChild("APC") then
                            detector = slot.APC:FindFirstChild("Detector")
                        end
                        if detector then
                            local char = player.Character
                            if char and char:FindFirstChild("HumanoidRootPart") then
                                char.HumanoidRootPart.CFrame = detector.CFrame
                                task.wait(2)
                                return true
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.5)
    end
    return false
end

function TDX:VoteMap(map, attempts)
    attempts = attempts or 10
    for _ = 1, attempts do
        local vote = getRemote("MapVoteCast")
        if vote then
            vote:FireServer(map)
            task.wait(0.5)
            self:Ready()
            return true
        end
        local change = getRemote("MapChangeVoteCast")
        if change then
            change:FireServer(true)
        end
        task.wait(1)
    end
    return self:JoinMapViaAPC(map)
end

function TDX:RerollMaps()
    local change = getRemote("MapChangeVoteCast")
    if change then
        change:FireServer(true)
    end
    task.wait(0.5)
end

function TDX:Ready()
    local ready = getRemote("MapVoteReady")
    if ready then
        ready:FireServer()
    end
    task.wait(0.3)
end

function TDX:VoteDifficulty(diff)
    task.wait(5.5)
    local vote = getRemote("DifficultyVoteCast")
    if vote then
        vote:FireServer(diff)
    end
    task.wait(0.5)
    local ready = getRemote("DifficultyVoteReady")
    if ready then
        ready:FireServer(diff)
    end
    task.wait(1)
end

function TDX:Loadout(id)
    task.wait(2)
    local load = getRemote("LoadoutSelectionChanged")
    if load then
        load:FireServer(id)
    end
    task.wait(0.5)
end

function TDX:Mode(mode)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local partyType = net:FindFirstChild("ClientChangePartyTypeRequest")
        local partyMap = net:FindFirstChild("ClientChangePartyMapRequest")
        if partyType and partyMap then
            partyType:FireServer("Party")
            task.wait(0.5)
            partyMap:FireServer(mode)
            task.wait(0.5)
            self:StartMatchmaking()
        end
    end
end

function TDX:StartMatchmaking()
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local start = net:FindFirstChild("ClientStartGameRequest")
        if start then
            start:FireServer()
        end
    end
    task.wait(0.5)
end

function TDX:Equip(items)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local eq = net:FindFirstChild("UpdateLoadout")
        if eq then
            eq:FireServer(items)
        end
    end
    task.wait(0.5)
end

function TDX:Ability(Id, AbilitySlot, Loop)
    local key = tostring(Id) .. "_" .. tostring(AbilitySlot)
    if AbilityConnections[key] then
        AbilityConnections[key]:Disconnect()
        AbilityConnections[key] = nil
    end
    if Loop == nil then
        local args = {Id, AbilitySlot}
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TowerUseAbilityRequest"):InvokeServer(unpack(args))
        return
    end
    local interval = 0.3
    if type(Loop) == "number" then interval = Loop end
    local connection
    connection = game:GetService("RunService").Heartbeat:Connect(function()
        if not connection then return end
        local args = {Id, AbilitySlot}
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TowerUseAbilityRequest"):InvokeServer(unpack(args))
        end)
        task.wait(interval)
    end)
    AbilityConnections[key] = connection
end

function TDX:Uber(MedicID, AbilitySlot, TowerID, Loop)
    if Loop == nil then
        local args = {MedicID, AbilitySlot, [4] = TowerID}
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TowerUseAbilityRequest"):InvokeServer(unpack(args))
        return
    end
    local interval = 0.3
    if type(Loop) == "number" then interval = Loop end
    local uberKey = "uber_" .. tostring(MedicID) .. "_" .. tostring(AbilitySlot) .. "_" .. tostring(TowerID)
    if AbilityConnections[uberKey] then
        AbilityConnections[uberKey]:Disconnect()
        AbilityConnections[uberKey] = nil
    end
    local connection
    connection = game:GetService("RunService").Heartbeat:Connect(function()
        local args = {MedicID, AbilitySlot, [4] = TowerID}
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("TowerUseAbilityRequest"):InvokeServer(unpack(args))
        end)
        task.wait(interval)
    end)
    AbilityConnections[uberKey] = connection
end

return TDX