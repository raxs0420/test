TDX._Towers = towers
TDX._ScanConnection = nil

local upgradeBuffer = {}
local processingBuffer = false

local function ensureRemotes()
    if Remotes then return Remotes end
    Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not Remotes then
        for i = 1, 10 do
            task.wait(0.5)
            Remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if Remotes then break end
        end
    end
    return Remotes
end

local function getRemote(name)
    local r = ensureRemotes()
    return r and r:FindFirstChild(name)
end

local function getCash()
    local plr = Players.LocalPlayer
    if not plr or not plr.leaderstats then return 0 end
    local cash = plr.leaderstats:FindFirstChild("Cash")
    return cash and cash.Value or 0
end

local function getTowerBeam(towerPart)
    local ring = towerPart:FindFirstChild("Ring")
    if not ring then return nil end
    local beam = ring:FindFirstChildWhichIsA("Beam")
    return beam
end

local function isTowerAlive(towerPart)
    local beam = getTowerBeam(towerPart)
    if not beam then return false end
    local colorSeq = beam.Color
    if colorSeq and colorSeq.Keypoints and #colorSeq.Keypoints > 0 then
        local color = colorSeq.Keypoints[1].Value
        if color.R < 0.1 and color.G < 0.1 and color.B < 0.1 then
            return false
        end
        return true
    end
    return false
end

local function allocateId()
    if #freeIds > 0 then
        return table.remove(freeIds)
    else
        local id = nextId
        nextId = nextId + 1
        return id
    end
end

local function freeId(id)
    if id and id > 0 then
        table.insert(freeIds, id)
        if towers[id] then
            if towers[id].part then
                partToId[towers[id].part] = nil
            end
            towers[id] = nil
        end
    end
end

local function getServerID(logicalID)
    local data = towers[logicalID]
    if not data or not data.part or not data.part.Parent then return nil end
    
    local container = Workspace:FindFirstChild("Game")
    if container then container = container:FindFirstChild("Towers") end
    if not container then return nil end
    
    local children = container:GetChildren()
    for idx, part in ipairs(children) do
        if part == data.part then
            return idx
        end
    end
    return nil
end

local function sendBatchUpgrade(logicalID, path, targetLevel)
    local data = towers[logicalID]
    if not data then return false end
    
    local serverID = getServerID(logicalID)
    if not serverID then return false end
    
    local remote = getRemote("TowerUpgradeRequest")
    if not remote then return false end
    
    local totalCost = 0
    for i = data.currentTopLevel + 1, targetLevel do
        if data.costs and data.costs[i] then
            totalCost = totalCost + data.costs[i]
        end
    end
    
    if getCash() < totalCost then
        print(string.format("[TDX] ⏳ Need $%d more for batch upgrade ID %d", totalCost - getCash(), logicalID))
        return false
    end
    
    task.wait(0.1)
    pcall(function()
        remote:FireServer(serverID, path, targetLevel)
    end)
    
    if path == 1 then
        data.currentTopLevel = targetLevel
    else
        data.currentBottomLevel = targetLevel
    end
    
    print(string.format("[TDX] ↑ Batch upgraded ID %d (%s) | Path %d to level %d | Cost: $%d", logicalID, data.name, path, targetLevel, totalCost))
    return true
end

local function sendSingleUpgrade(logicalID, path, level, cost)
    local data = towers[logicalID]
    if not data then return false end
    
    local serverID = getServerID(logicalID)
    if not serverID then return false end
    
    local remote = getRemote("TowerUpgradeRequest")
    if not remote then return false end
    
    if getCash() < cost then
        print(string.format("[TDX] ⏳ Need $%d more for upgrade ID %d level %d", cost - getCash(), logicalID, level))
        return false
    end
    
    task.wait(0.1)
    pcall(function()
        remote:FireServer(serverID, path, level)
    end)
    
    if path == 1 then
        data.currentTopLevel = level
    else
        data.currentBottomLevel = level
    end
    
    print(string.format("[TDX] ↑ Upgraded ID %d (%s) | Path %d to level %d | Cost: $%d", logicalID, data.name, path, level, cost))
    return true
end

local function processUpgradeBuffer()
    if processingBuffer then return end
    processingBuffer = true
    
    task.spawn(function()
        while #upgradeBuffer > 0 do
            local upgrade = table.remove(upgradeBuffer, 1)
            local data = towers[upgrade.logicalID]
            
            if not data or not data.alive then
                print(string.format("[TDX] ⏳ ID %d dead - upgrade queued", upgrade.logicalID))
                if not data then
                    table.insert(upgradeBuffer, 1, upgrade)
                    task.wait(1)
                end
            else
                if upgrade.isBatch then
                    sendBatchUpgrade(upgrade.logicalID, upgrade.path, upgrade.targetLevel)
                else
                    sendSingleUpgrade(upgrade.logicalID, upgrade.path, upgrade.level, upgrade.cost)
                end
            end
            
            task.wait(0.2)
        end
        processingBuffer = false
    end)
end

local function addToBuffer(logicalID, path, level, cost, isBatch, targetLevel)
    table.insert(upgradeBuffer, {
        logicalID = logicalID,
        path = path,
        level = level,
        cost = cost,
        isBatch = isBatch or false,
        targetLevel = targetLevel or level
    })
    processUpgradeBuffer()
end

local function findAndAssignPart(logicalID)
    local data = towers[logicalID]
    if not data then return nil end
    
    local container = Workspace:FindFirstChild("Game")
    if container then container = container:FindFirstChild("Towers") end
    if not container then return nil end
    
    for _, part in ipairs(container:GetChildren()) do
        if part:IsA("BasePart") and part.Name == data.name then
            if (part.Position - data.pos).Magnitude < 3 then
                local beam = getTowerBeam(part)
                if beam then
                    data.part = part
                    partToId[part] = logicalID
                    data.alive = true
                    return part
                end
            end
        end
    end
    return nil
end

local function checkAndHandleDeath()
    for id, data in pairs(towers) do
        if data.alive and data.part then
            if not data.part.Parent or not isTowerAlive(data.part) then
                print(string.format("[TDX] 💀 Tower ID %d (%s) died/sold", id, data.name))
                data.alive = false
                data.part = nil
                if data.part then
                    partToId[data.part] = nil
                end
            end
        elseif data.alive and not data.part then
            local part = findAndAssignPart(id)
            if not part then
                data.alive = false
                print(string.format("[TDX] 💀 Tower ID %d (%s) lost", id, data.name))
            end
        end
    end
end

local beamCheckConnection = nil

local function startBeamCheck()
    if beamCheckConnection then return end
    beamCheckConnection = game:GetService("RunService").Heartbeat:Connect(function()
        checkAndHandleDeath()
    end)
end

