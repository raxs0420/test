        towers[id] = nil
    end
end

function TDX:AbilitySpamRange(startMacroId, endMacroId, slot, loop, cycleDelay)
    cycleDelay = cycleDelay or 0.5
    if loop then
        local active = true
        task.spawn(function()
            while active do
                for macroId = startMacroId, endMacroId do
                    TDX:Ability(macroId, slot, false)
                end
                task.wait(cycleDelay)
            end
        end)
        return function() active = false end
    else
        for macroId = startMacroId, endMacroId do
            TDX:Ability(macroId, slot, false)
        end
    end
end

function TDX:AbilitySpamList(macroIds, slot, loop)
    if loop then
        local active = true
        task.spawn(function()
            while active do
                for _, macroId in ipairs(macroIds) do
                    TDX:Ability(macroId, slot, false)
                    task.wait(0.05)
                end
                task.wait(0.1)
            end
        end)
        return function() active = false end
    else
        for _, macroId in ipairs(macroIds) do
            TDX:Ability(macroId, slot, false)
            task.wait(0.05)
        end
    end
end

local typeMap = {
    Elite = 0,
    First = 1,
    Last = 2,
    Strong = 3,
    Weak = 4,
    Random = 5
}

local function getTypeValue(t)
    if type(t) == "number" then
        return math.clamp(t, 0, 5)
    elseif type(t) == "string" then
        return typeMap[t]
    end
    return nil
end

function TDX:SetTarget(towerID, targetType)
    local remote = getRemote("ChangeQueryType")
    if not remote then return false end
    local tv = getTypeValue(targetType)
    if tv == nil then return false end
    pcall(function() remote:FireServer(towerID, tv) end)
    return true
end

function TDX:TargetRange(startID, endID, targetType, interval)
    interval = interval or 0.5
    local remote = getRemote("ChangeQueryType")
    if not remote then return false end
    local tv = getTypeValue(targetType)
    if tv == nil then return false end
    task.spawn(function()
        while true do
            for id = startID, endID do
                pcall(function() remote:FireServer(id, tv) end)
            end
            task.wait(interval)
        end
    end)
    return true
end

function TDX:JoinMapViaAPC(mapName)
    local player = Players.LocalPlayer
    local level = 0
    local lvl = player and player.leaderstats and player.leaderstats:FindFirstChild("Level")
    if lvl then level = lvl.Value end

    local startTime = tick()
    local apcsFolder = nil

    while true do
        apcsFolder = Workspace:FindFirstChild("APCs")

        if not apcsFolder then
            if tick() - startTime >= 3 then
                return false
            end
            task.wait()
            continue
        end

        for _, slot in ipairs(apcsFolder:GetChildren()) do
            local attr = slot:GetAttribute("MapName") or ""
            if attr == mapName then
                local detector = slot:FindFirstChild("Detector")
                if not detector and slot:FindFirstChild("APC") then
                    detector = slot.APC:FindFirstChild("Detector")
                end
                if detector then
                    local char = player.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        char.HumanoidRootPart.CFrame = detector.CFrame
                        task.wait(2)
                        return true
                    end
                end
            end
        end

        if level >= 31 then
            local apcs2Folder = Workspace:FindFirstChild("APCs2")
            if apcs2Folder then
                for _, slot in ipairs(apcs2Folder:GetChildren()) do
                    local attr = slot:GetAttribute("MapName") or ""
                    if attr == mapName then
                        local detector = slot:FindFirstChild("Detector")
                        if not detector and slot:FindFirstChild("APC") then
                            detector = slot.APC:FindFirstChild("Detector")
                        end
                        if detector then
                            local char = player.Character
                            if char and char:FindFirstChild("HumanoidRootPart") then
                                char.HumanoidRootPart.CFrame = detector.CFrame
                                task.wait(2)
                                return true
                            end
                        end
                    end
                end
            end
        end

        startTime = tick()
        task.wait()
    end
end

