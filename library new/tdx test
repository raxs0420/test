local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Remotes = nil
local CommandQueue = {}
local IsProcessing = false
local CurrentSpeed = 1
local AutoSkipEnabled = false
local BATCH_DELAY = 0.15
local NORMAL_DELAY = 0.5

local function ensureRemotes()
    if Remotes then return Remotes end
    Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not Remotes then
        for i = 1, 10 do
            task.wait(0.5)
            Remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if Remotes then break end
        end
    end
    return Remotes
end

local function getRemote(remoteName)
    local remotes = ensureRemotes()
    return remotes and remotes:FindFirstChild(remoteName)
end

local function getCurrentCash()
    local player = Players.LocalPlayer
    if not player or not player.leaderstats then return 0 end
    local cash = player.leaderstats:FindFirstChild("Cash")
    return cash and cash.Value or 0
end

local function waitForCash(targetCash)
    while getCurrentCash() < targetCash do
        task.wait(0.01)
    end
end

local function getPositionKey(x, y, z)
    return string.format("%.1f_%.1f_%.1f", x, y, z)
end

local function findTowerAtPosition(x, y, z)
    local gameFolder = Workspace:FindFirstChild("Game")
    if gameFolder then
        local towersFolder = gameFolder:FindFirstChild("Towers")
        if towersFolder then
            local targetPos = Vector3.new(x, y, z)
            for _, part in ipairs(towersFolder:GetChildren()) do
                if part:IsA("BasePart") and (part.Position - targetPos).Magnitude < 2 then
                    return part
                end
            end
        end
    end
    return nil
end

local function isPositionOccupied(x, y, z)
    return findTowerAtPosition(x, y, z) ~= nil
end

local function waitForTowerToAppear(x, y, z)
    local startTime = tick()
    while tick() - startTime < 2 do
        if findTowerAtPosition(x, y, z) then
            return true
        end
        task.wait(0.1)
    end
    return false
end

local function isMapOnScreen(mapName)
    local player = Players.LocalPlayer
    if not player then return false end
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    local interface = playerGui:FindFirstChild("Interface")
    if not interface then return false end
    local mapOverride = interface:FindFirstChild("MapOverrideScreen")
    if not mapOverride then return false end
    local scrollingFrame = mapOverride:FindFirstChild("ScrollingFrame")
    if not scrollingFrame then return false end

    for _, child in ipairs(scrollingFrame:GetChildren()) do
        if (child:IsA("ImageButton") or child:IsA("TextButton")) and child.Name == mapName then
            if child.Visible == false then
                return true
            end
        end
    end
    return false
end

local function executeUpgrade(x, y, z, path, cost)
    local upgradeRemote = getRemote("TowerUpgradeRequest")
    if not upgradeRemote then return false end
    
    local tower = findTowerAtPosition(x, y, z)
    if not tower then return false end
    
    waitForCash(cost)
    
    local success = pcall(function()
        upgradeRemote:FireServer(tower, path, 1)
    end)
    
    return success
end

local function processCommand(command, ...)
    local args = {...}
    
    if command == "Place" then
        local towerName, x, y, z, rotation, cost = unpack(args)
        
        if isPositionOccupied(x, y, z) then
            return false
        end
        
        if cost and cost > 0 then
            waitForCash(cost)
        end
        
        local placeRemote = getRemote("PlaceTower")
        if not placeRemote then return false end
        
        task.wait(NORMAL_DELAY)
        
        local success, result = pcall(function()
            return placeRemote:InvokeServer(rotation or 0, towerName, Vector3.new(x, y, z), 0)
        end)
        
        if success and result then
            task.wait(NORMAL_DELAY)
            waitForTowerToAppear(x, y, z)
            return true
        end
        return false
        
    elseif command == "Upgrade" then
        local x, y, z, path, level, cost = unpack(args)
        
        if not findTowerAtPosition(x, y, z) then
            return false
        end
        
        return executeUpgrade(x, y, z, path, cost)
        
    elseif command == "Sell" then
        local tower = unpack(args)
        local sellRemote = getRemote("SellTower")
        if sellRemote then
            task.wait(NORMAL_DELAY)
            pcall(function()
                sellRemote:FireServer(tower)
            end)
            task.wait(NORMAL_DELAY)
            return true
        end
        return false
        
    elseif command == "TimeScale" then
        local targetSpeed = unpack(args)
        if targetSpeed == CurrentSpeed then return true end
        
        local speedRemote = getRemote("SoloToggleSpeedControl")
        if not speedRemote then return false end
        
        if targetSpeed == 1 then
            speedRemote:FireServer(false)
        elseif targetSpeed == 1.5 then
            speedRemote:FireServer(true, true)
        elseif targetSpeed == 0.5 then
            speedRemote:FireServer(true, false)
        else
            return false
        end
        
        CurrentSpeed = targetSpeed
        task.wait(NORMAL_DELAY)
        return true
    end
    
    return false
end

local function processQueue()
    if IsProcessing then return end
    IsProcessing = true
    
    local i = 1
    while i <= #CommandQueue do
        local cmd = CommandQueue[i]
        local batchProcessed = false
        
        if cmd.type == "Upgrade" then
            local x, y, z, path, level, cost = unpack(cmd.args)
            local posKey = getPositionKey(x, y, z)
            local samePosUpgrades = {}
            local totalCost = 0
            
            local j = i
            while j <= #CommandQueue and CommandQueue[j].type == "Upgrade" do
                local nextCmd = CommandQueue[j]
                local nx, ny, nz = unpack(nextCmd.args)
                local nextKey = getPositionKey(nx, ny, nz)
                
                if nextKey == posKey then
                    local nextCost = nextCmd.args[6] or 0
                    totalCost = totalCost + nextCost
                    table.insert(samePosUpgrades, nextCmd)
                    j = j + 1
                else
                    break
                end
            end
            
            if #samePosUpgrades >= 3 and getCurrentCash() >= totalCost then
                for _, upgradeCmd in ipairs(samePosUpgrades) do
                    local ux, uy, uz, upath, ulevel, ucost = unpack(upgradeCmd.args)
                    local success = executeUpgrade(ux, uy, uz, upath, ucost)
                    if not success then
                        batchProcessed = false
                        break
                    end
                    batchProcessed = true
                    task.wait(BATCH_DELAY)
                end
                
                if batchProcessed then
                    for _ = 1, #samePosUpgrades do
                        table.remove(CommandQueue, i)
                    end
                end
            end
        end
        
        if not batchProcessed then
            local success = processCommand(cmd.type, unpack(cmd.args))
            if success then
                table.remove(CommandQueue, i)
            else
                task.wait(NORMAL_DELAY)
                i = i + 1
            end
        end
    end
    
    IsProcessing = false
end

function TDX:JoinMapViaAPC(mapName)
    if self:WaitForGame() then
        return false
    end
    
    local player = Players.LocalPlayer
    local level = 0
    local lvl = player and player.leaderstats and player.leaderstats:FindFirstChild("Level")
    if lvl then level = lvl.Value end
    
    local startTime = tick()
    
    while tick() - startTime < 30 do
        if self:WaitForGame() then
            return false
        end
        
        local apcsContainer = Workspace:FindFirstChild("APCs")
        if apcsContainer then
            for _, slotFolder in ipairs(apcsContainer:GetChildren()) do
                local attrMap = slotFolder:GetAttribute("MapName") or ""
                local matched = attrMap == mapName
                
                if not matched then
                    local apcFolder = slotFolder:FindFirstChild("APC")
                    if apcFolder and apcFolder:GetAttribute("MapName") == mapName then
                        matched = true
                    end
                end
                
                if matched then
                    local detector = slotFolder:FindFirstChild("Detector")
                    if not detector and slotFolder:FindFirstChild("APC") then
                        detector = slotFolder.APC:FindFirstChild("Detector")
                    end
                    
                    if detector and detector:IsA("BasePart") then
                        local character = player.Character
                        if character and character:FindFirstChild("HumanoidRootPart") then
                            character.HumanoidRootPart.CFrame = detector.CFrame
                            task.wait(2)
                            return true
                        end
                    end
                end
            end
        end
        
        if level >= 31 then
            local apcs2Container = Workspace:FindFirstChild("APCs2")
            if apcs2Container then
                for _, slotFolder in ipairs(apcs2Container:GetChildren()) do
                    local attrMap = slotFolder:GetAttribute("MapName") or ""
                    local matched = attrMap == mapName
                    
                    if not matched then
                        local apcFolder = slotFolder:FindFirstChild("APC")
                        if apcFolder and apcFolder:GetAttribute("MapName") == mapName then
                            matched = true
                        end
                    end
                    
                    if matched then
                        local detector = slotFolder:FindFirstChild("Detector")
                        if not detector and slotFolder:FindFirstChild("APC") then
                            detector = slotFolder.APC:FindFirstChild("Detector")
                        end
                        
                        if detector and detector:IsA("BasePart") then
                            local character = player.Character
                            if character and character:FindFirstChild("HumanoidRootPart") then
                                character.HumanoidRootPart.CFrame = detector.CFrame
                                task.wait(2)
                                return true
                            end
                        end
                    end
                end
            end
        end
        
        task.wait(0.5)
    end
    
    return false
end

function TDX:Place(towerName, x, y, z, rotation, cost)
    table.insert(CommandQueue, {
        type = "Place",
        args = {towerName, x, y, z, rotation, cost}
    })
    task.spawn(processQueue)
    return true
end

function TDX:Upgrade(x, y, z, path, level, cost)
    table.insert(CommandQueue, {
        type = "Upgrade",
        args = {x, y, z, path, level, cost}
    })
    task.spawn(processQueue)
    return true
end

function TDX:Sell(tower)
    table.insert(CommandQueue, {
        type = "Sell",
        args = {tower}
    })
    task.spawn(processQueue)
    return true
end

function TDX:TimeScale(speed)
    table.insert(CommandQueue, {
        type = "TimeScale",
        args = {speed}
    })
    task.spawn(processQueue)
    return true
end

function TDX:AutoSkip(enabled)
    AutoSkipEnabled = enabled
    if enabled then
        task.spawn(function()
            while AutoSkipEnabled do
                local skipRemote = getRemote("SkipWaveVoteCast")
                if skipRemote then
                    pcall(function()
                        skipRemote:FireServer(true)
                    end)
                end
                task.wait(0.1)
            end
        end)
    end
    return true
end

function TDX:GetCurrentSpeed()
    return CurrentSpeed
end

function TDX:ClearQueue()
    local count = #CommandQueue
    CommandQueue = {}
    return count
end

function TDX:WaitForGame()
    local remotes = ensureRemotes()
    if not remotes then return false end
    return getRemote("PlaceTower") ~= nil and getRemote("SellTower") ~= nil and getRemote("TowerUpgradeRequest") ~= nil
end

function TDX:VoteMap(mapName, maxAttempts)
    maxAttempts = maxAttempts or 10
    for attempt = 1, maxAttempts do
        if isMapOnScreen(mapName) then
            local mapVote = getRemote("MapVoteCast")
            if mapVote then
                mapVote:FireServer(mapName)
            end
            task.wait(0.5)
            self:Ready()
            return true
        end
        local changeVote = getRemote("MapChangeVoteCast")
        if changeVote then
            changeVote:FireServer(true)
        end
        task.wait(1)
    end
    return self:JoinMapViaAPC(mapName)
end

function TDX:RerollMaps()
    local changeVote = getRemote("MapChangeVoteCast")
    if changeVote then
        changeVote:FireServer(true)
    end
    task.wait(0.5)
end

function TDX:Ready()
    local readyRemote = getRemote("MapVoteReady")
    if readyRemote then
        readyRemote:FireServer()
    end
    task.wait(0.3)
end

function TDX:VoteDifficulty(difficulty)
    task.wait(5.5)
    local voteRemote = getRemote("DifficultyVoteCast")
    if voteRemote then
        voteRemote:FireServer(difficulty)
    end
    task.wait(0.5)
    local readyRemote = getRemote("DifficultyVoteReady")
    if readyRemote then
        readyRemote:FireServer(difficulty)
    end
    task.wait(1)
end

function TDX:Loadout(loadoutId)
    task.wait(2)
    local loadoutRemote = getRemote("LoadoutSelectionChanged")
    if loadoutRemote then
        loadoutRemote:FireServer(loadoutId)
    end
    task.wait(0.5)
end

function TDX:Mode(mode)
    local network = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if network then
        local partyType = network:FindFirstChild("ClientChangePartyTypeRequest")
        local partyMap = network:FindFirstChild("ClientChangePartyMapRequest")
        if partyType and partyMap then
            partyType:FireServer("Party")
            task.wait(0.5)
            partyMap:FireServer(mode)
            task.wait(0.5)
            self:StartMatchmaking()
        end
    end
end

function TDX:StartMatchmaking()
    local network = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if network then
        local startGame = network:FindFirstChild("ClientStartGameRequest")
        if startGame then
            startGame:FireServer()
        end
    end
    task.wait(0.5)
end

function TDX:Equip(items)
    local network = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if network then
        local updateLoadout = network:FindFirstChild("UpdateLoadout")
        if updateLoadout then
            updateLoadout:FireServer(items)
        end
    end
    task.wait(0.5)
end

return TDX