local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Remotes = nil
local CurrentSpeed = 1
local AbilityConnections = {}

local towers = {}
local nextId = 1
local freeIds = {}
local partToId = {}

TDX._Towers = towers

local actionQueue = {}
local isProcessing = false
local upgradeBuffer = {}
local upgradeBatchTracker = {}
local batchTimeout = {}

local function ensureRemotes()
    if Remotes then return Remotes end
    Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not Remotes then
        for i = 1, 10 do
            task.wait(0.5)
            Remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if Remotes then break end
        end
    end
    return Remotes
end

local function getRemote(name)
    local r = ensureRemotes()
    return r and r:FindFirstChild(name)
end

local function getCash()
    local plr = Players.LocalPlayer
    if not plr or not plr.leaderstats then return 0 end
    local cash = plr.leaderstats:FindFirstChild("Cash")
    return cash and cash.Value or 0
end

local function getTowerBeam(towerPart)
    local ring = towerPart:FindFirstChild("Ring")
    if not ring then return nil end
    local beam = ring:FindFirstChildWhichIsA("Beam")
    return beam
end

local function isTowerAlive(towerPart)
    local beam = getTowerBeam(towerPart)
    if not beam then return false end
    local colorSeq = beam.Color
    if colorSeq and colorSeq.Keypoints and #colorSeq.Keypoints > 0 then
        local color = colorSeq.Keypoints[1].Value
        if color.R < 0.1 and color.G < 0.1 and color.B < 0.1 then
            return false
        end
        return true
    end
    return false
end

local function allocateId()
    if #freeIds > 0 then
        return table.remove(freeIds)
    else
        local id = nextId
        nextId = nextId + 1
        return id
    end
end

local function freeId(id)
    if id and id > 0 then
        table.insert(freeIds, id)
        if towers[id] then
            if towers[id].part then
                partToId[towers[id].part] = nil
            end
            towers[id] = nil
        end
    end
end

local function getServerID(logicalID)
    local data = towers[logicalID]
    if not data or not data.part or not data.part.Parent then return nil end
    
    local container = Workspace:FindFirstChild("Game")
    if container then container = container:FindFirstChild("Towers") end
    if not container then return nil end
    
    local children = container:GetChildren()
    for idx, part in ipairs(children) do
        if part == data.part then
            return idx
        end
    end
    return nil
end

local function processNextAction()
    if isProcessing then return end
    if #actionQueue == 0 then
        isProcessing = false
        return
    end
    
    isProcessing = true
    
    task.spawn(function()
        while #actionQueue > 0 do
            local action = table.remove(actionQueue, 1)
            
            if action.type == "place" then
                local remote = getRemote("PlaceTower")
                if remote then
                    while getCash() < action.cost do
                        task.wait(0.1)
                    end
                    task.wait(0.1)
                    
                    local ok, res = pcall(function()
                        return remote:InvokeServer(action.rot or 0, action.name, action.pos, 0)
                    end)
                    
                    if ok and res == true then
                        task.wait(0.3)
                        
                        local container = Workspace:FindFirstChild("Game")
                        if container then container = container:FindFirstChild("Towers") end
                        
                        local part = nil
                        for i = 1, 10 do
                            if container then
                                for _, p in ipairs(container:GetChildren()) do
                                    if p:IsA("BasePart") and p.Name == action.name then
                                        if (p.Position - action.pos).Magnitude < 3 then
                                            local beam = getTowerBeam(p)
                                            if beam then
                                                part = p
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                            if part then break end
                            task.wait(0.1)
                        end
                        
                        local id = allocateId()
                        towers[id] = {
                            name = action.name,
                            pos = action.pos,
                            part = part,
                            currentTopLevel = 0,
                            currentBottomLevel = 0,
                            alive = part ~= nil,
                            cost = action.cost
                        }
                        
                        if part then
                            partToId[part] = id
                        end
                        
                        print(string.format("[TDX] ✓ Placed %s | ID: %d", action.name, id))
                        
                        if upgradeBuffer[id] then
                            for _, upgrade in ipairs(upgradeBuffer[id]) do
                                table.insert(actionQueue, upgrade)
                            end
                            upgradeBuffer[id] = nil
                        end
                    end
                end
                task.wait(0.2)
                task.wait(0.1)
                
            elseif action.type == "upgrade" then
                local data = towers[action.logicalID]
                if data and data.alive then
                    local serverID = getServerID(action.logicalID)
                    if serverID then
                        local remote = getRemote("TowerUpgradeRequest")
                        if remote then
                            local totalCost = 0
                            for i = data.currentTopLevel + 1, action.targetLevel do
                                if action.costs and action.costs[i] then
                                    totalCost = totalCost + action.costs[i]
                                end
                            end
                            
                            while getCash() < totalCost do
                                task.wait(0.1)
                            end
                            task.wait(0.1)
                            
                            pcall(function()
                                remote:FireServer(serverID, action.path, action.targetLevel)
                            end)
                            if action.path == 1 then
                                data.currentTopLevel = action.targetLevel
                            else
                                data.currentBottomLevel = action.targetLevel
                            end
                            print(string.format("[TDX] ↑ Upgraded ID %d | Path %d to level %d", action.logicalID, action.path, action.targetLevel))
                            task.wait(0.15)
                        end
                    else
                        if not upgradeBuffer[action.logicalID] then
                            upgradeBuffer[action.logicalID] = {}
                        end
                        table.insert(upgradeBuffer[action.logicalID], action)
                        print(string.format("[TDX] ⏳ ID %d dead - upgrade queued", action.logicalID))
                    end
                else
                    if not upgradeBuffer[action.logicalID] then
                        upgradeBuffer[action.logicalID] = {}
                    end
                    table.insert(upgradeBuffer[action.logicalID], action)
                    print(string.format("[TDX] ⏳ ID %d not found - upgrade queued", action.logicalID))
                end
                task.wait(0.2)
                task.wait(0.1)
                
            elseif action.type == "sell" then
                local data = towers[action.logicalID]
                if data then
                    local serverID = getServerID(action.logicalID)
                    if serverID then
                        local remote = getRemote("SellTower")
                        if remote then
                            pcall(function() remote:FireServer(serverID) end)
                        end
                    end
                    print(string.format("[TDX] 💰 Sold ID %d", action.logicalID))
                    freeId(action.logicalID)
                    task.wait(0.2)
                end
                task.wait(0.2)
                task.wait(0.1)
            end
        end
        
        isProcessing = false
    end)
end

local function queueAction(action)
    table.insert(actionQueue, action)
    processNextAction()
end

local function checkAndHandleDeath()
    for id, data in pairs(towers) do
        if data.alive and data.part then
            if not data.part.Parent or not isTowerAlive(data.part) then
                print(string.format("[TDX] 💀 Tower ID %d (%s) died", id, data.name))
                data.alive = false
                data.part = nil
                if data.part then
                    partToId[data.part] = nil
                end
            end
        end
    end
end

local beamCheckConnection = nil

local function startBeamCheck()
    if beamCheckConnection then return end
    beamCheckConnection = game:GetService("RunService").Heartbeat:Connect(function()
        checkAndHandleDeath()
    end)
end

