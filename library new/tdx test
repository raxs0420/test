local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Remotes = nil
local CurrentSpeed = 1

local towers = {}
local partToId = {}
local expectedIdToActualId = {}
local actualIdToMacroId = {}

local nextId = 1
local freeIds = {}
local pendingPlacements = {}
local upgradeRetryQueue = {}

local MATCH_TOLERANCE = 0.01
local PENDING_TIMEOUT = 5
local gameOverTriggered = false

local player = Players.LocalPlayer
local towersFolder = nil

local towerLevels = {}
local pendingHash = nil
local pendingTop = 0
local pendingBottom = 0
local hashToMacroId = {} 

local function ensureRemotes()
    if Remotes then return Remotes end
    Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not Remotes then
        for i = 1, 10 do
            task.wait(0.5)
            Remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if Remotes then break end
        end
    end
    return Remotes
end

local function getRemote(name)
    local r = ensureRemotes()
    return r and r:FindFirstChild(name)
end

local function getCash()
    if not player or not player.leaderstats then return 0 end
    local cash = player.leaderstats:FindFirstChild("Cash")
    return cash and cash.Value or 0
end

local function isPartAlive(part)
    if not part or not part.Parent then return false end
    local ring = part:FindFirstChild("Ring")
    if not ring then return false end
    local beam = ring:FindFirstChildWhichIsA("Beam")
    if not beam then return false end
    local seq = beam.Color
    if seq and seq.Keypoints and #seq.Keypoints > 0 then
        local color = seq.Keypoints[1].Value
        return not (color.R < 0.1 and color.G < 0.1 and color.B < 0.1)
    end
    return false
end

local function getNumericLevel(part)
    if not part then return 0 end
    for _, child in ipairs(part:GetChildren()) do
        local num = tonumber(child.Name)
        if num then return num end
        if child:IsA("Model") then
            for _, sub in ipairs(child:GetChildren()) do
                local subNum = tonumber(sub.Name)
                if subNum then return subNum end
            end
        end
    end
    return 0
end

local function allocateId()
    if #freeIds > 0 then
        return table.remove(freeIds, #freeIds)
    else
        local id = nextId
        nextId = nextId + 1
        return id
    end
end

local function freeId(id)
    if not id or id == 0 then return end
    table.insert(freeIds, id)
    local data = towers[id]
    if data and data.part then
        partToId[data.part] = nil
    end
    local macroId = actualIdToMacroId[id]
    if macroId then
        expectedIdToActualId[macroId] = nil
        actualIdToMacroId[id] = nil
        towerLevels[macroId] = nil
        for h, m in pairs(hashToMacroId) do
            if m == macroId then hashToMacroId[h] = nil end
        end
    end
    towers[id] = nil
end

local function matchPendingPlacement(partName, partPos)
    local bestId = nil
    local bestDist = MATCH_TOLERANCE
    for expectedId, data in pairs(pendingPlacements) do
        if data.name:lower() == partName:lower() then
            local dist = (partPos - data.pos).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestId = expectedId
            end
        end
    end
    if bestId then
        print(string.format("[TDX] + Macro %d → %s", bestId, partName))
    end
    return bestId
end

local function addTower(part, expectedMacroId)
    if partToId[part] then
        if expectedMacroId then
            local existingId = partToId[part]
            local existingMacro = actualIdToMacroId[existingId]
            if existingMacro and existingMacro ~= expectedMacroId then
                freeId(existingId)
                partToId[part] = nil
            else
                return
            end
        else
            return
        end
    end

    local actualId = allocateId()
    partToId[part] = actualId
    towers[actualId] = {
        part = part,
        name = part.Name,
        position = part.Position,
        macroId = expectedMacroId,
        currentLevel = getNumericLevel(part)
    }

    if expectedMacroId then
        local oldActual = expectedIdToActualId[expectedMacroId]
        if oldActual and oldActual ~= actualId then
            freeId(oldActual)
        end
        expectedIdToActualId[expectedMacroId] = actualId
        actualIdToMacroId[actualId] = expectedMacroId
        print(string.format("[TDX] ✓ Macro %d → ID %d", expectedMacroId, actualId))
    end
end

local function removeTower(part)
    local actualId = partToId[part]
    if not actualId then return end
    local macroId = actualIdToMacroId[actualId]
    if macroId then
        print(string.format("[TDX] 💀 Macro %d died", macroId))
    end
    freeId(actualId)
    partToId[part] = nil
end

local function cleanupPendingPlacements()
    local now = os.time()
    for expectedId, data in pairs(pendingPlacements) do
        if now - data.time > PENDING_TIMEOUT then
            pendingPlacements[expectedId] = nil
            print(string.format("[TDX] ⏰ Macro %d timeout", expectedId))
        end
    end
end

local function processUpgradeRetries()
    for macroId, data in pairs(upgradeRetryQueue) do
        if data.retries > 0 then
            local actualId = expectedIdToActualId[macroId]
            if actualId and towers[actualId] and isPartAlive(towers[actualId].part) then
                local remote = getRemote("TowerUpgradeRequest")
                if remote then
                    pcall(function()
                        remote:FireServer(actualId, data.path, data.level)
                    end)
                    print(string.format("[TDX] ↑ Macro %d | Lv %d (retry)", macroId, data.level))
                    upgradeRetryQueue[macroId] = nil
                else
                    data.retries = data.retries - 1
                end
            else
                data.retries = data.retries - 1
            end
        else
            upgradeRetryQueue[macroId] = nil
        end
    end
end

local function onNumericLevelIncrease(part, newLevel, oldLevel)
    local actualId = partToId[part]
    if not actualId then return end
    local macroId = actualIdToMacroId[actualId]
    if not macroId then
        macroId = allocateId()
        actualIdToMacroId[actualId] = macroId
        expectedIdToActualId[macroId] = actualId
        print(string.format("[TDX] Auto-assigned Macro %d to %s", macroId, part.Name))
    end
    if pendingHash and not towerLevels[macroId] then
        hashToMacroId[pendingHash] = macroId
        towerLevels[macroId] = {top = pendingTop, bottom = pendingBottom}
        print(string.format("[TDX] Hash %d → Macro %d (top=%d bottom=%d)", pendingHash, macroId, pendingTop, pendingBottom))
        pendingHash = nil
        pendingTop = 0
        pendingBottom = 0
    end
    if towers[actualId] then
        towers[actualId].currentLevel = newLevel
    end
end

local function watchTowerLevels(part)
    local function checkExisting()
        for _, child in ipairs(part:GetChildren()) do
            local num = tonumber(child.Name)
            if num then
                local old = towers[partToId[part]] and towers[partToId[part]].currentLevel or 0
                if num > old then
                    onNumericLevelIncrease(part, num, old)
                end
            end
            if child:IsA("Model") then
                for _, sub in ipairs(child:GetChildren()) do
                    local subNum = tonumber(sub.Name)
                    if subNum then
                        local old = towers[partToId[part]] and towers[partToId[part]].currentLevel or 0
                        if subNum > old then
                            onNumericLevelIncrease(part, subNum, old)
                        end
                    end
                end
                child.ChildAdded:Connect(function(sub)
                    local subNum = tonumber(sub.Name)
                    if subNum then
                        local old = towers[partToId[part]] and towers[partToId[part]].currentLevel or 0
                        if subNum > old then
                            onNumericLevelIncrease(part, subNum, old)
                        end
                    end
                end)
            end
        end
    end
    part.ChildAdded:Connect(function(child)
        local num = tonumber(child.Name)
        if num then
            local old = towers[partToId[part]] and towers[partToId[part]].currentLevel or 0
            if num > old then
                onNumericLevelIncrease(part, num, old)
            end
        end
        if child:IsA("Model") then
            child.ChildAdded:Connect(function(sub)
                local subNum = tonumber(sub.Name)
                if subNum then
                    local old = towers[partToId[part]] and towers[partToId[part]].currentLevel or 0
                    if subNum > old then
                        onNumericLevelIncrease(part, subNum, old)
                    end
                end
            end)
            for _, sub in ipairs(child:GetChildren()) do
                local subNum = tonumber(sub.Name)
                if subNum then
                    local old = towers[partToId[part]] and towers[partToId[part]].currentLevel or 0
                    if subNum > old then
                        onNumericLevelIncrease(part, subNum, old)
                    end
                end
            end
        end
    end)
    checkExisting()
end

local function setupUpgradeListener()
    local upgradeRemote = getRemote("TowerUpgradeQueueUpdated")
    if not upgradeRemote then return end
    upgradeRemote.OnClientEvent:Connect(function(data)
        if type(data) ~= "table" then return end
        local entries = (#data > 0) and data or {data}
        for _, entry in ipairs(entries) do
            local hash = entry.Hash or entry.hash or entry.Id or entry.id
            if not hash then continue end
            if type(hash) == "string" then hash = tonumber(hash) end
            if not hash then continue end
            local top = 0
            local bottom = 0
            if entry.LevelReplicationData and type(entry.LevelReplicationData) == "table" then
                top = entry.LevelReplicationData[1] or 0
                bottom = entry.LevelReplicationData[2] or 0
            end
            if hashToMacroId[hash] then
                local macroId = hashToMacroId[hash]
                towerLevels[macroId] = {top = top, bottom = bottom}
                print(string.format("[TDX] Macro %d updated: top=%d bottom=%d", macroId, top, bottom))
            else
                pendingHash = hash
                pendingTop = top
                pendingBottom = bottom
                print(string.format("[TDX] New hash %d received, waiting for level increase", hash))
            end
        end
    end)
    print("[TDX] Upgrade listener active")
end

local function syncAllTowers()
    if not towersFolder then
        towersFolder = Workspace:FindFirstChild("Game") and Workspace.Game:FindFirstChild("Towers")
        if not towersFolder then return end
    end

    local aliveParts = {}
    local children = towersFolder:GetChildren()
    for i = 1, #children do
        local part = children[i]
        if part:IsA("BasePart") and isPartAlive(part) then
            aliveParts[part] = true
        end
    end

    for part in pairs(partToId) do
        if not aliveParts[part] then
            removeTower(part)
        end
    end

    for part in pairs(aliveParts) do
        if not partToId[part] then
            local expectedId = matchPendingPlacement(part.Name, part.Position)
            if expectedId then
                pendingPlacements[expectedId] = nil
                addTower(part, expectedId)
            else
                addTower(part, nil)
            end
            watchTowerLevels(part)
        end
    end

    cleanupPendingPlacements()
    processUpgradeRetries()
end

RunService.Stepped:Connect(syncAllTowers)

local function checkGameOver()
    if gameOverTriggered then return end

    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return end

    local interface = playerGui:FindFirstChild("Interface")
    if not interface then return end

    local gameOverScreen = interface:FindFirstChild("GameOverScreen")

    if not gameOverScreen then
        task.spawn(function()
            task.wait(10)
            checkGameOver()
        end)
        return
    end

    task.spawn(function()
        while not gameOverTriggered do
            if gameOverScreen.Visible then
                gameOverTriggered = true
                print("[TDX] Game Over! Teleporting...")
                task.wait(2)
                pcall(function()
                    TeleportService:Teleport(9503261072)
                end)
                break
            end
            task.wait(0.5)
        end
    end)
end

function TDX:Place(name, x, y, z, rot, cost, expectedId)
    local remote = getRemote("PlaceTower")
    if not remote then return nil end
    local pos = Vector3.new(x, y, z)
    local ok, res = pcall(function()
        return remote:InvokeServer(rot or 0, name, pos, 0)
    end)
    if ok and res == true then
        if expectedId then
            pendingPlacements[expectedId] = {
                name = name,
                pos = pos,
                time = os.time()
            }
        end
        print(string.format("[TDX] + %s (ID:%s)", name, expectedId or "auto"))
        task.wait(0.15)
        return true
    end
    return false
end

function TDX:Upgrade(macroId, path, level, cost)
    while true do
        local actualId = expectedIdToActualId[macroId]
        if actualId then
            local data = towers[actualId]
            if data and data.part and isPartAlive(data.part) then
                local remote = getRemote("TowerUpgradeRequest")
                if remote then
                    pcall(function()
                        remote:FireServer(actualId, path, level)
                    end)
                    print(string.format("[TDX] ↑ Macro %d Lv%d sent", macroId, level))
                end
            end
        elseif not upgradeRetryQueue[macroId] then
            upgradeRetryQueue[macroId] = {
                path = path,
                level = level,
                cost = cost,
                retries = 99999
            }
        end
        
        local lvl = towerLevels[macroId]
        if lvl then
            if (path == 1 and lvl.top >= level) or (path == 2 and lvl.bottom >= level) then
                print(string.format("[TDX] ✓ Macro %d Lv%d confirmed", macroId, level))
                task.wait(0.15)
                return true
            end
        end
        
        task.wait(0.15)
    end
end

function TDX:Sell(macroId)
    local actualId = expectedIdToActualId[macroId]
    if not actualId then return false end
    local data = towers[actualId]
    if not data or not data.part or not isPartAlive(data.part) then return false end
    local remote = getRemote("SellTower")
    if remote then
        task.wait(0.1)
        pcall(function() remote:FireServer(actualId) end)
        print(string.format("[TDX] 💰 Sold Macro %d", macroId))
    end
    return true
end

function TDX:Ability(macroId, slot, loop)
    if loop then
        task.spawn(function()
            while true do
                TDX:Ability(macroId, slot, false)
                task.wait(0.05)
            end
        end)
        return
    end
    local actualId = expectedIdToActualId[macroId]
    if not actualId then return end
    local data = towers[actualId]
    if not data or not data.part or not isPartAlive(data.part) then return end
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        local req = remote:FindFirstChild("TowerUseAbilityRequest")
        if req then
            pcall(function() req:InvokeServer(actualId, slot) end)
        end
    end
end

local upgradeQueue = {}
local isProcessing = false

function TDX:TowerUpgrade(TowerName, Skill)
    table.insert(upgradeQueue, {TowerName = TowerName, Skill = Skill})

    if not isProcessing then
        task.spawn(function()
            isProcessing = true
            while #upgradeQueue > 0 do
                local upgrade = table.remove(upgradeQueue, 1)
                local remote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("UpgradeShopOperationRequest")
                local upgraded = false
                while not upgraded do
                    local success, result = pcall(function()
                        return remote:InvokeServer(upgrade.TowerName, upgrade.Skill)
                    end)
                    if success and result == true then
                        upgraded = true
                        print(string.format("[TDX] Upgraded %s: %s", upgrade.TowerName, upgrade.Skill))
                    else
                        task.wait(0.5)
                    end
                end
                task.wait(0.1)
            end
            isProcessing = false
        end)
    end
end

function TDX:TimeScale(speed)
    if speed == CurrentSpeed then return true end
    local remote = getRemote("SoloToggleSpeedControl")
    if remote then
        if speed == 1 then
            remote:FireServer(false)
        elseif speed == 1.5 then
            remote:FireServer(true, true)
        elseif speed == 0.5 then
            remote:FireServer(true, false)
        else
            return false
        end
        CurrentSpeed = speed
    end
    return true
end

function TDX:AutoSkip(enabled)
    task.spawn(function()
        while enabled do
            local skip = getRemote("SkipWaveVoteCast")
            if skip then
                pcall(function() skip:FireServer(true) end)
            end
            local cutscene = getRemote("CutsceneVoteCast")
            if cutscene then
                pcall(function() cutscene:FireServer(true) end)
            end
            task.wait(0.1)
        end
    end)
    return true
end

function TDX:Mode(mode)
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local partyType = net:FindFirstChild("ClientChangePartyTypeRequest")
        local partyMap = net:FindFirstChild("ClientChangePartyMapRequest")
        if partyType and partyMap then
            partyType:FireServer("Party")
            task.wait(0.5)
            partyMap:FireServer(mode)
            task.wait(0.5)
            TDX:StartMatchmaking()
        end
    end
end

function TDX:StartMatchmaking()
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local start = net:FindFirstChild("ClientStartGameRequest")
        if start then
            start:FireServer()
        end
    end
    task.wait(0.5)
end

