                end
            end
            return remote
        end
        
        while true do
            local currentRemote = getRemote()
            if currentRemote then
                for i = 1, 100 do
                    pcall(function() 
                        currentRemote:FireServer(i) 
                    end)
                end
            end
            task.wait(1)
        end
    end)
end

local function makeOpaqueLoop()
    while true do
        local gameFolder = workspace:FindFirstChild("Game")
        if gameFolder then
            local projectiles = gameFolder:FindFirstChild("Projectiles")
            if projectiles then
                for _, part in ipairs(projectiles:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Transparency = 0
                    end
                end
            end
            
            local enemies = gameFolder:FindFirstChild("Enemies")
            if enemies then
                for _, part in ipairs(enemies:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Transparency = 0
                    end
                end
            end
        end
        task.wait(0.5)
    end
end

makeOpaqueLoop()
startCoinCollector()

return TDX