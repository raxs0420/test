function TDX:ResetMappings()
    nextId = 1
    freeIds = {}
    partToId = {}
    expectedIdToActualId = {}
    actualIdToMacroId = {}
    pendingPlacements = {}
    upgradeRetryQueue = {}
    towerLevels = {}
    hashToMacroId = {}
