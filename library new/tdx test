local upgradeTracker = {}

function TDX:Place(name, x, y, z, rot, cost)
    local remote = getRemote("PlaceTower")
    if not remote then return nil end
    
    while getCash() < cost do task.wait(0.05) end
    task.wait(0.1)
    
    local pos = Vector3.new(x, y, z)
    local ok, res = pcall(function()
        return remote:InvokeServer(rot or 0, name, pos, 0)
    end)
    
    if not (ok and res == true) then return nil end
    task.wait(0.5)
    
    local container = Workspace:FindFirstChild("Game")
    if container then container = container:FindFirstChild("Towers") end
    
    local part = nil
    for i = 1, 10 do
        if container then
            for _, p in ipairs(container:GetChildren()) do
                if p:IsA("BasePart") and p.Name == name then
                    if (p.Position - pos).Magnitude < 3 then
                        local beam = getTowerBeam(p)
                        if beam then
                            part = p
                            break
                        end
                    end
                end
            end
        end
        if part then break end
        task.wait(0.1)
    end
    
    local id = allocateId()
    towers[id] = {
        name = name,
        pos = pos,
        part = part,
        currentTopLevel = 0,
        currentBottomLevel = 0,
        alive = part ~= nil,
        cost = cost,
        pendingUpgrades = {}
    }
    
    if part then
        partToId[part] = id
    end
    
    upgradeTracker[id] = {top = {}, bottom = {}}
    
    printToUI(string.format("✓ Placed %s | ID: %d | Cost: $%d", name, id, cost), Color3.fromRGB(100, 255, 100))
    
    startBeamCheck()
    
    return id
end

function TDX:Upgrade(logicalID, path, level, cost)
    local data = towers[logicalID]
    if not data then 
        printToUI(string.format("✗ Upgrade failed - ID %d not found", logicalID), Color3.fromRGB(255, 100, 100))
        return false 
    end
    
    if not upgradeTracker[logicalID] then
        upgradeTracker[logicalID] = {top = {}, bottom = {}}
    end
    
    local tracker = upgradeTracker[logicalID]
    local targetPath = (path == 1) and "top" or "bottom"
    
    table.insert(tracker[targetPath], {level = level, cost = cost})
    
    local levels = {}
    for _, upgrade in ipairs(tracker[targetPath]) do
        levels[upgrade.level] = upgrade.cost
    end
    
    local sortedLevels = {}
    for lvl in pairs(levels) do
        table.insert(sortedLevels, lvl)
    end
    table.sort(sortedLevels)
    
    local isConsecutive = true
    for i = 1, #sortedLevels do
        if sortedLevels[i] ~= i then
            isConsecutive = false
            break
        end
    end
    
    local currentLevel = (path == 1) and data.currentTopLevel or data.currentBottomLevel
    
    if isConsecutive and #sortedLevels >= 2 and currentLevel == 0 then
        local targetLevel = #sortedLevels
        local totalCost = 0
        for lvl, cst in pairs(levels) do
            totalCost = totalCost + cst
        end
        
        data.costs = levels
        
        if data.alive and getCash() >= totalCost then
            addToBuffer(logicalID, path, targetLevel, totalCost, true, targetLevel)
            tracker[targetPath] = {}
        else
            printToUI(string.format("📦 Batched %d upgrades for ID %d path %d (target level %d, cost $%d)", #sortedLevels, logicalID, path, targetLevel, totalCost), Color3.fromRGB(255, 200, 0))
            data.pendingBatch = {path = path, targetLevel = targetLevel, totalCost = totalCost}
        end
    elseif isConsecutive and #sortedLevels >= 2 and currentLevel > 0 then
        local neededLevels = {}
        local totalCost = 0
        for lvl, cst in pairs(levels) do
            if lvl > currentLevel then
                neededLevels[lvl] = cst
                totalCost = totalCost + cst
            end
        end
        
        if #neededLevels >= 2 then
            local targetLevel = math.max(table.unpack(sortedLevels))
            if data.alive and getCash() >= totalCost then
                addToBuffer(logicalID, path, targetLevel, totalCost, true, targetLevel)
                tracker[targetPath] = {}
            else
                printToUI(string.format("📦 Batched %d upgrades for ID %d path %d (need %d more levels to %d, cost $%d)", #neededLevels, logicalID, path, targetLevel - currentLevel, targetLevel, totalCost), Color3.fromRGB(255, 200, 0))
            end
        else
            if data.alive then
                addToBuffer(logicalID, path, level, cost, false, level)
            end
            tracker[targetPath] = {}
        end
    else
        if data.alive then
            addToBuffer(logicalID, path, level, cost, false, level)
        else
            printToUI(string.format("⏳ ID %d dead - upgrade to level %d queued", logicalID, level), Color3.fromRGB(255, 200, 0))
        end
        tracker[targetPath] = {}
    end
    
    return true
end

function TDX:Sell(logicalID)
    local data = towers[logicalID]
    if not data then return false end
    
    local serverID = getServerID(logicalID)
    if serverID then
        local remote = getRemote("SellTower")
        if remote then
            pcall(function() remote:FireServer(serverID) end)
        end
    end
    
    printToUI(string.format("💰 Sold ID %d (%s)", logicalID, data.name), Color3.fromRGB(255, 200, 100))
    task.wait(0.3)
    freeId(logicalID)
    return true
end

function TDX:TimeScale(speed)
    if speed == CurrentSpeed then return true end
    local remote = getRemote("SoloToggleSpeedControl")
    if remote then
        if speed == 1 then
            remote:FireServer(false)
        elseif speed == 1.5 then
            remote:FireServer(true, true)
        elseif speed == 0.5 then
            remote:FireServer(true, false)
        else
            return false
        end
        CurrentSpeed = speed
        printToUI(string.format("⚡ Time scale: %dx", speed), Color3.fromRGB(100, 200, 255))
    end
    task.wait(0.5)
    return true
end

function TDX:AutoSkip(enabled)
    task.spawn(function()
        while enabled do
            local skip = getRemote("SkipWaveVoteCast")
            if skip then
                pcall(function() skip:FireServer(true) end)
            end
            task.wait(0.1)
        end
    end)
    printToUI(string.format("🔄 Auto-skip: %s", enabled and "ON" or "OFF"), Color3.fromRGB(100, 200, 255))
    return true
end

function TDX:GetCurrentSpeed()
    return CurrentSpeed
end

function TDX:WaitForGame()
    local r = ensureRemotes()
    return r and getRemote("PlaceTower") and getRemote("SellTower") and getRemote("TowerUpgradeRequest")
end

