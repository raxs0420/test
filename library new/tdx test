local TDX = {}
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Remotes = nil
local CurrentSpeed = 1
local AbilityConnections = {}

local towers = {}
local nextId = 1
local freeIds = {}
local partToId = {}

TDX._Towers = towers
TDX._ScanConnection = nil
TDX._LastScan = 0

local pendingUpgrades = {}
local upgradeQueue = {}
local processingQueue = false

local function ensureRemotes()
    if Remotes then return Remotes end
    Remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not Remotes then
        for i = 1, 10 do
            task.wait(0.5)
            Remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if Remotes then break end
        end
    end
    return Remotes
end

local function getRemote(name)
    local r = ensureRemotes()
    return r and r:FindFirstChild(name)
end

local function getCash()
    local plr = Players.LocalPlayer
    if not plr or not plr.leaderstats then return 0 end
    local cash = plr.leaderstats:FindFirstChild("Cash")
    return cash and cash.Value or 0
end

local function getTowerBeamColor(towerPart)
    local ring = towerPart:FindFirstChild("Ring")
    if not ring then return nil end
    local beam = ring:FindFirstChildWhichIsA("Beam")
    if not beam then return nil end
    local seq = beam.Color
    if seq and seq.Keypoints and #seq.Keypoints > 0 then
        return seq.Keypoints[1].Value
    end
    return nil
end

local function isDeadColor(color)
    return color.R < 0.1 and color.G < 0.1 and color.B < 0.1
end

local function getServerID(logicalID)
    local data = towers[logicalID]
    if not data or not data.alive then return nil end
    local container = Workspace:FindFirstChild("Game")
    if container then container = container:FindFirstChild("Towers") end
    if not container then return nil end
    
    if data.part and data.part.Parent then
        local children = container:GetChildren()
        for idx, part in ipairs(children) do
            if part == data.part then
                local color = getTowerBeamColor(part)
                if color and isDeadColor(color) then
                    data.alive = false
                    return nil
                end
                return idx
            end
        end
    end
    
    local children = container:GetChildren()
    for idx, part in ipairs(children) do
        if part:IsA("BasePart") and part.Name == data.name then
            if (part.Position - data.pos).Magnitude < 5 then
                local color = getTowerBeamColor(part)
                if color and isDeadColor(color) then
                    data.alive = false
                    return nil
                end
                data.part = part
                partToId[part] = logicalID
                return idx
            end
        end
    end
    return nil
end

local function allocateId()
    if #freeIds > 0 then
        return table.remove(freeIds)
    else
        local id = nextId
        nextId = nextId + 1
        return id
    end
end

local function freeId(id)
    if id and id > 0 then
        if not towers[id] then return end
        table.insert(freeIds, id)
        towers[id] = nil
    end
end

local function removeTower(logicalID)
    local data = towers[logicalID]
    if not data then return end
    
    if data.part then
        partToId[data.part] = nil
    end
    
    freeId(logicalID)
end

local function addTower(name, pos, part)
    local id = allocateId()
    towers[id] = {
        name = name,
        pos = pos,
        part = part,
        upgrades = {},
        topLevel = 0,
        bottomLevel = 0,
        alive = true,
        rebuilding = false,
        placedAfterAuto = true,
        cost = 0,
        pendingTopUpgrades = {},
        pendingBottomUpgrades = {}
    }
    if part then
        partToId[part] = id
    end
    return id
end

local function sendBatchUpgrade(logicalID, path, targetLevel)
    local data = towers[logicalID]
    if not data then return false end
    
    local serverID = getServerID(logicalID)
    if not serverID then return false end
    
    local remote = getRemote("TowerUpgradeRequest")
    if not remote then return false end
    
    pcall(function()
        remote:FireServer(serverID, path, targetLevel)
    end)
    
    if path == 1 then
        data.topLevel = targetLevel
        data.pendingTopUpgrades = {}
    else
        data.bottomLevel = targetLevel
        data.pendingBottomUpgrades = {}
    end
    
    print(string.format("[TDX] ↑ Batch upgraded Tower ID %d (%s) | Path %d to level %d", logicalID, data.name, path, targetLevel))
    return true
end

local function processUpgradeQueue()
    if processingQueue then return end
    processingQueue = true
    
    task.spawn(function()
        while #upgradeQueue > 0 do
            local upgrade = table.remove(upgradeQueue, 1)
            local data = towers[upgrade.logicalID]
            
            if not data or not data.alive or data.rebuilding then
                if not pendingUpgrades[upgrade.logicalID] then
                    pendingUpgrades[upgrade.logicalID] = {}
                end
                table.insert(pendingUpgrades[upgrade.logicalID], upgrade)
            else
                local success = false
                local attempts = 0
                while not success and attempts < 5 do
                    local serverID = getServerID(upgrade.logicalID)
                    if serverID then
                        local remote = getRemote("TowerUpgradeRequest")
                        if remote then
                            local totalCost = 0
                            for i = upgrade.fromLevel + 1, upgrade.toLevel do
                                totalCost = totalCost + upgrade.costs[i]
                            end
                            
                            while getCash() < totalCost do
                                task.wait(0.1)
                            end
                            
                            task.wait(0.1)
                            pcall(function()
                                remote:FireServer(serverID, upgrade.path, upgrade.toLevel)
                            end)
                            
                            if upgrade.path == 1 then
                                data.topLevel = upgrade.toLevel
                                data.pendingTopUpgrades = {}
                            else
                                data.bottomLevel = upgrade.toLevel
                                data.pendingBottomUpgrades = {}
                            end
                            
                            print(string.format("[TDX] ↑ Batch upgraded Tower ID %d (%s) | Path %d from level %d to %d (+%d levels) | Total: $%d", upgrade.logicalID, data.name, upgrade.path, upgrade.fromLevel, upgrade.toLevel, upgrade.toLevel - upgrade.fromLevel, totalCost))
                            success = true
                        end
                    end
                    attempts = attempts + 1
                    if not success then
                        task.wait(0.2)
                    end
                end
                
                if not success then
                    if not pendingUpgrades[upgrade.logicalID] then
                        pendingUpgrades[upgrade.logicalID] = {}
                    end
                    table.insert(pendingUpgrades[upgrade.logicalID], upgrade)
                end
            end
            
            task.wait(0.15)
        end
        processingQueue = false
    end)
end

local function addToUpgradeQueue(logicalID, path, toLevel, fromLevel, costs)
    table.insert(upgradeQueue, {
        logicalID = logicalID,
        path = path,
        toLevel = toLevel,
        fromLevel = fromLevel,
        costs = costs
    })
    processUpgradeQueue()
end

local function applyPendingUpgrades(logicalID)
    local data = towers[logicalID]
    if not data then return end
    
    task.spawn(function()
        task.wait(0.5)
        
        if data.topLevel > 0 and #data.pendingTopUpgrades > 0 then
            local maxLevel = math.max(table.unpack(data.pendingTopUpgrades))
            if maxLevel > data.topLevel then
                addToUpgradeQueue(logicalID, 1, maxLevel, data.topLevel, data.pendingTopUpgrades)
            end
        end
        
        if data.bottomLevel > 0 and #data.pendingBottomUpgrades > 0 then
            local maxLevel = math.max(table.unpack(data.pendingBottomUpgrades))
            if maxLevel > data.bottomLevel then
                addToUpgradeQueue(logicalID, 2, maxLevel, data.bottomLevel, data.pendingBottomUpgrades)
            end
        end
        
        if pendingUpgrades[logicalID] then
            for _, upgrade in ipairs(pendingUpgrades[logicalID]) do
                addToUpgradeQueue(upgrade.logicalID, upgrade.path, upgrade.toLevel, upgrade.fromLevel, upgrade.costs)
            end
            pendingUpgrades[logicalID] = nil
        end
    end)
end

local function rebuildTower(logicalID)
    local data = towers[logicalID]
    if not data or data.rebuilding then return end
    data.rebuilding = true
    task.spawn(function()
        task.wait(2.7)
        local placed = false
        while not placed do
            local remote = getRemote("PlaceTower")
            if remote then
                while getCash() < data.cost do
                    task.wait(0.3)
                end
                
                task.wait(0.2)
                local ok, res = pcall(function()
                    return remote:InvokeServer(0, data.name, data.pos, 0)
                end)
                if ok and res == true then
                    placed = true
                    task.wait(0.3)
                    
                    local container = Workspace:FindFirstChild("Game")
                    if container then container = container:FindFirstChild("Towers") end
                    if container then
                        for _, part in ipairs(container:GetChildren()) do
                            if part:IsA("BasePart") and part.Name == data.name then
                                if (part.Position - data.pos).Magnitude < 5 then
                                    data.part = part
                                    partToId[part] = logicalID
                                    break
                                end
                            end
                        end
                    end
                    
                    data.alive = true
                    data.rebuilding = false
                    
                    applyPendingUpgrades(logicalID)
                    return
                end
            end
            task.wait(0.5)
        end
    end)
end

local function scanAndRebuild()
    for id, data in pairs(towers) do
        if data.alive and not data.rebuilding then
            local serverID = getServerID(id)
            if not serverID then
                data.alive = false
                rebuildTower(id)
            end
        end
    end
end

local function startDeathScan()
    if TDX._ScanConnection then return end
    TDX._ScanConnection = game:GetService("RunService").Heartbeat:Connect(function()
        local now = tick()
        if now - TDX._LastScan >= 0.05 then
            TDX._LastScan = now
            scanAndRebuild()
        end
    end)
end

