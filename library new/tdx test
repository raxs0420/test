function TDX:Place(name, x, y, z, rot, cost)
    local pos = Vector3.new(x, y, z)
    local action = {
        type = "place",
        name = name,
        pos = pos,
        rot = rot or 0,
        cost = cost
    }
    queueAction(action)
    startBeamCheck()
    return true
end

function TDX:Upgrade(logicalID, path, increment, cost)
    if increment ~= 1 then
        local action = {
            type = "upgrade",
            logicalID = logicalID,
            path = path,
            targetLevel = increment,
            costs = {[increment] = cost}
        }
        queueAction(action)
        return true
    end
    
    local key = logicalID .. "_" .. path
    
    if batchTimeout[key] then
        if tick() - batchTimeout[key] > 0.5 then
            if upgradeBatchTracker[key] and upgradeBatchTracker[key].count > 0 then
                local data = towers[logicalID]
                local currentLevel = 0
                if data and data.alive then
                    currentLevel = (path == 1) and (data.currentTopLevel or 0) or (data.currentBottomLevel or 0)
                end
                
                local targetLevel = currentLevel + upgradeBatchTracker[key].count
                local action = {
                    type = "upgrade",
                    logicalID = logicalID,
                    path = path,
                    targetLevel = targetLevel,
                    costs = upgradeBatchTracker[key].costs
                }
                queueAction(action)
                printToUI(string.format("📦 Batched %d upgrades for ID %d path %d to level %d", upgradeBatchTracker[key].count, logicalID, path, targetLevel), Color3.fromRGB(255, 200, 0))
                upgradeBatchTracker[key] = nil
            end
            batchTimeout[key] = nil
        end
    end
    
    if not upgradeBatchTracker[key] then
        upgradeBatchTracker[key] = {count = 0, costs = {}}
    end
    
    local tracker = upgradeBatchTracker[key]
    tracker.count = tracker.count + 1
    tracker.costs[tracker.count] = cost
    
    local data = towers[logicalID]
    local currentLevel = 0
    if data and data.alive then
        currentLevel = (path == 1) and (data.currentTopLevel or 0) or (data.currentBottomLevel or 0)
    end
    
    local expectedCount = 1
    if tracker.count == 5 or (currentLevel + tracker.count) >= 5 then
        local targetLevel = currentLevel + tracker.count
        if targetLevel > 5 then targetLevel = 5 end
        
        local action = {
            type = "upgrade",
            logicalID = logicalID,
            path = path,
            targetLevel = targetLevel,
            costs = tracker.costs
        }
        queueAction(action)
        printToUI(string.format("📦 Batched %d upgrades for ID %d path %d to level %d", tracker.count, logicalID, path, targetLevel), Color3.fromRGB(255, 200, 0))
        upgradeBatchTracker[key] = nil
        batchTimeout[key] = nil
    else
        printToUI(string.format("⏳ Collected upgrade #%d for ID %d path %d (need %d more for max path)", tracker.count, logicalID, path, 5 - tracker.count), Color3.fromRGB(255, 200, 100))
        
        if batchTimeout[key] then
            batchTimeout[key] = tick()
        else
            batchTimeout[key] = tick()
        end
    end
    
    return true
end

function TDX:Sell(logicalID)
    local action = {
        type = "sell",
        logicalID = logicalID
    }
    queueAction(action)
    return true
end

function TDX:TimeScale(speed)
    if speed == CurrentSpeed then return true end
    local remote = getRemote("SoloToggleSpeedControl")
    if remote then
        if speed == 1 then
            remote:FireServer(false)
        elseif speed == 1.5 then
            remote:FireServer(true, true)
        elseif speed == 0.5 then
            remote:FireServer(true, false)
        else
            return false
        end
        CurrentSpeed = speed
        printToUI(string.format("⚡ Time scale: %dx", speed), Color3.fromRGB(100, 200, 255))
    end
    task.wait(0.5)
    return true
end

function TDX:AutoSkip(enabled)
    task.spawn(function()
        while enabled do
            local skip = getRemote("SkipWaveVoteCast")
            if skip then
                pcall(function() skip:FireServer(true) end)
            end
            task.wait(0.1)
        end
    end)
    printToUI(string.format("🔄 Auto-skip: %s", enabled and "ON" or "OFF"), Color3.fromRGB(100, 200, 255))
    return true
end

function TDX:GetCurrentSpeed()
    return CurrentSpeed
end

function TDX:WaitForGame()
    local r = ensureRemotes()
    return r and getRemote("PlaceTower") and getRemote("SellTower") and getRemote("TowerUpgradeRequest")
end

function TDX:ResetMappings()
    nextId = 1
    freeIds = {}
    partToId = {}
    upgradeBatchTracker = {}
    upgradeBuffer = {}
    batchTimeout = {}
    for id in pairs(towers) do
        towers[id] = nil
    end
    printToUI("🔄 Tower mappings reset", Color3.fromRGB(255, 200, 100))
end

function TDX:RemapAllTowers()
    self:ResetMappings()
end

function TDX:JoinMapViaAPC(mapName)
    local player = Players.LocalPlayer
    local level = 0
    local lvl = player and player.leaderstats and player.leaderstats:FindFirstChild("Level")
    if lvl then level = lvl.Value end
    
    for _ = 1, 60 do
        local apcs = Workspace:FindFirstChild("APCs")
        if apcs then
            for _, slot in ipairs(apcs:GetChildren()) do
                local attr = slot:GetAttribute("MapName") or ""
                if attr == mapName then
                    local detector = slot:FindFirstChild("Detector")
                    if not detector and slot:FindFirstChild("APC") then
                        detector = slot.APC:FindFirstChild("Detector")
                    end
                    if detector then
                        local char = player.Character
                        if char and char:FindFirstChild("HumanoidRootPart") then
                            char.HumanoidRootPart.CFrame = detector.CFrame
                            task.wait(2)
                            return true
                        end
                    end
                end
            end
        end
        if level >= 31 then
            local apcs2 = Workspace:FindFirstChild("APCs2")
            if apcs2 then
                for _, slot in ipairs(apcs2:GetChildren()) do
                    local attr = slot:GetAttribute("MapName") or ""
                    if attr == mapName then
                        local detector = slot:FindFirstChild("Detector")
                        if not detector and slot:FindFirstChild("APC") then
                            detector = slot.APC:FindFirstChild("Detector")
                        end
                        if detector then
                            local char = player.Character
                            if char and char:FindFirstChild("HumanoidRootPart") then
                                char.HumanoidRootPart.CFrame = detector.CFrame
                                task.wait(2)
                                return true
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.5)
    end
    return false
end

function TDX:VoteMap(map, attempts)
    attempts = attempts or 10
    for _ = 1, attempts do
        local vote = getRemote("MapVoteCast")
        if vote then
            vote:FireServer(map)
            task.wait(0.5)
            self:Ready()
            return true
        end
        local change = getRemote("MapChangeVoteCast")
        if change then
            change:FireServer(true)
        end
        task.wait(1)
    end
    return self:JoinMapViaAPC(map)
end

function TDX:RerollMaps()
    local change = getRemote("MapChangeVoteCast")
    if change then
        change:FireServer(true)
    end
    task.wait(0.5)
end

function TDX:Ready()
