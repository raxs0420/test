
local TDX = {}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

function TDX:VoteMap(mapName)
    Remotes.MapVoteCast:FireServer(mapName)
end

function TDX:Ready()
    Remotes.MapVoteReady:FireServer()
end

function TDX:VoteDifficulty(difficulty)
    Remotes.DifficultyVoteCast:FireServer(difficulty)
end

function TDX:SetLoadout(slot)
    Remotes.LoadoutSelectionChanged:FireServer(slot)
end

function TDX:Place(towerName, x, y, z, rotation)
    local args = {rotation or 0, towerName, Vector3.new(x, y, z), 0}
    return Remotes.PlaceTower:InvokeServer(unpack(args))
end

function TDX:Sell(towerId)
    Remotes.SellTower:FireServer(towerId)
end

function TDX:Upgrade(towerId, path, level)
    Remotes.TowerUpgradeRequest:FireServer(towerId, path, level)
end

function TDX:QuickSetup(config)
    if config.map then self:VoteMap(config.map) end
    if config.difficulty then self:VoteDifficulty(config.difficulty) end
    if config.loadout then self:SetLoadout(config.loadout) end
    task.wait(0.5)
    self:Ready()
end

return TDX