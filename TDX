-- Upgrade tower by name (with cash check)
function TDX:UpgradeByName(towerIdentifier, upgradeLevel, isBottom)
    local tower = self:FindTower(towerIdentifier)
    if not tower then
        warn(string.format("[TDX] Tower '%s' not found", tostring(towerIdentifier)))
        return false
    end
    
    if isBottom then
        return self:UpgradeBottom(tower.ID, upgradeLevel)
    else
        return self:Upgrade(tower.ID, upgradeLevel)
    end
end

-- Bulk place towers from array (with sequential cash checks)
function TDX:PlaceMultiple(towers, delayBetween)
    if type(towers) ~= "table" then
        warn("[TDX] Towers must be a table")
        return false
    end
    
    local successCount = 0
    local delay = delayBetween or 0.2
    
    for _, towerInfo in ipairs(towers) do
        if type(towerInfo) == "table" and #towerInfo >= 4 then
            local success = self:Place(towerInfo[1], towerInfo[2], towerInfo[3], towerInfo[4])
            if success then
                successCount = successCount + 1
            end
            task.wait(delay)
        end
    end
    
    print(string.format("[TDX] Placed %d/%d towers successfully", successCount, #towers))
    return successCount
end

-- Execute a command string with cash validation
function TDX:ExecuteCommand(commandString)
    local commandType, towerName, x, y, z, level, path
    
    -- Parse TDX:Place command
    if string.find(commandString, "TDX:Place%(") then
        towerName, x, y, z = string.match(commandString, 'TDX:Place%("([^"]+)",%s*([%d%.%-]+),%s*([%d%.%-]+),%s*([%d%.%-]+)')
        
        if towerName and x and y and z then
            return self:Place(towerName, tonumber(x), tonumber(y), tonumber(z))
        end
    
    -- Parse TDX:Upgrade command (top)
    elseif string.find(commandString, "TDX:Upgrade%(") then
        local towerID, level = string.match(commandString, "TDX:Upgrade%((%d+),%s*(%d+)")
        
        if towerID and level then
            return self:Upgrade(tonumber(towerID), tonumber(level))
        end
    
    -- Parse TDX:UpgradeBottom command
    elseif string.find(commandString, "TDX:UpgradeBottom%(") then
        local towerID, level = string.match(commandString, "TDX:UpgradeBottom%((%d+),%s*(%d+)")
        
        if towerID and level then
            return self:UpgradeBottom(tonumber(towerID), tonumber(level))
        end
    end
    
    warn("[TDX] Could not parse command:", commandString)
    return false
end

-- Get all tower data
function TDX:GetAllTowers()
    return TowerData
end

-- Get tower count
function TDX:GetTowerCount()
    local count = 0
    for _ in pairs(TowerData) do
        count = count + 1
    end
    return count
end

-- Export tower positions in recorder format with cost information
function TDX:ExportPositions()
    local exportText = "-- Tower Positions Export with Costs\n"
    exportText = exportText .. string.format("-- Generated: %s\n", os.date("%Y-%m-%d %H:%M:%S"))
    exportText = exportText .. string.format("-- Total Towers: %d\n", self:GetTowerCount())
    exportText = exportText .. string.format("-- Current Cash: $%d\n\n", CurrentCash)
    
    for id, data in pairs(TowerData) do
        local x = math.floor(data.Position.X * 100) / 100
        local y = math.floor(data.Position.Y * 100) / 100
        local z = math.floor(data.Position.Z * 100) / 100
        
        local cost = self:GetTowerCost(data.Type)
        
        exportText = exportText .. string.format('TDX:Place("%s", %.2f, %.2f, %.2f) -- ID: %d, Cost: $%d\n',
            data.Path, x, y, z, id, cost)
    end
    
    return exportText
end

-- Import and execute commands from text with cash validation
function TDX:ImportFromText(text, executeImmediately)
    local commands = {}
    local parseCount = 0
    
    for line in string.gmatch(text, "[^\r\n]+") do
        if string.find(line, "TDX:Place%(") then
            local towerName, x, y, z = string.match(line, 'TDX:Place%("([^"]+)",%s*([%d%.%-]+),%s*([%d%.%-]+),%s*([%d%.%-]+)')
            
            if towerName and x and y and z then
                table.insert(commands, {
                    towerName,
                    tonumber(x),
                    tonumber(y),
                    tonumber(z)
                })
                parseCount = parseCount + 1
            end
        end
    end
    
    print(string.format("[TDX] Parsed %d commands from text", parseCount))
    
    if executeImmediately and #commands > 0 then
        return self:PlaceMultiple(commands)
    end
    
    return commands
end

-- Initialize the library
TDX:Init()

return TDX
