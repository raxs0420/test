-- TDX Tower Control Library
-- Version 2.0 with Cash Tracking
local TDX = {}

-- Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Remote references
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local PlaceTowerRemote = Remotes:WaitForChild("PlaceTower")
local UpgradeTowerRemote = Remotes:WaitForChild("TowerUpgradeRequest")

-- Tower and cost tracking
local TowerInstances = {}
local TowerData = {}
local CurrentCash = 0
local CashObject = nil
local IsMonitoringCash = false

-- Tower cost configuration (adjust these values as needed)
local TowerCosts = {
    -- Placeholder costs - replace with actual game values
    ["Golden Ranger"] = 1000,
    ["Sniper"] = 800,
    ["Dart Monkey"] = 200,
    ["Tack Shooter"] = 280,
    ["Ice Monkey"] = 500,
    ["Bomb Tower"] = 700,
    ["Super Monkey"] = 2500,
    ["Ninja Monkey"] = 540,
    ["Alchemist"] = 600,
    ["Druid"] = 425,
    -- Add more tower types as needed
}

-- Upgrade costs per level (top/bottom paths)
local UpgradeCosts = {
    -- Format: {TopCost, BottomCost} for each level
    [1] = {250, 250},   -- Level 1
    [2] = {500, 500},   -- Level 2
    [3] = {1000, 1000}, -- Level 3
    [4] = {2000, 2000}, -- Level 4
    [5] = {5000, 5000}, -- Level 5
}

-- Initialize the TDX library
function TDX:Init()
    print("[TDX] Library initialized")
    
    -- Start cash monitoring
    self:StartCashMonitoring()
    
    -- Monitor workspace for towers
    self:MonitorTowers()
    
    return self
end

-- Start monitoring player's cash
function TDX:StartCashMonitoring()
    if IsMonitoringCash then return end
    
    IsMonitoringCash = true
    
    local function updateCash()
        -- Find leaderstats and cash
        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        if leaderstats then
            local cashObj = leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Money")
            if cashObj then
                CashObject = cashObj
                CurrentCash = cashObj.Value or 0
            end
        end
    end
    
    -- Initial update
    updateCash()
    
    -- Monitor for leaderstats creation
    if not LocalPlayer:FindFirstChild("leaderstats") then
        LocalPlayer.ChildAdded:Connect(function(child)
            if child.Name == "leaderstats" then
                task.wait(0.5)
                updateCash()
            end
        end)
    end
    
    -- Monitor cash value changes
    RunService.Heartbeat:Connect(function()
        if CashObject and CashObject:IsA("NumberValue") then
            CurrentCash = CashObject.Value
        end
    end)
    
    print("[TDX] Cash monitoring started")
end

-- Get current cash amount
function TDX:GetCash()
    return CurrentCash
end

-- Check if player has enough cash
function TDX:HasEnoughCash(amount)
    return CurrentCash >= amount
end

-- Set tower cost (can be called dynamically)
function TDX:SetTowerCost(towerType, cost)
    if type(towerType) ~= "string" or type(cost) ~= "number" then
        warn("[TDX] Invalid tower cost parameters")
        return false
    end
    
    TowerCosts[towerType] = cost
    print(string.format("[TDX] Set %s cost to $%d", towerType, cost))
    return true
end

-- Set upgrade cost for a level
function TDX:SetUpgradeCost(level, topCost, bottomCost)
    if type(level) ~= "number" or level < 1 or level > 5 then
        warn("[TDX] Upgrade level must be between 1-5")
        return false
    end
    
    UpgradeCosts[level] = {topCost or 0, bottomCost or 0}
    print(string.format("[TDX] Set level %d upgrade costs: Top $%d, Bottom $%d", 
        level, topCost, bottomCost))
    return true
end

-- Get tower placement cost
function TDX:GetTowerCost(towerType)
    return TowerCosts[towerType] or 0
end

-- Get upgrade cost
function TDX:GetUpgradeCost(level, isBottom)
    if not UpgradeCosts[level] then
        return 0
    end
    
    if isBottom then
        return UpgradeCosts[level][2] or 0
    else
        return UpgradeCosts[level][1] or 0
    end
end

-- Monitor workspace.Game.Towers for changes
function TDX:MonitorTowers()
    local function scanTowers()
        local gameFolder = Workspace:FindFirstChild("Game")
        if not gameFolder then return end
        
        local towersFolder = gameFolder:FindFirstChild("Towers")
        if not towersFolder then return end
        
        -- Clear existing data
        TowerInstances = {}
        TowerData = {}
        
        -- Scan all towers
        self:ScanFolder(towersFolder, "")
    end
    
    -- Initial scan
    task.spawn(scanTowers)
    
    -- Set up monitoring
    local gameFolder = Workspace:WaitForChild("Game", 10)
    if gameFolder then
        gameFolder:GetPropertyChangedSignal("ChildAdded"):Connect(function(child)
            if child.Name == "Towers" then
                scanTowers()
            end
        end)
        
        local towersFolder = gameFolder:WaitForChild("Towers", 5)
        if towersFolder then
            towersFolder.ChildAdded:Connect(function(child)
                task.wait(0.2)
                self:ScanObject(child, child.Name)
            end)
            
            towersFolder.ChildRemoved:Connect(function(child)
                self:RemoveTower(child)
            end)
        end
    end
end

-- Recursively scan folder for towers
function TDX:ScanFolder(folder, parentPath)
    for _, child in ipairs(folder:GetChildren()) do
        local path = parentPath .. (parentPath ~= "" and "." or "") .. child.Name
        
        if child:IsA("Model") or child:IsA("BasePart") then
            self:RegisterTower(child, path)
        elseif child:IsA("Folder") then
            self:ScanFolder(child, path)
        end
    end
end

-- Register a tower in the system
function TDX:RegisterTower(obj, path)
    if TowerInstances[obj] then return end
    
    local position = self:GetObjectPosition(obj)
    if not position then return end
    
    -- Generate ID based on position and name
    local id = #TowerData + 1
    local towerName = obj.Name
    
    TowerInstances[obj] = {
        ID = id,
        Path = path,
        Position = position,
        Type = towerName
    }
    
    TowerData[id] = {
        Instance = obj,
        ID = id,
        Position = position,
        Path = path,
        Type = towerName
    }
    
    -- Store reference in the object for easy retrieval
    obj:SetAttribute("TDX_ID", id)
    
    return id
end

-- Remove a tower from tracking
function TDX:RemoveTower(obj)
    local data = TowerInstances[obj]
    if data then
        TowerData[data.ID] = nil
        TowerInstances[obj] = nil
    end
end

-- Get position of an object
function TDX:GetObjectPosition(obj)
    if obj:IsA("Model") then
        local primaryPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if primaryPart then
            return primaryPart.Position
        end
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

-- Find tower by ID, name, or path
function TDX:FindTower(identifier)
    if type(identifier) == "number" then
        return TowerData[identifier]
    elseif type(identifier) == "string" then
        for _, data in pairs(TowerData) do
            if data.Path == identifier then
                return data
            end
        end
        
        for _, data in pairs(TowerData) do
            if string.find(data.Type, identifier) or string.find(data.Path, identifier) then
                return data
            end
        end
    end
    return nil
end

-- Place a tower at specified position (with cash check)
function TDX:Place(towerType, x, y, z)
    local towerName, position
    
    if type(towerType) == "table" then
        towerName = towerType
        position = Vector3.new(x, y, z)
    else
        towerName = towerType
        position = x
    end
    
    if typeof(position) ~= "Vector3" then
        if type(x) == "number" and type(y) == "number" and type(z) == "number" then
            position = Vector3.new(x, y, z)
        else
            warn("[TDX] Invalid position provided")
            return false
        end
    end
    
    -- Check tower cost
    local cost = self:GetTowerCost(towerName)
    if cost <= 0 then
        warn(string.format("[TDX] No cost configured for tower: %s", towerName))
        -- Continue anyway, but log warning
    end
    
    -- Check if player has enough cash
    if not self:HasEnoughCash(cost) then
        warn(string.format("[TDX] Insufficient cash! Need $%d, have $%d", cost, CurrentCash))
        return false
    end
    
    local args = {
        139.87838023900258,
        towerName,
        position,
        0
    }
    
    print(string.format("[TDX] Placing %s at %s (Cost: $%d, Cash: $%d)", 
        towerName, tostring(position), cost, CurrentCash))
    
    local success, result = pcall(function()
        return PlaceTowerRemote:InvokeServer(unpack(args))
    end)
    
    if success then
        print("[TDX] Tower placed successfully!")
        return true
    else
        warn("[TDX] Failed to place tower:", result)
        return false
    end
end

-- Upgrade a tower (top path with cash check)
function TDX:Upgrade(towerID, upgradeLevel)
    if not towerID or not upgradeLevel then
        warn("[TDX] Upgrade requires tower ID and upgrade level")
        return false
    end
    
    local tower = self:FindTower(towerID)
    if not tower then
        warn(string.format("[TDX] Tower with ID %d not found", towerID))
        return false
    end
    
    -- Check upgrade cost
    local cost = self:GetUpgradeCost(upgradeLevel, false)
    if cost <= 0 then
        warn(string.format("[TDX] No cost configured for upgrade level %d", upgradeLevel))
    end
    
    -- Check if player has enough cash
    if not self:HasEnoughCash(cost) then
        warn(string.format("[TDX] Insufficient cash for upgrade! Need $%d, have $%d", cost, CurrentCash))
        return false
    end
    
    local args = {
        towerID,
        upgradeLevel,
        1 -- Top path
    }
    
    print(string.format("[TDX] Upgrading tower ID %d to level %d (top) (Cost: $%d, Cash: $%d)", 
        towerID, upgradeLevel, cost, CurrentCash))
    
    local success, result = pcall(function()
        return UpgradeTowerRemote:FireServer(unpack(args))
    end)
    
    if success then
        print("[TDX] Tower upgraded successfully!")
        return true
    else
        warn("[TDX] Failed to upgrade tower:", result)
        return false
    end
end

