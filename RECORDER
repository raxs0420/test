old_namecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if _G.record_strat and (method == "InvokeServer" or method == "FireServer") then
        local args_string = ""
        for i, arg in ipairs(args) do
            args_string = args_string .. tostring(arg) .. " "
        end
        
        if args_string:find("Upgrade") then
            local action_data = args[4] or args[3]
            if action_data and action_data.Troop then
                local tower_id = towers_list[action_data.Troop]
                if tower_id then
                    record_action(string.format("TDS:Upgrade(%d)", tower_id))
                    add_log(string.format("Upgraded ID: %d", tower_id))
                end
            end
            
        elseif args_string:find("Sell") then
            local action_data = args[3]
            if action_data and action_data.Troop then
                local tower_id = towers_list[action_data.Troop]
                if tower_id then
                    record_action(string.format("TDS:Sell(%d)", tower_id))
                    add_log(string.format("Sold ID: %d", tower_id))
                    local tower_obj = action_data.Troop
                    towers_list[tower_obj] = nil
                    tower_id_map[tower_id] = nil
                end
            end
            
        elseif args_string:find("Target") then
            local action_data = args[4]
            if type(action_data) == "table" and action_data.Troop then
                local tower_id = towers_list[action_data.Troop]
                if tower_id then
                    record_action(string.format('TDS:SetTarget(%d, "%s")', tower_id, tostring(action_data.Target)))
                    add_log(string.format("Target ID: %d -> %s", tower_id, tostring(action_data.Target)))
                end
            end
            
        elseif args_string:find("Option") then
            local action_data = args[4]
            if type(action_data) == "table" and action_data.Troop then
                local tower_id = towers_list[action_data.Troop]
                if tower_id then
                    record_action(string.format('TDS:SetOption(%d, "%s", "%s")', tower_id, tostring(action_data.Name), tostring(action_data.Value)))
                    add_log(string.format("Option ID: %d -> %s = %s", tower_id, tostring(action_data.Name), tostring(action_data.Value)))
                end
            end
            
        elseif args_string:find("Skip") then
            record_action("TDS:Skip()")
            add_log("Skipped wave")
        end
    end
    
    return old_namecall(self, ...)
end)

workspace_service.Towers.ChildAdded:Connect(function(tower_folder)
    if not _G.record_strat then return end
    
    local replicator = tower_folder:FindFirstChild("TowerReplicator")
    if not replicator then
        replicator = tower_folder:WaitForChild("TowerReplicator", 2)
        if not replicator then return end
    end
    
    for i = 1, 10 do
        local owner = replicator:GetAttribute("OwnerId")
        local name = replicator:GetAttribute("Name")
        if owner and name then break end
        task.wait(0.1)
    end
    
    local owner_id = replicator:GetAttribute("OwnerId")
    local tower_name = replicator:GetAttribute("Name")
    
    if owner_id and tostring(owner_id) == tostring(player.UserId) and tower_name then
        placement_count = placement_count + 1
        local tower_id = placement_count
        towers_list[tower_folder] = tower_id
        tower_id_map[tower_id] = tower_folder
        tower_folder.Name = tostring(tower_id)
        
        local pos = tower_folder:GetPivot().Position
        local x = pos.X + get_random_offset()
        local z = pos.Z + get_random_offset()
        
        x = tonumber(string.format("%.6f", x))
        z = tonumber(string.format("%.6f", z))
        
        
        record_action(string.format('TDS:Place("%s", %.6f, 60, %.6f)', tower_name, x, z))
        add_log(string.format("Placed %s [ID: %d] at (%.1f, 60, %.1f)", tower_name, tower_id, x, z))
    end
end)


local function find_tower_by_id(id)
    local target_id = tonumber(id)
    if not target_id then return nil end
    
    if tower_id_map[target_id] then
        local tower = tower_id_map[target_id]
        if tower and tower.Parent then
            return tower
        else
            tower_id_map[target_id] = nil
        end
    end
    
    local towers_folder = workspace_service:FindFirstChild("Towers")
    if towers_folder then
        for _, tower in ipairs(towers_folder:GetChildren()) do
            if tower.Name == tostring(target_id) then
                tower_id_map[target_id] = tower
                return tower
            end
        end
    end
    
    return nil
end

local function execute_place_command(tower_name, x, y, z)
    add_play_log(string.format("Placing %s at (%.1f, %.1f, %.1f)", tower_name, x, y, z))
    local success, result = pcall(function()
        return remote_function:InvokeServer("Troops", "Pl\208\176ce", {
            Rotation = CFrame.new(),
            Position = Vector3.new(x, y, z)
        }, tower_name)
    end)
    if success then
        add_play_log(string.format("✓ Placed %s", tower_name))
        task.wait(0.3)
        
        local towers_folder = workspace_service:FindFirstChild("Towers")
        if towers_folder then
            for _, tower in ipairs(towers_folder:GetChildren()) do
                local replicator = tower:FindFirstChild("TowerReplicator")
                if replicator and replicator:GetAttribute("OwnerId") == player.UserId then
                    local found = false
                    for existing_tower, _ in pairs(towers_list) do
                        if existing_tower == tower then
                            found = true
                            break
                        end
                    end
                    if not found then
                        placement_count = placement_count + 1
                        local new_id = placement_count
                        towers_list[tower] = new_id
                        tower_id_map[new_id] = tower
                        tower.Name = tostring(new_id)
                        add_play_log(string.format("Tracked new tower as ID: %d", new_id))
                        break
                    end
                end
            end
        end
        return true
    else
        add_play_log(string.format("✗ Failed to place %s", tower_name))
        return false
    end
end

local function execute_upgrade_command(id)
    add_play_log(string.format("Upgrading ID: %s", id))
    local tower = find_tower_by_id(id)
    if tower then
        local replicator = tower:FindFirstChild("TowerReplicator")
        local current_level = replicator and replicator:GetAttribute("Upgrade") or 0
        add_play_log(string.format("Current level: %d", current_level))
        
        local success, result = pcall(function()
            return remote_function:InvokeServer("Troops", "Upgrade", "Set", {
                Troop = tower,
                Path = 1
            })
        end)
        if success then
            add_play_log(string.format("✓ Upgraded ID: %s", id))
            return true
        else
            add_play_log(string.format("✗ Upgrade failed for ID: %s", id))
        end
    else
        add_play_log(string.format("✗ Tower ID %s not found", id))
        local towers_folder = workspace_service:FindFirstChild("Towers")
        if towers_folder then
            local available = {}
            for _, tower in ipairs(towers_folder:GetChildren()) do
                local replicator = tower:FindFirstChild("TowerReplicator")
                if replicator and replicator:GetAttribute("OwnerId") == player.UserId then
                    table.insert(available, tower.Name)
                end
            end
            if #available > 0 then
                add_play_log(string.format("Available tower IDs: %s", table.concat(available, ", ")))
            end
        end
    end
    return false
end

local function execute_sell_command(id)
    add_play_log(string.format("Selling ID: %s", id))
    local tower = find_tower_by_id(id)
    if tower then
        local success, result = pcall(function()
            return remote_function:InvokeServer("Troops", "Sell", { Troop = tower })
        end)
        if success then
            add_play_log(string.format("✓ Sold ID: %s", id))
            towers_list[tower] = nil
            tower_id_map[tonumber(id)] = nil
            return true
        else
            add_play_log(string.format("✗ Sell failed for ID: %s", id))
        end
    else
        add_play_log(string.format("✗ Tower ID %s not found", id))
    end
    return false
end

