local function parse_and_execute_command(line)
    if line:match("Place%(") then
        local tower_name = line:match('"([^"]+)"')
        local x, y, z = line:match("([%d%.%-]+),%s*([%d%.%-]+),%s*([%d%.%-]+)")
        if tower_name and x and y and z then
            return execute_place_command(tower_name, tonumber(x), tonumber(y), tonumber(z))
        end
        
    elseif line:match("Upgrade%(") then
        local id = line:match("Upgrade%((%d+)%)")
        if id then return execute_upgrade_command(id) end
        
    elseif line:match("Sell%(") then
        local id = line:match("Sell%((%d+)%)")
        if id then return execute_sell_command(id) end
        
    elseif line:match("SetTarget%(") then
        local id, target = line:match("SetTarget%((%d+),%s*\"([^\"]+)\"%)")
        if id and target then return execute_target_command(id, target) end
        
    elseif line:match("SetOption%(") then
        local id, opt_name, opt_value = line:match("SetOption%((%d+),%s*\"([^\"]+)\",%s*\"([^\"]+)\"%)")
        if id and opt_name and opt_value then return execute_option_command(id, opt_name, opt_value) end
        
    elseif line:match("Skip%(") then
        return execute_skip_command()
    end
    
    return false
end

local function load_script_file()
    if readfile then
        local success, content = pcall(function()
            return readfile(file_name)
        end)
        
        if success and content then
            loaded_commands = {}
            for line in content:gmatch("[^\r\n]+") do
                line = line:gsub("^%s+", ""):gsub("%s+$", "")
                if line:match("Place%(") or line:match("Upgrade%(") or line:match("Sell%(") or 
                   line:match("SetTarget%(") or line:match("SetOption%(") or line:match("Skip%(") then
                    table.insert(loaded_commands, line)
                end
            end
            script_name_label.Text = file_name
            script_name_label.TextColor3 = Color3.fromRGB(100, 255, 100)
            add_play_log(string.format("Loaded %d commands from %s", #loaded_commands, file_name))
            return true
        else
            add_play_log("Failed to load script file")
            return false
        end
    else
        add_play_log("No file read permission")
        return false
    end
end

local function play_strat()
    if #loaded_commands == 0 then
        add_play_log("No commands loaded. Load a script first.")
        return
    end
    
    if playback_running then
        add_play_log("Playback already running!")
        return
    end
    
    placement_count = 0
    towers_list = {}
    tower_id_map = {}
    
    playback_running = true
    playback_cancel = false
    
    add_play_log("Starting strat execution...")
    
    for i, command in ipairs(loaded_commands) do
        if playback_cancel then
            add_play_log("Playback cancelled by user")
            break
        end
        
        add_play_log(string.format("[%d/%d] Executing: %s", i, #loaded_commands, command))
        parse_and_execute_command(command)
        task.wait(0.15)
    end
    
    add_play_log("Strat execution completed!")
    playback_running = false
end

