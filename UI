        sliderLabel.Text = "Mercenary Distance: " .. tostring(math.floor(_G.MercDistance)) .. " / " .. math.floor(currentMaxDistance) .. " studs"
        local percent = math.clamp(_G.MercDistance / currentMaxDistance, 0, 1)
        sliderFill.Size = UDim2.new(percent, 0, 1, 0)
        task.wait()
        if sliderFrame.AbsoluteSize.X > 0 then
            local buttonPosX = math.clamp(percent * sliderFrame.AbsoluteSize.X - sliderButton.AbsoluteSize.X/2, 0, sliderFrame.AbsoluteSize.X - sliderButton.AbsoluteSize.X)
            sliderButton.Position = UDim2.new(0, buttonPosX, 0.5, -sliderButton.AbsoluteSize.Y/2)
