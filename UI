function SC.findAnimFromTrack(state, originalTrack)
    if not (state and state.clone and originalTrack) then return nil end
    local oAnim
    pcall(function() oAnim = originalTrack.Animation end)
    if oAnim then
        local direct = SC.findDesc(state, oAnim)
        if direct and direct:IsA("Animation") then return direct end
    end
    local tName = tostring(originalTrack.Name or "")
    local pName = oAnim and oAnim.Parent and oAnim.Parent.Name or nil
    local best, bestScore = nil, -1
    for _, d in ipairs(state.clone:GetDescendants()) do
        if d:IsA("Animation") then
            local score = 0
            if d.Name == tName then score += 100 end
            if oAnim and d.Name == oAnim.Name then score += 120 end
            if pName and d.Parent and d.Parent.Name == pName then score += 40 end
            if score > bestScore then best, bestScore = d, score end
