        error(result)
    end
    entity._createTrap = wrapped
    state.connections = state.connections or {}
    table.insert(state.connections, {
        Disconnect = function()
            if entity and entity._createTrap == wrapped then entity._createTrap = original end
            if entity and rawget(entity, "__skinOrigCreateTrap") == original then
