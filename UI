    local function safeRequire(module, timeout)
        local finished, result = false, nil
        local co = coroutine.create(function()
            local ok, res = pcall(require, module)
            if ok then result = res end
            finished = true
        end)
        coroutine.resume(co)
        local start = tick()
        while not finished and tick() - start < timeout do task.wait(0.05) end
        return result
    end

