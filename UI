local function updateTowerButtons(container)
    if not container then return end

    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local towersByTypeLevel = {}
    local towersFolder = Workspace:FindFirstChild("Towers")

    if not towersFolder then
        return
    end

    for _, towerFolder in ipairs(towersFolder:GetChildren()) do
        local replicator = towerFolder:FindFirstChild("TowerReplicator")
        if replicator then
            local towerName = replicator:GetAttribute("Name")
            local ownerId = replicator:GetAttribute("OwnerId")
            local upgradeLevel = replicator:GetAttribute("Upgrade") or 0

            if ownerId and tostring(ownerId) == tostring(player.UserId) and towerName then
                local key = towerName .. "_" .. tostring(upgradeLevel)
                if not towersByTypeLevel[key] then
                    towersByTypeLevel[key] = {
                        name = towerName,
                        level = upgradeLevel,
                        count = 0,
                        folders = {},
                        key = key
                    }
                end
                towersByTypeLevel[key].count = towersByTypeLevel[key].count + 1
                table.insert(towersByTypeLevel[key].folders, towerFolder)
            end
        end
    end

    local sortedTowers = {}
    for key, data in pairs(towersByTypeLevel) do
        table.insert(sortedTowers, data)
    end
    table.sort(sortedTowers, function(a, b)
        if a.name == b.name then
            return a.level < b.level
        end
        return a.name < b.name
    end)

    local yPos = 0
    local btnHeight = Library:ScaleY(4)

    local selectedStillExists = false
    if selectedTowerKey then
        for _, towerData in ipairs(sortedTowers) do
            if towerData.key == selectedTowerKey then
                selectedStillExists = true
                selectedTowerData = towerData
                break
            end
        end
        if not selectedStillExists then
            clearTowerSelection()
        end
    end

    for index, towerData in ipairs(sortedTowers) do
        local towerBtn = Instance.new("TextButton")
        towerBtn.Size = UDim2.new(1, -Library:ScaleX(2), 0, btnHeight)
        towerBtn.Position = UDim2.new(0, Library:ScaleX(1), 0, yPos)

        if index % 2 == 0 then
            towerBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
        else
            towerBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
        end

        if towerData.count > 1 then
            towerBtn.Text = string.format("L%s.%s (%d)", tostring(towerData.level), towerData.name, towerData.count)
        else
            towerBtn.Text = string.format("L%s.%s", tostring(towerData.level), towerData.name)
        end

        towerBtn.TextColor3 = Library.Colors.Text
        towerBtn.TextSize = Library:ScaleY(1.2)
        towerBtn.Font = Library.Fonts.Normal
        towerBtn.Parent = container
        towerBtn.AutoButtonColor = false

        Library:AddCorner(towerBtn, 4)
        Library:AddStroke(towerBtn, 1, Library.Colors.Border)

        towerBtn:SetAttribute("TowerKey", towerData.key)
        towerBtn:SetAttribute("TowerName", towerData.name)
        towerBtn:SetAttribute("TowerLevel", towerData.level)
        towerBtn:SetAttribute("TowerCount", towerData.count)
        towerBtn:SetAttribute("OriginalColor", towerBtn.BackgroundColor3)

        if selectedTowerKey == towerData.key then
            towerBtn.BackgroundColor3 = Library.Colors.Success
        end

        towerBtn.MouseButton1Click:Connect(function()
            if selectedTowerKey == towerData.key then
                clearTowerSelection()
                towerBtn.BackgroundColor3 = towerBtn:GetAttribute("OriginalColor")
            else
                for _, btn in ipairs(container:GetChildren()) do
                    if btn:IsA("TextButton") and btn:GetAttribute("OriginalColor") then
                        btn.BackgroundColor3 = btn:GetAttribute("OriginalColor")
                    end
                end
                selectedTowerKey = towerData.key
                selectedTowerData = towerData
                towerBtn.BackgroundColor3 = Library.Colors.Success

                if contentFrames["SWITCHER"] and contentFrames["SWITCHER"].Visible then
                    if lastSelectedSlot then
                        slotFilled[lastSelectedSlot] = true
                        slotNames[lastSelectedSlot] = towerData.name
                        slotButtons[lastSelectedSlot].BackgroundColor3 = Library.Colors.Success
                        slotButtons[lastSelectedSlot].Text = towerData.name
                        slotButtons[lastSelectedSlot].TextColor3 = Library.Colors.Text
                        slotButtons[lastSelectedSlot].BackgroundColor3 = Color3.fromRGB(0, 100, 0)
