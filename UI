function SC.getInfoSkin(info)
    if not info then return nil end
    if info.forcedSkinName then
        if info.sourceKind ~= "Unit"
            and not SC.supportsTower(info.forcedTowerName or info.name) then
            return nil
        end
        return tostring(info.forcedSkinName),
            tostring(info.forcedTowerName or info.sourceName or info.name or "")
    end
    if not SC.supportsTower(info.name) then return nil end
    local cands, seen = {}, {}
    local function add(v)
        if type(v) ~= "string" or v == "" or v == "Default" then return end
        if not seen[v] then seen[v] = true; table.insert(cands, v) end
    end
    add(info.name)
    local entity = info.entity
    if type(entity) == "table" then
        add(entity.TowerName); add(entity.Name)
        if type(entity.State) == "table" then add(entity.State.Type); add(entity.State.Name) end
        pcall(function() add(entity.Replicator and entity.Replicator:Get("Name")) end)
        pcall(function() add(entity.Replicator and entity.Replicator:Get("Type")) end)
    end
    local model = info.model
    if model then
        add(model:GetAttribute("TowerName")); add(model:GetAttribute("Type")); add(model:GetAttribute("DisplayName"))
        local trep = model:FindFirstChild("TowerReplicator")
        if trep then
            add(trep:GetAttribute("TowerName"))
            add(trep:GetAttribute("Name"))
            add(trep:GetAttribute("Type"))
        end
    end
    for _, tn in ipairs(cands) do
        local saved = SC.getSavedSkin(tn)
        if saved and SC.skinExists(tn, saved) then return saved, tn end
    end
    local sels = SC.getSelections()
    for st, saved in pairs(sels) do
        local sk = SC.key(st)
        for _, tn in ipairs(cands) do
            if sk == SC.key(tn) and SC.skinExists(st, saved) then
                return saved, st
            end
        end
    end
    return nil
end
function SC.buildSyncMaps(state)
