    return nil
end
function SC.findAnimForLevel(group, level, path)
    if not group then return nil end
    if group:IsA("Animation") then return group end
    level = math.max(0, math.floor(tonumber(level) or 0))
    path = math.max(0, math.floor(tonumber(path) or 0))
    local pc = path > 0 and string.char(96 + math.clamp(path, 1, 26)) or nil
    local best = nil
    for i = 0, level do
        local names = { tostring(i) }
        if pc then
            table.insert(names, 1, tostring(i) .. pc)
            table.insert(names, 2, tostring(i) .. "_" .. tostring(path))
            table.insert(names, 3, tostring(i) .. "-" .. tostring(path))
        end
        for _, name in ipairs(names) do
            local anim = SC.findFirstAnim(group:FindFirstChild(name))
            if anim then best = anim end
        end
    end
    return best or SC.findFirstAnim(group)
end
function SC.getCloneTrack(state, animName)
