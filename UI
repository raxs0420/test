function SC.findMatchSound(state, original)
    if not (state and state.clone and original and original:IsA("Sound")) then return nil end
    local direct = SC.findDesc(state, original)
    if direct and direct:IsA("Sound") then return direct end
    local oRoles = SC.soundRolesOf(original)
    local oName = SC.key(original.Name)
    local oParent = original.Parent and SC.key(original.Parent.Name) or ""
    local best, bestScore = nil, -1
    for _, cand in ipairs(state.clone:GetDescendants()) do
        if cand:IsA("Sound") and tostring(cand.SoundId or "") ~= "" then
            local score = 0
            local cName = SC.key(cand.Name)
            local cParent = cand.Parent and SC.key(cand.Parent.Name) or ""
            if cName == oName then score += 150 end
            if cParent ~= "" and cParent == oParent then score += 45 end
            local cRoles = SC.soundRolesOf(cand)
            for role in pairs(oRoles) do
                if cRoles[role] then score += 70 end
            end
            if score > bestScore then best, bestScore = cand, score end
        end
    end
    return bestScore >= 70 and best or nil
end
