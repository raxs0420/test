function SC.findUnitSkinFuzzy(unitName, skinName)
    local skins = SC.getUnitSkinsFolder(unitName)
    if not skins then return nil end
    local wanted = SC.key(skinName)
    if wanted == "" then return nil end
    local best, bestScore = nil, -1
    for _, child in ipairs(skins:GetChildren()) do
        local k = SC.key(child.Name)
        if k ~= "" and k ~= "default" then
            local score = 0
            if k == wanted then score = 100 end
            if string.find(wanted, k, 1, true) then score = math.max(score, 50) end
            if string.find(k, wanted, 1, true) then score = math.max(score, 45) end
            if score > bestScore then best, bestScore = child, score end
        end
    end
    return bestScore > 0 and best or nil
end
function SC.unitNameScore(unitName, sourceName)
    local wanted = SC.key(unitName)
    local k = SC.key(sourceName)
    if wanted == "" or k == "" then return 0 end
    if k == wanted then return 220 end
    if string.find(k, wanted, 1, true) then return 120 end
    if string.find(wanted, k, 1, true) then return 95 end
    if string.find(wanted, "goon", 1, true) and string.find(k, "goon", 1, true) then return 85 end
    if string.find(wanted, "humvee", 1, true) and string.find(k, "humvee", 1, true) then return 85 end
    if string.find(wanted, "tank", 1, true) and string.find(k, "tank", 1, true) then return 85 end
    if string.find(wanted, "sentry", 1, true) and string.find(k, "sentry", 1, true) then return 85 end
    if string.find(wanted, "mark", 1, true) and string.find(k, "mark", 1, true) then return 85 end
    return 0
end
function SC.containerBonus(inst)
    local score = 0
    local cur = inst and inst.Parent
    local depth = 0
    while cur and depth < 5 do
        if SC.unitContainerKeys[SC.key(cur.Name)] then score += 45 end
        cur = cur.Parent
        depth += 1
    end
    return score
end
function SC.findUnitInOwnerSkin(ownerTowerName, ownerSkinName, unitName)
    ownerTowerName = tostring(ownerTowerName or "")
