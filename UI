local function scheduleUpdate(container)
    if not updateScheduled then
        updateScheduled = true
        task.spawn(function()
            task.wait(0.1)
            updateTowerButtons(container)
            updateScheduled = false
        end)
    end
end

local function startPeriodicRefresh()
    task.spawn(function()
        while periodicRefreshEnabled do
            task.wait(2)

            if contentFrames["MANAGER"] and contentFrames["MANAGER"].Visible and currentManagerScrollFrame then
                updateTowerButtons(currentManagerScrollFrame)
            end
        end
    end)
end

local function setupTowerUpdates(scrollFrame)
    local towersFolder = Workspace:FindFirstChild("Towers")
    if towersFolder then
        local function onTowerChange()
            scheduleUpdate(scrollFrame)
        end

        local addedConnection = towersFolder.ChildAdded:Connect(onTowerChange)
        table.insert(towerConnections, addedConnection)

        local removedConnection = towersFolder.ChildRemoved:Connect(onTowerChange)
        table.insert(towerConnections, removedConnection)

        local function setupReplicatorConnections(folder)
            local replicator = folder:FindFirstChild("TowerReplicator")
            if replicator then
                local upgradeConnection = replicator:GetAttributeChangedSignal("Upgrade"):Connect(onTowerChange)
                table.insert(towerConnections, upgradeConnection)

                local nameConnection = replicator:GetAttributeChangedSignal("Name"):Connect(onTowerChange)
                table.insert(towerConnections, nameConnection)

                local ownerConnection = replicator:GetAttributeChangedSignal("OwnerId"):Connect(onTowerChange)
                table.insert(towerConnections, ownerConnection)
            end
        end

        for _, towerFolder in ipairs(towersFolder:GetChildren()) do
            setupReplicatorConnections(towerFolder)
        end

        local childAddedConnection = towersFolder.ChildAdded:Connect(function(newFolder)
            task.wait(0.1)
            setupReplicatorConnections(newFolder)
        end)
        table.insert(towerConnections, childAddedConnection)
    end
end

local function flashButton(button, color, text)
    local originalColor = button.BackgroundColor3
    local originalText = button.Text
    button.BackgroundColor3 = color
    if text then
        button.Text = text
    end
    task.wait(0.2)
    if button.Text == text or text == nil then
        button.BackgroundColor3 = originalColor
        if text then
            button.Text = originalText
        end
    end
end

