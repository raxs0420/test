                    if container then
                        local valueLabel = container:FindFirstChild("value")
                        if valueLabel and valueLabel:IsA("TextLabel") then
                            local text = valueLabel.Text
                            local parts = {}
                            for part in string.gmatch(text, "[^/]+") do table.insert(parts, part) end
                            if #parts == 2 then
                                local maxWave = tonumber(parts[2]:match("%d+"))
                                if maxWave then return maxWave end
                            end
                        end
                    end
                end
            end
        end
        return 0
    end

