function SC.installSource(towerName, skinName, source)
    towerName = tostring(towerName or "")
    skinName = tostring(skinName or "Default")
    if towerName == "" or skinName == "" or skinName == "Default" then return source end
    if not (source and source.Parent) then return source end
    local troops = SC.getContentTroops()
    if not troops then
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        troops = assets and assets:FindFirstChild("Troops")
    end
    local tower = troops and troops:FindFirstChild(towerName)
    local skins = tower and tower:FindFirstChild("Skins")
    if not skins then return source end
    local ex = skins:FindFirstChild(skinName)
    if ex then return ex end
    local ok, clone = pcall(function() return source:Clone() end)
    if not ok or not clone then return source end
    clone.Name = skinName
    clone.Parent = skins
    return clone
end
function SC.requestSourceAsync(towerName, skinName, key)
    if SC.sourcePending[key] then return end
    SC.sourcePending[key] = true
    task.delay(8, function() if SC.sourcePending[key] then SC.sourcePending[key] = nil end end)
    task.spawn(function()
        local path = ("Troops/%s/Skins/%s"):format(tostring(towerName), tostring(skinName))
        local src = SC.findStreaming(path)
        if not src then
            local s = SC.getStreamer()
            if s and type(s.getAsset) == "function" then
                local ok, streamed = pcall(function() return s.getAsset(path, "SkinFolder") end)
                if ok and typeof(streamed) == "Instance" then src = streamed end
            end
        end
        if not src then
            for _ = 1, 50 do
                task.wait(0.1)
                src = SC.findStreaming(path)
                if src then break end
            end
        end
        if src and src.Parent then
            src = SC.installSource(towerName, skinName, src) or src
            SC.sourceCache[key] = src
        else
            SC.sourceCache[key] = false
            SC.sourceCacheAt[key] = tick()
        end
        SC.sourcePending[key] = nil
    end)
end
function SC.getSource(towerName, skinName)
    towerName = tostring(towerName or "")
    skinName = tostring(skinName or "Default")
    local key = towerName .. "\0" .. skinName
    local cached = SC.sourceCache[key]
    if typeof(cached) == "Instance" and cached.Parent then
        return SC.installSource(towerName, skinName, cached) or cached
    end
    if cached == false and SC.sourceCacheAt[key] and tick() - SC.sourceCacheAt[key] < 3 then return nil end
    local src = SC.findInTroops(SC.getContentTroops(), towerName, skinName)
    if not src then
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local troops = assets and assets:FindFirstChild("Troops")
        src = SC.findInTroops(troops, towerName, skinName)
    end
    if not src then
        src = SC.findStreaming(("Troops/%s/Skins/%s"):format(towerName, skinName))
    end
    if src and src.Parent then
        src = SC.installSource(towerName, skinName, src) or src
        SC.sourceCache[key] = src
        return src
    end
    SC.requestSourceAsync(towerName, skinName, key)
    return nil
end

