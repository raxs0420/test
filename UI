local function updateTowerButtons(container)
    if not container then return end

    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local towersByTypeLevel = {}
    local towersFolder = Workspace:FindFirstChild("Towers")

    if not towersFolder then
        return
    end

    for _, towerFolder in ipairs(towersFolder:GetChildren()) do
        local replicator = towerFolder:FindFirstChild("TowerReplicator")
        if replicator then
            local towerName = replicator:GetAttribute("Name")
            local ownerId = replicator:GetAttribute("OwnerId")
            local upgradeLevel = replicator:GetAttribute("Upgrade") or 0

            if ownerId and tostring(ownerId) == tostring(player.UserId) and towerName then
                local key = towerName .. "_" .. tostring(upgradeLevel)
                if not towersByTypeLevel[key] then
                    towersByTypeLevel[key] = {
                        name = towerName,
                        level = upgradeLevel,
                        count = 0,
                        folders = {},
                        key = key
