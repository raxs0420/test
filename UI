    local targetUUID = getTowerUID(targetFolder)
    if not targetUUID then return false end

    local medics = {}
    for _, folder in ipairs(towersFolder:GetChildren()) do
        local rep = folder:FindFirstChild("TowerReplicator")
        if rep and rep:GetAttribute("Name") == "Medic" and rep:GetAttribute("OwnerId") == player.UserId then
            local upgrade = rep:GetAttribute("Upgrade") or 0
            local max = 1
            if upgrade == 1 then max = 2
            elseif upgrade >= 2 and upgrade <= 3 then max = 3
            elseif upgrade == 4 then max = 4
            elseif upgrade >= 5 then max = 5
            end
            local current = extractUUIDsFromTowersSelected(rep:GetAttribute("TowersSelected") or "")
            local pos = getMedicPosition(folder)
            table.insert(medics, {folder = folder, max = max, current = current, pos = pos})
        end
    end
    if #medics == 0 then return false end

    local medicWithTarget = nil
    for _, medic in ipairs(medics) do
        for _, uuid in ipairs(medic.current) do
            if uuid == targetUUID then
                medicWithTarget = medic
                break
            end
        end
        if medicWithTarget then break end
    end

    if medicWithTarget then
        pcall(function()
            RemoteFunction:InvokeServer("Troops", "TowerServerEvent", "ToggleSelectedTower", medicWithTarget.folder, targetFolder)
        end)
        return true
    end

    local targetPos = getTowerPosition(targetFolder)
    if not targetPos then
        for _, medic in ipairs(medics) do
            if #medic.current < medic.max then
                pcall(function()
                    RemoteFunction:InvokeServer("Troops", "TowerServerEvent", "ToggleSelectedTower", medic.folder, targetFolder)
                end)
                return true
            end
        end
        return false
    end

    local medicsWithDistance = {}
    for _, medic in ipairs(medics) do
        local dist = medic.pos and (medic.pos - targetPos).Magnitude or math.huge
        table.insert(medicsWithDistance, {medic = medic, dist = dist})
    end
    table.sort(medicsWithDistance, function(a, b) return a.dist < b.dist end)
    
    for _, item in ipairs(medicsWithDistance) do
        local medic = item.medic
        if #medic.current < medic.max then
            pcall(function()
                RemoteFunction:InvokeServer("Troops", "TowerServerEvent", "ToggleSelectedTower", medic.folder, targetFolder)
            end)
            return true
        end
    end

    return false
end

