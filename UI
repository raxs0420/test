    local function _safeRequire(mod)
        if not mod or type(require) ~= "function" then return nil end
        local ok, res = pcall(require, mod)
        if ok then return res end
        return nil
    end

    local function _safeRequirePath(root, ...)
        local cur = root
        for i = 1, select("#", ...) do
            if not cur then return nil end
            cur = cur:FindFirstChild((select(i, ...)))
        end
        return _safeRequire(cur)
    end

    local function _cloneDeep(t)
        if type(t) ~= "table" then return t end
        local o = {}
        for k, v in pairs(t) do o[k] = _cloneDeep(v) end
        return o
    end

    local function _getClientCache()
        return _safeRequirePath(ReplicatedStorage, "Client", "Modules", "Cache")
    end

    local function _getCacheValue(cm, name, fallback)
        local c = cm and cm(name)
        if not c then return fallback end
        local v
        pcall(function() v = c:GetValue() end)
        return v == nil and fallback or v
    end

    local function _updateCacheValue(cm, name, value)
        local c = cm and cm(name)
        if not c then return false end
        local ok = pcall(function() c:Update(value) end)
        return ok == true
    end

    local function _buildUnlockedTroops(cm)
        local troops = _cloneDeep(_getCacheValue(cm, "Inventory.Troops", {}) or {})
        if type(troops) ~= "table" then troops = {} end
        local content = ReplicatedStorage:FindFirstChild("Content")
        local towerFolder = content and content:FindFirstChild("Tower")
        if not towerFolder then return nil, 0 end
        local count = 0
        for _, tower in ipairs(towerFolder:GetChildren()) do
            local name = tostring(tower.Name or "")
            if name ~= "" then
                local cur = type(troops[name]) == "table" and _cloneDeep(troops[name]) or {}
                local skin = tostring(cur.Skin or "Default")
                if skin == "" then skin = "Default" end
                cur.Name = cur.Name or name
                cur.Skin = skin
                cur.Owned = true
                cur.Unlocked = true
                cur.Purchased = true
                cur.Acquired = true
                troops[name] = cur
                count += 1
            end
        end
        return troops, count
    end

    local function _applyTowerUnlock(enabled)
        local cm = _towerUnlockCache or _getClientCache()
        if not cm then return false, "Cache unavailable" end
        _towerUnlockCache = cm
        if enabled then
            if not _towerUnlockOriginal then
                _towerUnlockOriginal = _cloneDeep(_getCacheValue(cm, "Inventory.Troops", {}) or {})
            end
            local troops, count = _buildUnlockedTroops(cm)
            if not troops or count <= 0 then return false, "Tower data unavailable" end
            _towerUnlockSuppress = true
            _updateCacheValue(cm, "Inventory.Troops", troops)
            task.defer(function() _towerUnlockSuppress = false end)
            _towerUnlockEnabled = true
            return true, count
        else
            if _towerUnlockOriginal then
                _towerUnlockSuppress = true
                _updateCacheValue(cm, "Inventory.Troops", _cloneDeep(_towerUnlockOriginal))
                task.defer(function() _towerUnlockSuppress = false end)
            end
            _towerUnlockOriginal = nil
            _towerUnlockEnabled = false
            return true, 0
        end
    end

