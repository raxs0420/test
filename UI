function SC.cleanupDupFaces(clone)
    if not clone then return end
    local heads = {}
    for _, inst in ipairs(clone:GetDescendants()) do
        if (inst:IsA("Decal") or inst:IsA("Texture")) and inst.Transparency < 0.98 then
            local parent = inst.Parent
            local pk = SC.key(parent and parent.Name or "")
            local nk = SC.key(inst.Name)
            local isHead = pk == "head" or string.find(pk, "head", 1, true) ~= nil
            local isFace = nk == "face"
                or string.find(nk, "eye", 1, true) ~= nil
                or string.find(nk, "mouth", 1, true) ~= nil
                or string.find(nk, "brow", 1, true) ~= nil
                or string.find(nk, "expression", 1, true) ~= nil
            if isHead and isFace then
                heads[parent] = heads[parent] or {}
                table.insert(heads[parent], inst)
            end
        end
    end
    for _, layers in pairs(heads) do
        local custom = 0
        local faces = {}
        for _, layer in ipairs(layers) do
            if SC.key(layer.Name) == "face" then table.insert(faces, layer)
            else custom += 1 end
        end
        if custom > 0 then
            for _, f in ipairs(faces) do pcall(function() f.Transparency = 1 end) end
        elseif #faces > 1 then
            local keep = faces[#faces]
            for _, f in ipairs(faces) do
                if f ~= keep then pcall(function() f.Transparency = 1 end) end
            end
        end
    end
end
function SC.isRenderablePart(inst)
    if not inst:IsA("BasePart") then return false end
    if inst.Transparency >= 0.98 then return false end
    local name = string.lower(inst.Name or "")
    if string.find(name, "hitbox", 1, true) or string.find(name, "range", 1, true) then return false end
    if string.find(name, "placement", 1, true) or string.find(name, "bounds", 1, true) then return false end
    return true
end
function SC.cloneLooksRenderable(clone)
    if not clone then return false end
    local parts = 0
    for _, inst in ipairs(clone:GetDescendants()) do
        if SC.isRenderablePart(inst) then parts += 1; if parts >= 2 then break end end
    end
    if parts <= 0 then return false end
    local ok, size = pcall(function() return clone:GetExtentsSize() end)
    if not ok or not size then return parts > 0 end
    return size.Magnitude > 0.35
end
function SC.makeClone(towerName, skinName, info)
