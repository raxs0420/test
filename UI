    local SellFarmsRunning = false
    local function get_current_wave()
        local success, result = pcall(function()
            local waveLabel = playerGui:FindFirstChild("ReactGameTopGameDisplay", true)
            if waveLabel and waveLabel.Frame and waveLabel.Frame.wave and waveLabel.Frame.wave.container then
                local valueLabel = waveLabel.Frame.wave.container:FindFirstChild("value")
                if valueLabel and valueLabel.Text then
                    local waveNum = valueLabel.Text:match("(%d+)")
                    return tonumber(waveNum) or 0
                end
            end
            return 0
        end)
        return success and result or 0
    end
    local function StartSellFarm()
        if SellFarmsRunning or not _G.SellFarms then return end
        SellFarmsRunning = true

        print("Auto Sell Farms started, selling at wave:", _G.WaveFS)

        task.spawn(function()
            while _G.SellFarms do
                local success, CurrentWave = pcall(get_current_wave)
                if not success then CurrentWave = 0 end

                local sellAtWave = _G.WaveFS or 40

                if CurrentWave >= sellAtWave and CurrentWave > 0 then
                    local TowersFolder = workspace:FindFirstChild("Towers")
                    if TowersFolder then
                        for _, replicator in ipairs(TowersFolder:GetDescendants()) do
                            if replicator:IsA("Folder") and replicator.Name == "TowerReplicator" then
                                local IsFarm = replicator:GetAttribute("Name") == "Farm"
                                local IsMine = replicator:GetAttribute("OwnerId") == game.Players.LocalPlayer.UserId

                                if IsFarm and IsMine then
                                    local TowerModel = replicator.Parent
                                    pcall(function()
                                        RemoteFunction:InvokeServer("Troops", "Sell", { Troop = TowerModel })
                                    end)
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                end
                task.wait(1)
            end
            SellFarmsRunning = false
            print("Auto Sell Farms stopped")
        end)
    end

