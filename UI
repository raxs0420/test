    local function extractUUIDsFromTowersSelected(raw)
        if not raw or raw == "" then return {} end
        local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok and type(decoded) == "table" then
            local uuids = {}
            for k, v in pairs(decoded) do
                if v == true and type(k) == "string" and #k > 20 then table.insert(uuids, k) end
            end
            return uuids
        end
        local uuids = {}
        for match in string.gmatch(raw, "([%a%d%-]+%-[%a%d%-]+%-[%a%d%-]+%-[%a%d%-]+%-[%a%d%-]+)") do
            table.insert(uuids, match)
        end
        return uuids
    end

