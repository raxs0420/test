function SC.safeRequire(mod)
    if not mod or type(require) ~= "function" then return nil end
    local ok, res = pcall(require, mod)
    if ok then return res end
    return nil
end
function SC.findPath(root, ...)
    local cur = root
    for i = 1, select("#", ...) do
        if not cur then return nil end
        cur = cur:FindFirstChild((select(i, ...)))
    end
    return cur
end
function SC.safeRequirePath(root, ...)
