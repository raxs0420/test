function SC.isLocalOwnerValue(v)
    if v == nil then return false end
    if v == player or v == player.UserId then return true end
    if tostring(v) == tostring(player.UserId) or tostring(v) == player.Name then return true end
    if typeof(v) == "Instance" and v:IsA("Player") then
        return v == player or v.UserId == player.UserId
    end
    if type(v) == "table" then
        return tostring(v.UserId or v.userId or "") == tostring(player.UserId)
    end
    return false
end
function SC.isOwnedEntity(entity)
    if not entity then return false end
    if SC.isLocalOwnerValue(entity.OwnerId) or SC.isLocalOwnerValue(entity.Owner) then return true end
    if type(entity.State) == "table" then
        if SC.isLocalOwnerValue(entity.State.OwnerId) or SC.isLocalOwnerValue(entity.State.Owner) then return true end
    end
    local rep = entity.Replicator
    for _, k in ipairs({ "OwnerId", "Owner", "UserId", "Player" }) do
        local ok, v = pcall(function() return rep and rep:Get(k) end)
        if ok and SC.isLocalOwnerValue(v) then return true end
    end
    return false
end
function SC.resolveOwnedName(model, entity)
    local c = {}
    local function add(v)
        if type(v) == "string" and v ~= "" and v ~= "Default" then table.insert(c, v) end
    end
    if entity then
        add(entity.TowerName); add(entity.Name)
        if type(entity.State) == "table" then add(entity.State.Type); add(entity.State.Name) end
        pcall(function() add(entity.Replicator and entity.Replicator:Get("Name")) end)
        pcall(function() add(entity.Replicator and entity.Replicator:Get("Type")) end)
    end
    if model then
        add(model:GetAttribute("TowerName"))
        add(model:GetAttribute("Name"))
        add(model:GetAttribute("Type"))
        add(model:GetAttribute("DisplayName"))
        local trep = model:FindFirstChild("TowerReplicator")
        if trep then
            add(trep:GetAttribute("TowerName"))
            add(trep:GetAttribute("Name"))
            add(trep:GetAttribute("Type"))
        end
    end
    return c[1] or tostring(model and model.Name or entity and entity.Name or "")
end
function SC.isOwnModel(tower)
    local owner = tower and tower:FindFirstChild("Owner")
    if not owner then return true end
    local ok, v = pcall(function() return owner.Value end)
    if not ok then return true end
    return v == player or v == player.UserId or v == player.Name
        or tostring(v) == tostring(player.UserId)
end
function SC.getOwnedRaw()
    local out = {}
    local rep = SC.getTowerReplicator()
    if rep and type(rep.getTowers) == "function" then
        local ok, towers = pcall(rep.getTowers)
        if ok and type(towers) == "table" then
            for model, entity in pairs(towers) do
                if SC.isOwnedEntity(entity) then
                    table.insert(out, { model = model, entity = entity, name = SC.resolveOwnedName(model, entity) })
                end
            end
        end
    end
    if #out == 0 then
        local tf = workspace:FindFirstChild("Towers")
        if tf then
            for _, tower in ipairs(tf:GetChildren()) do
                if tower:IsA("Model") and SC.isOwnModel(tower) then
                    table.insert(out, { model = tower, entity = nil, name = SC.resolveOwnedName(tower, nil) })
                end
            end
        end
    end
    return out
end
function SC.getOwned()
    local now = tick()
    if SC.ownedCache and now - SC.ownedCacheAt < SC.OWNED_TTL then
        local alive = true
        for _, t in ipairs(SC.ownedCache) do
            local m = t and t.model
            if m and typeof(m) == "Instance" and not m.Parent then alive = false; break end
        end
        if alive then return SC.ownedCache end
    end
    SC.ownedCache = SC.getOwnedRaw()
    SC.ownedCacheAt = now
    return SC.ownedCache
end

