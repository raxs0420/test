function SC.alignClone(clone, model, verticalOffset)
    if not (clone and clone.Parent and model and model.Parent) then return end
    local applied = tonumber(verticalOffset)
    pcall(function()
        clone:PivotTo(model:GetPivot())
        if applied == nil and SC.shouldFloor(clone, model) then
            local rf = SC.floorPoint(model)
            local cf = SC.floorPoint(clone)
            if rf and cf then
                local dy = rf.Y - cf.Y
                if math.abs(dy) <= 12 then applied = dy end
            end
        end
        if applied and applied ~= 0 then
            clone:PivotTo(clone:GetPivot() + Vector3.new(0, applied, 0))
        end
    end)
    return applied or 0
end
