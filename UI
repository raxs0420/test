function SC.mirrorTrack(state, originalTrack)
    if state and state.mirroredTracks and state.mirroredTracks[originalTrack] then return end
    local anim = SC.findAnimFromTrack(state, originalTrack)
    if not anim then return end
    local animator = state.animator or SC.getAnimator(state.clone)
    state.animator = animator
    if not animator then return end
    local ok, ct = pcall(function() return animator:LoadAnimation(anim) end)
    if not ok or not ct then return end
    state.mirroredTracks = state.mirroredTracks or {}
    state.mirroredTracks[originalTrack] = ct
    pcall(function()
        ct.Priority = originalTrack.Priority
        ct.Looped = originalTrack.Looped
        ct:Play(0.05, originalTrack.WeightCurrent, originalTrack.Speed)
        if originalTrack.TimePosition > 0 then ct.TimePosition = originalTrack.TimePosition end
    end)
    local stopped
    stopped = originalTrack.Stopped:Connect(function()
        if stopped then stopped:Disconnect(); stopped = nil end
        state.mirroredTracks[originalTrack] = nil
        pcall(function() ct:Stop(0.05); ct:Destroy() end)
    end)
    state.connections = state.connections or {}
    table.insert(state.connections, stopped)
end
function SC.syncMirror(state)
    if not (state and state.clone and state.clone.Parent) then return end
    local animator = state.originalAnimator
    if not animator then return end
    local playing = {}
    local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
    if ok and type(tracks) == "table" then
        for _, t in ipairs(tracks) do
            playing[t] = true
            SC.mirrorTrack(state, t)
            local ct = state.mirroredTracks and state.mirroredTracks[t]
            if ct then
                pcall(function()
                    local speed = tonumber(t.Speed) or 1
                    if not ct.IsPlaying then
                        ct:Play(0.03, math.max(tonumber(t.WeightCurrent) or 1, 0.01), speed)
                    end
                    if math.abs((ct.TimePosition or 0) - (t.TimePosition or 0)) > 0.18 then
                        ct.TimePosition = t.TimePosition
                    end
                    ct:AdjustSpeed(speed)
                end)
            end
        end
    end
    for ot, ct in pairs(state.mirroredTracks or {}) do
        if not playing[ot] then
            state.mirroredTracks[ot] = nil
            pcall(function() ct:Stop(0.05); ct:Destroy() end)
        end
    end
end
function SC.observeAnims(info, state)
    local entity = info and info.entity
    local animator = entity and entity.AnimationAnimator
    if not animator then
        local ctrl = state.model and state.model:FindFirstChild("AnimationController")
