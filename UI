        if not mapsFolder then
            loadingLabel.Text = "No Maps folder"
            return
        end

        local allModules = {}
        for _, mapFolder in ipairs(mapsFolder:GetChildren()) do
            if mapFolder:IsA("Folder") or mapFolder:IsA("Model") then
                local data = mapFolder:FindFirstChild("Data")
                if data and data:IsA("ModuleScript") then
                    table.insert(allModules, data)
                else
                    for _, child in ipairs(mapFolder:GetChildren()) do
                        if child:IsA("ModuleScript") then
                            table.insert(allModules, child)
                        end
                    end
                end
            elseif mapFolder:IsA("ModuleScript") then
                table.insert(allModules, mapFolder)
            end
        end

        local mapDataTable = {}
        for _, module in ipairs(allModules) do
            local mapName = nil
            local parent = module.Parent
            if parent and parent.Name == "Data" then
                local gp = parent.Parent
                if gp and gp ~= mapsFolder then mapName = gp.Name end
            end
            if not mapName and parent and parent ~= mapsFolder then mapName = parent.Name end
            if not mapName or mapName == "" then mapName = module.Name end
            local mapData = safeRequire(module, 1.5)
            local isCommunity = false
            if mapData and type(mapData) == "table" and CommunityEnumValue then
                if mapData.MapType == CommunityEnumValue then isCommunity = true end
            end
            if mapDataTable[mapName] == nil then
                mapDataTable[mapName] = isCommunity
            elseif isCommunity then
                mapDataTable[mapName] = true
            end
        end

        local validMaps = {}
        for mapName, isCom in pairs(mapDataTable) do
            if isCom and not SKIP_MAPS[mapName] then 
                table.insert(validMaps, mapName) 
            end
        end
        table.sort(validMaps)

        loadingLabel.Visible = false

        local n = 0
        for _, mapName in ipairs(validMaps) do
            n += 1
            local mapBtn = Instance.new("TextButton", mapListFrame)
            mapBtn.Size = UDim2.new(1, 0, 0, 28)
            mapBtn.LayoutOrder = n
            local defaultColor = (n % 2 == 0) and C.card or C.surface
            mapBtn.BackgroundColor3 = defaultColor
            mapBtn.Text = mapName
            mapBtn.TextColor3 = C.textSec
            mapBtn.TextSize = 11
            mapBtn.Font = Enum.Font.Gotham
            mapBtn.AutoButtonColor = false
            mapBtn.TextXAlignment = Enum.TextXAlignment.Left
            mapBtn:SetAttribute("OriginalColor", defaultColor)
            corner(mapBtn, 5)
            stroke(mapBtn, 1, C.border, 0.4)
            local pad = Instance.new("UIPadding", mapBtn)
            pad.PaddingLeft = UDim.new(0, 10)
            hover(mapBtn, C.surfaceAlt, C.text)
            mapBtn.MouseButton1Click:Connect(function()
                if selectedMapButton == mapBtn then
                    setColor(selectedMapButton, selectedMapButton:GetAttribute("OriginalColor"), C.textSec)
                    selectedMapButton = nil
                    selectedMapName = nil
                else
                    if selectedMapButton then
                        setColor(selectedMapButton, selectedMapButton:GetAttribute("OriginalColor"), C.textSec)
                    end
                    selectedMapButton = mapBtn
                    selectedMapName = mapName
                    setColor(mapBtn, C.accent, Color3.fromRGB(255, 255, 255))
                end
            end)
            table.insert(mapButtons, mapBtn)
        end

        if #validMaps == 0 then
            local noMapsBtn = Instance.new("TextButton", mapListFrame)
            noMapsBtn.Size = UDim2.new(1, 0, 0, 28)
            noMapsBtn.LayoutOrder = 1
            noMapsBtn.BackgroundColor3 = C.surface
            noMapsBtn.Text = "No Community maps available"
            noMapsBtn.TextColor3 = C.textDim
            noMapsBtn.TextSize = 11
            noMapsBtn.Font = Enum.Font.Gotham
            noMapsBtn.AutoButtonColor = false
            noMapsBtn.TextXAlignment = Enum.TextXAlignment.Left
            corner(noMapsBtn, 5)
            local pad = Instance.new("UIPadding", noMapsBtn)
            pad.PaddingLeft = UDim.new(0, 10)
        end

        task.defer(function()
            mapListFrame.CanvasSize = UDim2.new(0, 0, 0, mapListLayout.AbsoluteContentSize.Y + 12)
        end)
    end

    task.spawn(populateMaps)

    chooseBtn.MouseButton1Click:Connect(function()
        if not selectedMapName then
            flashButton(chooseBtn, C.red, "NO MAP")
            return
        end
        setColor(chooseBtn, C.green, C.text)
        chooseBtn.Text = "SELECTING..."
        pcall(function()
            RemoteFunction:InvokeServer("LobbyVoting", "Override", selectedMapName)
        end)
        task.wait(0.2)
        local net = ReplicatedStorage:FindFirstChild("Network")
        local sandbox = net and net:FindFirstChild("Sandbox")
        local switch = sandbox and sandbox:FindFirstChild("RE:SwitchMap")
        if switch then pcall(function() switch:FireServer(selectedMapName) end) end
        task.wait(0.3)
        setColor(chooseBtn, C.blueDark, C.blue)
        chooseBtn.Text = "CHOOSE"
        flashButton(chooseBtn, C.green, "✓")
    end)
end

    local function getMaxLevelForTower(towerModel)
        local upgrades = towerModel:FindFirstChild("Upgrades")
        if not upgrades then return nil end
        local maxLv = 0
        for _, child in ipairs(upgrades:GetChildren()) do
            local n = tonumber(child.Name)
            if n and n > maxLv then maxLv = n end
        end
        return maxLv > 0 and maxLv or nil
    end

    local function setupAutoUpgradeListener()
        local towersFolder = Workspace:FindFirstChild("Towers")
        if not towersFolder then
            towersFolder = Instance.new("Folder")
            towersFolder.Name = "Towers"
            towersFolder.Parent = Workspace
        end
        towersFolder.ChildAdded:Connect(function(towerFolder)
            if not _G.AutoUpgradeEnabled then return end
            task.spawn(function()
                local rep = towerFolder:FindFirstChild("TowerReplicator")
                if not rep then
                    rep = towerFolder:WaitForChild("TowerReplicator", 5)
                    if not rep then return end
                end
                if tostring(rep:GetAttribute("OwnerId")) ~= tostring(player.UserId) then return end
                local towerName = rep:GetAttribute("Name")
                if not towerName then return end
                local config = _G.AutoUpgradeConfig[towerName]
                local isManual = true
                if not config or type(config) ~= "table" then
                    local maxLv = getMaxLevelForTower(towerFolder)
                    if maxLv and maxLv > 0 then
                        config = {{path = 1, count = maxLv}}
                        isManual = false
                    else
                        return
                    end
                end
                task.wait(0.1)
                local currentLv = rep:GetAttribute("Upgrade") or 0
                local targetLv
                if isManual then
                    local total = 0
                    for _, e in ipairs(config) do total = total + (e.count or 0) end
                    targetLv = currentLv + total
                else
                    targetLv = config[1].count
                end
                if targetLv <= currentLv then return end
                local remaining = targetLv - currentLv
                for _, e in ipairs(config) do
                    if remaining <= 0 then break end
                    local path = e.path or 1
                    local cnt = math.min(e.count, remaining)
                    for i = 1, cnt do
                        pcall(function()
                            RemoteFunction:InvokeServer("Troops", "Upgrade", "Set", {
                                Troop = towerFolder, Path = path
                            })
                        end)
                        remaining -= 1
                        task.wait(0.05)
                    end
                    if remaining <= 0 then break end
                end
            end)
        end)
    end

    setupAutoUpgradeListener()

