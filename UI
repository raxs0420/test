function SC.floorPoint(model)
    if not model then return nil end
    local primary = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChildWhichIsA("BasePart", true)
    local ho = primary and primary:FindFirstChild("HeightOffset")
    if ho and ho:IsA("Attachment") then return ho.WorldPosition end
    local lowest = math.huge
    local cx, cz, count = 0, 0, 0
    for _, inst in ipairs(model:GetDescendants()) do
        if inst:IsA("BasePart") and inst.Transparency < 0.98
            and not string.find(string.lower(inst.Name), "hitbox", 1, true)
            and not string.find(string.lower(inst.Name), "range", 1, true) then
            lowest = math.min(lowest, inst.Position.Y - (inst.Size.Y * 0.5))
            cx += inst.Position.X; cz += inst.Position.Z; count += 1
        end
    end
    if count > 0 and lowest < math.huge then return Vector3.new(cx / count, lowest, cz / count) end
    if primary then return primary.Position end
    return nil
end
function SC.shouldFloor(clone, model)
    if not clone then return true end
    local k = SC.key(clone:GetAttribute("SkinTower") or "")
    if k == SC.key("Pursuit") then return false end
    if clone:FindFirstChild("FlightPos", true) or (model and model:FindFirstChild("FlightPos", true)) then return false end
    return true
