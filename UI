    for model, state in pairs(SC.visuals) do
        if not (model and typeof(model) == "Instance" and model.Parent) then
            table.insert(stale, model)
        elseif state and state.clone and state.clone.Parent then
            alive[state.clone] = true
        end
    end
    for _, model in ipairs(stale) do SC.restoreVisual(model) end
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
