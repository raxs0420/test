                    original = original, clone = clone,
                    originalRelative = mPivot:ToObjectSpace(original.CFrame),
                    cloneRelative = cPivot:ToObjectSpace(clone.CFrame),
                })
            end
            if syncVis and (
                (original:IsA("BasePart") and clone:IsA("BasePart"))
                or ((original:IsA("Decal") or original:IsA("Texture")) and clone.ClassName == original.ClassName)
                or ((original:IsA("ParticleEmitter") or original:IsA("Beam") or original:IsA("Trail"))
                    and clone.ClassName == original.ClassName)
