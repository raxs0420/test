    local wrapped
    wrapped = function(...)
        local result = original(...)
        if SC.visuals[state.model] == state and state.model and state.model.Parent then
            pcall(function()
                local parent = state.model.PrimaryPart or state.model:FindFirstChildWhichIsA("BasePart", true)
                if parent and narrator then
                    local s = Instance.new("Sound")
                    s.SoundId = SC.narratorBackup[math.random(1, #SC.narratorBackup)]
                    s.Volume = 1
                    s.Parent = parent
                    local tg = SC.SoundService:FindFirstChild("Towers")
                    if tg then s.SoundGroup = tg end
                    s:Play()
                    SC.Debris:AddItem(s, 15)
                    local delay = math.max(tonumber(s.TimeLength) or 0, 1) * 0.93
                    task.delay(delay, function()
                        if math.random() >= 0.43 then return end
                        for om, os in pairs(SC.visuals) do
                            if os ~= state and om and om.Parent
                                and SC.key(os.towerName) == SC.key("Crook Boss")
                                and SC.isNarrator(os.skin) then
                                local op = om.PrimaryPart or om:FindFirstChildWhichIsA("BasePart", true)
                                if op then
                                    local r = Instance.new("Sound")
                                    r.SoundId = SC.narratorTalk
                                    r.Volume = 1
                                    r.Parent = op
                                    if tg then r.SoundGroup = tg end
                                    r:Play()
                                    SC.Debris:AddItem(r, 15)
                                end
                                break
                            end
                        end
                    end)
                elseif parent and gm then
                    local level = 0
                    pcall(function() level = tonumber(entity:GetLevel()) or 0 end)
                    local src = state.clone:FindFirstChild(level == 4 and "SummonMax" or "Summon", true)
                        or state.clone:FindFirstChild("Summon", true)
                    if src and src:IsA("Sound") then
                        local s = src:Clone()
                        s.Parent = parent
                        local tg = SC.SoundService:FindFirstChild("Towers")
                        if tg then s.SoundGroup = tg end
                        s:Play()
                        SC.Debris:AddItem(s, 15)
                    end
                end
            end)
        end
        return result
    end
    exec.CallBackup = wrapped
    state.connections = state.connections or {}
    table.insert(state.connections, {
        Disconnect = function()
            if exec and exec.CallBackup == wrapped then exec.CallBackup = original end
        end,
    })
end

function SC.getTrapGroupName(trapName, level)
