    clone:SetAttribute("SkinName", tostring(skinName))
    local primary = clone.PrimaryPart or clone:FindFirstChild("HumanoidRootPart")
        or clone:FindFirstChildWhichIsA("BasePart", true)
    if primary and primary:IsA("BasePart") then clone.PrimaryPart = primary end
    for _, inst in ipairs(clone:GetDescendants()) do
        if inst:IsA("BasePart") then
            inst.CanCollide = false; inst.CanTouch = false
            inst.CanQuery = false; inst.Massless = true
