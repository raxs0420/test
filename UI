            else
                local currentValue = tonumber(waveBox.Text)
                if currentValue and currentValue > maxWave then
                    waveBox.Text = tostring(maxWave)
                    _G.WaveFS = maxWave
                    saveSettings()
                end
            end
        else
            waveBox.PlaceholderText = "Wave to Sell Farms"
