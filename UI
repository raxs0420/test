function SC.getSkinsForTower(towerName)
    local found = SC.clone(SC.getTowerSkinData(towerName))
    local list = {}
    for name in pairs(found) do table.insert(list, name) end
    table.sort(list, function(a, b)
        if a == "Default" then return true end
        if b == "Default" then return false end
        return tostring(a):lower() < tostring(b):lower()
    end)
    return list
end
function SC.getPickerTowers()
    local list, seen = {}, {}
    local content = ReplicatedStorage:FindFirstChild("Content")
    local towerFolder = content and content:FindFirstChild("Tower")
    if towerFolder then
        for _, tower in ipairs(towerFolder:GetChildren()) do
            local statsModule = tower:FindFirstChild("Stats")
            if statsModule then
                local data = SC.safeRequire(statsModule)
                local skinData = data and data.Properties and data.Properties.SkinData
                if type(skinData) == "table" and next(skinData)
                    and not seen[tower.Name] and SC.supportsTower(tower.Name) then
                    seen[tower.Name] = true
                    table.insert(list, tower.Name)
                end
            end
        end
    end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    local troops = assets and assets:FindFirstChild("Troops")
    if troops then
        for _, tower in ipairs(troops:GetChildren()) do
            local skins = tower:FindFirstChild("Skins")
            if skins and #skins:GetChildren() > 0 and not seen[tower.Name]
                and SC.supportsTower(tower.Name) then
                seen[tower.Name] = true
                table.insert(list, tower.Name)
            end
        end
    end
    table.sort(list, function(a, b) return tostring(a):lower() < tostring(b):lower() end)
    return list
end

