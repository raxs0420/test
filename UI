local function getWorldPositionPrecise(screenPosition)
    if not screenPosition then return nil, nil, nil end
    
    if terrain and terrain.GetMousePosition then
        local success, pos = pcall(function()
            return terrain:GetMousePosition(Camera, screenPosition)
        end)
        if success and pos and type(pos) == "Vector3" then
            return pos.X, pos.Y + 2, pos.Z
        end
    end

    local ray
    local success, result = pcall(function()
        return Camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
    end)
    if not success or not result then return nil, nil, nil end
    ray = result
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {player.Character, Camera}
    raycastParams.IgnoreWater = true

    local raycastSuccess, raycastResult = pcall(function()
        return Workspace:Raycast(ray.Origin, ray.Direction * 1000, raycastParams)
    end)
    
    if raycastSuccess and raycastResult then
        local hitPoint = raycastResult.Position
        return hitPoint.X, hitPoint.Y + 2, hitPoint.Z
    end

    return nil, nil, nil
end

local function placeTowerAtPosition(towerName, x, y, z)
