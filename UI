    updateSliderMax()

    return contentFrame
end

local function createMapsTab()
    local contentFrame = Library:CreateFrame(
        rightPanel,
        UDim2.new(1, -Library:ScaleX(2), 1, -Library:ScaleY(2)),
        UDim2.new(0, Library:ScaleX(1), 0, Library:ScaleY(1)),
        false,
        Library.Colors.BackgroundDarker
    )

    local mapsContainer = Library:CreateFrame(
        contentFrame,
        UDim2.new(1, -Library:ScaleX(2), 1, -Library:ScaleY(12)),
        UDim2.new(0, Library:ScaleX(1), 0, Library:ScaleY(1)),
        false,
        Library.Colors.BackgroundDark
    )
    Library:AddCorner(mapsContainer, 6)

    local mapListFrame = Library:CreateScrollingFrame(
        mapsContainer,
        UDim2.new(1, -Library:ScaleX(1), 1, -Library:ScaleY(2)),
        UDim2.new(0, Library:ScaleX(1), 0, Library:ScaleY(1)),
        Library.Colors.BackgroundDarker
    )
    mapListFrame.ScrollBarThickness = 8
    Library:AddCorner(mapListFrame, 4)
    Library:AddStroke(mapListFrame, 1, Library.Colors.Border)

    local loadingLabel = Instance.new("TextLabel")
    loadingLabel.Size = UDim2.new(1, -Library:ScaleX(2), 0, Library:ScaleY(4))
    loadingLabel.Position = UDim2.new(0, Library:ScaleX(1), 0, Library:ScaleY(1))
    loadingLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    loadingLabel.TextColor3 = Library.Colors.TextDim
    loadingLabel.TextSize = Library:ScaleY(1.2)
    loadingLabel.Font = Library.Fonts.Bold
    loadingLabel.Text = "Loading maps..."
    loadingLabel.Parent = mapListFrame
    loadingLabel.ZIndex = 10

    local chooseBtn = Instance.new("TextButton")
    chooseBtn.Size = UDim2.new(0, Library:ScaleX(10), 0, Library:ScaleY(5))
    chooseBtn.Position = UDim2.new(0.5, -Library:ScaleX(5), 1, -Library:ScaleY(8.5)) 
    chooseBtn.BackgroundColor3 = Library.Colors.Accent
    chooseBtn.Text = "CHOOSE"
    chooseBtn.TextColor3 = Library.Colors.Text
    chooseBtn.Font = Library.Fonts.Bold
    chooseBtn.TextSize = Library:ScaleY(1.3)
    chooseBtn.Parent = contentFrame
    chooseBtn.AutoButtonColor = false
    Library:AddCorner(chooseBtn, 4)
    Library:AddStroke(chooseBtn, 1, Library.Colors.Border)

    local selectedMapName = nil
    local selectedMapButton = nil
    local mapButtons = {}

    local CommunityEnumValue = nil
    pcall(function()
        if Enum.MapType and Enum.MapType.Community then
            CommunityEnumValue = Enum.MapType.Community
        end
    end)
    if not CommunityEnumValue then
        local EnumModule = ReplicatedStorage:FindFirstChild("Shared") and ReplicatedStorage.Shared:FindFirstChild("Modules") and ReplicatedStorage.Shared.Modules:FindFirstChild("Enum")
        if EnumModule then
            local success, enum = pcall(require, EnumModule)
            if success and enum and enum.MapType then
                CommunityEnumValue = enum.MapType.Community
            end
        end
    end
    local debugging = false 

    local function populateMaps()
        for _, btn in pairs(mapButtons) do
            pcall(function() btn:Destroy() end)
        end
        mapButtons = {}
        selectedMapButton = nil
        selectedMapName = nil
        loadingLabel.Visible = true
        loadingLabel.Text = "Loading maps..."

        local mapsFolder = ReplicatedStorage:FindFirstChild("Content") and ReplicatedStorage.Content:FindFirstChild("Maps")
        if not mapsFolder then
            loadingLabel.Text = "No Maps folder"
            return
        end

        local allModules = {}
        local descendants = mapsFolder:GetDescendants()
        for _, obj in ipairs(descendants) do
            if obj:IsA("ModuleScript") then
                table.insert(allModules, obj)
            end
        end

        local mapDataTable = {}
        for _, module in ipairs(allModules) do
            local mapName = nil
            local parent = module.Parent

            if parent and parent.Name == "Data" then
                local grandParent = parent.Parent
                if grandParent and grandParent ~= mapsFolder then
                    mapName = grandParent.Name
                end
            end
            if not mapName and parent and parent ~= mapsFolder then
                mapName = parent.Name
            end
            if not mapName or mapName == "" then
                mapName = module.Name
            end

            local mapData = nil
            local loadSuccess, loadedData = pcall(require, module)
            if loadSuccess then
                mapData = loadedData
            end
            local isCommunity = false
            if mapData and type(mapData) == "table" and CommunityEnumValue then
                if mapData.MapType == CommunityEnumValue then
                    isCommunity = true
                end
            elseif not CommunityEnumValue then
                isCommunity = true
            end

            if mapDataTable[mapName] == nil then
                mapDataTable[mapName] = isCommunity
            elseif isCommunity then
                mapDataTable[mapName] = true
            end
        end

        local validMaps = {}
        for mapName, isCommunity in pairs(mapDataTable) do
            if debugging then
                table.insert(validMaps, mapName)
            else
                if isCommunity then
                    table.insert(validMaps, mapName)
                end
            end
        end
        table.sort(validMaps)

        loadingLabel.Visible = false

        local yPos = Library:ScaleY(1)
        local btnHeight = Library:ScaleY(4)
        for i, mapName in ipairs(validMaps) do
            local mapBtn = Instance.new("TextButton")
            mapBtn.Size = UDim2.new(1, -Library:ScaleX(2), 0, btnHeight)
            mapBtn.Position = UDim2.new(0, Library:ScaleX(1), 0, yPos)
            local defaultColor = (i % 2 == 0) and Color3.fromRGB(40, 40, 48) or Color3.fromRGB(35, 35, 42)
            mapBtn.BackgroundColor3 = defaultColor
            mapBtn.Text = mapName
            mapBtn.TextColor3 = Library.Colors.Text
            mapBtn.TextSize = Library:ScaleY(1.1)
            mapBtn.Font = Library.Fonts.Normal
            mapBtn.Parent = mapListFrame
            mapBtn.AutoButtonColor = false
            mapBtn:SetAttribute("OriginalColor", defaultColor)
            Library:AddCorner(mapBtn, 3)
            Library:AddStroke(mapBtn, 1, Library.Colors.Border)

            mapBtn.MouseButton1Click:Connect(function()
                if selectedMapButton == mapBtn then
                    selectedMapButton.BackgroundColor3 = selectedMapButton:GetAttribute("OriginalColor")
                    selectedMapButton = nil
                    selectedMapName = nil
                else
                    if selectedMapButton then
                        selectedMapButton.BackgroundColor3 = selectedMapButton:GetAttribute("OriginalColor")
                    end
                    selectedMapButton = mapBtn
                    selectedMapName = mapName
                    mapBtn.BackgroundColor3 = Library.Colors.Success
                end
            end)

            mapBtn.MouseEnter:Connect(function()
                if mapBtn ~= selectedMapButton then
                    mapBtn.BackgroundColor3 = Library.Colors.BackgroundLight
                end
            end)
            mapBtn.MouseLeave:Connect(function()
                if mapBtn ~= selectedMapButton then
                    mapBtn.BackgroundColor3 = mapBtn:GetAttribute("OriginalColor")
                end
            end)

            table.insert(mapButtons, mapBtn)
            yPos = yPos + btnHeight + Library:ScaleY(0.5)
        end

        if #validMaps == 0 then
            local noMapsBtn = Instance.new("TextButton")
            noMapsBtn.Size = UDim2.new(1, -Library:ScaleX(2), 0, btnHeight)
            noMapsBtn.Position = UDim2.new(0, Library:ScaleX(1), 0, yPos)
            noMapsBtn.BackgroundColor3 = Library.Colors.BackgroundLight
            noMapsBtn.Text = "No Community maps available"
            noMapsBtn.TextColor3 = Library.Colors.TextDim
            noMapsBtn.TextSize = Library:ScaleY(1.2)
            noMapsBtn.Font = Library.Fonts.Normal
            noMapsBtn.Parent = mapListFrame
            noMapsBtn.AutoButtonColor = false
            Library:AddCorner(noMapsBtn, 4)
            yPos = yPos + btnHeight + Library:ScaleY(0.5)
        end

        mapListFrame.CanvasSize = UDim2.new(0, 0, 0, yPos + Library:ScaleY(1))
    end

    task.spawn(populateMaps)

    local function selectMapOverride(mapName)
        pcall(function()
            RemoteFunction:InvokeServer("LobbyVoting", "Override", mapName)
        end)
    end

    local function switchSandboxMap(mapName)
        local sandboxRemote = ReplicatedStorage:FindFirstChild("Network")
        if sandboxRemote then
            sandboxRemote = sandboxRemote:FindFirstChild("Sandbox")
            if sandboxRemote then
                sandboxRemote = sandboxRemote:FindFirstChild("RE:SwitchMap")
                if sandboxRemote then
                    pcall(function() sandboxRemote:FireServer(mapName) end)
                end
            end
        end
    end

    chooseBtn.MouseButton1Click:Connect(function()
        if selectedMapName then
            local originalColor = chooseBtn.BackgroundColor3
            chooseBtn.BackgroundColor3 = Library.Colors.Success
            chooseBtn.Text = "SELECTING..."
            selectMapOverride(selectedMapName)
            task.wait(0.2)
            switchSandboxMap(selectedMapName)
            task.wait(0.3)
            chooseBtn.BackgroundColor3 = originalColor
            chooseBtn.Text = "CHOOSE"
            flashButton(chooseBtn, Library.Colors.Success, "✓")
        else
            flashButton(chooseBtn, Library.Colors.Danger, "NO MAP")
        end
    end)

    return contentFrame
end

