    pcall(function()
        if type(props) == "table" then
            if props.Priority then track.Priority = props.Priority end
            if props.Looped ~= nil then track.Looped = props.Looped == true end
        end
        if tostring(animName) == "Idle" then
            track.Looped = true
            if state.idleTrack and state.idleTrack ~= track then
                pcall(function() state.idleTrack:Stop(0.08) end)
            end
            state.idleTrack = track
            if track.IsPlaying then return end
        end
        local ft = 0.08
        if type(args) == "table" and tonumber(args[1]) then ft = tonumber(args[1]) end
        track:Play(ft)
        if type(props) == "table" and tonumber(props.Speed) then track:AdjustSpeed(tonumber(props.Speed)) end
    end)
    return true
end
