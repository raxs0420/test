if isMobile then
    local lastCameraCFrame = Camera.CFrame
    local lastCameraMoveTime = tick()
    local cameraCooldown = 0.3

    RunService.RenderStepped:Connect(function()
        local currentCFrame = Camera.CFrame
        if (currentCFrame.Position - lastCameraCFrame.Position).Magnitude > 0.01 or
           currentCFrame.LookVector:Dot(lastCameraCFrame.LookVector) < 0.9999 then
            lastCameraMoveTime = tick()
        end
        lastCameraCFrame = currentCFrame
    end)

    local function canPlaceTouch()
        return tick() - lastCameraMoveTime > cameraCooldown
    end

    local activeTouch = nil
    local touchStartTime = 0
    local touchStartPosition = nil

    UIS.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.UserInputType == Enum.UserInputType.Touch then
            if lastSelectedSlot and slotFilled[lastSelectedSlot] and canPlaceTouch() and placingEnabled then
                activeTouch = input
                touchStartTime = tick()
                touchStartPosition = input.Position
                placeToggle.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
            end
        end
    end)

    UIS.InputEnded:Connect(function(input, processed)
        if input.UserInputType == Enum.UserInputType.Touch and input == activeTouch then
            activeTouch = nil
            touchStartPosition = nil
            placeToggle.BackgroundColor3 = placingEnabled and Library.Colors.Success or Library.Colors.Danger
        end
    end)

    spawn(function()
        while true do
            if activeTouch and touchStartPosition and canPlaceTouch() and placingEnabled then
                if tick() - touchStartTime >= 0.4 then
                    if lastSelectedSlot and slotFilled[lastSelectedSlot] then
                        local x, y, z = getWorldPositionPrecise(touchStartPosition)
                        if x and z then
                            local success, result = placeTowerAtPosition(slotNames[lastSelectedSlot], x, y, z)

                            if success then
                                placeToggle.BackgroundColor3 = Library.Colors.Success
                                local originalColor = slotButtons[lastSelectedSlot].BackgroundColor3
                                slotButtons[lastSelectedSlot].BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                                task.wait(0.1)
                                slotButtons[lastSelectedSlot].BackgroundColor3 = originalColor
                            else
                                placeToggle.BackgroundColor3 = Library.Colors.Danger
                                task.wait(0.2)
                                placeToggle.BackgroundColor3 = Library.Colors.Success
                            end
                        end
                    end
                    activeTouch = nil
                    touchStartPosition = nil
                end
            end
            wait(0.1)
        end
    end)
end

