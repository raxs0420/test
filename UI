function SC.requestUnitSourceAsync(unitName, skinName)
    local key = tostring(unitName) .. "\0" .. tostring(skinName)
    local cached = SC.unitSourceCache[key]
    if typeof(cached) == "Instance" and cached.Parent then return end
    if cached == false and SC.unitSourceCacheAt[key] and tick() - SC.unitSourceCacheAt[key] < 3 then return end
    if SC.unitSourcePending[key] then return end
    SC.unitSourcePending[key] = true
    task.delay(8, function() if SC.unitSourcePending[key] then SC.unitSourcePending[key] = nil end end)
    task.spawn(function()
        local path = ("Units/%s/Skins/%s"):format(tostring(unitName), tostring(skinName))
        local src = SC.findStreaming(path)
        if not src then
            local s = SC.getStreamer()
            if s and type(s.getAsset) == "function" then
                local ok, streamed = pcall(function() return s.getAsset(path, "SkinFolder") end)
                if ok and typeof(streamed) == "Instance" then src = streamed end
            end
        end
        if not src then
            for _ = 1, 40 do
                task.wait(0.1)
                src = SC.findStreaming(path)
                if src then break end
            end
        end
        if src and src.Parent then
            src = SC.installUnitSource(unitName, skinName, src) or src
            SC.unitSourceCache[key] = src
        else
            SC.unitSourceCache[key] = false
            SC.unitSourceCacheAt[key] = tick()
        end
        SC.unitSourcePending[key] = nil
    end)
end
function SC.getUnitSource(unitName, skinName, info)
    unitName = tostring(unitName or "")
    skinName = tostring(skinName or "Default")
    if unitName == "" or skinName == "" or skinName == "Default" then return nil end
    local cands, seen = {}, {}
    SC.addSkinCand(cands, seen, skinName)
    if info and type(info.unitSkinCandidates) == "table" then
        for _, c in ipairs(info.unitSkinCandidates) do SC.addSkinCand(cands, seen, c) end
    end
    local unitNames, unitSeen = {}, {}
    SC.addUnitName(unitNames, unitSeen, unitName)
    if info and type(info.unitSourceCandidates) == "table" then
        for _, n in ipairs(info.unitSourceCandidates) do SC.addUnitName(unitNames, unitSeen, n) end
    end
    for _, u in ipairs(unitNames) do
        for _, c in ipairs(cands) do
            local s = SC.findUnitSkinDirect(u, c)
            if s then return s end
        end
    end
    for _, u in ipairs(unitNames) do
        for _, c in ipairs(cands) do
            local s = SC.findUnitSkinFuzzy(u, c)
            if s then return s end
        end
    end
    if info and info.ownerTowerName then
        for _, u in ipairs(unitNames) do
            for _, c in ipairs(cands) do
                local s = SC.findUnitInOwnerSkin(info.ownerTowerName, c, u)
                if s then return s end
            end
        end
    end
    for _, u in ipairs(unitNames) do
        for _, c in ipairs(cands) do
            SC.requestUnitSourceAsync(u, c)
        end
    end
    return nil
end
