    local function updateSliderFromInput()
        if not dragging then return end
        local mousePos = UIS:GetMouseLocation()
        if mousePos.X == 0 and mousePos.Y == 0 then
            local touches = UIS:GetTouchPositions()
            if #touches > 0 then mousePos = touches[1] else return end
        end
        if sliderFrame.AbsoluteSize.X == 0 then return end
        local framePos = sliderFrame.AbsolutePosition.X
        local relativeX = math.clamp(mousePos.X - framePos, 0, sliderFrame.AbsoluteSize.X)
        local percent = relativeX / sliderFrame.AbsoluteSize.X
        local newDist = percent * currentMaxDistance
        newDist = math.clamp(newDist, 1, currentMaxDistance)
        if math.abs(_G.MercDistance - newDist) > 0.5 then
            _G.MercDistance = newDist
            updateSliderMax()
        end
    end
