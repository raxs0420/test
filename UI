        if music and music:IsA("Sound") then
            pcall(function()
                if not music.Playing then
                    music.Playing = true
                end
            end)
        end
    end
end
function SC.applyVisual(info)
    local model = info and info.model
    if not (model and model.Parent) then return end
    local skinName, resolved = SC.getInfoSkin(info)
    local towerName = tostring(resolved or info.name or "")
    if not skinName or skinName == "Default" then SC.restoreVisual(model); return end
    local level, path = SC.getUpgradeState(info)
    local state = SC.visuals[model]
    if state and state.skin == skinName and state.level == level and state.path == path then
        if state.clone and state.clone.Parent then
            SC.alignClone(state.clone, model, state.alignYOffset)
            SC.enforceHide(state)
            return
        end
        SC.restoreVisual(model)
    end
    if SC.visuals[model] then SC.restoreVisual(model) end
    local clone = SC.makeClone(towerName, skinName, info)
    if not clone then return end
    clone.Parent = SC.getVisualFolder()
    SC.runUpgrades(clone, info, level, path)
    local alignY = SC.alignClone(clone, model)
    if not SC.cloneLooksRenderable(clone) then pcall(function() clone:Destroy() end); return end
    local newState = {
        model = model, towerName = towerName,
        sourceKind = info and info.sourceKind,
        skin = skinName, level = level, path = path,
        clone = clone, alignYOffset = alignY,
        originals = {}, observedSounds = {}, connections = {},
    }
    newState.originals = SC.hideOriginal(model, newState)
    SC.visuals[model] = newState
    SC.buildSyncMaps(newState)
    SC.syncModelState(newState)
    newState.descendantConn = model.DescendantAdded:Connect(function(inst)
        SC.rememberHide(newState, inst)
    end)
    SC.observeAnims(info, newState)
    SC.observeSounds(newState)
    SC.resetSoundCaches(info)
    SC.installSpecialAudio(info, newState)
    SC.installTrapPatch(info, newState)
    if not next(newState.mirroredTracks or {}) then
        SC.playCloneAnim(newState, "Idle", { Priority = Enum.AnimationPriority.Core })
    end
end

function SC.spawnRuleMatches(rule, unitName)
    if not (rule and type(rule.units) == "table") then return false end
    unitName = tostring(unitName or "")
    local k = SC.key(unitName)
    if rule.units[unitName] == true or rule.units[k] == true then return true end
    local ok = SC.key(rule.owner)
    if ok == SC.key("Crook Boss") then
        return string.find(k, "goon", 1, true) ~= nil
            or string.find(k, "bodyguard", 1, true) ~= nil
            or string.find(k, "crook", 1, true) ~= nil
    elseif ok == SC.key("Military Base") then
        return string.find(k, "humvee", 1, true) ~= nil
            or string.find(k, "tank", 1, true) ~= nil
            or string.find(k, "railgun", 1, true) ~= nil
            or string.find(k, "apc", 1, true) ~= nil
            or string.find(k, "vehicle", 1, true) ~= nil
    elseif ok == SC.key("Engineer") then
        return string.find(k, "sentry", 1, true) ~= nil
    elseif ok == SC.key("Mecha Base") then
        return string.find(k, "mark", 1, true) ~= nil or string.find(k, "mecha", 1, true) ~= nil
    end
    return false
end
function SC.collectSpawnedCands(model, entity, ownerSkin, rule)
    local cands, seen = {}, {}
    SC.addSkinCand(cands, seen, ownerSkin)
    local aliases = rule and rule.aliases and rule.aliases[SC.key(ownerSkin)]
    if type(aliases) == "table" then
        for _, a in ipairs(aliases) do SC.addSkinCand(cands, seen, a) end
    end
    if type(entity) == "table" then
        pcall(function()
            local rep = entity.Replicator
            if rep then
                SC.addSkinCand(cands, seen, rep:Get("Skin"))
                SC.addSkinCand(cands, seen, rep:Get("SkinName"))
                SC.addSkinCand(cands, seen, rep:Get("UnitSkin"))
                SC.addSkinCand(cands, seen, rep:Get("UnitSkinName"))
            end
        end)
    end
    if model then
        SC.addSkinCand(cands, seen, model:GetAttribute("Skin"))
        SC.addSkinCand(cands, seen, model:GetAttribute("SkinName"))
        SC.addSkinCand(cands, seen, model:GetAttribute("UnitSkin"))
        local p = model:FindFirstChild("RootPointer")
        if p and p:IsA("ObjectValue") and p.Value then
            SC.addSkinCand(cands, seen, p.Value:GetAttribute("Skin"))
            SC.addSkinCand(cands, seen, p.Value:GetAttribute("SkinName"))
            SC.addSkinCand(cands, seen, p.Value:GetAttribute("UnitSkin"))
        end
    end
    return cands
end
function SC.resolveUnitName(model)
    local name = tostring(model and model.Name or "")
    local entity = nil
    local p = model and model:FindFirstChild("RootPointer")
    if p and p:IsA("ObjectValue") and p.Value then
        local r = SC.getUnitReplicator()
        if r and type(r.GetNPCFromFolder) == "function" then
            pcall(function() entity = r.GetNPCFromFolder(p.Value) end)
        end
    end
    if type(entity) == "table" then
        name = tostring(entity.Name or name)
        pcall(function()
            local rep = entity.Replicator
            local mn = rep and (rep:Get("ModelName") or rep:Get("DisplayName"))
            if type(mn) == "string" and mn ~= "" then name = mn end
        end)
    end
    local k = SC.key(name)
    return SC.crookGoons[k] or name, entity
end
function SC.getExtraUnits()
    local out = {}
    local uf = workspace:FindFirstChild("ClientUnits")
    if not uf then return out end
    for _, model in ipairs(uf:GetChildren()) do
        if model:IsA("Model") then
            local unitName, entity = SC.resolveUnitName(model)
            for _, rule in ipairs(SC.spawnRules) do
                if SC.spawnRuleMatches(rule, unitName) then
                    local ownerSkin = SC.getSavedSkin(rule.owner)
                    if ownerSkin and ownerSkin ~= "Default" then
                        local info = {
                            model = model, entity = entity, name = unitName,
                            sourceKind = "Unit", sourceName = unitName,
                            forcedTowerName = unitName, forcedSkinName = ownerSkin,
                            ownerTowerName = rule.owner, ownerSkinName = ownerSkin,
                            unitSkinCandidates = SC.collectSpawnedCands(model, entity, ownerSkin, rule),
                            unitSourceCandidates = SC.collectUnitNameCands(unitName, rule),
                        }
                        if SC.getUnitSource(unitName, ownerSkin, info) then
                            table.insert(out, info)
                            break
                        end
                    end
                end
            end
        end
    end
    return out
end
function SC.prefetchSpawned()
    for _, rule in ipairs(SC.spawnRules) do
        local ownerSkin = SC.getSavedSkin(rule.owner)
        if ownerSkin and ownerSkin ~= "Default" then
            local cands, seen = {}, {}
            SC.addSkinCand(cands, seen, ownerSkin)
            local aliases = rule.aliases and rule.aliases[SC.key(ownerSkin)]
            if type(aliases) == "table" then
                for _, a in ipairs(aliases) do SC.addSkinCand(cands, seen, a) end
            end
            for _, unitName in ipairs(rule.prefetchUnits or {}) do
                for _, c in ipairs(cands) do SC.requestUnitSourceAsync(unitName, c) end
            end
        end
    end
end
function SC.prefetchSaved()
    local sel = SC.getSelections()
    local streamer = SC.getStreamer()
    local requests, keys = {}, {}
    for towerName, skinName in pairs(sel) do
        towerName = tostring(towerName or "")
        skinName = tostring(skinName or "Default")
        if towerName ~= "" and skinName ~= "" and skinName ~= "Default" and SC.skinExists(towerName, skinName) then
            local key = towerName .. "\0" .. skinName
            local cached = SC.sourceCache[key]
            if not SC.sourcePending[key] and not (typeof(cached) == "Instance" and cached.Parent) then
                local path = ("Troops/%s/Skins/%s"):format(towerName, skinName)
                SC.sourcePending[key] = true
                task.delay(8, function() if SC.sourcePending[key] then SC.sourcePending[key] = nil end end)
                table.insert(keys, key)
                table.insert(requests, { path = path, context = "SkinFolder" })
            end
        end
    end
    if #requests == 0 then return end
    task.spawn(function()
        if streamer and type(streamer.getAssets) == "function" then
            local ok, assets = pcall(function() return streamer.getAssets(requests) end)
            if ok and type(assets) == "table" then
                for idx, source in pairs(assets) do
                    local key = keys[idx]
                    if key and typeof(source) == "Instance" and source.Parent then
                        local tn, sn = string.match(key, "^([^%z]+)%z(.+)$")
                        source = SC.installSource(tn, sn, source) or source
                        SC.sourceCache[key] = source
                    end
                end
            end
        else
            for idx, req in ipairs(requests) do
                local key = keys[idx]
                local source = SC.findStreaming(req.path)
                if key and source and source.Parent then
                    local tn, sn = string.match(key, "^([^%z]+)%z(.+)$")
                    source = SC.installSource(tn, sn, source) or source
                    SC.sourceCache[key] = source
                end
            end
        end
        for _, key in ipairs(keys) do
            local cached = SC.sourceCache[key]
            if not (typeof(cached) == "Instance" and cached.Parent) then
                SC.sourceCache[key] = false
                SC.sourceCacheAt[key] = tick()
            end
            SC.sourcePending[key] = nil
        end
    end)
end
function SC.refreshVisuals()
    local seen = {}
    for _, info in ipairs(SC.getOwned()) do
        if info.model then seen[info.model] = true; SC.applyVisual(info) end
    end
    for _, info in ipairs(SC.getExtraUnits()) do
        if info.model then seen[info.model] = true; SC.applyVisual(info) end
    end
    for model in pairs(SC.visuals) do
        if not seen[model] or not (model and model.Parent) then SC.restoreVisual(model) end
    end
    SC.cleanupStale()
end
function SC.getOrigPlacementSkin(towerName, fallbackSkin)
    towerName = tostring(towerName or "")
    local ot = SC.captureOriginalTroops()
    local owned = type(ot) == "table" and ot[towerName]
    if type(owned) == "table" and type(owned.Skin) == "string" and owned.Skin ~= "" then return owned.Skin end
    local cm = SC.getClientCache()
    local lt = SC.getCacheValue(cm, "Inventory.Troops", {}) or {}
    owned = type(lt) == "table" and lt[towerName]
    if type(owned) == "table" and type(owned.Skin) == "string" and owned.Skin ~= "" then
        local saved = SC.getSelections()[towerName]
        if owned.Skin ~= saved then return owned.Skin end
    end
    fallbackSkin = tostring(fallbackSkin or "Default")
    if fallbackSkin ~= "" and fallbackSkin ~= tostring(SC.getSelections()[towerName] or "") then
        return fallbackSkin
    end
    return "Default"
end
function SC.getPreviewPlacementSkin(towerName, fallbackSkin)
    towerName = tostring(towerName or "")
    if not SC.supportsTower(towerName) then return SC.getOrigPlacementSkin(towerName, fallbackSkin) end
    local saved = SC.getSavedSkin(towerName)
    if SC.enabled and saved and saved ~= "Default" and SC.skinExists(towerName, saved) then return saved end
    return SC.getOrigPlacementSkin(towerName, fallbackSkin)
end
function SC.patchHotbar()
    if SC.hotbarPatched then return true end
    local hotbar = SC.safeRequirePath(ReplicatedStorage, "Client", "Modules", "LegacyInterfaces", "Elements", "Hotbar")
    local clicked = hotbar and hotbar.Clicked
    if type(clicked) ~= "table" or type(clicked.Fire) ~= "function" then return false end
    
    if clicked.SkinSafePatched then 
        SC.hotbarPatched = true
        return true 
    end
    
    local orig = clicked.Fire
    clicked.SkinOriginalFire = orig
    clicked.SkinSafePatched = true
    
    clicked.Fire = function(self, towerName, skinName, goldenPerks, ...)
        if _G.SyncHotbarToUI then pcall(_G.SyncHotbarToUI, towerName) end
        
        local safeSkin = SC.getPreviewPlacementSkin(towerName, skinName)
        return orig(self, towerName, safeSkin, goldenPerks, ...)
    end
    
    SC.hotbarPatched = true
    return true
end
function SC.start()
    if SC.thread then return true end
    pcall(SC.patchHotbar)
    local sel = SC.getSelections()
    local removed = false
    for tn in pairs(sel) do
        if not SC.supportsTower(tn) then sel[tn] = nil; removed = true end
    end
    if removed then saveSettings() end
    local cm = SC.getClientCache()
    if cm then
        pcall(SC.captureOriginalTroops, cm)
        pcall(SC.rememberFromCache, cm)
        pcall(SC.applyToCache, cm)
        pcall(SC.prefetchSaved)
        pcall(SC.prefetchSpawned)
        local tc = cm("Inventory.Troops")
        local sc = cm("Inventory.Skins")
        if tc and tc.Updated and type(tc.Updated.Connect) == "function" then
            SC.cacheConn = tc.Updated:Connect(function()
                if SC.suppressRemember then return end
                SC.originalTroops = nil
                pcall(SC.captureOriginalTroops, cm)
                pcall(SC.rememberFromCache, cm)
                task.defer(function() if SC.enabled then pcall(SC.applyToCache, cm) end end)
            end)
        end
        if sc and sc.Updated and type(sc.Updated.Connect) == "function" then
            SC.skinCacheConn = sc.Updated:Connect(function()
                if SC.suppressRemember then return end
                pcall(SC.rememberFromCache, cm)
                task.defer(function() if SC.enabled then pcall(SC.applyToCache, cm) end end)
            end)
        end
    end
    SC.enabled = true
    _G.SkinChangerEnabled = true
    saveSettings()
    SC.cleanupStale()
    pcall(SC.refreshVisuals)
    local tf = workspace:FindFirstChild("Towers")
    if tf and not SC.towerConn then
        SC.towerConn = tf.ChildAdded:Connect(function()
            task.defer(function() if SC.enabled then pcall(SC.refreshVisuals) end end)
            task.delay(0.15, function() if SC.enabled then pcall(SC.refreshVisuals) end end)
        end)
    end
    local uf = workspace:FindFirstChild("ClientUnits")
    if uf and not SC.unitConn then
        SC.unitConn = uf.ChildAdded:Connect(function()
            task.defer(function() if SC.enabled then pcall(SC.refreshVisuals) end end)
            task.delay(0.15, function() if SC.enabled then pcall(SC.refreshVisuals) end end)
        end)
    end
    if not SC.unitFolderConn then
        SC.unitFolderConn = workspace.ChildAdded:Connect(function(child)
            if child.Name ~= "ClientUnits" then return end
            task.defer(function()
                if not SC.enabled then return end
                if SC.unitConn then SC.unitConn:Disconnect(); SC.unitConn = nil end
                SC.unitConn = child.ChildAdded:Connect(function()
                    task.defer(function() if SC.enabled then pcall(SC.refreshVisuals) end end)
                    task.delay(0.15, function() if SC.enabled then pcall(SC.refreshVisuals) end end)
                end)
                pcall(SC.refreshVisuals)
            end)
        end)
    end
    SC.thread = task.spawn(function()
        local nextRefresh = 0
        while SC.enabled do
            local now = tick()
            if now >= nextRefresh then
                nextRefresh = now + 0.5
                pcall(SC.refreshVisuals)
            end
            for model, state in pairs(SC.visuals) do
                if state and state.clone and state.clone.Parent and model and model.Parent then
                    local moving = state.sourceKind == "Unit"
                    if not state.nextAlignAt or now >= state.nextAlignAt then
                        state.nextAlignAt = now + (moving and 0.035 or 0.15)
                        pcall(SC.alignClone, state.clone, model, state.alignYOffset)
                    end
                    if not state.nextAnimSyncAt or now >= state.nextAnimSyncAt then
                        state.nextAnimSyncAt = now + 0.08
                        pcall(SC.syncMirror, state)
                    end
                    if not state.nextModelSyncAt or now >= state.nextModelSyncAt then
                        state.nextModelSyncAt = now + (moving and 0.05 or 0.1)
                        pcall(SC.syncModelState, state)
                    end
                    if not state.nextHideAt or now >= state.nextHideAt then
                        state.nextHideAt = now + 0.2
                        pcall(SC.enforceHide, state)
                    end
                end
            end
            task.wait(0.03)
        end
        SC.thread = nil
    end)
    return true
end
function SC.stop()
    SC.enabled = false
    _G.SkinChangerEnabled = false
    saveSettings()
    local cm = SC.getClientCache()
    if cm then pcall(SC.restoreTroopCache, cm) end
    SC.originalTroops = nil
    if SC.cacheConn then pcall(function() SC.cacheConn:Disconnect() end); SC.cacheConn = nil end
    if SC.skinCacheConn then pcall(function() SC.skinCacheConn:Disconnect() end); SC.skinCacheConn = nil end
    if SC.towerConn then pcall(function() SC.towerConn:Disconnect() end); SC.towerConn = nil end
    if SC.unitConn then pcall(function() SC.unitConn:Disconnect() end); SC.unitConn = nil end
    if SC.unitFolderConn then pcall(function() SC.unitFolderConn:Disconnect() end); SC.unitFolderConn = nil end
    if SC.thread then pcall(task.cancel, SC.thread); SC.thread = nil end
    for model in pairs(SC.visuals) do pcall(SC.restoreVisual, model) end
    pcall(SC.cleanupStale)
    if SC.visualFolder and SC.visualFolder.Parent and #SC.visualFolder:GetChildren() == 0 then
        pcall(function() SC.visualFolder:Destroy() end)
    end
    SC.visualFolder = nil
end

