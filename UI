    stroke(scrollFrame, 1, C.border, 0.4)

    local observedTowers = {}

    local function getOptionsDict(rep)
        local opt = rep:GetAttribute("Options")
        if not opt then return {} end
        
        if type(opt) == "table" then
            return opt
        elseif type(opt) == "string" then
            local success, decoded = pcall(function() return game:GetService("HttpService"):JSONDecode(opt) end)
            if success and type(decoded) == "table" then 
                return decoded 
            end
            local result = {}
            for k, v in string.gmatch(opt, '"([^"]+)"%s*:%s*"([^"]+)"') do
                result[k] = v
            end
            return result
        end
        return {}
    end

    local function getMappedValue(towerName, val)
        local v = tostring(val)
        if v == "" then return "" end
        
        if towerName == "Mercenary Base" then
            if v == "Rifle" then return "Rifleman" end
            if v == "Granade" or v == "Grenade" then return "Grenadier" end
            if v == "Guard" then return "Riot Guard" end
            if v == "Medic" then return "Field Medic" end
        elseif towerName == "Jester" then
            if v == "1" then return "Fire" end
            if v == "2" then return "Ice" end
            if v == "3" then return "Poison" end
            if v == "4" then return "Confusion" end
        elseif towerName == "Elementalist" then
            if v == "1" then return "Frost" end
            if v == "2" then return "Fire" end
        elseif towerName == "Evolved Kingpin" then
            if v == "MoneyRunner" then return "Money Runner" end
        end
        
        return v
    end

    local function buildSelectionUI()
        for _, child in ipairs(scrollFrame:GetChildren()) do child:Destroy() end
        local tf = Workspace:FindFirstChild("Towers")
        if not tf then return end
        
        local owned = {}
        for _, folder in ipairs(tf:GetChildren()) do
            local name = getTowerName(folder)
            if name and TOWER_OPTIONS[name] and isOwnedByPlayer(folder) then
                table.insert(owned, folder)
            end
        end
        
        if #owned == 0 then
            local lbl = Instance.new("TextLabel", scrollFrame)
            lbl.Size = UDim2.new(1, -12, 0, 24)
            lbl.Position = UDim2.fromOffset(6, 6)
            lbl.BackgroundTransparency = 1
            lbl.TextColor3 = C.textDim
            lbl.TextSize = 11
            lbl.Font = Enum.Font.GothamBold
            lbl.Text = "No selectable towers found"
            return
        end
        
        local yPos = 6
        for _, folder in ipairs(owned) do
            local name = getTowerName(folder)
            local level = getTowerLevel(folder)
            local rep = folder:FindFirstChild("TowerReplicator")
            local path = rep and rep:GetAttribute("Path") or 0
            
            local config = TOWER_OPTIONS[name]
            if config[1] then
                config = config[path] or config[1]
            end
            
            if config and config.slots then
                local options = config.options
                local reqs = config.reqs or {}
                local slot_reqs = config.slot_reqs or {}
                
                local currentOptions = getOptionsDict(rep)
                
                if rep and not observedTowers[rep] then
                    observedTowers[rep] = true
                    rep:GetAttributeChangedSignal("Options"):Connect(function()
                        if CurrentTab == "SELECTION" then
                            local refreshDebounce = false
                            if not refreshDebounce then
                                refreshDebounce = true
                                task.spawn(function()
                                    buildSelectionUI()
                                    task.wait(0.1)
                                    refreshDebounce = false
                                end)
                            end
                        end
                    end)
                end
                
                local visibleSlots = 0
                for i = 1, #config.slots do
                    if level >= (slot_reqs[i] or 0) then
                        visibleSlots += 1
                    end
                end
                
                if visibleSlots > 0 then
                    local sectionFrame = Instance.new("Frame", scrollFrame)
                    sectionFrame.BackgroundColor3 = C.card
                    sectionFrame.BorderSizePixel = 0
                    sectionFrame.Position = UDim2.fromOffset(6, yPos)
                    corner(sectionFrame, 6)
                    stroke(sectionFrame, 1, C.border, 0.4)

                    local rowH, gapH, topM, botM = 26, 3, 22, 6
                    local totalH = topM + (visibleSlots * rowH) + ((visibleSlots - 1) * gapH) + botM
                    sectionFrame.Size = UDim2.new(1, -12, 0, totalH)

                    local titleLbl = Instance.new("TextLabel", sectionFrame)
                    titleLbl.Size = UDim2.new(1, -16, 0, 16)
                    titleLbl.Position = UDim2.fromOffset(8, 4)
                    titleLbl.BackgroundTransparency = 1
                    local pathText = (path > 0) and (" (Path " .. path .. ")") or ""
                    titleLbl.Text = string.format("%s  (L%d)%s", name, level, pathText)
                    titleLbl.TextColor3 = C.accent
                    titleLbl.Font = Enum.Font.GothamBold
                    titleLbl.TextSize = 11
                    titleLbl.TextXAlignment = Enum.TextXAlignment.Left

                    local yRow = topM
                    for slot = 1, visibleSlots do
                        local slotName = config.slots[slot]
                        local rawVal = tostring(currentOptions[slotName] or "")
                        local currentDisp = getMappedValue(name, rawVal)

                        local rowFrame = Instance.new("Frame", sectionFrame)
                        rowFrame.Size = UDim2.new(1, -16, 0, rowH)
                        rowFrame.Position = UDim2.fromOffset(8, yRow)
                        rowFrame.BackgroundTransparency = 1

                        local btnGap = 0.02
                        local btnW = (1 - (#options - 1) * btnGap) / #options
                        
                        for i, opt in ipairs(options) do
                            local btn = Instance.new("TextButton", rowFrame)
                            btn.Size = UDim2.new(btnW, 0, 1, 0)
                            btn.Position = UDim2.new((i - 1) * (btnW + btnGap) + btnGap / 2, 0, 0, 0)
                            
                            local isSel = (currentDisp == opt)
                            
                            if currentDisp == "" then
                                if (opt == "Sunflower" and name == "Biologist") or
                                   (opt == "Rifleman" and name == "Mercenary Base") or
                                   (opt == "Lackey" and name == "Evolved Kingpin") or
                                   (opt == "Purple" and name == "DJ Booth") or
                                   (opt == "Spike" and name == "Trapper") or
                                   (opt == "Fire" and name == "Jester") or
                                   (opt == "Frost" and name == "Elementalist") then
                                    isSel = true
                                end
                            end
                            
                            local reqLevel = reqs[opt] or 0
                            local unlocked = level >= reqLevel
                            
                            btn.Text = opt
                            btn.Font = Enum.Font.GothamBold
                            btn.TextSize = 10
                            btn.AutoButtonColor = false
                            corner(btn, 5)
                            
                            if unlocked then
                                if isSel then
                                    btn.BackgroundColor3 = C.accent
                                    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                                else
                                    btn.BackgroundColor3 = C.surface
                                    btn.TextColor3 = C.textSec
                                end
                                stroke(btn, 1, C.border, 0.4)
                                hover(btn, C.surfaceAlt, C.text)
                                
                                btn.MouseButton1Click:Connect(function()
                                    local sendValue = isSel and "" or opt
                                    
                                    pcall(function()
                                        RemoteFunction:InvokeServer("Troops", "Option", "Set", {
                                            Troop = folder, Name = slotName, Value = sendValue
                                        })
                                    end)
                                    
                                    task.wait(0.05)
                                    buildSelectionUI()
                                end)
                            else
                                btn.BackgroundColor3 = Color3.fromRGB(14, 16, 20)
                                btn.TextColor3 = Color3.fromRGB(70, 78, 82)
                                stroke(btn, 1, Color3.fromRGB(30, 34, 38), 0.5)
                                btn.Text = opt .. " (L" .. reqLevel .. ")"
                            end
                        end
                        yRow += rowH + gapH
                    end
                    yPos += totalH + 6
                end
            end
        end
        task.defer(function()
            scrollFrame.CanvasSize = UDim2.new(0, 0, 0, yPos + 6)
        end)
    end

    local refreshDebounce = false
    local function safeRefresh()
        if not refreshDebounce then
            refreshDebounce = true
            task.spawn(function()
                buildSelectionUI()
                task.wait(0.1)
                refreshDebounce = false
            end)
        end
    end

    buildSelectionUI()

    local tf = Workspace:FindFirstChild("Towers")
    if tf then
        tf.ChildAdded:Connect(function()
            if CurrentTab == "SELECTION" then safeRefresh() end
        end)
        tf.ChildRemoved:Connect(function()
            if CurrentTab == "SELECTION" then safeRefresh() end
        end)
    end

    task.spawn(function()
        while true do
            task.wait(1.5)
            if CurrentTab == "SELECTION" then safeRefresh() end
        end
    end)
end

