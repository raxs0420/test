    local function getWorldPositionPrecise(screenPosition)
        if isMobile then
            if terrain then
                local ok, pos = pcall(function()
                    return terrain:GetMousePosition(Camera, screenPosition)
                end)
                if ok and pos then return pos.X, pos.Y + 2, pos.Z end
            end
            local ray = Camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Blacklist
            rp.FilterDescendantsInstances = {player.Character, Camera}
            rp.IgnoreWater = true
            local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
            if result then return result.Position.X, result.Position.Y + 2, result.Position.Z end
            local dirs = {
                ray.Direction,
                Vector3.new(ray.Direction.X, ray.Direction.Y - 0.1, ray.Direction.Z),
                Vector3.new(ray.Direction.X, ray.Direction.Y + 0.1, ray.Direction.Z)
            }
            for _, dir in ipairs(dirs) do
                local fb = Workspace:Raycast(ray.Origin, dir * 1000, rp)
                if fb then return fb.Position.X, fb.Position.Y + 2, fb.Position.Z end
            end
            return nil, nil, nil
        else
            local ray = Camera:ViewportPointToRay(screenPosition.X, screenPosition.Y)
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Blacklist
            rp.FilterDescendantsInstances = {player.Character, Camera}
            rp.IgnoreWater = true
            local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
            if result then return result.Position.X, result.Position.Y + 5, result.Position.Z end
            local dirs = {
                ray.Direction,
                Vector3.new(ray.Direction.X, ray.Direction.Y - 0.05, ray.Direction.Z),
                Vector3.new(ray.Direction.X, ray.Direction.Y + 0.05, ray.Direction.Z)
            }
            for _, dir in ipairs(dirs) do
                local fb = Workspace:Raycast(ray.Origin, dir * 1000, rp)
                if fb then return fb.Position.X, fb.Position.Y + 5, fb.Position.Z end
            end
            return nil, nil, nil
        end
    end

