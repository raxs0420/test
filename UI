local function GetEquippedTowers()
    local towers = {}
    local StateReplicators = ReplicatedStorage:FindFirstChild("StateReplicators")
    
    if not StateReplicators then return {} end

    for _, folder in ipairs(StateReplicators:GetChildren()) do
        if folder and folder.Name == "PlayerReplicator" then
            local userId = folder:GetAttribute("UserId")
            if userId == player.UserId then
                local equipped = folder:GetAttribute("EquippedTowers")
                if type(equipped) == "string" and equipped ~= "" then
                    local CleanedJson = equipped:match("%[.*%]") 
                    if CleanedJson then
                        local success, TowerTable = pcall(HttpService.JSONDecode, HttpService, CleanedJson)
                        if success and type(TowerTable) == "table" then
                            for i = 1, math.min(5, #TowerTable) do
                                if TowerTable[i] and TowerTable[i] ~= "None" then
                                    table.insert(towers, TowerTable[i])
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return towers
end

local function AssignEquippedTowersToSlots()
    local equippedTowers = GetEquippedTowers()

    if #equippedTowers > 0 then
        for i = 1, math.min(5, #equippedTowers) do
            if equippedTowers[i] and equippedTowers[i] ~= "None" then
                slotFilled[i] = true
                slotNames[i] = equippedTowers[i]
                slotButtons[i].BackgroundColor3 = Library.Colors.Success
                slotButtons[i].Text = equippedTowers[i]
                slotButtons[i].TextColor3 = Library.Colors.Text
            end
        end
    end
end

