Instance.new("UICorner", logBox)

local logLayout = Instance.new("UIListLayout", logBox)
logLayout.Padding = UDim.new(0, 2)
logLayout.SortOrder = Enum.SortOrder.LayoutOrder

local recording = false
local actions = {}
local nextMacroId = 1
local nextRealId = 1
local freeRealIds = {}         
local realIdToMacroId = {}
local macroIdToRealId = {}     
local pendingUpgrade = nil

local function addLog(msg, color)
    local label = Instance.new("TextLabel", logBox)
    label.Size = UDim2.new(1, -10, 0, 14)
    label.Text = msg
    label.TextColor3 = color or Color3.fromRGB(200,200,200)
    label.TextSize = 10
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Code
    task.wait()
    logBox.CanvasSize = UDim2.new(0, 0, 0, logLayout.AbsoluteContentSize.Y)
    logBox.CanvasPosition = Vector2.new(0, logBox.CanvasSize.Y.Offset)
    return label
end

local function allocateRealId()
    if #freeRealIds > 0 then
        return table.remove(freeRealIds)
    else
        local id = nextRealId
        nextRealId = nextRealId + 1
        return id
    end
end

local function freeRealId(id)
    table.insert(freeRealIds, id)
end

local function monitorUpgrades()
    task.spawn(function()
        while recording do
            task.wait(0.01)
            if pendingUpgrade then
                local cmd = string.format('TDX:Upgrade(%d, %s, %d)', pendingUpgrade.macroId, pendingUpgrade.path, pendingUpgrade.level)
                table.insert(actions, cmd)
                addLog(cmd, Color3.fromRGB(150, 255, 150))
                pendingUpgrade = nil
            end
        end
    end)
end

if TowersFolder then
    TowersFolder.ChildAdded:Connect(function(part)
        if not recording then return end
        if not part:IsA("BasePart") then return end
        task.wait(0.05)
        if not part.Parent then return end

        local name = part.Name
        local pos = part.Position

        local realId = allocateRealId()

        local macroId = nextMacroId
        nextMacroId = nextMacroId + 1

        realIdToMacroId[realId] = macroId
        macroIdToRealId[macroId] = realId

        local cmd = string.format('TDX:Place("%s", %.6f, %.6f, %.6f, %d)', name, pos.X, pos.Y, pos.Z, macroId)
        table.insert(actions, cmd)
        addLog(cmd, Color3.fromRGB(100, 255, 100))
        addLog(string.format("  → Real ID: %d → Macro ID: %d", realId, macroId), Color3.fromRGB(150, 150, 150))
    end)
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if recording and (method == "FireServer" or method == "InvokeServer") then
        if self.Name == "TowerUpgradeRequest" then
            local realId = args[1]
            local path = args[2] or 1
            local level = args[3] or 1
            local macroId = realIdToMacroId[realId]
            if macroId then
                pendingUpgrade = {macroId = macroId, path = path, level = level}
            end

        elseif self.Name == "SellTower" then
            local realId = args[1]
            local macroId = realIdToMacroId[realId]
            if macroId then
                local cmd = string.format('TDX:Sell(%d)', macroId)
                table.insert(actions, cmd)
                addLog(cmd, Color3.fromRGB(255, 150, 100))
                freeRealId(realId)
                realIdToMacroId[realId] = nil
                macroIdToRealId[macroId] = nil
            end
        end
    end

    return oldNamecall(self, ...)
end)

local function generateScript()
    local lines = {
        "local TDX = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/raxs0420/test/refs/heads/main/library%20new/tdx%20test%20test\"))()",
        "TDX:SetupUpgradeListener()",
        "task.wait(2)",
        ""
    }
    for _, cmd in ipairs(actions) do
        table.insert(lines, cmd)
    end
    return table.concat(lines, "\n")
end

local function startRecording()
    recording = true
    actions = {}
    nextMacroId = 1
    nextRealId = 1
    freeRealIds = {}
    realIdToMacroId = {}
    macroIdToRealId = {}
    pendingUpgrade = nil
    recordBtn.Text = "STOP RECORDING"
    recordBtn.BackgroundColor3 = Color3.fromRGB(231,76,60)
    addLog("=== RECORDING STARTED ===", Color3.fromRGB(100, 255, 100))
    addLog("Macro IDs are SEQUENTIAL (1,2,3...)", Color3.fromRGB(255, 200, 100))
    monitorUpgrades()
end

local function stopRecording()
    recording = false
    recordBtn.Text = "START RECORDING"
    recordBtn.BackgroundColor3 = Color3.fromRGB(46,204,113)
    if #actions > 0 then
        addLog(string.format("=== RECORDING STOPPED - %d actions ===", #actions), Color3.fromRGB(100, 255, 100))
        addLog(string.format("Macro IDs used: 1 through %d", nextMacroId - 1), Color3.fromRGB(255, 200, 100))
    else
        addLog("=== RECORDING STOPPED - No actions ===", Color3.fromRGB(255, 200, 100))
    end
end

local function copyScript()
    local scriptText = generateScript()
    if setclipboard then
        setclipboard(scriptText)
        addLog(string.format("✓ Script copied! (%d actions)", #actions), Color3.fromRGB(100, 255, 100))
        local oldColor = copyBtn.BackgroundColor3
        copyBtn.BackgroundColor3 = Color3.fromRGB(39,174,96)
        copyBtn.Text = "COPIED!"
        task.wait(0.5)
        copyBtn.BackgroundColor3 = oldColor
        copyBtn.Text = "COPY SCRIPT"
    else
        addLog("✗ No clipboard access - printed to console", Color3.fromRGB(255, 100, 100))
        print(scriptText)
    end
end

recordBtn.MouseButton1Click:Connect(function()
    if recording then stopRecording() else startRecording() end
end)
copyBtn.MouseButton1Click:Connect(copyScript)
closeBtn.MouseButton1Click:Connect(function()
    recording = false
    gui:Destroy()
end)

addLog("=== READY ===", Color3.fromRGB(100, 255, 100))