local function getLevel(hash, patch)
    local l = levels[hash]
    if not l then return 0 end
    return l[patch] or 0
end

local function getCurrentWave()
    local ok, text = pcall(function()
        return LocalPlayer.PlayerGui.Interface.GameInfoBar.Default.Wave.WaveText.Text
    end)
    if not ok or type(text) ~= "string" then return nil end
    local n = tonumber(text:match("%d+"))
    return n
end

local function resolvePendingUpgrades(hash)
    for i = #pendingUpgrades, 1, -1 do
        local p = pendingUpgrades[i]
        if p.hash == hash and not p.resolved then
            local cur = getLevel(hash, p.patch)
            if cur >= p.expected then
                p.resolved = true
                p.entry.include = true
                p.entry.label.TextColor3 = COLORS.good
                p.entry.label.Text = p.successText()
                table.remove(pendingUpgrades, i)
            end
        end
    end
end

local function buildPlaceCommand(name, timer, pos, rebuild, aim, id)
    local effective = logToggles.forceAutoRebuild and true or rebuild
    if aim then
        return string.format('TDX:Place("%s", %s, %s, %s, %s, %s) -- ID: %s',
            name, preciseNumber(timer), vectorPrecise(pos), tostring(effective),
            vectorPrecise(aim), tostring(id), tostring(id))
    end
    return string.format('TDX:Place("%s", %s, %s, %s, nil, %s) -- ID: %s',
        name, preciseNumber(timer), vectorPrecise(pos), tostring(effective),
        tostring(id), tostring(id))
end

local function buildPlaceDisplay(name, timer, pos, rebuild, aim, id)
    local effective = logToggles.forceAutoRebuild and true or rebuild
    if aim then
        return string.format('TDX:Place("%s", %s, %s, %s, %s, %s) -- ID: %s',
            name, preciseNumber(timer), vectorShort(pos), tostring(effective),
            vectorShort(aim), tostring(id), tostring(id))
    end
    return string.format('TDX:Place("%s", %s, %s, %s, nil, %s) -- ID: %s',
        name, preciseNumber(timer), vectorShort(pos), tostring(effective),
        tostring(id), tostring(id))
end

local function consumeFactoryMatch(record, info)
    local id = info.id
    local lvl = info.lvl

    record.resolved = true
    record.entry.include = true
    record.entry.label.TextColor3 = COLORS.good

    local display = buildPlaceDisplay(
        record.name, record.timer, record.pos, record.rebuild, record.aim, id)
    local exact = buildPlaceCommand(
        record.name, record.timer, record.pos, record.rebuild, record.aim, id)

    if record.waitPrefix and record.waitPrefix ~= "" then
        display = record.waitPrefix .. display
        exact = record.waitPrefix .. exact
    end

    record.entry.label.Text = display
    record.entry.exact = exact

    if id ~= nil and type(lvl) == "table" then
        levels[id] = { lvl[1] or 0, lvl[2] or 0 }
    end
    if id ~= nil and info.name then
        towerNames[id] = info.name
    end

    for i = #pendingPlaces, 1, -1 do
        if pendingPlaces[i] == record then
            table.remove(pendingPlaces, i)
            break
        end
    end
end

local function tryMatchPendingAgainstBuffer()
    for i = #pendingPlaces, 1, -1 do
        local record = pendingPlaces[i]
        if not record.resolved then
            local bestIdx, bestDist = nil, MATCH_DISTANCE
            for j, buffered in ipairs(factoryBuffer) do
                if not buffered.consumed and buffered.info.name == record.name then
                    local d = (buffered.info.pos - record.pos).Magnitude
                    if d < bestDist then
                        bestIdx, bestDist = j, d
                    end
                end
            end
            if bestIdx then
                local buffered = factoryBuffer[bestIdx]
                buffered.consumed = true
                consumeFactoryMatch(record, buffered.info)
                table.remove(factoryBuffer, bestIdx)
            end
        end
    end
end

local function pruneFactoryBuffer()
    local now = tick()
    for i = #factoryBuffer, 1, -1 do
        if now - factoryBuffer[i].timestamp > FACTORY_BUFFER_TTL then
            table.remove(factoryBuffer, i)
        end
    end
    while #factoryBuffer > FACTORY_BUFFER_MAX do
        table.remove(factoryBuffer, 1)
    end
end

local function parseFactoryInfo(raw)
    if type(raw) ~= "table" then return nil end
    local info = raw[1]
    if type(info) ~= "table" then return nil end
    local pos = info[4]
    if typeof(pos) ~= "Vector3" then return nil end
    return {
        id = info[1],
        name = info[2],
        pos = pos,
        username = info[7],
        lvl = info[8],
        timer = raw[2],
    }
end

if TowerFactoryQueueUpdated then
    TowerFactoryQueueUpdated.OnClientEvent:Connect(function(data)
        if type(data) ~= "table" then return end
        pruneFactoryBuffer()
        for _, item in ipairs(data) do
            if type(item) == "table" and item.Creation then
                local parsed = parseFactoryInfo(item.Data)
                if parsed then
                    if parsed.id ~= nil and type(parsed.lvl) == "table" then
                        levels[parsed.id] = { parsed.lvl[1] or 0, parsed.lvl[2] or 0 }
                    end
                    if parsed.id ~= nil and parsed.name then
                        towerNames[parsed.id] = parsed.name
                    end

                    if parsed.username == LocalPlayer.Name then
                        local matched = false
                        local bestIdx, bestDist = nil, MATCH_DISTANCE
                        for i, record in ipairs(pendingPlaces) do
                            if not record.resolved and record.name == parsed.name then
                                local d = (parsed.pos - record.pos).Magnitude
                                if d < bestDist then
                                    bestIdx, bestDist = i, d
                                end
                            end
                        end
                        if bestIdx then
                            local record = pendingPlaces[bestIdx]
                            consumeFactoryMatch(record, parsed)
                            matched = true
                        end

                        if not matched then
                            table.insert(factoryBuffer, {
                                info = parsed,
                                timestamp = tick(),
                                consumed = false,
                            })
                        end
                    end
                end
            end
        end
    end)
end

