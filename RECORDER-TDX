local function resolvePendingSkips(votes)
    for i = #pendingSkips, 1, -1 do
        local p = pendingSkips[i]
        if not p.resolved and votes >= 1 then
            p.resolved = true
            p.entry.include = true
            p.entry.label.TextColor3 = COLORS.good

            local line, exact
            if p.wave then
                line = string.format("TDX:Skip(%d) -- skipped wave %d", p.wave, p.wave)
                exact = string.format("TDX:Skip(%d)", p.wave)
            else
                line = "TDX:Skip() -- yes votes: " .. tostring(votes)
                exact = "TDX:Skip()"
            end

            if p.waitPrefix and p.waitPrefix ~= "" then
                line = p.waitPrefix .. line
                exact = p.waitPrefix .. exact
            end

            p.entry.label.Text = line
            p.entry.exact = exact

            table.remove(pendingSkips, i)
        end
    end
end

