local function getUICosts()
    local path1Cost = 0
    local path2Cost = 0

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local interface = playerGui:FindFirstChild("Interface")
        if interface then
            local towerUI = interface:FindFirstChild("TowerUI")
            if towerUI and towerUI.Visible then
                local path1Button = towerUI:FindFirstChild("Path1Button")
                if path1Button then
                    local costText = path1Button:FindFirstChild("CostText")
                    if costText and costText:IsA("TextLabel") then
                        local costStr = costText.Text:gsub("[^%d]", "")
                        path1Cost = tonumber(costStr) or 0
                    end
                end

                local path2Button = towerUI:FindFirstChild("Path2Button")
                if path2Button then
                    local costText = path2Button:FindFirstChild("CostText")
                    if costText and costText:IsA("TextLabel") then
                        local costStr = costText.Text:gsub("[^%d]", "")
                        path2Cost = tonumber(costStr) or 0
                    end
                end
            end
        end
    end

    return path1Cost, path2Cost
end

local function getTowerCost(towerName)
    local towersBar = LocalPlayer.PlayerGui:FindFirstChild("Interface"):FindFirstChild("BottomBar"):FindFirstChild("TowersBar")
    if towersBar then
        local towerFolder = towersBar:FindFirstChild(towerName)
        if towerFolder then
            local costFrame = towerFolder:FindFirstChild("CostFrame")
            if costFrame then
                local costText = costFrame:FindFirstChild("CostText")
                if costText and costText:IsA("TextLabel") then
                    local costStr = costText.Text:gsub("[^%d]", "")
                    local cost = tonumber(costStr)
                    return cost or 0
                end
            end
        end
    end
    return 0
end

local function getEquippedTowers()
    local towers = {}
    local towersBar = LocalPlayer.PlayerGui:FindFirstChild("Interface"):FindFirstChild("BottomBar"):FindFirstChild("TowersBar")
    if towersBar then
        for _, child in ipairs(towersBar:GetChildren()) do
            if child:IsA("Frame") or child:IsA("ImageButton") then
                local towerName = child.Name
                if towerName ~= "TowerTemplate" and towerName ~= "TouchPlacementButtons" and towerName ~= "UIGridLayout" then
                    table.insert(towers, towerName)
                end
            end
        end
    end
    return towers
end

local function addLog(msg, color, isPending)
    local label = Instance.new("TextLabel", logBox)
    label.Size = UDim2.new(1, -10, 0, 14)
    label.Text = msg
    label.TextColor3 = color or Color3.fromRGB(200,200,200)
    label.TextSize = 10
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Code

    if isPending then
        label.Position = UDim2.new(0, 15, 0, 0)
        label.Text = "  " .. msg
    end

    task.wait()
    logBox.CanvasSize = UDim2.new(0, 0, 0, logLayout.AbsoluteContentSize.Y)
    logBox.CanvasPosition = Vector2.new(0, logBox.CanvasSize.Y.Offset)
    return label
end

local function updatePendingLog(index, cost)
    if pendingUpgradeLines[index] then
        local label = pendingUpgradeLines[index]
        local newMsg = label.Text:gsub("%(Waiting for cost%.%.%.%)$", "[" .. cost .. "$]")
        label.Text = newMsg
        label.TextColor3 = Color3.fromRGB(100, 255, 100)
        label.Position = UDim2.new(0, 5, 0, 0)
    end
end

local function monitorUI()
    task.spawn(function()
        while recording do
            local path1Cost, path2Cost = getUICosts()

            if path1Cost ~= currentUIState.path1Cost and currentUIState.path1Cost > 0 then
                for i = #actions, 1, -1 do
                    local action = actions[i]
                    if action:match("Upgrade") and action:match(", 0%)$") then
                        local newAction = action:gsub(", 0%)$", ", " .. currentUIState.path1Cost .. ")")
                        actions[i] = newAction
                        updatePendingLog(i, currentUIState.path1Cost)
                        addLog(string.format("  → Cost applied: $%d", currentUIState.path1Cost), Color3.fromRGB(100, 255, 100), true)
                        break
                    end
                end
            end

            if path2Cost ~= currentUIState.path2Cost and currentUIState.path2Cost > 0 then
                for i = #actions, 1, -1 do
                    local action = actions[i]
                    if action:match("Upgrade") and action:match(", 0%)$") then
                        local newAction = action:gsub(", 0%)$", ", " .. currentUIState.path2Cost .. ")")
                        actions[i] = newAction
                        updatePendingLog(i, currentUIState.path2Cost)
                        addLog(string.format("  → Cost applied: $%d", currentUIState.path2Cost), Color3.fromRGB(100, 255, 100), true)
                        break
                    end
                end
            end

            currentUIState.path1Cost = path1Cost
            currentUIState.path2Cost = path2Cost

            task.wait(0.01)
        end
    end)
end

if TowersFolder then
    TowersFolder.ChildAdded:Connect(function(part)
        if not recording then return end
        if not part:IsA("BasePart") then return end
        task.wait(0.05)
        local name = part.Name
        local pos = part.Position
        local towerId = nextTowerId
        nextTowerId = nextTowerId + 1
        knownParts[part] = towerId
        towerIdMap[part] = towerId

        local cost = getTowerCost(name)
        local cmd = string.format('local id%d = TDX:Place("%s", %.6f, %.6f, %.6f, 0, %d)', towerId, name, pos.X, pos.Y, pos.Z, cost)
        table.insert(actions, {cmd = cmd, towerId = towerId})
        addLog(cmd, Color3.fromRGB(100, 255, 100))
    end)
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if recording and (method == "FireServer" or method == "InvokeServer") then
        if self.Name == "TowerUpgradeRequest" then
            local id = args[1]
            local path = args[2] or 1
            local level = args[3] or 1
            
            local cmd = string.format('TDX:Upgrade(id%d, %d, %d, 0)', id, path, level)
            table.insert(actions, {cmd = cmd, isUpgrade = true})
            local logLabel = addLog(cmd .. " (Waiting for cost...)", Color3.fromRGB(150, 255, 150), true)
            pendingUpgradeLines[#actions] = logLabel
        elseif self.Name == "SellTower" then
            local id = args[1]
            local cmd = string.format('TDX:Sell(id%d)', id)
            table.insert(actions, {cmd = cmd, isSell = true})
            addLog(cmd, Color3.fromRGB(255, 150, 150))
        end
    end
    return oldNamecall(self, ...)
end)

local function generateScript()
    equippedTowers = getEquippedTowers()
    local towerList = {}
    for _, tower in ipairs(equippedTowers) do
        table.insert(towerList, string.format('"%s"', tower))
    end

    local lines = {
        "local TDX = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/raxs0420/test/refs/heads/main/library%20new/tdx%20test\"))()",
        "",
        string.format("TDX:Equip({%s})", table.concat(towerList, ", ")),
        "TDX:Mode("")",
        "TDX:VoteDifficulty("")",
        "TDX:Loadout()",
        "TDX:TimeScale(1)",
        "",
        "",
        ""
    }
    
    local varDeclarations = {}
    local commands = {}
    
    for _, action in ipairs(actions) do
        if action.cmd:match("local id%d = TDX:Place") then
            table.insert(varDeclarations, action.cmd)
        else
            table.insert(commands, action.cmd)
        end
    end
    
    for _, line in ipairs(varDeclarations) do
        table.insert(lines, line)
    end
    
    table.insert(lines, "")
    
    for _, line in ipairs(commands) do
        table.insert(lines, line)
    end
    
    return table.concat(lines, "\n")
end

local function startRecording()
    recording = true
    actions = {}
    knownParts = {}
    nextId = 1
    nextTowerId = 1
    pendingUpgradeLines = {}
    currentUIState = {path1Cost = 0, path2Cost = 0}
    recordBtn.Text = "STOP RECORDING"
    recordBtn.BackgroundColor3 = Color3.fromRGB(231,76,60)
    addLog("=== RECORDING STARTED ===", Color3.fromRGB(100, 255, 100))
    monitorUI()
end

local function stopRecording()
    recording = false
    recordBtn.Text = "START RECORDING"
    recordBtn.BackgroundColor3 = Color3.fromRGB(46,204,113)
    if #actions > 0 then
        addLog(string.format("=== RECORDING STOPPED - %d actions ===", #actions), Color3.fromRGB(100, 255, 100))
    else
        addLog("=== RECORDING STOPPED - No actions ===", Color3.fromRGB(255, 200, 100))
    end
end

local function copyScript()
    equippedTowers = getEquippedTowers()
    local scriptText = generateScript()
    if setclipboard then
        setclipboard(scriptText)
        addLog(string.format("✓ Script copied! (%d towers, %d actions)", #equippedTowers, #actions), Color3.fromRGB(100, 255, 100))
        local oldColor = copyBtn.BackgroundColor3
        copyBtn.BackgroundColor3 = Color3.fromRGB(39,174,96)
        copyBtn.Text = "COPIED!"
        task.wait(0.5)
        copyBtn.BackgroundColor3 = oldColor
        copyBtn.Text = "COPY SCRIPT"
    else
        addLog("✗ No clipboard access - printed to console", Color3.fromRGB(255, 100, 100))
        print(scriptText)
    end
end

recordBtn.MouseButton1Click:Connect(function()
    if recording then stopRecording() else startRecording() end
