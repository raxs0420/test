local hooked = false

local function installHook()
    if hooked then return true end

    local oldNamecall
    local newNamecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()

        if method == "FireServer" then
            if self == TowerUpgradeRequest then
                local args = table.pack(...)
                oldNamecall(self, ...)
                pcall(logUpgrade, args)
                return
            elseif self == SellTower then
                local args = table.pack(...)
                oldNamecall(self, ...)
                pcall(logSell, args)
                return
            elseif self == SkipWaveVoteCast then
                local args = table.pack(...)
                oldNamecall(self, ...)
                if args[1] == true then
                    pcall(logSkip)
                end
                return
            elseif self == ChangeQueryType then
                local args = table.pack(...)
                oldNamecall(self, ...)
                pcall(logTarget, args)
                return
            end

        elseif method == "InvokeServer" then
            if self == PlaceTower then
                local args = table.pack(...)
                local results = table.pack(oldNamecall(self, ...))
                if results[1] == true then
                    pcall(logPlace, args)
                else
                    pcall(function()
                        addEntry("\u{2717} PlaceTower call rejected", "", COLORS.bad, false)
                    end)
                end
                return table.unpack(results, 1, results.n)

            elseif self == TowerUseAbilityRequest then
                local args = table.pack(...)
                local results = table.pack(oldNamecall(self, ...))
                if results[1] == true then
                    pcall(logAbility, args)
                end
                return table.unpack(results, 1, results.n)

            elseif self == RetargetTower then
                local args = table.pack(...)
                local results = table.pack(oldNamecall(self, ...))
                if results[1] == true then
                    pcall(logRetarget, args)
                end
                return table.unpack(results, 1, results.n)
            end
        end

        return oldNamecall(self, ...)
    end)

    if type(hookmetamethod) == "function" then
        local ok = pcall(function()
            oldNamecall = hookmetamethod(game, "__namecall", newNamecall)
        end)
        if ok and oldNamecall then
            hooked = true
            return true
        end
    end

    if type(getrawmetatable) == "function" and type(setreadonly) == "function" then
        local ok = pcall(function()
            local mt = getrawmetatable(game)
            oldNamecall = mt.__namecall
            setreadonly(mt, false)
            mt.__namecall = newNamecall
            setreadonly(mt, true)
        end)
        if ok then
            hooked = true
            return true
        end
    end

    return false
end

local success = installHook()

if success then
    addEntry("Hook installed \u{2014} recording.", "", COLORS.dim, false)
else
    addEntry("Failed to install hook.", "", COLORS.bad, false)
end

