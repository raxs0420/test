local function getTowerCost(towerName)
    local towersBar = LocalPlayer.PlayerGui:FindFirstChild("Interface"):FindFirstChild("BottomBar"):FindFirstChild("TowersBar")
    if towersBar then
        local towerFolder = towersBar:FindFirstChild(towerName)
        if towerFolder then
            local costFrame = towerFolder:FindFirstChild("CostFrame")
            if costFrame then
                local costText = costFrame:FindFirstChild("CostText")
                if costText and costText:IsA("TextLabel") then
                    local costStr = costText.Text:gsub("[^%d]", "")
                    return tonumber(costStr) or 0
                end
            end
        end
    end
    return 0
end

local function getUpgradeCostForPath(path)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local interface = playerGui:FindFirstChild("Interface")
        if interface then
            local towerUI = interface:FindFirstChild("TowerUI")
            if towerUI and towerUI.Visible then
                local buttonName = (path == 1) and "Path1Button" or "Path2Button"
                local pathButton = towerUI:FindFirstChild(buttonName)
                if pathButton then
                    local costText = pathButton:FindFirstChild("CostText")
                    if costText and costText:IsA("TextLabel") then
                        local costStr = costText.Text:gsub("[^%d]", "")
                        return tonumber(costStr) or 0
                    end
                end
            end
        end
    end
    return 0
end

local function addLog(msg, color)
    local label = Instance.new("TextLabel", logBox)
    label.Size = UDim2.new(1, -10, 0, 14)
    label.Text = msg
    label.TextColor3 = color or Color3.fromRGB(200,200,200)
    label.TextSize = 10
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Code
    task.wait()
    logBox.CanvasSize = UDim2.new(0, 0, 0, logLayout.AbsoluteContentSize.Y)
    logBox.CanvasPosition = Vector2.new(0, logBox.CanvasSize.Y.Offset)
    return label
end

local function monitorUpgrades()
    task.spawn(function()
        while recording do
            task.wait(0.01)
            local currentTime = tick()
            if pendingUpgrade then
                local cost = getUpgradeCostForPath(pendingUpgrade.path)
                if cost > 0 and currentTime - lastUpgradeTime > 0.05 then
                    -- Use MACRO ID, not game ID
                    local cmd = string.format('TDX:Upgrade(%d, %d, 1, %d)', pendingUpgrade.macroId, pendingUpgrade.path, cost)
                    table.insert(actions, cmd)
                    addLog(cmd, Color3.fromRGB(150, 255, 150))
                    pendingUpgrade = nil
                    lastUpgradeTime = currentTime
                end
            end
        end
    end)
end

if TowersFolder then
    TowersFolder.ChildAdded:Connect(function(part)
        if not recording then return end
        if not part:IsA("BasePart") then return end
        task.wait(0.05)
        local name = part.Name
        local pos = part.Position
        
        -- Assign macro ID sequentially
        local macroId = nextMacroId
        nextMacroId = nextMacroId + 1
        
        -- Store mapping from game ID to macro ID
        -- We need to get the game ID from the tower's position in the folder
        local gameId = nil
        local children = TowersFolder:GetChildren()
        for idx, p in ipairs(children) do
            if p == part then
                gameId = idx
                break
            end
        end
        
        if gameId then
            towerMacroIds[gameId] = macroId
        end
        
        local cost = getTowerCost(name)
        local cmd = string.format('TDX:Place("%s", %.6f, %.6f, %.6f, 0, %d, %d)', name, pos.X, pos.Y, pos.Z, cost, macroId)
        table.insert(actions, cmd)
        addLog(cmd, Color3.fromRGB(100, 255, 100))
    end)
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if recording and (method == "FireServer" or method == "InvokeServer") then
        if self.Name == "TowerUpgradeRequest" then
            local gameId = args[1]
            local path = args[2] or 1
            local level = args[3] or 1
            
            -- Convert game ID to macro ID
            local macroId = towerMacroIds[gameId]
            if macroId then
                pendingUpgrade = {macroId = macroId, path = path, level = level}
            end
            
        elseif self.Name == "SellTower" then
            local gameId = args[1]
            local macroId = towerMacroIds[gameId]
            if macroId then
                local cmd = string.format('TDX:Sell(%d)', macroId)
                table.insert(actions, cmd)
                addLog(cmd, Color3.fromRGB(255, 150, 100))
            end
        end
    end
    return oldNamecall(self, ...)
end)

local function generateScript()
    local towerList = {}
    local addedTowers = {}
    
    -- Get unique tower names from recorded actions
    for _, cmd in ipairs(actions) do
        local name = string.match(cmd, 'TDX:Place%"([^"]+)"')
        if name and not addedTowers[name] then
            addedTowers[name] = true
            table.insert(towerList, string.format('"%s"', name))
        end
    end

    local lines = {
        "local TDX = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/raxs0420/test/refs/heads/main/library%20new/tdx%20test\"))()",
        "",
        string.format("TDX:Equip({%s})", table.concat(towerList, ", ")),
        "TDX:TimeScale(1.5)",
        "",
        "",
        ""
    }
    for _, cmd in ipairs(actions) do
        table.insert(lines, cmd)
    end
    return table.concat(lines, "\n")
end

local function startRecording()
    recording = true
    actions = {}
    nextMacroId = 1
    towerMacroIds = {}
    pendingUpgrade = nil
    lastUpgradeTime = 0
    recordBtn.Text = "STOP RECORDING"
    recordBtn.BackgroundColor3 = Color3.fromRGB(231,76,60)
    addLog("=== RECORDING STARTED (using Macro IDs) ===", Color3.fromRGB(100, 255, 100))
    monitorUpgrades()
end

local function stopRecording()
    recording = false
    recordBtn.Text = "START RECORDING"
    recordBtn.BackgroundColor3 = Color3.fromRGB(46,204,113)
    if #actions > 0 then
        addLog(string.format("=== RECORDING STOPPED - %d actions ===", #actions), Color3.fromRGB(100, 255, 100))
    else
        addLog("=== RECORDING STOPPED - No actions ===", Color3.fromRGB(255, 200, 100))
    end
end

local function copyScript()
    local scriptText = generateScript()
    if setclipboard then
        setclipboard(scriptText)
        addLog(string.format("✓ Script copied! (%d actions)", #actions), Color3.fromRGB(100, 255, 100))
        local oldColor = copyBtn.BackgroundColor3
        copyBtn.BackgroundColor3 = Color3.fromRGB(39,174,96)
        copyBtn.Text = "COPIED!"
        task.wait(0.5)
        copyBtn.BackgroundColor3 = oldColor
        copyBtn.Text = "COPY SCRIPT"
    else
        addLog("✗ No clipboard access - printed to console", Color3.fromRGB(255, 100, 100))
        print(scriptText)
    end
end

