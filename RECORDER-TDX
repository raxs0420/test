}

local function targetName(t)
    if t == nil then return "none" end
    return TARGET_TYPES[tonumber(t)] or ("Type" .. tostring(t))
end

local function preciseNumber(n)
    local short = string.format("%.14g", n)
    if tonumber(short) == n then return short end
    return string.format("%.17g", n)
end

local function vectorShort(v)
    return string.format("Vector3.new(%.1f, %.1f, %.1f)", v.X, v.Y, v.Z)
end

local function vectorPrecise(v)
    return string.format("Vector3.new(%s, %s, %s)",
        preciseNumber(v.X), preciseNumber(v.Y), preciseNumber(v.Z))
end

local function wallClock()
    if type(tick) == "function" then
        return tick()
    end
    return os.clock()
end

