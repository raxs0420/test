local function logPlace(args)
    local timer = tonumber(args[1]) or 0
    local name = tostring(args[2] or "Unknown")
    local pos = typeof(args[3]) == "Vector3" and args[3] or Vector3.new(0, 0, 0)
    local rebuild = (args[4] == true or args[4] == 1)
    local aim = typeof(args[5]) == "Vector3" and args[5] or nil

    local waitPrefix
    if lastCommandClock == nil then
        lastCommandClock = wallClock()
        waitPrefix = ""
    else
        waitPrefix = buildWaitPrefix()
    end

    local pendingDisplay = waitPrefix .. "\u{2026} Placing " .. name .. "..."
    local entry = addEntry(pendingDisplay, "", COLORS.pending, false)

    local record = {
        name = name,
        pos = pos,
        timer = timer,
        rebuild = rebuild,
        aim = aim,
        waitPrefix = waitPrefix,
        entry = entry,
        resolved = false,
    }
    table.insert(pendingPlaces, record)

    task.defer(tryMatchPendingAgainstBuffer)

    task.delay(6, function()
        if not record.resolved then
            record.resolved = true
            entry.label.TextColor3 = COLORS.bad
            entry.label.Text = waitPrefix .. "\u{2717} Place " .. name .. " -- not confirmed"
            for i = #pendingPlaces, 1, -1 do
                if pendingPlaces[i] == record then
                    table.remove(pendingPlaces, i)
                    break
                end
            end
        end
    end)
end

local function logUpgrade(args)
    local hash = tonumber(args[1]) or 0
    local patch = tonumber(args[2]) or 1
    local count = tonumber(args[3]) or 1

    local beforeT = getLevel(hash, 1)
    local beforeB = getLevel(hash, 2)

    for _, p in ipairs(pendingUpgrades) do
        if p.hash == hash and not p.resolved then
            if p.patch == 1 then beforeT = beforeT + p.count end
            if p.patch == 2 then beforeB = beforeB + p.count end
        end
    end

    local afterT, afterB = beforeT, beforeB
    if patch == 1 then
        afterT = afterT + count
    elseif patch == 2 then
        afterB = afterB + count
    end

    local fromStr = string.format("%d/%d", beforeT, beforeB)
    local toStr = string.format("%d/%d", afterT, afterB)

    local callText
    if count == 1 then
        callText = string.format("TDX:Upgrade(%s, %s)", tostring(hash), tostring(patch))
    else
        callText = string.format("TDX:Upgrade(%s, %s, %s)", tostring(hash), tostring(patch), tostring(count))
    end

    local commentText = string.format(" -- %s %s --> %s", tostring(hash), fromStr, toStr)

    local waitPrefix = buildWaitPrefix()

    local exact = waitPrefix .. callText .. commentText
    local successDisplay = waitPrefix .. callText .. commentText
    local pendingDisplay = waitPrefix .. "\u{2026} " .. callText .. " -- " .. tostring(hash) .. " " .. fromStr .. " --> " .. toStr

    local entry = addEntry(pendingDisplay, exact, COLORS.pending, false)

    local expected = (patch == 1 and afterT or afterB)

    local record = {
        hash = hash,
        patch = patch,
        count = count,
        expected = expected,
        resolved = false,
        entry = entry,
        successText = function()
            return successDisplay
        end,
    }
    table.insert(pendingUpgrades, record)

    task.delay(4, function()
        if not record.resolved then
            record.resolved = true
            entry.label.TextColor3 = COLORS.bad
            entry.label.Text = waitPrefix .. "\u{2717} " .. callText .. " -- " .. tostring(hash) .. " " .. fromStr .. " --> " .. toStr .. " (unconfirmed)"
            for i = #pendingUpgrades, 1, -1 do
                if pendingUpgrades[i] == record then
                    table.remove(pendingUpgrades, i)
                    break
                end
            end
        end
    end)
end

