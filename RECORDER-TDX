end

local function buildWaitPrefix()
    local now = wallClock()
    local prev = lastCommandClock
    lastCommandClock = now
    if not logToggles.logWaits then return "" end
    if prev == nil then return "" end
    local delta = now - prev
    if delta < WAIT_MIN then return "" end
    return string.format("TDX:Wait(%.2f)\n", delta)
end

local dragging, dragStart, startPos = false, nil, nil

local function clampPosition(x, y)
    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 450)
    x = math.clamp(x, -(WIDTH - 70), vp.X - 70)
    y = math.clamp(y, 0, math.max(0, vp.Y - HEADER_H))
    return x, y
end

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local delta = input.Position - dragStart
    local nx, ny = clampPosition(startPos.X.Offset + delta.X, startPos.Y.Offset + delta.Y)
    main.Position = UDim2.new(startPos.X.Scale, nx, startPos.Y.Scale, ny)
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

