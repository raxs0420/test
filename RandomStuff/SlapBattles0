local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local backpack = player:WaitForChild("Backpack")
local resetEvent = player:FindFirstChild("Reset")

local currentTween = nil
local isTeleporting = false
local lastTargetPos = nil
local teleportedToLobby = false
local selectedTarget = nil
local monitoringThread = nil

local function hasTools()
	local char = player.Character
	if char then
		for _, obj in pairs(char:GetDescendants()) do
			if obj:IsA("Tool") then return true end
		end
	end
	for _, obj in pairs(backpack:GetChildren()) do
		if obj:IsA("Tool") then return true end
	end
	return false
end

local function smoothTeleport(targetPos, duration)
	if isTeleporting then
		if currentTween then
			currentTween:Cancel()
			currentTween = nil
			isTeleporting = false
		else
			return
		end
	end
	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	if lastTargetPos and (root.Position - targetPos).Magnitude < 2 then
		return
	end
	isTeleporting = true
	lastTargetPos = targetPos
	local tweenInfo = TweenInfo.new(duration or 0.1, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
	local goal = {CFrame = CFrame.new(targetPos)}
	local tween = TweenService:Create(root, tweenInfo, goal)
	currentTween = tween
	tween:Play()
	tween.Completed:Wait()
	currentTween = nil
	isTeleporting = false
end

local function teleportToLobby()
	local lobby = workspace:FindFirstChild("Lobby")
	if not lobby then return end
	local teleportPart = lobby:FindFirstChild("Teleport1")
	if not teleportPart then return end
	local targetPos = teleportPart.Position + Vector3.new(0, 2, 0)
	smoothTeleport(targetPos, 0.1)
end

local function teleportToSelectedPlayer()
	if not selectedTarget then return end
	local targetChar = selectedTarget.Character
	if not targetChar then return end
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
	if not targetRoot then return end
	local targetPos = targetRoot.Position + targetRoot.CFrame.LookVector * 4 + Vector3.new(0, 0.1, 0)
	smoothTeleport(targetPos, 0.1)
end

local function performEmptyCycle()
	if teleportedToLobby then return end
	if not selectedTarget then
		for _, other in pairs(Players:GetPlayers()) do
			if other ~= player then
				selectedTarget = other
				mainButton.Text = other.Name
				break
			end
		end
	end
	if not selectedTarget then return end

	if monitoringThread then
		task.cancel(monitoringThread)
		monitoringThread = nil
	end

	teleportToLobby()
	task.wait(0.3)
	teleportToSelectedPlayer()
	teleportedToLobby = true

	local landingPos = lastTargetPos
	if not landingPos then return end

	monitoringThread = task.spawn(function()
		task.wait(0.05) 
		while true do
			task.wait(0.1)
			local char = player.Character
			if char then
				local root = char:FindFirstChild("HumanoidRootPart")
				if root then
					local dist = (root.Position - landingPos).Magnitude
					if dist > 8 then   -- increased to 8 for knockback detection
						if resetEvent and resetEvent:IsA("RemoteEvent") then
							resetEvent:FireServer()
						end
						break
					end
				end
			end
		end
		monitoringThread = nil
	end)
end

local function checkBackpack()
	if not hasTools() then
		performEmptyCycle()
	else
		teleportedToLobby = false
	end
end

