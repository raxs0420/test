local function refreshDropdown()
	for _, child in pairs(scroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for _, otherPlayer in pairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(0.9, 0, 0, 30)
			btn.Text = otherPlayer.Name
			btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.BorderSizePixel = 0
			btn.Font = Enum.Font.SourceSans
			btn.TextSize = 14
			btn.Parent = scroll

			local btnCorner = Instance.new("UICorner")
			btnCorner.CornerRadius = UDim.new(0, 4)
			btnCorner.Parent = btn

			btn.MouseEnter:Connect(function()
				btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
			end)
			btn.MouseLeave:Connect(function()
				btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			end)

			btn.MouseButton1Click:Connect(function()
				selectedTarget = otherPlayer
				mainButton.Text = otherPlayer.Name
				dropdown.Visible = false
				teleportedToLobby = false
				performEmptyCycle()
			end)
		end
	end
	task.wait()
	scroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
end

mainButton.MouseButton1Click:Connect(function()
	dropdown.Visible = not dropdown.Visible
	if dropdown.Visible then refreshDropdown() end
end)

Players.PlayerAdded:Connect(refreshDropdown)
Players.PlayerRemoving:Connect(refreshDropdown)

backpack.ChildAdded:Connect(checkBackpack)
backpack.ChildRemoved:Connect(checkBackpack)

player.CharacterAdded:Connect(function()
	teleportedToLobby = false
	lastTargetPos = nil
	if monitoringThread then
		task.cancel(monitoringThread)
		monitoringThread = nil
	end
	task.wait(0.5)
	checkBackpack()
end)

task.wait(0.5)
checkBackpack()