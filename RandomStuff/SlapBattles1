local function createRow(name, defaultText, layoutOrder)
    local row = Instance.new("TextLabel")
    row.Name = name
    row.Size = UDim2.new(1, 0, 0, 22)
    row.BackgroundTransparency = 1
    row.Text = defaultText
    row.TextColor3 = Color3.fromRGB(220, 220, 230)
    row.Font = Enum.Font.GothamMedium
    row.TextSize = 13
    row.TextXAlignment = Enum.TextXAlignment.Left
    row.RichText = true
    row.LayoutOrder = layoutOrder
    row.Parent = mainFrame
    return row
end

local beforeLabel = createRow("Before", "Before: 0", 1)
local afterLabel = createRow("After", "After: 0", 2)
local gainedLabel = createRow("Gained", "Gained: +0", 3)
local sessionStartLabel = createRow("SessionStart", "Session Start: 0", 4)
local sessionGainedLabel = createRow("SessionGained", "Total Gained: +0", 5)
local timeLabel = createRow("Time", "Time: 0s", 6)
local rateLabel = createRow("Rate", "Rate: 0/h", 7)

local dragging = false
local dragStart = nil
local startPos = nil
local dragInput = nil

local function updatePosition(input)
    local delta = input.Position - dragStart
    mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

topBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

userInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        updatePosition(input)
    end
end)

local function teleportToModel(model)
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local pos = model:GetPivot().Position + Vector3.new(0, 2, 0)
    root.CFrame = CFrame.new(pos)
end

local function getSlaps()
    local stats = player:FindFirstChild("leaderstats")
    if not stats then return 0 end
    local slaps = stats:FindFirstChild("Slaps")
    return slaps and slaps.Value or 0
end

local function formatTime(seconds)
    local m = math.floor(seconds / 60)
    local s = math.floor(seconds % 60)
    if m > 0 then
        return string.format("%dm %ds", m, s)
    else
        return string.format("%ds", s)
    end
end

local function updateUI()
    beforeLabel.Text = string.format("Before: %d", beforeSlaps)
    afterLabel.Text = string.format("After: %d", afterSlaps)
    gainedLabel.Text = string.format("Gained: +%d", runGain)
    sessionStartLabel.Text = string.format("Session Start: %d", sessionData.sessionStart)
    sessionGainedLabel.Text = string.format("Total Gained: +%d", sessionData.sessionGain)

    local elapsed = os.time() - sessionData.sessionStartTime
    if elapsed < 0 then elapsed = 0 end
    timeLabel.Text = "Time: " .. formatTime(elapsed)

    local rate = 0
    if elapsed > 0 then
        rate = sessionData.sessionGain / (elapsed / 3600)
    end
    rateLabel.Text = string.format("Rate: %.1f/h", rate)

    if runGain > 0 then
        gainedLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
        local tween = game:GetService("TweenService"):Create(uiStroke, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Color = Color3.fromRGB(46, 204, 113)})
        tween:Play()
        task.delay(0.8, function()
            game:GetService("TweenService"):Create(uiStroke, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Color = Color3.fromRGB(55, 55, 75)}):Play()
        end)
    end
end

task.spawn(function()
    while screenGui and screenGui.Parent do
        updateUI()
        task.wait(1)
    end
end)

task.wait(0.1)

local teleportPart = workspace:FindFirstChild("Lobby")
if teleportPart then teleportPart = teleportPart:FindFirstChild("Teleport1") end
if teleportPart then
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = CFrame.new(teleportPart.Position + Vector3.new(0, 2, 0))
        end
    end
end

task.wait(0.05)

beforeSlaps = getSlaps()

if sessionData.sessionStart == 0 then
    sessionData.sessionStart = beforeSlaps
    sessionData.sessionGain = 0
    sessionData.sessionTime = os.time()
    sessionData.sessionStartTime = os.time()
    saveSession()
end

local cyclesDone = 0
while cyclesDone < 1 do
    while not player.Character do task.wait(0.05) end
    local model = models[index]
    if model then teleportToModel(model) end
    index = index + 1
    if index > #models then
        index = 1
        cyclesDone = cyclesDone + 1
    end
    task.wait(0.05)
end

afterSlaps = getSlaps()
runGain = afterSlaps - beforeSlaps

sessionData.sessionGain = sessionData.sessionGain + runGain
sessionData.sessionTime = os.time()
saveSession()

updateUI()

local PlaceId = game.PlaceId
local CurrentJobId = game.JobId

local function getServers(cursor)
    local url = "https://games.roblox.com/v1/games/" .. PlaceId ..
        "/servers/Public?sortOrder=Asc&limit=100"
    if cursor then
        url = url .. "&cursor=" .. cursor
    end
    return httpService:JSONDecode(game:HttpGet(url))
end

local searchStartTime = os.time()
local stuck = false

while true do
    local cursor = nil
    local found = false

    for i = 1, 5 do
        local success, data = pcall(getServers, cursor)
        if not success or not data or not data.data then
            break
        end

        for _, server in ipairs(data.data) do
            if server.id ~= CurrentJobId and server.playing >= 6 and server.playing <= 16 then
                teleportService:TeleportToPlaceInstance(PlaceId, server.id, player)
                found = true
                break
            end
        end

        if found then break end
        cursor = data.nextPageCursor
        if not cursor then break end
    end

    if found then
        break
    end

    if os.time() - searchStartTime >= STUCK_TIMEOUT then
        stuck = true
        break
    end

    task.wait(2)
end

if stuck then
    teleportService:Teleport(PlaceId, player)
end