local player = game.Players.LocalPlayer
local teleportService = game:GetService("TeleportService")
local httpService = game:GetService("HttpService")
local userInputService = game:GetService("UserInputService")

local SESSION_TIMEOUT = 300
local SESSION_FILE = "SlapSession.json"
local STUCK_TIMEOUT = 240

local folder = workspace:FindFirstChild("Arena")
if folder then folder = folder:FindFirstChild("island5") end
if folder then folder = folder:FindFirstChild("Slapples") end
if not folder then return end

local models = folder:GetChildren()
if #models == 0 then return end

local index = 1

local sessionData = { sessionStart = 0, sessionGain = 0, sessionTime = 0, sessionStartTime = 0 }
local beforeSlaps = 0
local afterSlaps = 0
local runGain = 0

local function loadSession()
    local success, data = pcall(readfile, SESSION_FILE)
    if success and data then
        local decoded = httpService:JSONDecode(data)
        if decoded and decoded.sessionStart and decoded.sessionTime then
            local currentTime = os.time()
            if currentTime - decoded.sessionTime < SESSION_TIMEOUT then
                sessionData = decoded
                if not sessionData.sessionStartTime then
                    sessionData.sessionStartTime = sessionData.sessionTime
                end
                return
            end
        end
    end
    sessionData = { sessionStart = 0, sessionGain = 0, sessionTime = 0, sessionStartTime = 0 }
end

local function saveSession()
    local encoded = httpService:JSONEncode(sessionData)
    pcall(writefile, SESSION_FILE, encoded)
end

loadSession()

