                end
            end
        end

        if #folders == 0 then
            local enemies = Workspace:FindFirstChild("enemies")
            if enemies then
                table.insert(folders, enemies)
            end
        end

        cachedEnemyFolders = folders
    end

    local function getEnemyClusters(myPos, ignoreEnemy)
        updateEnemyFolders()
        if not cachedEnemyFolders or #cachedEnemyFolders == 0 then
            return nil
        end

        local allEnemies = {}
        for _, enemyFolder in pairs(cachedEnemyFolders) do
            for _, enemy in pairs(enemyFolder:GetChildren()) do
                if enemy:IsA("Model") or enemy:IsA("Part") or enemy:IsA("MeshPart") then
                    if ignoreEnemy and enemy == ignoreEnemy then
                    else
                        local hrp = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChild("Torso") or enemy:FindFirstChild("Head")
                        if not hrp then
                            hrp = enemy:FindFirstChildWhichIsA("BasePart")
                        end
                        if hrp then
                            table.insert(allEnemies, hrp)
                        end
                    end
                end
            end
        end

        if #allEnemies == 0 then
            return nil
        end

        local clusters = {}
        local visited = {}
        local clusterThreshold = 10

        for i = 1, #allEnemies do
            if not visited[i] then
                local cluster = {}
                local queue = {i}
                visited[i] = true
                while #queue > 0 do
                    local idx = table.remove(queue, 1)
                    local part = allEnemies[idx]
                    table.insert(cluster, part)
                    for j = 1, #allEnemies do
                        if not visited[j] then
                            local other = allEnemies[j]
                            local dist = (part.Position - other.Position).Magnitude
                            if dist <= clusterThreshold then
                                visited[j] = true
                                table.insert(queue, j)
                            end
                        end
                    end
                end
                table.insert(clusters, cluster)
            end
        end

        local resultClusters = {}
        for _, cluster in ipairs(clusters) do
            local centroid = Vector3.new(0,0,0)
            for _, part in ipairs(cluster) do
                centroid = centroid + part.Position
            end
            centroid = centroid / #cluster
            local closestDist = math.huge
            local closestPart = nil
            for _, part in ipairs(cluster) do
                local dist = (myPos - part.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestPart = part
                end
            end
            table.insert(resultClusters, {
                centroid = centroid,
                enemies = cluster,
                size = #cluster,
                closestEnemy = closestPart,
                closestDist = closestDist
            })
        end

        table.sort(resultClusters, function(a, b)
            local da = (myPos - a.centroid).Magnitude
            local db = (myPos - b.centroid).Magnitude
            return da < db
        end)

        return resultClusters
    end

