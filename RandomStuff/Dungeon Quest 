        maxLabel.TextSize = 9
        maxLabel.Font = Enum.Font.Gotham
        maxLabel.TextXAlignment = Enum.TextXAlignment.Right
        maxLabel.Parent = section

        local isDragging = false
        local trackWidth = 0

        local function formatValue(val)
            if isInteger then
                return math.floor(val + 0.5)
            else
                return math.floor(val * 10) / 10
            end
        end

        local function updateSliderFromPercent(percent)
            local value = minVal + (maxVal - minVal) * percent
            value = formatValue(value)
            value = math.clamp(value, minVal, maxVal)
            sliderFill.Size = UDim2.new(0, trackWidth * percent, 1, 0)
            valueBox.Text = tostring(value)
            callback(value)
            saveSettings()
            return value
        end

        local function updateSlider(inputX)
            local trackPos = sliderTrack.AbsolutePosition.X
            trackWidth = sliderTrack.AbsoluteSize.X
            local relativeX = math.clamp(inputX - trackPos, 0, trackWidth)
            local percent = relativeX / trackWidth
            updateSliderFromPercent(percent)
        end

        local function updateSliderFromValue(value)
            trackWidth = sliderTrack.AbsoluteSize.X
            local clamped = math.clamp(value, minVal, maxVal)
            local percent = (clamped - minVal) / (maxVal - minVal)
            sliderFill.Size = UDim2.new(0, trackWidth * percent, 1, 0)
            valueBox.Text = tostring(clamped)
            callback(clamped)
            saveSettings()
        end

        task.delay(0.1, function()
            trackWidth = sliderTrack.AbsoluteSize.X
            local initialPercent = (defaultValue - minVal) / (maxVal - minVal)
            local initialWidth = trackWidth * initialPercent
            sliderFill.Size = UDim2.new(0, initialWidth, 1, 0)
        end)

        sliderBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
                updateSlider(input.Position.X)
            end
        end)

        sliderKnob.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateSlider(input.Position.X)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = false
            end
        end)

        valueBox.FocusLost:Connect(function(enterPressed)
            local num = tonumber(valueBox.Text)
            if num then
                num = math.clamp(num, minVal, maxVal)
                num = formatValue(num)
                updateSliderFromValue(num)
            else
                local currentPercent = sliderFill.Size.X.Offset / trackWidth
                local currentVal = minVal + (maxVal - minVal) * currentPercent
                valueBox.Text = tostring(formatValue(currentVal))
            end
        end)

        return section, valueBox
    end

