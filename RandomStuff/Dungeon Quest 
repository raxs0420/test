    local function shouldHeal()
        local character = LocalPlayer.Character
        if not character then return false end
        local humanoid = character:FindFirstChild("Humanoid")
        if not humanoid then return false end
        local healthPercent = (humanoid.Health / humanoid.MaxHealth) * 100
        return healthPercent <= Settings.HealThreshold
    end

    local function isHealingSpell(name)
        return name == "Redemption" or name == "Universal Heal" or name == "Chain Heal" or name == "Aura of Life"
    end

    local function startAutoAttack()
        stopAutoAttack()
        updateCachedWeapon()
        local lastAttack = 0
        local lastWeaponCheck = 0
        local lastSpellCheck = 0
        attackConnection = RunService.Heartbeat:Connect(function()
            if not Settings.AutoAttack then return end
            local now = tick()
            if now - lastWeaponCheck >= 1 then
                lastWeaponCheck = now
                updateCachedWeapon()
            end
            if now - lastSpellCheck >= 1 then
                lastSpellCheck = now
                updateCachedSpell()
            end
            if cachedSwingRemote then
                if now - lastAttack >= Settings.AttackInterval then
                    lastAttack = now
                    cachedSwingRemote:FireServer()
                end
            end
            if #cachedSpellEvents > 0 then
                if now - lastSpellCast >= 0.3 then
                    lastSpellCast = now
                    for _, spellEvent in ipairs(cachedSpellEvents) do
                        local tool = spellEvent.Parent
                        local spellName = tool and tool.Name or ""
                        if isHealingSpell(spellName) then
                            if shouldHeal() and (now - lastHealCast >= healCooldown) then
                                lastHealCast = now
                                pcall(function()
                                    spellEvent:FireServer()
                                end)
                            end
                        else
                            pcall(function()
                                spellEvent:FireServer()
                            end)
                        end
                    end
                end
            end
            if #cachedAbilityEvents > 0 then
                if now - lastAbilityCast >= 0.3 then
                    lastAbilityCast = now
                    for _, abilityEvent in ipairs(cachedAbilityEvents) do
                        local tool = abilityEvent.Parent
                        local abilityName = tool and tool.Name or ""
                        if isHealingSpell(abilityName) then
