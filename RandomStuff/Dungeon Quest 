    local function getProjRadius(part)
        if not part then return 0 end
        local s, cf = part.Size, part.CFrame
        local ws = Vector3.new(
            math.abs(cf.RightVector.X)*s.X + math.abs(cf.UpVector.X)*s.Y + math.abs(cf.LookVector.X)*s.Z,
            math.abs(cf.RightVector.Y)*s.X + math.abs(cf.UpVector.Y)*s.Y + math.abs(cf.LookVector.Y)*s.Z,
            math.abs(cf.RightVector.Z)*s.X + math.abs(cf.UpVector.Z)*s.Y + math.abs(cf.LookVector.Z)*s.Z)
        return math.max(ws.X, ws.Y, ws.Z) * 0.5
    end

    local function isPosSafe(pos, projs, margin)
        margin = margin or DODGE_SAFE_MARGIN
        if not projs or #projs == 0 then return true end
        for _, pd in ipairs(projs) do
            local p = pd.part
            if p and p:IsA("BasePart") and p.Parent then
                if (p.Position - pos).Magnitude < (getProjRadius(p) + margin) then return false end
            end
        end
        return true
    end

    local function findSafePos(myPos, enemyCentroid, projs, yOff)
        local bestPos, bestScore = myPos, -math.huge
        for i = 1, 36 do
            local angle = (i / 36) * math.pi * 2
            for _, dist in ipairs({3,5,8,10,12,15,18,20,25,30,35,40,45,50}) do
                local offset = Vector3.new(math.cos(angle)*dist, 0, math.sin(angle)*dist)
                local test = Vector3.new(enemyCentroid.X + offset.X, enemyCentroid.Y + yOff, enemyCentroid.Z + offset.Z)
                if isPosSafe(test, projs) then
                    local score = 100 - (test - enemyCentroid).Magnitude
                    local minThreat = math.huge
                    for _, pd in ipairs(projs) do
                        local p = pd.part
                        if p and p:IsA("BasePart") then
                            local bd = (p.Position - test).Magnitude - getProjRadius(p)
                            if bd < minThreat then minThreat = bd end
                        end
                    end
                    score = score + minThreat * 5
                    if score > bestScore then bestScore = score; bestPos = test end
                end
            end
        end
        return bestPos
    end

