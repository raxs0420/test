    lastAbilityCast = 0
end

local function startAutoAttack()
    stopAutoAttack()
    local hasWeapon = updateCachedWeapon()
    if not hasWeapon then
    else
    end
    local lastAttack = 0
    local lastWeaponCheck = 0
    local lastSpellCheck = 0
    attackConnection = RunService.Heartbeat:Connect(function()
        if not Settings.AutoAttack then return end
        local now = tick()
        if now - lastWeaponCheck >= 1 then
            lastWeaponCheck = now
            updateCachedWeapon()
        end
        if now - lastSpellCheck >= 1 then
            lastSpellCheck = now
            updateCachedSpell()
        end
        if cachedSwingRemote then
            if now - lastAttack >= Settings.AttackInterval then
                lastAttack = now
                cachedSwingRemote:FireServer()
            end
        end
        if #cachedSpellEvents > 0 then
            if now - lastSpellCast >= 0.3 then
                lastSpellCast = now
                for _, spellEvent in ipairs(cachedSpellEvents) do
                    pcall(function()
                        spellEvent:FireServer()
                    end)
                end
            end
        end
        if #cachedAbilityEvents > 0 then
            if now - lastAbilityCast >= 0.3 then
                lastAbilityCast = now
                for _, abilityEvent in ipairs(cachedAbilityEvents) do
                    pcall(function()
                        abilityEvent:FireServer()
                    end)
                end
            end
        end
    end)
end

local function startAutoFarm()
    if farmConnection then
        farmConnection:Disconnect()
        farmConnection = nil
    end
    local lastTime = tick()

    setNoclip(true)

    farmConnection = RunService.Heartbeat:Connect(function()
        if not Settings.AutoFarm then
            return
        end
        if not Settings.AutoAttack then
            Settings.AutoAttack = true
            if attackBtnRef then
                attackBtnRef.Text = "ON"
                attackBtnRef.BackgroundColor3 = Color3.fromRGB(0, 160, 0)
            end
            startAutoAttack()
        end

        local character = LocalPlayer.Character
        if not character then return end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local myPos = hrp.Position

        local now = tick()
        if now - lastEnemyUpdate >= ENEMY_UPDATE_INTERVAL then
            lastEnemyUpdate = now

            local specialEnemy = nil
            for _, obj in pairs(Workspace:GetChildren()) do
                if obj.Name == "Azrallik's Heart" then
                    local hrpPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("Head")
                    if not hrpPart then
                        hrpPart = obj:FindFirstChildWhichIsA("BasePart")
                    end
                    if hrpPart then
                        specialEnemy = hrpPart
                        break
                    end
                end
            end

            local newCluster = nil
            if specialEnemy then
                newCluster = {
                    centroid = specialEnemy.Position,
                    enemies = {specialEnemy},
                    size = 1,
                    closestEnemy = specialEnemy,
                    closestDist = (myPos - specialEnemy.Position).Magnitude
                }
            else
                local clusters = getEnemyClusters(myPos)
                if clusters and #clusters > 0 then
                    newCluster = clusters[1]
                end
            end

            if newCluster ~= cachedCluster then
                cachedCluster = newCluster
                if transitionTween then
                    transitionTween:Cancel()
                    transitionTween = nil
                    isTweening = false
                end
            end
        end

        if cachedCluster then
            if not platformPart then
                platformPart = Instance.new("Part")
                platformPart.Name = "AutoFarmPlatform"
                platformPart.Size = Vector3.new(500, 1, 500)
                platformPart.Anchored = true
                platformPart.CanCollide = true
                platformPart.Transparency = 1
                platformPart.Material = Enum.Material.SmoothPlastic
                platformPart.Parent = Workspace
            end
            local centroid = cachedCluster.centroid
            platformPart.Position = Vector3.new(centroid.X, centroid.Y - 15, centroid.Z)
        else
            if platformPart then
                local dist = (myPos - platformPart.Position).Magnitude
                if dist > 100 then
                    platformPart:Destroy()
                    platformPart = nil
                end
            end
        end

        if not cachedCluster then
            return
        end

        local targetPos, targetCFrame
        if Settings.FarmingMode == "Under" then
            local enemyPart = cachedCluster.closestEnemy
            if enemyPart then
                local sizeY = enemyPart.Size.Y
                local bottomY = enemyPart.Position.Y - (sizeY / 2)
                targetPos = Vector3.new(enemyPart.Position.X, bottomY - 6, enemyPart.Position.Z)
                targetCFrame = CFrame.new(targetPos, enemyPart.Position)
            end
        else
            local targetY = cachedCluster.centroid.Y + orbitYOffset
            local dt = now - lastTime
            lastTime = now
            local angularSpeed = orbitSpeed / orbitRadius
            orbitAngle = orbitAngle + angularSpeed * dt
            local x = math.cos(orbitAngle) * orbitRadius
            local z = math.sin(orbitAngle) * orbitRadius
            targetPos = Vector3.new(cachedCluster.centroid.X + x, targetY, cachedCluster.centroid.Z + z)
            targetCFrame = CFrame.new(targetPos, cachedCluster.centroid)
        end

        if targetCFrame then
            local dist = (targetPos - myPos).Magnitude
            if dist > 30 and not isTweening then
                if transitionTween then transitionTween:Cancel() end
                isTweening = true
                local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                local goal = {CFrame = targetCFrame}
                transitionTween = TweenService:Create(hrp, tweenInfo, goal)
                transitionTween:Play()
                transitionTween.Completed:Connect(function()
                    isTweening = false
                    transitionTween = nil
                end)
            elseif not isTweening then
                hrp.CFrame = targetCFrame
            end
        end
    end)
end

