    local function getProjectileBoundaryDistance(projPart, myPos)
        if not projPart or not myPos then return math.huge end
        
        local size = projPart.Size
        local cf = projPart.CFrame
        local right = cf.RightVector
        local up = cf.UpVector
        local look = cf.LookVector
        
        local worldSize = Vector3.new(
            math.abs(right.X) * size.X + math.abs(up.X) * size.Y + math.abs(look.X) * size.Z,
            math.abs(right.Y) * size.X + math.abs(up.Y) * size.Y + math.abs(look.Y) * size.Z,
            math.abs(right.Z) * size.X + math.abs(up.Z) * size.Y + math.abs(look.Z) * size.Z
        )
        
        local worldRadius = math.max(worldSize.X, worldSize.Y, worldSize.Z) * 0.5
        local dist = (projPart.Position - myPos).Magnitude
        
        return dist - worldRadius
    end

    local function isPositionSafe(position, projectiles, minSafeDist)
        minSafeDist = minSafeDist or DODGE_SAFE_MARGIN
        if not projectiles or #projectiles == 0 then return true end
        
        for _, projData in ipairs(projectiles) do
            local part = projData.part
            if part and part:IsA("BasePart") and part.Parent then
                local size = part.Size
                local cf = part.CFrame
                
                local worldSize = Vector3.new(
                    math.abs(cf.RightVector.X) * size.X + math.abs(cf.UpVector.X) * size.Y + math.abs(cf.LookVector.X) * size.Z,
                    math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z,
                    math.abs(cf.RightVector.Z) * size.X + math.abs(cf.UpVector.Z) * size.Y + math.abs(cf.LookVector.Z) * size.Z
                )
                local worldRadius = math.max(worldSize.X, worldSize.Y, worldSize.Z) * 0.5
                local dist = (part.Position - position).Magnitude
                
                if dist < (worldRadius + minSafeDist) then
                    return false
                end
            end
        end
        return true
    end

    local function findSafePosition(myPos, enemyCentroid, projectiles, currentYOffset)
        local bestPos = myPos
        local bestScore = -math.huge
        
        for i = 1, 36 do
            local angle = (i / 36) * math.pi * 2
            
            for _, dist in ipairs({3, 5, 8, 10, 12, 15, 18, 20, 25, 30, 35, 40, 45, 50}) do
                local offset = Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
                local testPos = enemyCentroid + offset
                testPos = Vector3.new(testPos.X, enemyCentroid.Y + currentYOffset, testPos.Z)
                
                if isPositionSafe(testPos, projectiles) then
                    local score = 100 - (testPos - enemyCentroid).Magnitude
                    
                    local minThreatDist = math.huge
                    for _, projData in ipairs(projectiles) do
                        local part = projData.part
                        if part and part:IsA("BasePart") then
                            local size = part.Size
                            local cf = part.CFrame
                            local worldSize = Vector3.new(
                                math.abs(cf.RightVector.X) * size.X + math.abs(cf.UpVector.X) * size.Y + math.abs(cf.LookVector.X) * size.Z,
                                math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z,
                                math.abs(cf.RightVector.Z) * size.X + math.abs(cf.UpVector.Z) * size.Y + math.abs(cf.LookVector.Z) * size.Z
                            )
                            local worldRadius = math.max(worldSize.X, worldSize.Y, worldSize.Z) * 0.5
                            local boundaryDist = (part.Position - testPos).Magnitude - worldRadius
                            if boundaryDist < minThreatDist then
                                minThreatDist = boundaryDist
                            end
                        end
                    end
                    score = score + minThreatDist * 5
                    
                    if score > bestScore then
                        bestScore = score
                        bestPos = testPos
                    end
                end
            end
        end
        
        if bestPos == myPos then
            for i = 1, 36 do
                local angle = (i / 36) * math.pi * 2
                for _, dist in ipairs({10, 20, 30, 40, 50, 60}) do
                    local offset = Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
                    local testPos = enemyCentroid + offset
                    testPos = Vector3.new(testPos.X, enemyCentroid.Y + currentYOffset, testPos.Z)
                    
                    if isPositionSafe(testPos, projectiles) then
                        bestPos = testPos
                        break
                    end
                end
                if bestPos ~= myPos then break end
            end
        end
        
        return bestPos
    end

