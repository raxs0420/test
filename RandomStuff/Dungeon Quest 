    local function autoSellItems()
        if game.PlaceId ~= LOBBY_PLACE_ID then return end
        if not Settings.AutoSell then return end
        local rs = ReplicatedStorage:FindFirstChild("remotes")
        local ri = rs and rs:FindFirstChild("reloadInvy")
        local sellRemote = rs and rs:FindFirstChild("sellItemEvent")
        if not ri or not sellRemote then
            warn("[DQR] Sell remote not found")
            return
        end
        local ok, inv = pcall(function() return ri:InvokeServer() end)
        if not ok or not inv then
            warn("[DQR] Failed to get inventory")
            return
        end

        local toSell = {helmet = {}, ability = {}, chest = {}, weapon = {}}

        local function collectItems(itemTable, outputCategory)
            for key, item in pairs(itemTable or {}) do
                local isEquipped = false
                if type(item.equipped) == "table" then
                    for _, v in pairs(item.equipped) do
                        if v == true then isEquipped = true; break end
                    end
                else
                    isEquipped = item.equipped == true
                end
                if item.rarity and Settings.SelectedQualities[item.rarity] and not isEquipped then
                    local num = tonumber(key:match("%d+"))
                    if num then
                        table.insert(toSell[outputCategory], num)
                        print("[DQR] Queued " .. outputCategory .. " #" .. num .. " (" .. item.rarity .. ")")
                    end
                end
            end
        end

        if Settings.SellTypes.weapon then collectItems(inv.weapons, "weapon") end
        if Settings.SellTypes.helmet then collectItems(inv.helmets, "helmet") end
        if Settings.SellTypes.chest then collectItems(inv.chests, "chest") end
        if Settings.SellTypes.ability then collectItems(inv.abilities, "ability") end

        local totalItems = #toSell.weapon + #toSell.ability + #toSell.helmet + #toSell.chest
        if totalItems > 0 then
            print("[DQR] Selling " .. totalItems .. " items...")
            print("[DQR] Payload: " .. HttpService:JSONEncode(toSell))
            local sellOk, sellErr = pcall(function()
                sellRemote:FireServer(toSell)
            end)
            if not sellOk then
                warn("[DQR] Sell failed: " .. tostring(sellErr))
            else
                print("[DQR] Sell request sent successfully")
            end
        else
            print("[DQR] No items to sell")
        end
    end

    local function equipBestWeapon()
        local lp = Players.LocalPlayer
        local sp = lp:FindFirstChild("spellPower")
        local pp = lp:FindFirstChild("physicalPower")
        local useSpell = false
        if sp and pp then
            useSpell = sp.Value > pp.Value
        elseif sp then
            useSpell = true
        end
        local rs = ReplicatedStorage:FindFirstChild("remotes")
        local ri = rs and rs:FindFirstChild("reloadInvy")
        local ei = rs and rs:FindFirstChild("equipItem")
        if not ri or not ei then return end
        local ok, inv = pcall(function() return ri:InvokeServer() end)
        if not ok or not inv or not inv.weapons then return end
        local bestNum, bestVal, equippedNum = nil, -1, nil
        for key, item in pairs(inv.weapons) do
            local num = tonumber(key:match("weapon_(%d+)"))
            if num then
                if item.equipped then
                    equippedNum = num
                end
                local val = useSpell and (item.spellPower or 0) or (item.physicalDamage or 0)
                if val > bestVal then
                    bestVal = val
                    bestNum = num
                end
            end
        end
        if bestNum and bestNum ~= equippedNum then
            pcall(function() ei:InvokeServer("weapon", bestNum) end)
        end
    end

    local function getBestArmorIndex()
        local lp = Players.LocalPlayer
        local sp = lp:FindFirstChild("spellPower")
        local pp = lp:FindFirstChild("physicalPower")
        local useSpell = false
        if sp and pp then
            useSpell = sp.Value > pp.Value
        elseif sp then
            useSpell = true
        end
        local rs = ReplicatedStorage:FindFirstChild("remotes")
        local ri = rs and rs:FindFirstChild("reloadInvy")
        if not ri then return nil end
        local ok, inv = pcall(function() return ri:InvokeServer() end)
        if not ok or not inv then return nil end

        local function collectArmors(armorTable, prefix)
            local list = {}
            for key, item in pairs(armorTable or {}) do
                local num = tonumber(key:match(prefix .. "_(%d+)"))
                if num then
                    table.insert(list, {
                        num = num,
                        name = item.name,
                        physicalPower = item.physicalPower or 0,
                        spellPower = item.spellPower or 0,
                        health = item.health or 0,
                        equipped = item.equipped,
                        rarity = item.rarity
                    })
                end
            end
            return list
        end

        local allArmors = {}
        local helmets = collectArmors(inv.helmets, "helmet")
        local chests = collectArmors(inv.chests, "chest")
        for _, a in ipairs(helmets) do table.insert(allArmors, a) end
        for _, a in ipairs(chests) do table.insert(allArmors, a) end

        if #allArmors == 0 then return nil end

        table.sort(allArmors, function(a, b)
            if useSpell then
                return a.spellPower > b.spellPower
            else
                return a.physicalPower > b.physicalPower
            end
        end)

        return allArmors[1].num
    end

    local function equipBestArmor()
        local lp = Players.LocalPlayer
        local sp = lp:FindFirstChild("spellPower")
        local pp = lp:FindFirstChild("physicalPower")
        local useSpell = false
        if sp and pp then
            useSpell = sp.Value > pp.Value
        elseif sp then
            useSpell = true
        end
        local rs = ReplicatedStorage:FindFirstChild("remotes")
        local ri = rs and rs:FindFirstChild("reloadInvy")
        local ei = rs and rs:FindFirstChild("equipItem")
        if not ri or not ei then return end
        local ok, inv = pcall(function() return ri:InvokeServer() end)
        if not ok or not inv then return end

        local function findBest(itemTable, prefix)
            local bestNum, bestVal, equippedNum = nil, -1, nil
            for key, item in pairs(itemTable or {}) do
                local num = tonumber(key:match(prefix .. "_(%d+)"))
                if num then
                    if item.equipped then
                        equippedNum = num
                    end
                    local val = useSpell and (item.spellPower or 0) or (item.physicalPower or 0)
                    if val > bestVal then
                        bestVal = val
                        bestNum = num
                    end
                end
            end
            return bestNum, equippedNum
        end

        local bestHelmet, equippedHelmet = findBest(inv.helmets, "helmet")
        local bestChest, equippedChest = findBest(inv.chests, "chest")

        if bestHelmet and bestHelmet ~= equippedHelmet then
            pcall(function() ei:InvokeServer("helmet", bestHelmet) end)
        end
        if bestChest and bestChest ~= equippedChest then
            pcall(function() ei:InvokeServer("chest", bestChest) end)
        end
    end

    local function startAutoEquip()
        if equipConnection then return end
        if Settings.EquipBestWeapon then
            task.delay(0.5, function()
                pcall(equipBestWeapon)
            end)
        end
        if Settings.EquipBestArmor then
            task.delay(0.5, function()
                pcall(equipBestArmor)
            end)
        end
        equipConnection = task.spawn(function()
            while true do
                task.wait(5)
                if not Settings.EquipBestWeapon and not Settings.EquipBestArmor then
                    continue
                end
                local rs = ReplicatedStorage:FindFirstChild("remotes")
                local ri = rs and rs:FindFirstChild("reloadInvy")
                if not ri then
                    continue
                end
                local ok, inv = pcall(function() return ri:InvokeServer() end)
                if not ok or not inv then
                    continue
                end
                if Settings.EquipBestWeapon then
                    pcall(equipBestWeapon)
                end
                if Settings.EquipBestArmor then
                    pcall(equipBestArmor)
                end
            end
        end)
    end

    local function stopAutoEquip()
        if equipConnection then
            equipConnection = nil
        end
    end

