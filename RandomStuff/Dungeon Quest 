    local function updatePlayerList()
        if not playerListFrame then return end
        local all = getPlayerHealthData()
        local myData = getLocalHealth()
        local display = {}
        if myData then
            table.insert(display, {name = LocalPlayer.Name, percent = myData.percent, isLocal = true})
        end
        for _, p in ipairs(all) do
            table.insert(display, {name = p.name, percent = p.percent, isLocal = false})
        end

        for i, card in ipairs(playerCards) do
            local data = display[i]
            if data then
                card.frame.Visible = true
                card.name.Text = data.name
                card.name.TextColor3 = data.isLocal and Color3.fromRGB(100, 200, 255) or C_TEXT
                card.hp.Text = math.floor(data.percent) .. "%"
                if data.percent >= 75 then
                    card.hp.TextColor3 = C_GREEN
                    card.frame.BackgroundColor3 = Color3.fromRGB(35, 55, 40)
                elseif data.percent >= 35 then
                    card.hp.TextColor3 = C_YELLOW
                    card.frame.BackgroundColor3 = Color3.fromRGB(55, 50, 30)
                else
                    card.hp.TextColor3 = C_RED
                    card.frame.BackgroundColor3 = Color3.fromRGB(55, 35, 35)
                end
            else
                card.frame.Visible = false
            end
        end

        local rows = math.ceil(#display / 2)
        playerListFrame.CanvasSize = UDim2.new(0, 0, 0, rows * 48 + 8)
    end

    local function init()
        createUI()
