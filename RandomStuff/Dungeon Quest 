local function runCannonballSequence()
    if cannonballRunning then return end
    if not isGhastlyHarbor() then return end
    if game.PlaceId == LOBBY_PLACE_ID then return end
    
    cannonballRunning = true
    
    if cannonballDeathConnection then
        cannonballDeathConnection:Disconnect()
        cannonballDeathConnection = nil
    end
    
    if respawnTimer then
        respawnTimer:Disconnect()
        respawnTimer = nil
    end
    
    cannonballDeathConnection = LocalPlayer.CharacterRemoving:Connect(function()
        if cannonballRunning then
            disableAllMovement()
        end
    end)
    
    disableAllMovement()
    
    local hrp = getHrp()
    local originalPos = hrp and hrp.Position or nil
    local fireDetected = false
    local lastTarget = nil
    
    local event = ReplicatedStorage:FindFirstChild("remotes")
    if event then
        event = event:FindFirstChild("ghastlyBossSpecficEvents")
    end
    
    if event then
        if cannonballFireConnection then
            cannonballFireConnection:Disconnect()
            cannonballFireConnection = nil
        end
        
        cannonballFireConnection = event.OnClientEvent:Connect(function(msg)
            if msg == "Fire Cannon At Boat" then
                fireDetected = true
                cannonballRunning = false
            end
        end)
    end
    
    local tweenDuration = 1.5

    while not fireDetected do
        if not LocalPlayer.Character then
            local waitStart = tick()
            while not LocalPlayer.Character and not fireDetected and tick() - waitStart < 60 do
                task.wait(0.1)
            end
            
            if fireDetected then
                break
            end
            
            if not LocalPlayer.Character then
                task.wait(0.5)
                continue
            end
            
            task.wait(0.5)
            
            hrp = getHrp()
            if hrp then
                originalPos = hrp.Position
                setNoclip(true)
            end
            continue
        end
        
        hrp = getHrp()
        if not hrp then
            task.wait(0.1)
            continue
        end
        
        local pickupRing = Workspace:FindFirstChild("playerPickupCannonballRing")
        local fireCannon = Workspace:FindFirstChild("playerFireCannon")
        local fireRing = fireCannon and fireCannon:FindFirstChild("ring")
        
        local pickupPos = pickupRing and pickupRing.Position + Vector3.new(0, 1, 0) or nil
        local firePos = fireRing and fireRing.Position + Vector3.new(0, 1, 0) or nil
        
        if pickupPos and pickupPos ~= lastTarget and LocalPlayer.Character then
            lastTarget = pickupPos
            local success = pcall(function()
                tweenToPosition(pickupPos, tweenDuration)
            end)
            if success then
                waitForTweenComplete()
            end
        end
        
        if fireDetected then
            break
        end
        
        if not LocalPlayer.Character then
            continue
        end
        
        hrp = getHrp()
        if not hrp then
            continue
        end
        
        if firePos and firePos ~= lastTarget and LocalPlayer.Character then
            lastTarget = firePos
            local success = pcall(function()
                tweenToPosition(firePos, tweenDuration)
            end)
            if success then
                waitForTweenComplete()
            end
        end
        
        task.wait(0.05)
    end
    
    if currentTween then
        pcall(function()
            currentTween:Cancel()
        end)
        currentTween = nil
    end
    
    if cannonballDeathConnection then
        cannonballDeathConnection:Disconnect()
        cannonballDeathConnection = nil
    end
    
    if cannonballFireConnection then
        cannonballFireConnection:Disconnect()
        cannonballFireConnection = nil
    end
    
    if fireDetected then
        task.wait(0.5)
    end
    
    task.wait(0.2)
    
    if originalPos and LocalPlayer.Character then
        hrp = getHrp()
        if hrp and hrp.Parent then
            pcall(function()
                hrp.Position = originalPos
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end)
        end
    end
    
    restoreAllMovement()
    
    cannonballRunning = false
end

local function startGhastlyCannonball()
    if cannonballConnection then return end
    
    local event = ReplicatedStorage:FindFirstChild("remotes")
    if event then
        event = event:FindFirstChild("ghastlyBossSpecficEvents")
    end
    if not event then return end
    
    cannonballConnection = event.OnClientEvent:Connect(function(msg)
        if msg == "Show Cannonball Rings" then
            if isGhastlyHarbor() and not cannonballRunning and game.PlaceId ~= LOBBY_PLACE_ID then
                if LocalPlayer.Character then
                    task.spawn(runCannonballSequence)
                else
                    local charConn = LocalPlayer.CharacterAdded:Connect(function()
                        charConn:Disconnect()
                        task.wait(0.5)
                        if isGhastlyHarbor() and not cannonballRunning then
                            task.spawn(runCannonballSequence)
                        end
                    end)
                end
            end
        end
    end)
end

local function stopGhastlyCannonball()
    if cannonballConnection then
        cannonballConnection:Disconnect()
        cannonballConnection = nil
    end
    if cannonballFireConnection then
        cannonballFireConnection:Disconnect()
        cannonballFireConnection = nil
    end
    if currentTween then
        pcall(function()
            currentTween:Cancel()
        end)
        currentTween = nil
    end
    if cannonballDeathConnection then
        cannonballDeathConnection:Disconnect()
        cannonballDeathConnection = nil
    end
    if respawnTimer then
        respawnTimer:Disconnect()
        respawnTimer = nil
    end
    cannonballRunning = false
end

    local speedOverrideConnection = nil

    local function startSpeedOverride()
        if speedOverrideConnection then
            speedOverrideConnection:Disconnect()
            speedOverrideConnection = nil
        end
        
        speedOverrideConnection = RunService.Heartbeat:Connect(function()
            local character = LocalPlayer.Character
            if not character then return end
            local humanoid = character:FindFirstChild("Humanoid")
            if not humanoid then return end
            
            if humanoid.WalkSpeed ~= Settings.WalkSpeed then
                humanoid.WalkSpeed = Settings.WalkSpeed
            end
        end)
    end

    local function stopSpeedOverride()
        if speedOverrideConnection then
            speedOverrideConnection:Disconnect()
            speedOverrideConnection = nil
        end
    end

    local function init()
        local statusLabel = createUI()
        startWeaponMonitor(statusLabel)
        startSpeedMonitor()
        startDungeonMonitor()
        startProjectileDodge()
        
        startGhastlyCannonball()
        startSpeedOverride()
        
        if Settings.AutoStart and not isInDungeon then
            task.spawn(autoStartSequence)
        end
        if Settings.AutoLevelUp then
            startAutoLevelUp()
        end
        if Settings.FastRejoin then
            task.delay(10, function()
                if Settings.FastRejoin then
                    startFastRejoin()
                end
            end)
        end
        
        UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if not gameProcessed and input.KeyCode == Enum.KeyCode.Insert then
                if uiScreenGui then
                    uiScreenGui.Enabled = not uiScreenGui.Enabled
                end
            end
        end)
    end

    init()
end)

