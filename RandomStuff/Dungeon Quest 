        local function setupBossRejoinListener()
            if bossRejoinConnection then return end
            local dp = Workspace:FindFirstChild("dungeonProgress")
            if not dp then
                warn("[DQR] dungeonProgress not found for Boss Rejoin")
                return
            end
            print("[DQR] Boss Rejoin listener active")
            bossRejoinConnection = dp:GetPropertyChangedSignal("Value"):Connect(function()
                if not Settings.BossRejoin then return end
                if game.PlaceId == LOBBY_PLACE_ID then return end
                local progress = dp.Value
                print("[DQR] dungeonProgress changed to: " .. tostring(progress) .. " (Boss Rejoin)")
                if progress == "bossKilled" and lastDungeonProgress ~= "bossKilled" then
                    lastDungeonProgress = progress
                    task.wait(0.2)
                    print("[DQR] Boss Rejoin triggered!")
                    doRejoin()
                else
                    lastDungeonProgress = progress
                end
            end)
        end

        setupBossRejoinListener()

        local inventoryMonitorConnection = nil
        local lastInventoryCheck = 0
        local INVENTORY_CHECK_INTERVAL = 5
        local INVENTORY_FULL_THRESHOLD = 250
        local wasFastRejoinBeforeFull = nil
        local lastAutoSellTime = 0
        local AUTO_SELL_INTERVAL = 5

        local function getInventoryItemCount()
            if game.PlaceId ~= LOBBY_PLACE_ID then return 0 end
            local rs = ReplicatedStorage:FindFirstChild("remotes")
            local ri = rs and rs:FindFirstChild("reloadInvy")
            if not ri then return 0 end
            local ok, inv = pcall(function() return ri:InvokeServer() end)
            if not ok or not inv then return 0 end
            local count = 0
            local function countItems(itemTable)
                for _, item in pairs(itemTable or {}) do
                    count = count + 1
                end
            end
            if Settings.SellTypes.weapon then countItems(inv.weapons) end
            if Settings.SellTypes.helmet then countItems(inv.helmets) end
            if Settings.SellTypes.chest then countItems(inv.chests) end
            if Settings.SellTypes.ability then countItems(inv.abilities) end
            return count
        end

        local function startInventoryMonitor()
            if inventoryMonitorConnection then return end
            inventoryMonitorConnection = RunService.Heartbeat:Connect(function()
                local now = tick()
                if now - lastInventoryCheck < INVENTORY_CHECK_INTERVAL then return end
                lastInventoryCheck = now
                if game.PlaceId ~= LOBBY_PLACE_ID then return end
                local itemCount = getInventoryItemCount()
                print("[DQR] Inventory count: " .. itemCount .. "/" .. INVENTORY_FULL_THRESHOLD)
                if itemCount >= INVENTORY_FULL_THRESHOLD then
                    if wasFastRejoinBeforeFull == nil then
                        wasFastRejoinBeforeFull = Settings.FastRejoin
                        print("[DQR] Inventory FULL! Pausing fast rejoin...")
                    end
                    if Settings.FastRejoin then
                        Settings.FastRejoin = false
                    end
                    if Settings.AutoSell then
                        autoSellItems()
                    end
                else
                    if wasFastRejoinBeforeFull ~= nil then
                        if wasFastRejoinBeforeFull and not Settings.FastRejoin then
                            Settings.FastRejoin = true
                            print("[DQR] Inventory cleared. Fast rejoin restored.")
                        end
                        wasFastRejoinBeforeFull = nil
                    end
                    if Settings.AutoSell and (now - lastAutoSellTime >= AUTO_SELL_INTERVAL) then
                        lastAutoSellTime = now
                        autoSellItems()
                    end
                end
            end)
        end

        local function stopInventoryMonitor()
            if inventoryMonitorConnection then
                inventoryMonitorConnection:Disconnect()
                inventoryMonitorConnection = nil
            end
        end

        startInventoryMonitor()
        setupBossRejoinListener()

        local function switchTab(tabName)
            currentTab = tabName
            for name, btn in pairs(tabs) do
                local normalColor = name == tabName and C_PANEL or Color3.fromRGB(35, 35, 42)
                local hoverColor = name == tabName and Color3.fromRGB(48, 48, 56) or Color3.fromRGB(50, 50, 58)
                btn.BackgroundColor3 = normalColor
                btn.TextColor3 = name == tabName and C_WHITE or C_TEXT_DIM
                setupButtonHover(btn, normalColor, hoverColor)
            end
            for name, content in pairs(tabContents) do
                content.Visible = (name == tabName)
            end
        end

        for name, btn in pairs(tabs) do
            btn.MouseButton1Click:Connect(function() switchTab(name) end)
        end

        setupButtonHover(minBtn, Color3.fromRGB(50, 50, 58), Color3.fromRGB(70, 70, 78))

        minBtn.MouseButton1Click:Connect(function()
            isMinimized = not isMinimized
            if isMinimized then
                for _, c in pairs(uiScreenGui:GetDescendants()) do
                    if c.Name == "SellDropdownMenu" and c:IsA("Frame") then
                        c.Visible = false
                    end
                    if c.Name == "TypeDropdownMenu" and c:IsA("Frame") then
                        c.Visible = false
                    end
                    if c.Name == "DropdownMenu" and c:IsA("Frame") then
                        c.Visible = false
                    end
                end
                if menuPosConnection then
                    menuPosConnection:Disconnect()
                    menuPosConnection = nil
                end
                if typeMenuPosConnection then
                    typeMenuPosConnection:Disconnect()
                    typeMenuPosConnection = nil
                end
                contentFrame.Visible = false
                tabBar.Visible = false
                mainFrame.Size = UDim2.new(0, 480, 0, 40)
                minBtn.Text = "+"
            else
                contentFrame.Visible = true
                tabBar.Visible = true
                mainFrame.Size = UDim2.new(0, 480, 0, 520)
                minBtn.Text = "−"
            end
        end)

        setupButtonHover(closeBtn, C_RED_DARK, Color3.fromRGB(160, 50, 50))

        closeBtn.MouseButton1Click:Connect(function()
            screenGui.Enabled = false
        end)

        UserInputService.InputBegan:Connect(function(input, gp)
            if not gp and input.KeyCode == Enum.KeyCode.Insert then
                screenGui.Enabled = not screenGui.Enabled
            end
        end)
    end

    local function updatePlayerList()
        if not playerListFrame then return end
        local all = getPlayerHealthData()
        local myData = getLocalHealth()
        local display = {}
        if myData then
            table.insert(display, {name = LocalPlayer.Name, percent = myData.percent, isLocal = true})
        end
        for _, p in ipairs(all) do
            table.insert(display, {name = p.name, percent = p.percent, isLocal = false})
        end

        for i, card in ipairs(playerCards) do
            local data = display[i]
            if data then
                card.frame.Visible = true
                card.name.Text = data.name
                card.name.TextColor3 = data.isLocal and Color3.fromRGB(100, 200, 255) or C_TEXT
                card.hp.Text = math.floor(data.percent) .. "%"
                if data.percent >= 75 then
                    card.hp.TextColor3 = C_GREEN
                    card.frame.BackgroundColor3 = Color3.fromRGB(35, 55, 40)
                elseif data.percent >= 35 then
                    card.hp.TextColor3 = C_YELLOW
                    card.frame.BackgroundColor3 = Color3.fromRGB(55, 50, 30)
                else
                    card.hp.TextColor3 = C_RED
                    card.frame.BackgroundColor3 = Color3.fromRGB(55, 35, 35)
                end
            else
                card.frame.Visible = false
            end
        end

        local rows = math.ceil(#display / 2)
        playerListFrame.CanvasSize = UDim2.new(0, 0, 0, rows * 48 + 8)
    end

    local function init()
        createUI()
        startDungeonMonitor()
        setupCannonballListener()
        startAntiFling()

        LocalPlayer.CharacterAdded:Connect(function(char)
            local hum = char:WaitForChild("Humanoid")
            hum.WalkSpeed = Settings.WalkSpeed
        end)

        RunService.Heartbeat:Connect(function()
            updatePlayerList()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum and hum.WalkSpeed ~= Settings.WalkSpeed then
                    hum.WalkSpeed = Settings.WalkSpeed
                end
            end
        end)

        local lastWeapon = nil
        RunService.Heartbeat:Connect(function()
            local w = getEquippedWeapon()
            if w ~= lastWeapon then
                lastWeapon = w
                if not w and Settings.AutoAttack and not Settings.AutoFarm then
                    Settings.AutoAttack = false
                    stopAutoAttack()
                    if attackToggle then attackToggle.Text = "OFF"; attackToggle.BackgroundColor3 = C_RED end
                end
            end
        end)

        if Settings.AutoAttack then
            if attackToggle then attackToggle.Text = "ON"; attackToggle.BackgroundColor3 = C_GREEN end
            if game.PlaceId ~= LOBBY_PLACE_ID then startAutoAttack() end
        end
        if Settings.AutoAbility then
            if abilityToggle then attackToggle.Text = "ON"; attackToggle.BackgroundColor3 = C_GREEN end
            startAutoAbility()
        end
        if Settings.AutoHealSelf or Settings.AutoHealTeam then
            if Settings.AutoHealSelf and selfHealToggle then selfHealToggle.Text = "ON"; selfHealToggle.BackgroundColor3 = C_GREEN end
            if Settings.AutoHealTeam and teamHealToggle then teamHealToggle.Text = "ON"; teamHealToggle.BackgroundColor3 = C_GREEN end
            startAutoHeal()
        end
        if Settings.AutoStart and not isInDungeon then
            task.spawn(autoStartSequence)
        end
        if Settings.AutoLevelUp then startAutoLevelUp() end
        startAutoEquip()
        if Settings.EquipBestWeapon then
            task.delay(1, function()
                pcall(equipBestWeapon)
            end)
        end
        if Settings.EquipBestArmor then
            task.delay(1, function()
                pcall(equipBestArmor)
            end)
        end
        if Settings.AutoSell and game.PlaceId == LOBBY_PLACE_ID then
            task.delay(2, function()
                autoSellItems()
            end)
        end

    end

    init()
    print("[DQR] Init completed")
end)

if not success then
    warn("Script error: " .. tostring(err))
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "DQR Error",
        Text = tostring(err),
        Duration = 10
    })
end
