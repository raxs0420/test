    local function enableFarmAttack()
        Settings.AutoFarm = true; Settings.AutoAttack = true
        if farmToggle then farmToggle.Text = "ON"; farmToggle.BackgroundColor3 = C_GREEN end
        if attackToggle then attackToggle.Text = "ON"; attackToggle.BackgroundColor3 = C_GREEN end
        if autoStartToggle then autoStartToggle.Text = "Running" end
        startAutoAttack(); startAutoFarm()
    end

    local function autoStartSequence()
        if autoStartRunning then return end
        autoStartRunning = true
        if game.PlaceId ~= LOBBY_PLACE_ID then
            isInDungeon = true; pcall(changeStartValue)
            task.delay(3, function() if isInDungeon then enableFarmAttack() end end)
            autoStartRunning = false; return
        end
        if autoStartToggle then autoStartToggle.Text = "Creating..." end
        local ok = pcall(createLobby)
        if not ok then
            if autoStartToggle then autoStartToggle.Text = "Failed!" end
            task.delay(2, function() if autoStartToggle and Settings.AutoStart then autoStartToggle.Text = "ON" end; autoStartRunning = false end)
            return
        end
        if autoStartToggle then autoStartToggle.Text = "Starting..." end
        task.wait(1)
        if not Settings.AutoStart then autoStartRunning = false; return end
        local ok2 = pcall(startDungeon)
        if not ok2 then
            if autoStartToggle then autoStartToggle.Text = "Failed!" end
            task.delay(2, function() if autoStartToggle and Settings.AutoStart then autoStartToggle.Text = "ON" end; autoStartRunning = false end)
            return
        end
        if autoStartToggle then autoStartToggle.Text = "Waiting..." end
        while Settings.AutoStart do
            task.wait(0.5)
            if game.PlaceId ~= LOBBY_PLACE_ID then break end
        end
        if not Settings.AutoStart then autoStartRunning = false; return end
        task.wait(1)
        local found, wt = false, 0
        while Settings.AutoStart and wt < 10 do
            task.wait(0.5); wt = wt + 0.5
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local clusters = getEnemyClusters(LocalPlayer.Character.HumanoidRootPart.Position)
                if clusters and #clusters > 0 then found = true; break end
            end
        end
        if not Settings.AutoStart then autoStartRunning = false; return end
        isInDungeon = true; pcall(changeStartValue)
        task.delay(3, function() if isInDungeon then enableFarmAttack() end end)
        autoStartRunning = false
    end

    local function startDungeonMonitor()
        RunService.Heartbeat:Connect(function()
            local isLobby = (game.PlaceId == LOBBY_PLACE_ID)
            local inDungeonNow = not isLobby
            if inDungeonNow and not isInDungeon then
                isInDungeon = true
                if Settings.AutoStart and not autoStartRunning then
                    task.delay(3, function() if isInDungeon then enableFarmAttack() end end)
                end
            elseif not inDungeonNow and isInDungeon then
                isInDungeon = false
                Settings.AutoFarm = false; Settings.AutoAttack = false
                stopAutoAttack(); stopAutoFarm()
                if farmToggle then farmToggle.Text = "OFF"; farmToggle.BackgroundColor3 = C_RED end
                if attackToggle then attackToggle.Text = "OFF"; attackToggle.BackgroundColor3 = C_RED end
                if autoStartToggle and Settings.AutoStart then autoStartToggle.Text = "ON" end
            end
        end)
    end

