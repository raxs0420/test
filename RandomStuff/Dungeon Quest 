        local function setupFastRejoinListener()
            if fastRejoinConnection then return end
            local r = ReplicatedStorage:FindFirstChild("remotes")
            local sjr = r and r:FindFirstChild("showJoinRequest")
            if not sjr then return end
            fastRejoinConnection = sjr.OnClientEvent:Connect(function(...)
                if tick() - rejoinStartTime < 30 then return end
                if Settings.Raid then return end
                local shouldRejoin = Settings.ForceRejoin or (Settings.FastRejoin and Settings.AutoStart)
                if not shouldRejoin then return end
                local rd = r:FindFirstChild("replayDungeon")
                if rd then
                    rd:FireServer({dungeonProgress="bossKilled", dungeonStarted=true, hardcore=Settings.Hardcore, dungeonFinished=true, dungeonName=Settings.SelectedDungeon, isHardcore=Settings.Hardcore, fightingBoss=true})
                end
            end)
        end

