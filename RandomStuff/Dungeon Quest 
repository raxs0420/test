    local function startAutoHeal()
        if healConnection then return end
        healConnection = RunService.Heartbeat:Connect(function()
            if game.PlaceId == LOBBY_PLACE_ID then return end
            local now = tick()
            if now - lastHealCast < 0.1 then return end
            local abilities = getEquippedAbilities()
            local heals = {}
            for _, a in ipairs(abilities) do if a.isHealing then table.insert(heals, a) end end
            if #heals == 0 then return end
            local shouldHeal = false
            if Settings.AutoHealSelf then
                local hd = getLocalHealth()
                if hd and hd.percent <= Settings.SelfHealThreshold then shouldHeal = true end
            end
            if not shouldHeal and Settings.AutoHealTeam then
                local myData = getLocalHealth()
                if myData then
                    for _, pd in ipairs(getPlayerHealthData()) do
                        if pd.percent <= Settings.TeamHealThreshold then
                            if Settings.TeamHealDistance <= 0 or (myData.position - pd.position).Magnitude <= Settings.TeamHealDistance then
                                shouldHeal = true; break
                            end
                        end
                    end
                end
            end
            if shouldHeal then lastHealCast = now; for _, h in ipairs(heals) do pcall(function() castAbility(h) end) end end
        end)
    end

