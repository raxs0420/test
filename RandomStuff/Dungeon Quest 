    local function startAutoAbility()
        stopAutoAbility()
        abilityCycleSlot = 1
        lastCycleTime = tick()
        abilityConnection = RunService.Heartbeat:Connect(function()
            if not Settings.AutoAbility then return end
            if game.PlaceId == LOBBY_PLACE_ID then return end
            local now = tick()
            local delay = Settings.AbilityCycleDelay
            if delay <= 0 then delay = 0.05 end
            if now - lastCycleTime < delay then return end
            local abilities = getEquippedAbilities()
            local nonHeal = {}
            for _, a in ipairs(abilities) do if not a.isHealing then table.insert(nonHeal, a) end end
            if #nonHeal == 0 then return end
            lastCycleTime = now
            local ab = nonHeal[abilityCycleSlot]
            if ab then pcall(function() castAbility(ab) end) end
            abilityCycleSlot = abilityCycleSlot + 1
            if abilityCycleSlot > #nonHeal then abilityCycleSlot = 1 end
        end)
    end

