        cannonballDeathConnection:Disconnect()
        cannonballDeathConnection = nil
    end
    
    local character = LocalPlayer.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                hrp.Anchored = false
            end)
        end
    end
    
    if restartAfterRespawn then
        if respawnTimer then
            respawnTimer:Disconnect()
