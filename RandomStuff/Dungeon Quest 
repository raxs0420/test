    local function startAntiFling()
        if antiFlingConnection then return end
        antiFlingConnection = RunService.Heartbeat:Connect(function()
            local now = tick()
            if now - lastCheck < COOLDOWN then return end
            lastCheck = now

            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local linVel = hrp.AssemblyLinearVelocity
            local angVel = hrp.AssemblyAngularVelocity
            local linSpeed = linVel.Magnitude
            local angSpeed = angVel.Magnitude

            local stopped = false
            if linSpeed > FLING_VEL_THRESHOLD then
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                stopped = true
            end
            if angSpeed > FLING_ANG_THRESHOLD then
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                stopped = true
            end
            if stopped then
                local newVel = hrp.AssemblyLinearVelocity
                if math.abs(newVel.Y) > 50 then
                    hrp.AssemblyLinearVelocity = Vector3.new(newVel.X, 0, newVel.Z)
                end
            end
        end)
    end

