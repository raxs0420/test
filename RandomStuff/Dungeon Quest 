local function autoStartSequence()
    if autoStartRunning then return end
    autoStartRunning = true

    local isLobby = (game.PlaceId == LOBBY_PLACE_ID)
    if not isLobby then
        isInDungeon = true
        pcall(changeStartValue)
        task.delay(3, function()
            if isInDungeon then
                enableAutoFarmAttack()
            end
        end)
        autoStartRunning = false
        return
    end

    if autoStartBtnRef then
        autoStartBtnRef.Text = "Creating..."
    end
    local success, err = pcall(createLobby)
    if not success then
        if autoStartBtnRef then autoStartBtnRef.Text = "Failed!" end
        task.delay(2, function()
            if autoStartBtnRef and Settings.AutoStart then autoStartBtnRef.Text = "ON" end
            autoStartRunning = false
        end)
        return
    end
    if autoStartBtnRef then
        autoStartBtnRef.Text = "Starting..."
    end
    task.wait(1)
    if not Settings.AutoStart then
        autoStartRunning = false
        return
    end
    local success2, err2 = pcall(startDungeon)
    if not success2 then
        if autoStartBtnRef then autoStartBtnRef.Text = "Failed!" end
        task.delay(2, function()
            if autoStartBtnRef and Settings.AutoStart then autoStartBtnRef.Text = "ON" end
            autoStartRunning = false
        end)
        return
    end
    if autoStartBtnRef then
        autoStartBtnRef.Text = "Waiting..."
    end
    while Settings.AutoStart do
        task.wait(0.5)
        if game.PlaceId ~= LOBBY_PLACE_ID then
            break
        end
    end
    if not Settings.AutoStart then
        autoStartRunning = false
        return
    end
    task.wait(1)
    local enemiesFound = false
    local waitTime = 0
    while Settings.AutoStart and waitTime < 10 do
        task.wait(0.5)
        waitTime = waitTime + 0.5
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local myPos = LocalPlayer.Character.HumanoidRootPart.Position
            local clusters = getEnemyClusters(myPos)
            if clusters and #clusters > 0 then
                enemiesFound = true
                break
            end
        end
    end
    if not Settings.AutoStart then
        autoStartRunning = false
        return
    end
    if not enemiesFound then
    end
    isInDungeon = true
    pcall(changeStartValue)
    task.delay(3, function()
        if isInDungeon then
            enableAutoFarmAttack()
        end
    end)
    autoStartRunning = false
end

local function startDungeonMonitor()
    RunService.Heartbeat:Connect(function()
        local isLobby = (game.PlaceId == LOBBY_PLACE_ID)
        local inDungeonNow = not isLobby
        if inDungeonNow and not isInDungeon then
            isInDungeon = true
            if Settings.AutoStart and not autoStartRunning then
                task.delay(3, function()
                    if isInDungeon then
                        enableAutoFarmAttack()
                    end
                end)
            end
        elseif not inDungeonNow and isInDungeon then
            isInDungeon = false
            Settings.AutoFarm = false
            Settings.AutoAttack = false
            stopAutoAttack()
            stopAutoFarm()
            if farmBtnRef then
                farmBtnRef.Text = "OFF"
                farmBtnRef.BackgroundColor3 = Color3.fromRGB(160, 0, 0)
            end
            if attackBtnRef then
                attackBtnRef.Text = "OFF"
                attackBtnRef.BackgroundColor3 = Color3.fromRGB(160, 0, 0)
            end
            if autoStartBtnRef and Settings.AutoStart then
                autoStartBtnRef.Text = "ON"
            end
        end
    end)
end

