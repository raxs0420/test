        local isDragging = false
        local trackWidth = 0

        local function updateSpeedSlider(percent)
            local speed = math.floor(minSpeed + (maxSpeed - minSpeed) * percent)
            speed = math.clamp(speed, minSpeed, maxSpeed)
            sliderFill.Size = UDim2.new(0, trackWidth * percent, 1, 0)
            speedValueBox.Text = tostring(speed)
            Settings.WalkSpeed = speed
            setWalkSpeed(speed)
            saveSettings()
        end

        local function updateSpeedFromValue(value)
            trackWidth = sliderTrack.AbsoluteSize.X            local clamped = math.clamp(value, minSpeed, maxSpeed)
            local percent = (clamped - minSpeed) / (maxSpeed - minSpeed)
            sliderFill.Size = UDim2.new(0, trackWidth * percent, 1, 0)
            speedValueBox.Text = tostring(clamped)
            Settings.WalkSpeed = clamped
            setWalkSpeed(clamped)
            saveSettings()
        end

        task.delay(0.1, function()
            trackWidth = sliderTrack.AbsoluteSize.X
            local initialPercent = (Settings.WalkSpeed - minSpeed) / (maxSpeed - minSpeed)
            local initialWidth = trackWidth * initialPercent
            sliderFill.Size = UDim2.new(0, initialWidth, 1, 0)
        end)

        sliderBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
                local trackPos = sliderTrack.AbsolutePosition.X
                trackWidth = sliderTrack.AbsoluteSize.X
                local relativeX = math.clamp(input.Position.X - trackPos, 0, trackWidth)
                local percent = relativeX / trackWidth
                updateSpeedSlider(percent)
            end
        end)

        sliderKnob.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local trackPos = sliderTrack.AbsolutePosition.X
                trackWidth = sliderTrack.AbsoluteSize.X
                local relativeX = math.clamp(input.Position.X - trackPos, 0, trackWidth)
                local percent = relativeX / trackWidth
                updateSpeedSlider(percent)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = false
            end
        end)

        speedValueBox.FocusLost:Connect(function(enterPressed)
            local num = tonumber(speedValueBox.Text)
            if num then
                updateSpeedFromValue(num)
            else
                local currentPercent = sliderFill.Size.X.Offset / trackWidth
                local currentSpeed = math.floor(minSpeed + (maxSpeed - minSpeed) * currentPercent)
                speedValueBox.Text = tostring(currentSpeed)
            end
        end)

