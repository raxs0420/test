local function startWeaponMonitor(statusLabel)
    local lastWeapon = nil
    RunService.Heartbeat:Connect(function()
        local weapon = getEquippedWeapon()
        if weapon ~= lastWeapon then
            lastWeapon = weapon
            if weapon then
                statusLabel.Text = "Weapon: " .. weapon
                statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            else
                statusLabel.Text = "Weapon: None"
                statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
        end
        if not weapon and Settings.AutoAttack and not Settings.AutoFarm then
            Settings.AutoAttack = false
            stopAutoAttack()
            if attackBtnRef then
                attackBtnRef.Text = "OFF"
                attackBtnRef.BackgroundColor3 = Color3.fromRGB(160, 0, 0)
            end
        end
    end)
end

local function startSpeedMonitor()
    LocalPlayer.CharacterAdded:Connect(function(character)
        local humanoid = character:WaitForChild("Humanoid")
        humanoid.WalkSpeed = Settings.WalkSpeed
    end)
end

local function init()
    local statusLabel = createUI()
    startWeaponMonitor(statusLabel)
    startSpeedMonitor()
    startDungeonMonitor()
    if Settings.AutoStart and not isInDungeon then
        task.spawn(autoStartSequence)
    end
    if Settings.AutoLevelUp then
        startAutoLevelUp()
    end
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.Insert then
            if uiScreenGui then
                uiScreenGui.Enabled = not uiScreenGui.Enabled
            end
        end
    end)
end

