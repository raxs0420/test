            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local hum = char:FindFirstChild("Humanoid")
            if hum then hum.PlatformStand = true; hum.Sit = false end

            hrp.Anchored = false
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

            local myPos = hrp.Position
            local now = tick()

            if now - lastEnemyUpdate >= ENEMY_UPDATE_INTERVAL then
                lastEnemyUpdate = now
                local special = nil
                for _, obj in pairs(Workspace:GetChildren()) do
                    if obj.Name == "Azrallik's Heart" then
                        local p = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
                        if p then special = p; break end
                    end
                end
                local newCluster = nil
                if special then
                    newCluster = {centroid = special.Position, enemies = {special}, closestEnemy = special, closestDist = (myPos - special.Position).Magnitude}
                else
                    local clusters = getEnemyClusters(myPos)
                    if clusters and #clusters > 0 then newCluster = clusters[1]; dodgeState.currentEnemy = newCluster.closestEnemy end
                end
                cachedCluster = newCluster
            end

            if not cachedCluster then return end
            local enemyPart = cachedCluster.closestEnemy
            if not enemyPart then return end

            local desiredPos, baseYOffset
            if Settings.FarmingMode == "Under" then
                baseYOffset = Settings.UnderOffset
                desiredPos = Vector3.new(enemyPart.Position.X, enemyPart.Position.Y + Settings.UnderOffset, enemyPart.Position.Z)
            elseif Settings.FarmingMode == "Top" then
                baseYOffset = math.abs(Settings.UnderOffset)
                desiredPos = Vector3.new(enemyPart.Position.X, enemyPart.Position.Y + math.abs(Settings.UnderOffset), enemyPart.Position.Z)
            elseif Settings.FarmingMode == "TopOrbit" then
                baseYOffset = math.abs(Settings.OrbitYOffset)
                local dt = now - lastTime; lastTime = now
                orbitAngle = orbitAngle + (Settings.OrbitSpeed / Settings.OrbitRadius) * dt
                local s = Settings.RotationDirection == "Counterclockwise" and -1 or 1
                desiredPos = Vector3.new(cachedCluster.centroid.X + math.cos(orbitAngle)*Settings.OrbitRadius, enemyPart.Position.Y + math.abs(Settings.OrbitYOffset), cachedCluster.centroid.Z + s*math.sin(orbitAngle)*Settings.OrbitRadius)
            else
                baseYOffset = Settings.OrbitYOffset
                local dt = now - lastTime; lastTime = now
                orbitAngle = orbitAngle + (Settings.OrbitSpeed / Settings.OrbitRadius) * dt
                local s = Settings.RotationDirection == "Counterclockwise" and -1 or 1
                desiredPos = Vector3.new(cachedCluster.centroid.X + math.cos(orbitAngle)*Settings.OrbitRadius, enemyPart.Position.Y + Settings.OrbitYOffset, cachedCluster.centroid.Z + s*math.sin(orbitAngle)*Settings.OrbitRadius)
            end

            if Settings.AutoDodge then
                scanProjectiles()
                local hasThreats = false
                for _, pd in ipairs(activeProjectiles) do
                    local p = pd.part
                    if p and p:IsA("BasePart") and p.Parent then
                        if (p.Position - myPos).Magnitude - getProjRadius(p) < DODGE_DANGER_ZONE then hasThreats = true; break end
                    end
                end
                if hasThreats then
                    local safe = findSafePos(myPos, cachedCluster.centroid, activeProjectiles, baseYOffset)
                    if safe then dodgeState.isDodging = true; dodgeState.stablePosition = safe; desiredPos = safe end
                else
                    if dodgeState.isDodging then
                        if isPosSafe(desiredPos, activeProjectiles) then dodgeState.isDodging = false; dodgeState.stablePosition = nil
                        elseif dodgeState.stablePosition then desiredPos = dodgeState.stablePosition end
                    end
                end
                local targetCF = CFrame.new(desiredPos, cachedCluster.centroid)
                if (desiredPos - myPos).Magnitude > 0.5 then hrp.CFrame = targetCF end
            else
                local targetCF = CFrame.new(desiredPos, cachedCluster.centroid)
                local dist = (desiredPos - myPos).Magnitude
                if dist > 50 then
                    if not isTweening then
                        isTweening = true
                        local wp = (myPos + desiredPos) * 0.5 + Vector3.new(0, 10, 0)
                        local ti = TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                        local tw = TweenService:Create(hrp, ti, {CFrame = CFrame.new(wp, cachedCluster.centroid)})
                        tw:Play(); tw.Completed:Wait()
                        tw = TweenService:Create(hrp, ti, {CFrame = targetCF})
                        tw:Play(); tw.Completed:Wait()
                        isTweening = false
                    end
                else
                    hrp.CFrame = targetCF
                end
            end
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
    end

