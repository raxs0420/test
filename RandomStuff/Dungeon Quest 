        corner(knob, 7)

        local minLabel = Instance.new("TextLabel")
        minLabel.Size = UDim2.new(0, 30, 0, 14)
        minLabel.Position = UDim2.new(0, 10, 0, 44)
        minLabel.BackgroundTransparency = 1
        minLabel.Text = tostring(minVal)
        minLabel.TextColor3 = C_TEXT_DIM
        minLabel.TextSize = 9
        minLabel.Font = Enum.Font.Gotham
        minLabel.Parent = container

        local maxLabel = Instance.new("TextLabel")
        maxLabel.Size = UDim2.new(0, 30, 0, 14)
        maxLabel.Position = UDim2.new(1, -40, 0, 44)
        maxLabel.BackgroundTransparency = 1
        maxLabel.Text = tostring(maxVal)
        maxLabel.TextColor3 = C_TEXT_DIM
        maxLabel.TextSize = 9
        maxLabel.Font = Enum.Font.Gotham
        maxLabel.TextXAlignment = Enum.TextXAlignment.Right
        maxLabel.Parent = container

        local isDragging = false
        local trackWidth = 0

        local function formatVal(v)
            if isFloat then return math.floor(v * 10) / 10 end
            return math.floor(v + 0.5)
        end

        local function updateFromPercent(pct)
            local v = minVal + (maxVal - minVal) * pct
            v = formatVal(v)
            v = math.clamp(v, minVal, maxVal)
            fill.Size = UDim2.new(0, trackWidth * pct, 1, 0)
            valBox.Text = tostring(v)
            Settings[settingKey] = v
            saveSettings()
            if callback then callback(v) end
            return v
        end

        local function updateFromInput(x)
            local tp = track.AbsolutePosition.X
            trackWidth = track.AbsoluteSize.X
            local rx = math.clamp(x - tp, 0, trackWidth)
            updateFromPercent(rx / trackWidth)
        end

        local function setFromValue(v)
            trackWidth = track.AbsoluteSize.X
            local c = math.clamp(v, minVal, maxVal)
            local pct = (c - minVal) / (maxVal - minVal)
            fill.Size = UDim2.new(0, trackWidth * pct, 1, 0)
            valBox.Text = tostring(c)
        end

        task.delay(0.1, function()
            trackWidth = track.AbsoluteSize.X
            local pct = (Settings[settingKey] - minVal) / (maxVal - minVal)
            fill.Size = UDim2.new(0, trackWidth * pct, 1, 0)
        end)

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true; updateFromInput(input.Position.X)
            end
        end)

        knob.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromInput(input.Position.X)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDragging = false
            end
        end)

        valBox.FocusLost:Connect(function()
            local num = tonumber(valBox.Text)
            if num then
                num = math.clamp(num, minVal, maxVal)
                num = formatVal(num)
                setFromValue(num)
                Settings[settingKey] = num
                saveSettings()
                if callback then callback(num) end
            else
                setFromValue(Settings[settingKey])
            end
        end)

        return container, valBox, fill
    end

