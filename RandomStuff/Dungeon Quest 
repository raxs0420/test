local function setNoclip(enabled)
    if noclipEnabled == enabled then return end
    noclipEnabled = enabled
    local character = LocalPlayer.Character
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not enabled
        end
    end
end

local function getEquippedWeapon()
    local weaponValue = LocalPlayer:FindFirstChild("weaponEquipped")
    if weaponValue and weaponValue:IsA("StringValue") then
        return weaponValue.Value
    end
    return nil
end

local function getEquippedSpells()
    local spells = {}
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return spells end
    for _, child in pairs(backpack:GetChildren()) do
        if child:IsA("Tool") then
            local spellEvent = child:FindFirstChild("spellEvent")
            if spellEvent then
                table.insert(spells, spellEvent)
            end
            local abilityEvent = child:FindFirstChild("abilityEvent")
            if abilityEvent then
                table.insert(spells, abilityEvent)
            end
        end
    end
    return spells
end

local function updateCachedSpell()
    local allEvents = getEquippedSpells()
    cachedSpellEvents = {}
    cachedAbilityEvents = {}
    for _, event in ipairs(allEvents) do
        local parent = event.Parent
        if parent then
            if event.Name == "spellEvent" then
                table.insert(cachedSpellEvents, event)
            elseif event.Name == "abilityEvent" then
                table.insert(cachedAbilityEvents, event)
            end
        end
    end
    return #cachedSpellEvents > 0 or #cachedAbilityEvents > 0
end

