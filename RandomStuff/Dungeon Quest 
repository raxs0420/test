        local function doRejoin()
            local r = ReplicatedStorage:FindFirstChild("remotes")
            local rd = r and r:FindFirstChild("replayDungeon")
            if not rd then
                warn("[DQR] replayDungeon remote not found!")
                return
            end
            local hc = Workspace:FindFirstChild("hardcore")
            local isHc = hc and hc.Value or false
            local dn = Workspace:FindFirstChild("dungeonName")
            local dName = dn and dn.Value or Settings.SelectedDungeon
            local payload = {
                dungeonProgress = "bossKilled",
                dungeonStarted = true,
                hardcore = isHc,
                dungeonFinished = true,
                dungeonName = dName,
                isHardcore = isHc,
                fightingBoss = true
            }
            print("[DQR] Sending replayDungeon with dungeonName=" .. tostring(dName) .. ", hardcore=" .. tostring(isHc))
            local ok, err = pcall(function()
                rd:FireServer(payload)
            end)
            if not ok then
                warn("[DQR] replayDungeon failed: " .. tostring(err))
            else
                print("[DQR] replayDungeon sent successfully")
            end
        end

