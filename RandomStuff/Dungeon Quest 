    local function getEquippedAbilities()
        local abilities = {}
        local function scan(parent)
            if not parent then return end
            for _, child in pairs(parent:GetChildren()) do
                if child:IsA("Tool") then
                    local se = child:FindFirstChild("spellEvent")
                    local ae = child:FindFirstChild("abilityEvent")
                    if se or ae then
                        table.insert(abilities, {
                            name = child.Name,
                            spellEvent = se,
                            abilityEvent = ae,
                            isHealing = isHealingSpell(child.Name)
                        })
                    end
                end
            end
        end
        scan(LocalPlayer.Character)
        scan(LocalPlayer:FindFirstChild("Backpack"))
        return abilities
    end

    local function castAbility(ability)
        if not ability then return false end
        local ok = false
        if ability.spellEvent then
            ok = pcall(function() ability.spellEvent:FireServer() end)
        elseif ability.abilityEvent then
            ok = pcall(function() ability.abilityEvent:FireServer() end)
        end
        return ok
    end

    local function getPlayerHealthData()
