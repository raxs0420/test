    local function enableFarmAttack()
        Settings.AutoFarm = true; Settings.AutoAttack = true
        if farmToggle then farmToggle.Text = "ON"; farmToggle.BackgroundColor3 = C_GREEN end
        if attackToggle then attackToggle.Text = "ON"; attackToggle.BackgroundColor3 = C_GREEN end
        if autoStartToggle then autoStartToggle.Text = "Running" end
        startAutoAttack(); startAutoFarm()
        if Settings.EquipBestWeapon then
            task.delay(0.5, function() pcall(equipBestWeapon) end)
        end
        if Settings.EquipBestArmor then
