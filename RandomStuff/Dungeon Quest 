    local function updateDodge(myPos, desiredPos, enemyCentroid, baseYOffset)
        scanActiveProjectiles()
        
        local hasThreats = false
        for _, projData in ipairs(activeProjectiles) do
            local part = projData.part
            if part and part:IsA("BasePart") and part.Parent then
                local boundaryDist = getProjectileBoundaryDistance(part, myPos)
                if boundaryDist < DODGE_DANGER_ZONE then
                    hasThreats = true
                    break
                end
            end
        end
        
        if hasThreats then
            local safePos = findSafePosition(myPos, enemyCentroid, activeProjectiles, baseYOffset)
            
            if safePos then
                dodgeState.isDodging = true
                dodgeState.stablePosition = safePos
                return safePos
            end
            
            return myPos
        else
            if dodgeState.isDodging then
                if isPositionSafe(desiredPos, activeProjectiles) then
                    dodgeState.isDodging = false
                    dodgeState.stablePosition = nil
                    return desiredPos
                else
                    if dodgeState.stablePosition then
                        return dodgeState.stablePosition
                    end
                end
            end
            return desiredPos
        end
    end

