    local function runCannonballLoop()
        if cannonballRunning then return end
        if not isGhastlyHarbor() then return end
        if game.PlaceId == LOBBY_PLACE_ID then return end

        cannonballRunning = true
        cannonballStopSignal = false

        local hrp = getHrp()
        local originalPosition = hrp and hrp.Position or nil

        disableFarmForCannonball()

        while cannonballRunning and not cannonballStopSignal do
            if not LocalPlayer.Character then
                local waitStart = tick()
                while not LocalPlayer.Character and not cannonballStopSignal and tick() - waitStart < 30 do
                    task.wait(0.1)
                end
                if cannonballStopSignal or not LocalPlayer.Character then break end
                task.wait(0.5)
                setNoclip(true)
            end

            hrp = getHrp()
            if hrp then
                local pickupRing = Workspace:FindFirstChild("playerPickupCannonballRing")
            local pickupPos = pickupRing and pickupRing.Position + Vector3.new(0, 1, 0)
            if pickupPos and not cannonballStopSignal then
                pcall(function() tweenTo(pickupPos, 2.4) end)
                if waitForTweenOrStop() then break end
            end

            if cannonballStopSignal then break end

            local fireCannon = Workspace:FindFirstChild("playerFireCannon")
            local fireRing = fireCannon and fireCannon:FindFirstChild("ring")
            local firePos = fireRing and fireRing.Position + Vector3.new(0, 1, 0)
            if firePos and not cannonballStopSignal then
                pcall(function() tweenTo(firePos, 2.4) end)
                if waitForTweenOrStop() then break end
            end

            end
            task.wait(0.05)
        end

        resetCannonballState()

        if originalPosition then
            local hrp = getHrp()
            if hrp and hrp.Parent then
                pcall(function()
                    hrp.CFrame = CFrame.new(originalPosition)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end)
            end
        end

        restoreFarmAfterCannonball()
    end

    local function setupCannonballListener()
        if cannonballConnection then
            pcall(function() cannonballConnection:Disconnect() end)
            cannonballConnection = nil
        end

        local remotes = ReplicatedStorage:FindFirstChild("remotes")
        local ghastlyEvents = remotes and remotes:FindFirstChild("ghastlyBossSpecficEvents")
        if not ghastlyEvents then return end

        cannonballConnection = ghastlyEvents.OnClientEvent:Connect(function(msg)
            if msg == "Show Cannonball Rings" then
                if isGhastlyHarbor() and not cannonballRunning and game.PlaceId ~= LOBBY_PLACE_ID then
                    if LocalPlayer.Character then
                        task.spawn(runCannonballLoop)
                    else
                        local conn
                        conn = LocalPlayer.CharacterAdded:Connect(function()
                            pcall(function() conn:Disconnect() end)
                            task.wait(0.5)
                            if isGhastlyHarbor() and not cannonballRunning then
                                task.spawn(runCannonballLoop)
                            end
                        end)
                    end
                end
            elseif msg == "Fire Cannon At Boat" then
                if cannonballRunning then
                    cannonballStopSignal = true
                    if cannonballTween then
                        pcall(function() cannonballTween:Cancel() end)
                        cannonballTween = nil
                    end
                end
            end
        end)
    end

