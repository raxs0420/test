    local function resetCannonballState()
        cannonballRunning = false
        cannonballStopSignal = false
        if cannonballTween then
            pcall(function() cannonballTween:Cancel() end)
            cannonballTween = nil
        end
    end

    local function tweenTo(pos, duration)
        if cannonballTween then
            pcall(function() cannonballTween:Cancel() end)
            cannonballTween = nil
        end
        local hrp = getHrp()
        if not hrp then return false end
        local ti = TweenInfo.new(duration or 2.4, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
        local ok = pcall(function()
            cannonballTween = TweenService:Create(hrp, ti, {Position = pos})
            cannonballTween:Play()
        end)
        return ok
    end

    local function waitForTweenOrStop()
        local start = tick()
        while cannonballTween and cannonballRunning and not cannonballStopSignal and tick() - start < 8 do
            pcall(function()
                if cannonballTween then
                    local state = cannonballTween.PlaybackState
                    if state == Enum.PlaybackState.Completed or state == Enum.PlaybackState.Cancelled then
                        cannonballTween = nil
                    end
                end
            end)
            task.wait(0.03)
        end
        if cannonballTween then
            pcall(function() cannonballTween:Cancel() end)
            cannonballTween = nil
        end
        return cannonballStopSignal
    end

