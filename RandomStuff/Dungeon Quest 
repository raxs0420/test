    local function getEnemyClusters(myPos)
        local folders = updateEnemyFolders()
        if #folders == 0 then return nil end
        local all = {}
        for _, f in pairs(folders) do
            for _, e in pairs(f:GetChildren()) do
                if e:IsA("Model") or e:IsA("BasePart") then
                    local hrp = e:FindFirstChild("HumanoidRootPart") or e:FindFirstChild("Torso") or e:FindFirstChild("Head") or e:FindFirstChildWhichIsA("BasePart")
                    if hrp then table.insert(all, hrp) end
                end
            end
        end
        if #all == 0 then return nil end
        local clusters = {}
        local visited = {}
        for i = 1, #all do
            if not visited[i] then
                local cluster = {}
                local queue = {i}
                visited[i] = true
                while #queue > 0 do
                    local idx = table.remove(queue, 1)
                    local part = all[idx]
                    table.insert(cluster, part)
                    for j = 1, #all do
                        if not visited[j] and (part.Position - all[j].Position).Magnitude <= 10 then
                            visited[j] = true; table.insert(queue, j)
                        end
                    end
                end
                local centroid = Vector3.new(0,0,0)
                for _, p in ipairs(cluster) do centroid = centroid + p.Position end
                centroid = centroid / #cluster
                local closest, cdist = nil, math.huge
                for _, p in ipairs(cluster) do
                    local d = (myPos - p.Position).Magnitude
                    if d < cdist then cdist = d; closest = p end
                end
                table.insert(clusters, {centroid = centroid, enemies = cluster, closestEnemy = closest, closestDist = cdist})
            end
        end
        table.sort(clusters, function(a, b) return (myPos - a.centroid).Magnitude < (myPos - b.centroid).Magnitude end)
        return clusters
    end

