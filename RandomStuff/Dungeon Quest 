                humanoid.Sit = false
            end
            
            hrp.Anchored = false
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            
            local myPos = hrp.Position

            local now = tick()
            if now - lastEnemyUpdate >= ENEMY_UPDATE_INTERVAL then
                lastEnemyUpdate = now

                local specialEnemy = nil
                for _, obj in pairs(Workspace:GetChildren()) do
                    if obj.Name == "Azrallik's Heart" then
                        local hrpPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("Head")
                        if not hrpPart then
                            hrpPart = obj:FindFirstChildWhichIsA("BasePart")
                        end
                        if hrpPart then
                            specialEnemy = hrpPart
                            break
                        end
                    end
                end

                local newCluster = nil
                if specialEnemy then
                    newCluster = {
                        centroid = specialEnemy.Position,
                        enemies = {specialEnemy},
                        size = 1,
                        closestEnemy = specialEnemy,
                        closestDist = (myPos - specialEnemy.Position).Magnitude
                    }
                else
                    local clusters = getEnemyClusters(myPos, dodgeState.currentEnemy)
                    if clusters and #clusters > 0 then
                        newCluster = clusters[1]
                        dodgeState.currentEnemy = newCluster.closestEnemy
                    end
                end

                if newCluster ~= cachedCluster then
                    cachedCluster = newCluster
                end
            end

            if not cachedCluster then
                return
            end

            local enemyPart = cachedCluster.closestEnemy
            if not enemyPart then return end

            local desiredPos
            local baseYOffset
            if Settings.FarmingMode == "Under" then
                baseYOffset = Settings.UnderOffset
                desiredPos = Vector3.new(enemyPart.Position.X, enemyPart.Position.Y + Settings.UnderOffset, enemyPart.Position.Z)
            elseif Settings.FarmingMode == "Top" then
                baseYOffset = math.abs(Settings.UnderOffset)
                desiredPos = Vector3.new(enemyPart.Position.X, enemyPart.Position.Y + math.abs(Settings.UnderOffset), enemyPart.Position.Z)
            elseif Settings.FarmingMode == "TopOrbit" then
                baseYOffset = math.abs(Settings.OrbitYOffset)
                local targetY = enemyPart.Position.Y + math.abs(Settings.OrbitYOffset)
                local dt = now - lastTime
                lastTime = now
                local angularSpeed = Settings.OrbitSpeed / Settings.OrbitRadius
                orbitAngle = orbitAngle + angularSpeed * dt
                local dirSign = Settings.RotationDirection
                local x = math.cos(orbitAngle) * Settings.OrbitRadius
                local z = dirSign * math.sin(orbitAngle) * Settings.OrbitRadius
                desiredPos = Vector3.new(cachedCluster.centroid.X + x, targetY, cachedCluster.centroid.Z + z)
            else
                baseYOffset = Settings.OrbitYOffset
                local targetY = enemyPart.Position.Y + Settings.OrbitYOffset
                local dt = now - lastTime
                lastTime = now
                local angularSpeed = Settings.OrbitSpeed / Settings.OrbitRadius
                orbitAngle = orbitAngle + angularSpeed * dt
                local dirSign = Settings.RotationDirection
                local x = math.cos(orbitAngle) * Settings.OrbitRadius
                local z = dirSign * math.sin(orbitAngle) * Settings.OrbitRadius
                desiredPos = Vector3.new(cachedCluster.centroid.X + x, targetY, cachedCluster.centroid.Z + z)
            end

            if Settings.AutoDodge then
                local finalPos = updateDodge(myPos, desiredPos, cachedCluster.centroid, baseYOffset)
                
                if finalPos then
                    local targetCFrame = CFrame.new(finalPos, cachedCluster.centroid)
                    local dist = (finalPos - myPos).Magnitude
                    
                    if dist > 0.5 then
                        hrp.CFrame = targetCFrame
                    end
                end
            else
                local targetCFrame = CFrame.new(desiredPos, cachedCluster.centroid)
                local dist = (desiredPos - myPos).Magnitude
                
                if dist > 50 then
                    if not isTweening then
                        isTweening = true
                        local waypoint = (myPos + desiredPos) * 0.5 + Vector3.new(0, 10, 0)
                        local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                        local goal = {CFrame = CFrame.new(waypoint, cachedCluster.centroid)}
                        local tween = TweenService:Create(hrp, tweenInfo, goal)
                        tween:Play()
                        tween.Completed:Wait()
                        tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                        goal = {CFrame = targetCFrame}
                        tween = TweenService:Create(hrp, tweenInfo, goal)
                        tween:Play()
                        tween.Completed:Wait()
                        isTweening = false
                    end
                else
                    hrp.CFrame = targetCFrame
                end
            end
            
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
    end

