local function getTowerType(tower)
    local rep = tower:FindFirstChild("TowerReplicator")
    if rep then
        local nameAttr = rep:GetAttribute("Name")
        if nameAttr and nameAttr ~= "" then
            return nameAttr
        end
    end
    return tower:GetAttribute("TowerName") or tower.Name
end

local function findAnimationInSkin(skin, animName)
    local animFolder = skin:FindFirstChild("Animations")
    if not animFolder then return nil end
    local function search(folder, name)
        for _, child in ipairs(folder:GetChildren()) do
            if child:IsA("Animation") and child.Name == name then
                return child
            end
            if child:IsA("Folder") then
                local found = search(child, name)
                if found then return found end
            end
        end
        return nil
    end
    return search(animFolder, animName)
end

local function playIdleOnSkin(skin, level)
    local animator = skin:FindFirstChild("AnimationController") and skin.AnimationController:FindFirstChildOfClass("Animator")
    if not animator then return nil end
    local idleFolder = skin:FindFirstChild("Animations") and skin.Animations:FindFirstChild("Idle")
    if not idleFolder then return nil end
    local keys = {}
    for _, child in ipairs(idleFolder:GetChildren()) do
        local num = tonumber(child.Name)
        if num ~= nil then table.insert(keys, num) end
    end
    if #keys == 0 then return nil end
    table.sort(keys)
    local selectedKey = keys[1]
    for _, k in ipairs(keys) do
        if level >= k then selectedKey = k else break end
    end
    local entry = idleFolder:FindFirstChild(tostring(selectedKey))
    if not entry then return nil end
    local animObj = entry:IsA("Folder") and entry:FindFirstChildOfClass("Animation") or (entry:IsA("Animation") and entry)
    if animObj then
        local track = animator:LoadAnimation(animObj)
        track.Looped = true
        track:Play()
        return track
    end
    return nil
end

local function getFireSoundFromSkin(skin, level, rightHand)
    local weapon = skin:FindFirstChild("Weapon")
    if not weapon then return nil end
    local gunName = (level >= 4) and (rightHand and "Gun2" or "Gun1") or "Gun1"
    local gun = weapon:FindFirstChild(gunName)
    if not gun then gun = weapon:FindFirstChild("Gun") end
    if not gun then return nil end
    local handle = gun:FindFirstChild("Handle")
    if handle then
        local sound = handle:FindFirstChild("Fire")
        if sound and sound:IsA("Sound") then return sound end
    end
    local config = gun:FindFirstChild("Configuration")
    if config then
        local sounds = config:FindFirstChild("Sounds")
        if sounds then
            local fireVal = sounds:FindFirstChild("Fire")
            if fireVal and fireVal:IsA("ObjectValue") then
                local soundObj = fireVal.Value
                if soundObj and soundObj:IsA("Sound") then return soundObj end
            end
            if fireVal and fireVal:IsA("Sound") then return fireVal end
        end
    end
    return nil
end

local function applyUpgradeModule(skin, level)
    local module = skin:FindFirstChild("UpgradesModule")
    if not module or not module:IsA("ModuleScript") then return end
    local ok, data = pcall(require, module)
    if not ok or not data then return end

    if data.Weapons then
        local weaponFolder = skin:FindFirstChild("Weapon")
        if weaponFolder then
            for reqLevel, path in pairs(data.Weapons) do
                if reqLevel <= level then
                    if type(path) ~= "string" then continue end
                    local parts = {}
                    for part in path:gmatch("[^%.]+") do table.insert(parts, part) end
                    local current = skin
                    local source = nil
                    for i, part in ipairs(parts) do
                        if i == #parts then
                            source = current:FindFirstChild(part)
                        else
                            current = current:FindFirstChild(part)
                            if not current then break end
                        end
                    end
                    if source then
                        local existing = weaponFolder:FindFirstChild(source.Name)
                        if not existing then
                            local clone = source:Clone()
                            clone.Parent = weaponFolder
                            clone.Name = source.Name
                        end
                    end
                end
            end
        end
    end

    if data.Transparency then
        for i, transTable in ipairs(data.Transparency) do
            local levelIndex = i - 1
            if levelIndex <= level then
                for path, _ in pairs(transTable) do
                    if type(path) ~= "string" then continue end
                    local parts = {}
                    for part in path:gmatch("[^%.]+") do table.insert(parts, part) end
                    local current = skin
                    local target = nil
                    for j, part in ipairs(parts) do
                        if j == #parts then
                            target = current:FindFirstChild(part)
                        else
                            current = current:FindFirstChild(part)
                            if not current then break end
                        end
                    end
                    if target and target:IsA("BasePart") then
                        target.Transparency = 0
                    end
                end
            end
        end
    end

    if data.Deletions then
        for i, delTable in ipairs(data.Deletions) do
            local levelIndex = i - 1
            if levelIndex <= level then
                for path, _ in pairs(delTable) do
                    if type(path) ~= "string" then continue end
                    local parts = {}
                    for part in path:gmatch("[^%.]+") do table.insert(parts, part) end
                    local current = skin
                    local target = nil
                    for j, part in ipairs(parts) do
                        if j == #parts then
                            target = current:FindFirstChild(part)
                        else
                            current = current:FindFirstChild(part)
                            if not current then break end
                        end
                    end
                    if target and target:IsA("BasePart") then
                        target.Transparency = 1
                    end
                end
            end
        end
    end
end

local function linkBones(skin, tower)
    local skinWeapon = skin:FindFirstChild("Weapon")
    local towerWeapon = tower:FindFirstChild("Weapon")
    if not skinWeapon or not towerWeapon then return end
    local skinConfig = skinWeapon:FindFirstChild("Configuration")
    local towerConfig = towerWeapon:FindFirstChild("Configuration")
    if not skinConfig or not towerConfig then return end
    local skinBones = skinConfig:FindFirstChild("Bones")
    local towerBones = towerConfig:FindFirstChild("Bones")
    if not towerBones then return end
    if skinBones then skinBones:Destroy() end
    local newBones = towerBones:Clone()
    newBones.Parent = skinConfig
    newBones.Name = "Bones"
end

local function requestAndApplySkin(towerName, skinName)
    if not enabled then return end
    selectedSkins[towerName] = skinName

    local assets = game:GetService("ReplicatedStorage"):FindFirstChild("Assets")
    local skinModel = nil
    if assets then
        local troops = assets:FindFirstChild("Troops")
        if troops then
            local tower = troops:FindFirstChild(towerName)
            if tower then
                local skins = tower:FindFirstChild("Skins")
                if skins then skinModel = skins:FindFirstChild(skinName) end
            end
        end
    end

    if not skinModel then
        local requestRemote = game:GetService("ReplicatedStorage").Network.AssetStreaming["RE:requestAssets"]
        if requestRemote then
            requestRemote:FireServer({ "Troops/" .. towerName .. "/Skins/" .. skinName })
        else
            return
        end

        local streaming = player:WaitForChild("PlayerGui"):WaitForChild("Streaming")
        for i = 1, 60 do
            local path = streaming:FindFirstChild("Troops")
            if path then path = path:FindFirstChild(towerName) end
            if path then path = path:FindFirstChild("Skins") end
            if path then skinModel = path:FindFirstChild(skinName) end
            if skinModel then break end
            task.wait(0.15)
        end
        if not skinModel then
            warn("Skin not found: " .. skinName .. " for " .. towerName)
            return
        end
        if assets then
            local troops = assets:FindFirstChild("Troops") or Instance.new("Folder") troops.Name = "Troops" troops.Parent = assets
            local tower = troops:FindFirstChild(towerName) or Instance.new("Folder") tower.Name = towerName tower.Parent = troops
            local skins = tower:FindFirstChild("Skins") or Instance.new("Folder") skins.Name = "Skins" skins.Parent = tower
            local existing = skins:FindFirstChild(skinName)
            if existing then existing:Destroy() end
            local copy = skinModel:Clone()
            copy.Parent = skins
            copy.Name = skinName
            skinModel = copy
        end
    end

    if not skinModel then return end

    local skinFolder = workspace:FindFirstChild("SkinChanger")
    if not skinFolder then
        skinFolder = Instance.new("Folder")
        skinFolder.Name = "SkinChanger"
        skinFolder.Parent = workspace
    end

    local upgradeFolder = skinModel:FindFirstChild("Upgrades")
    local maxLevel = 0
    if upgradeFolder then
        for _, child in ipairs(upgradeFolder:GetChildren()) do
            local num = tonumber(child.Name)
            if num and num > maxLevel then maxLevel = num end
        end
    end

    local function muteOriginalSounds(tower)
        for _, sound in ipairs(tower:GetDescendants()) do
            if sound:IsA("Sound") then
                sound.Volume = 0
                sound.Playing = false
            end
        end
    end

    local function hideOriginalParts(tower)
        for _, part in ipairs(tower:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 0.999
                part.CanQuery = true
                part.CanCollide = false
            end
        end
    end

    local tracked = {}
    local towerContainer = workspace:FindFirstChild("Towers") or workspace

    local function applySkinToTower(tower)
        if not enabled then return false end
        if not tower:IsA("Model") then return false end
        if getTowerType(tower) ~= towerName then return false end

        local uid = tower:GetAttribute("TowerUID") or tostring(tower)

        local newSkin = skinModel:Clone()
        newSkin.Name = "Skin_" .. skinName
        newSkin:SetAttribute("Skin", skinName)
        newSkin:SetAttribute("Tower", towerName)
        newSkin:SetAttribute("TowerUID", uid)

        local rootPart = newSkin:FindFirstChild("HumanoidRootPart")
        if rootPart then newSkin.PrimaryPart = rootPart end

        local primary = tower.PrimaryPart
        if primary then
            pcall(function() newSkin:PivotTo(primary.CFrame) end)
        else
            pcall(function() newSkin:PivotTo(tower:GetPivot()) end)
        end

        for _, part in ipairs(newSkin:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanQuery = false
                part.CanCollide = false
                part.CanTouch = false
            end
        end

        for _, child in ipairs(skinFolder:GetChildren()) do
            if child:IsA("Model") and child:GetAttribute("Tower") == towerName and child:GetAttribute("TowerUID") == uid then
                local animator = child:FindFirstChild("AnimationController") and child.AnimationController:FindFirstChildOfClass("Animator")
                if animator then stopAllTracks(animator) end
                safeDestroy(child)
            end
        end
        if tracked[uid] then
            if tracked[uid].skin then
                local animator = tracked[uid].skin:FindFirstChild("AnimationController") and tracked[uid].skin.AnimationController:FindFirstChildOfClass("Animator")
                if animator then stopAllTracks(animator) end
                safeDestroy(tracked[uid].skin)
            end
            if tracked[uid].animConnection then tracked[uid].animConnection:Disconnect() end
            tracked[uid] = nil
        end

        newSkin.Parent = skinFolder

        hideOriginalParts(tower)

        local rep = tower:FindFirstChild("TowerReplicator")
        local level = 0
        if rep then level = rep:GetAttribute("Upgrade") or 0 end
        local rightHand = true
        local fireSound = getFireSoundFromSkin(newSkin, level, rightHand)
        if fireSound then
            muteOriginalSounds(tower)
        else
            for _, sound in ipairs(tower:GetDescendants()) do
                if sound:IsA("Sound") then
                    sound.Volume = 1
                    sound.Playing = true
                end
            end
        end

        local origHumanoid = tower:FindFirstChildOfClass("Humanoid")
        local skinHumanoid = newSkin:FindFirstChildOfClass("Humanoid")
        if origHumanoid and skinHumanoid then
            skinHumanoid.WalkSpeed = origHumanoid.WalkSpeed
            skinHumanoid.JumpPower = origHumanoid.JumpPower
            skinHumanoid.MaxHealth = origHumanoid.MaxHealth
            skinHumanoid.Health = origHumanoid.Health
            skinHumanoid.RigType = origHumanoid.RigType
        end

        applyUpgradeModule(newSkin, level)

        local upgrades = newSkin:FindFirstChild("Upgrades")
        if upgrades then
            for i = 0, maxLevel do
                local folder = upgrades:FindFirstChild(tostring(i))
                if folder then
                    local visible = (i <= level)
                    for _, part in ipairs(folder:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Transparency = visible and 0 or 1
                            part.CanCollide = false
                            part.CanQuery = false
                        end
                    end
                end
            end
        end

        linkBones(newSkin, tower)

        local idleTrack = playIdleOnSkin(newSkin, level)

        local towerAnimator = tower:FindFirstChild("AnimationController") and tower.AnimationController:FindFirstChildOfClass("Animator")
        local skinAnimator = newSkin:FindFirstChild("AnimationController") and newSkin.AnimationController:FindFirstChildOfClass("Animator")
        local animConnection
        local currentFireTrack = nil

        if towerAnimator and skinAnimator then
            animConnection = towerAnimator.AnimationPlayed:Connect(function(track)
                if not enabled then return end
                local anim = track.Animation
                if not anim then return end

                local fullPath = anim:GetFullName()
                if string.find(fullPath, "Idle/") or string.find(fullPath, "Idle.") then
                    return
                end

                local towerNamePath = tower:GetFullName() .. "."
                local relativePath = fullPath:sub(#towerNamePath + 1)

                local skinAnim = findAnimationInSkin(newSkin, anim.Name)
                if skinAnim then
                    if currentFireTrack then
                        currentFireTrack:Stop()
                        currentFireTrack:Destroy()
                        currentFireTrack = nil
                    end
                    local newTrack = skinAnimator:LoadAnimation(skinAnim)
                    newTrack:Play()
                    currentFireTrack = newTrack
                    newTrack.Stopped:Connect(function()
                        if currentFireTrack == newTrack then currentFireTrack = nil end
                    end)
                    if string.find(anim.Name, "Fire") then
                        local fireSound = getFireSoundFromSkin(newSkin, level, rightHand)
                        if fireSound and fireSound:IsA("Sound") then
                            local soundClone = fireSound:Clone()
                            local rootPart = newSkin:FindFirstChild("HumanoidRootPart")
                            if rootPart then soundClone.Parent = rootPart else soundClone.Parent = newSkin end
                            soundClone.RollOffMinDistance = 5
                            soundClone.MaxDistance = 200
                            soundClone:Play()
                            task.spawn(function()
                                task.wait(soundClone.TimeLength or 0.5)
                                soundClone:Destroy()
                            end)
                        end
                        if tracked[uid] then tracked[uid].rightHand = not rightHand end
                    end
                end
            end)
        end

        tracked[uid] = {
            tower = tower,
            skin = newSkin,
            animConnection = animConnection,
            rightHand = true,
            level = level,
            currentFireTrack = currentFireTrack,
            idleTrack = idleTrack,
        }
        return true
    end

    for _, child in ipairs(towerContainer:GetChildren()) do
        if child:IsA("Model") then applySkinToTower(child) end
    end

    towerContainer.ChildAdded:Connect(function(child)
        task.wait(0.02)
        if child:IsA("Model") and enabled then applySkinToTower(child) end
    end)

    activeInjectors[towerName] = {
        tracked = tracked,
        maxLevel = maxLevel,
    }

    local lastLevels = {}
    spawn(function()
        while enabled do
            task.wait(0.2)
            if not enabled then break end
            for _, child in ipairs(towerContainer:GetChildren()) do
                if child:IsA("Model") then
                    local rep = child:FindFirstChild("TowerReplicator")
                    if rep then
                        local currentLevel = rep:GetAttribute("Upgrade") or 0
                        local uid = child:GetAttribute("TowerUID") or tostring(child)
                        if lastLevels[uid] ~= currentLevel then
                            lastLevels[uid] = currentLevel
                            if enabled then applySkinToTower(child) end
                        end
                    end
                end
            end
        end
    end)

    local heartbeatConn = game:GetService("RunService").Heartbeat:Connect(function()
        if not enabled then return end
        local data = activeInjectors[towerName]
        if not data then return end
        local track = data.tracked
        for uid, info in pairs(track) do
            local tower = info.tower
            local skin = info.skin
            if not tower or not tower.Parent or not skin or not skin.Parent then
                if skin then
                    local animator = skin:FindFirstChild("AnimationController") and skin.AnimationController:FindFirstChildOfClass("Animator")
                    if animator then stopAllTracks(animator) end
                    safeDestroy(skin)
                end
                if info.animConnection then info.animConnection:Disconnect() end
                track[uid] = nil
            else
                local primary = tower.PrimaryPart
                if primary then
                    pcall(function() skin:PivotTo(primary.CFrame) end)
                else
                    pcall(function() skin:PivotTo(tower:GetPivot()) end)
                end
                hideOriginalParts(tower)
                local rep = tower:FindFirstChild("TowerReplicator")
                if rep then
                    local level = rep:GetAttribute("Upgrade") or 0
                    local fireSound = getFireSoundFromSkin(skin, level, info.rightHand or true)
                    if fireSound then
                        for _, sound in ipairs(tower:GetDescendants()) do
                            if sound:IsA("Sound") then
                                sound.Volume = 0
                                sound.Playing = false
                            end
                        end
                    else
                        for _, sound in ipairs(tower:GetDescendants()) do
                            if sound:IsA("Sound") then
                                sound.Volume = 1
                                sound.Playing = true
                            end
                        end
                    end
                    if level ~= info.level then
                        info.level = level
                        applySkinToTower(tower)
                    end
                end
            end
        end
    end)
    heartbeatConnections[towerName] = heartbeatConn
end

local towerButtons = {}
