local function clearSkins()
    for _, btn in ipairs(skinButtons) do btn:Destroy() end
    skinButtons = {}
end

local function showSkins(towerName)
    clearSkins()
    local skins = allTowers[towerName] or {}
    for _, skin in ipairs(skins) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -8, 0, 26)
        btn.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        btn.Text = skin.Name .. " (" .. tostring(skin.Rarity) .. ")"
        btn.TextColor3 = Color3.fromRGB(220, 220, 220)
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 12
        btn.Parent = rightScroll
        btn.MouseButton1Click:Connect(function()
            requestAndApplySkin(towerName, skin.Name)
        end)
        table.insert(skinButtons, btn)
    end
    rightScroll.CanvasSize = UDim2.new(0, 0, 0, #skinButtons * 30)
end

for _, name in ipairs(towerNames) do
    local btn = Instance.new("TextButton")
