local function getSkinsForTower(towerName)
    local statsModule = towerFolder:FindFirstChild(towerName):FindFirstChild("Stats")
    if not statsModule then return {} end
    local ok, data = pcall(require, statsModule)
    if not ok or not data then return {} end
    local skinData = data.Properties and data.Properties.SkinData
    if not skinData then skinData = data.SkinData end
    if not skinData then return {} end
    local skins = {}
    for name, info in pairs(skinData) do
        table.insert(skins, {Name = name, Rarity = info.Rarity})
    end
    table.sort(skins, function(a,b) return a.Name < b.Name end)
    return skins
end

local allTowers = {}
for _, child in ipairs(towerFolder:GetChildren()) do
    if child:IsA("Folder") then
        allTowers[child.Name] = getSkinsForTower(child.Name)
    end
end
