local selectedSkins = {}
local heartbeatConnections = {}

local function stopAllTracks(animator)
    if not animator then return end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        pcall(function()
            track:Stop()
            track:Destroy()
        end)
    end
end

local function safeDestroy(obj)
    if obj and obj.Parent then
        pcall(function() obj:Destroy() end)
    end
end

local function cleanupAll()
    local skinFolder = workspace:FindFirstChild("SkinChanger")
    if skinFolder then
        for _, child in ipairs(skinFolder:GetChildren()) do
            if child and child:IsA("Model") then
                local animator = child:FindFirstChild("AnimationController") and child.AnimationController:FindFirstChildOfClass("Animator")
                if animator then stopAllTracks(animator) end
                safeDestroy(child)
            end
        end
    end
    for towerName, data in pairs(activeInjectors) do
        if data.tracked then
            for uid, info in pairs(data.tracked) do
                if info.skin then
                    local animator = info.skin:FindFirstChild("AnimationController") and info.skin.AnimationController:FindFirstChildOfClass("Animator")
                    if animator then stopAllTracks(animator) end
                    safeDestroy(info.skin)
                end
                if info.animConnection then info.animConnection:Disconnect() end
            end
            data.tracked = {}
        end
    end
    activeInjectors = {}
    for _, conn in pairs(heartbeatConnections) do conn:Disconnect() end
    heartbeatConnections = {}
end

local function restoreOriginalParts()
    local towerContainer = workspace:FindFirstChild("Towers") or workspace
    for _, child in ipairs(towerContainer:GetChildren()) do
        if child:IsA("Model") then
            for _, part in ipairs(child:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = 0
                    part.CanQuery = true
                    part.CanCollide = true
                end
            end
        end
    end
end

local function toggleSkinChanger()
    enabled = not enabled
    if enabled then
        toggleBtn.Text = "Disable"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(80, 200, 80)
        for towerName, skinName in pairs(selectedSkins) do
            requestAndApplySkin(towerName, skinName)
        end
    else
        toggleBtn.Text = "Enable"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
        cleanupAll()
        restoreOriginalParts()
    end
end

