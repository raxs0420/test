                    local meets = false
                    if requiredPath == "top" then
                        meets = data.topCount >= pathLevel
                    elseif requiredPath == "bottom" then
                        meets = data.bottomCount >= pathLevel
                    elseif requiredPath == "any" then
                        meets = data.topCount >= pathLevel or data.bottomCount >= pathLevel
                    end
                    if meets then
