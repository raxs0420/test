equipBtn.MouseButton1Click:Connect(function()
    local currentlyEquipped = getEquippedTowers()
    local loadout = {}
    for towerName, _ in pairs(currentlyEquipped) do
        table.insert(loadout, towerName)
    end
    local added = 0
    for towerName, selected in pairs(selectedTowers) do
        if selected and not currentlyEquipped[towerName] then
            if #loadout < 6 then
                table.insert(loadout, towerName)
                added = added + 1
            else
                equipBtn.BackgroundColor3 = Color3.fromRGB(200,70,70)
                equipBtn.Text = "Max 6 towers reached!"
                task.delay(1.5, function()
                    equipBtn.BackgroundColor3 = Color3.fromRGB(70,150,70)
                    equipBtn.Text = "Equip Selected Towers"
                end)
                return
            end
        end
    end
    if added == 0 then
        equipBtn.BackgroundColor3 = Color3.fromRGB(200,70,70)
        equipBtn.Text = "All selected towers already equipped!"
        task.delay(1.5, function()
            equipBtn.BackgroundColor3 = Color3.fromRGB(70,150,70)
            equipBtn.Text = "Equip Selected Towers"
        end)
        return
    end
    local net = ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage:FindFirstChild("Remotes")
    if net then
        local eq = net:FindFirstChild("UpdateLoadout")
        if eq then
            eq:FireServer(loadout)
            settings.towerLoadout = loadout
            saveSettings()
            equipBtn.BackgroundColor3 = Color3.fromRGB(70,200,70)
            task.delay(1, function()
                equipBtn.BackgroundColor3 = Color3.fromRGB(70,150,70)
            end)
            task.wait(0.5)
            refreshEquippedDisplay()
            for towerName, btn in pairs(towerButtons) do
                if getEquippedTowers()[towerName] then
                    btn.BackgroundColor3 = Color3.fromRGB(70,150,70)
                elseif not selectedTowers[towerName] then
                    btn.BackgroundColor3 = Color3.fromRGB(60,60,60)
                end
            end
        end
    end
end)

