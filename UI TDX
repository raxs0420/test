local function parseCashValue(text)
    if not text then return nil end
    local clean = text:gsub("[$,]", "")
    local kMatch = clean:match("([%d%.]+)k")
    if kMatch then
        return tonumber(kMatch) * 1000
    end
    local num = clean:match("([%d%.]+)")
    return tonumber(num)
end

