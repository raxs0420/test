local function runClusterCooldownAbility(abilityName, towerName, requiredPath, pathLevel, slot, clusterRadius)
    return function()
        local clusterStates = {}
        while settings.activeAbilities[abilityName] do
            local eligible = {}
            for part, data in pairs(towers) do
                if data.owned and data.name == towerName and data.hash and part.Parent then
                    local meets = false
                    if requiredPath == "top" then
                        meets = data.topCount >= pathLevel
                    elseif requiredPath == "bottom" then
                        meets = data.bottomCount >= pathLevel
                    end
                    if meets then
                        table.insert(eligible, {part = part, pos = part.Position, hash = data.hash})
                    end
                end
            end
            if #eligible > 0 then
                local clusters = {}
                local visited = {}
                for i, tower in ipairs(eligible) do
                    if not visited[i] then
                        local cluster = {tower}
                        visited[i] = true
                        for j, other in ipairs(eligible) do
                            if not visited[j] and (tower.pos - other.pos).Magnitude <= clusterRadius then
                                table.insert(cluster, other)
                                visited[j] = true
                            end
                        end
                        table.insert(clusters, cluster)
                    end
                end
                for _, cluster in ipairs(clusters) do
                    local clusterKey = ""
                    for _, t in ipairs(cluster) do
                        clusterKey = clusterKey .. t.hash .. "_"
                    end
                    local state = clusterStates[clusterKey]
                    local now = tick()
                    if not state then
                        state = { lastUse = 0, nextIndex = 1 }
                        clusterStates[clusterKey] = state
                    end
                    if now - state.lastUse >= 8 then
                        local target = cluster[state.nextIndex]
                        if target then
                            task.spawn(function()
                                sendAbilityNoPosition(target.part, slot)
                                state.lastUse = now
                                state.nextIndex = (state.nextIndex % #cluster) + 1
                            end)
                        end
                    end
                end
            end
            task.wait(0.3)
        end
    end
end

local medicDroneIgnoreTowers = {
    ["Barracks"] = true, ["Behemoth Factory"] = true, ["Relic"] = true, ["War Machine"] = true,
    ["Z.E.D."] = true, ["Farm"] = true, ["Oil Derrick"] = true, ["Scout Helicopter"] = true,
    ["Jet Trooper"] = true, ["AA Turret"] = true, ["Combat Drone"] = true, ["Helicopter"] = true,
    ["Cryo Helicopter"] = true, ["Warship"] = true, ["Chicken House"] = true, ["Scarecrow"] = true,
    ["XWM Turret"] = true, ["Patrol Boat"] = true, ["Troll Tower"] = true,
}
local towerWeights = { ["Refractor"] = 5, ["Golden Mobster"] = 3, ["Golden Juggernaut"] = 3 }

local function getBestMedicDronePosition(towerPositions, radius)
    local bestPos = nil
    local bestWeightedSum = -1
    local candidatePoints = {}
    for _, pos in ipairs(towerPositions) do
        table.insert(candidatePoints, pos)
        for dx = -radius, radius, radius/2 do
            for dz = -radius, radius, radius/2 do
                local offset = Vector3.new(dx, 0, dz)
                if offset.Magnitude <= radius then table.insert(candidatePoints, pos + offset) end
            end
        end
    end
    for _, candidate in ipairs(candidatePoints) do
        local weightedSum = 0
        local includedTowers = {}
        for _, towerPos in ipairs(towerPositions) do
            if (candidate - towerPos).Magnitude <= radius then
                table.insert(includedTowers, towerPos)
                local towerName = nil
                for part, data in pairs(towers) do
                    if part and part.Position == towerPos then towerName = data.name break end
                end
                weightedSum = weightedSum + (towerWeights[towerName] or 1)
            end
        end
        if weightedSum > bestWeightedSum then
            bestWeightedSum = weightedSum
            if #includedTowers > 0 then
                local sum = Vector3.zero
                for _, pos in ipairs(includedTowers) do sum = sum + pos end
                bestPos = sum / #includedTowers
            else
                bestPos = candidate
            end
        end
    end
    return bestPos, bestWeightedSum
end

local function runMedicDroneSequential(slot)
    local recentDronePositions = {}
    local function isPositionAllowed(pos)
        local now = tick()
        for _, entry in ipairs(recentDronePositions) do
            if now - entry.time <= 10 and (pos - entry.position).Magnitude <= 12 then return false end
        end
        return true
    end
    while settings.activeAbilities["MEDIC_DRONE"] do
        local medicParts = {}
        for part, data in pairs(towers) do
            if data.owned and data.name == "Combat Medic" and part.Parent and data.hash and data.bottomCount >= 3 then
                local pauseUntil = towerPauseUntil[part]
                if not pauseUntil or tick() >= pauseUntil then
                    table.insert(medicParts, part)
                end
            end
        end
        if #medicParts > 0 then
            local eligiblePositions = {}
            for part, data in pairs(towers) do
                if data.owned and part.Parent and not medicDroneIgnoreTowers[data.name] then
                    table.insert(eligiblePositions, part.Position)
                end
            end
            if #eligiblePositions >= 2 then
                for _, part in ipairs(medicParts) do
                    if not settings.activeAbilities["MEDIC_DRONE"] then break end
                    local bestPos, bestWeight = getBestMedicDronePosition(eligiblePositions, 12)
                    if bestPos and isPositionAllowed(bestPos) then
                        task.spawn(function()
                            if sendAbilityWithPosition(part, slot, bestPos) == true then
                                table.insert(recentDronePositions, {position = bestPos, time = tick()})
                                local startTime = tick()
                                while tick() - startTime < 20 and settings.activeAbilities["MEDIC_DRONE"] do
                                    local freshPositions = {}
                                    for p, d in pairs(towers) do
                                        if d.owned and p.Parent and not medicDroneIgnoreTowers[d.name] then
                                            table.insert(freshPositions, p.Position)
                                        end
                                    end
                                    if #freshPositions >= 2 then
                                        local secondBestPos, secondBestWeight = getBestMedicDronePosition(freshPositions, 12)
                                        if secondBestPos and isPositionAllowed(secondBestPos) and (secondBestPos - bestPos).Magnitude > 5 then
                                            if sendAbilityWithPosition(part, slot, secondBestPos) == true then
                                                table.insert(recentDronePositions, {position = secondBestPos, time = tick()})
                                                break
                                            end
                                        end
                                    end
                                    task.wait(0.5)
                                end
                                towerPauseUntil[part] = tick() + 10
                            end
                        end)
                    end
                end
            end
        end
        task.wait(0.1)
    end
end

local function runCallToArmsSequential()
    local clusterStates = {}
    while settings.activeAbilities["CALL_TO_ARMS"] do
        local commanders = {}
        for part, data in pairs(towers) do
            if data.owned and data.name == "Commander" and data.hash and data.topCount >= 3 and part.Parent then
                table.insert(commanders, {part = part, pos = part.Position, hash = data.hash})
            end
        end
        if #commanders > 0 then
            local clusters = {}
            local visited = {}
            for i, cmd in ipairs(commanders) do
                if not visited[i] then
                    local cluster = {cmd}
                    visited[i] = true
                    for j, other in ipairs(commanders) do
                        if not visited[j] and (cmd.pos - other.pos).Magnitude <= 5 then
                            table.insert(cluster, other)
                            visited[j] = true
                        end
                    end
                    table.insert(clusters, cluster)
                end
            end
            for _, cluster in ipairs(clusters) do
                local size = #cluster
                if size >= 2 then
                    local clusterKey = ""
                    for _, cmd in ipairs(cluster) do
                        clusterKey = clusterKey .. cmd.hash .. "_"
                    end
                    local state = clusterStates[clusterKey]
                    local now = tick()
                    local interval = (size == 2) and 21 or 13
                    if not state then
                        state = { lastUse = 0, nextIndex = 1 }
                        clusterStates[clusterKey] = state
                    end
                    if now - state.lastUse >= interval then
                        local targetCmd = cluster[state.nextIndex]
                        task.spawn(function()
                            sendAbilityNoPosition(targetCmd.part, 1)
                            state.lastUse = now
                            state.nextIndex = (state.nextIndex % size) + 1
                        end)
                    end
                end
            end
        end
        task.wait(0.3)
    end
end

