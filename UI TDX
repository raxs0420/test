            for part, data in pairs(towers) do
                if data.owned and data.name == towerName and data.hash and part.Parent then
                    local meets = false
                    if requiredPath == "top" then meets = data.topCount >= pathLevel
                    elseif requiredPath == "bottom" then meets = data.bottomCount >= pathLevel
                    elseif requiredPath == "any" then meets = data.topCount >= pathLevel or data.bottomCount >= pathLevel end
                    if meets then
                        task.spawn(function() sendAbilityNoPosition(part, slot) end)
                    end
                end
            end
            task.wait(0.05)
        end
    end
end

local bountyTimeout = 0.5

local function runBountyTargeted(abilityName, slot, requiredBottomLevel, towerName)
    return function()
        while settings.activeAbilities[abilityName] do
            local validParts = {}
            for part, data in pairs(towers) do
                if data.owned and data.name == towerName and part.Parent and data.hash and data.bottomCount >= requiredBottomLevel then
                    local pauseUntil = towerPauseUntil[part]
                    if not pauseUntil or tick() >= pauseUntil then table.insert(validParts, part) end
                end
            end
            if #validParts == 0 then task.wait(0.1) continue end
            for _, part in ipairs(validParts) do
                if not settings.activeAbilities[abilityName] then break end
                local enemies = getAllEnemies()
                if #enemies == 0 then task.wait(0.01) continue end
                local target = getClosestEnemy(part.Position, enemies, globalHitBlacklist)
                if not target then task.wait(0.01) continue end
                local hash = towers[part].hash
                if not hash then continue end
                abilityUsedQueue[hash] = nil
                task.spawn(function() sendAbilityWithPosition(part, slot, target.Position) end)
                local start = tick()
                local confirmed = false
                while tick() - start < bountyTimeout do
                    if abilityUsedQueue[hash] then
                        confirmed = true
                        abilityUsedQueue[hash] = nil
                        break
                    end
                    task.wait(0.01)
                end
                if confirmed then
                    globalHitBlacklist[target] = true
                    towerPauseUntil[part] = tick() + 6
                end
                task.wait(0.2)
            end
            task.wait(0.1)
        end
    end
end

local function runEnemyInRangeAbility(abilityName, towerName, requiredPath, pathLevel, slot, range, enemyThreshold)
    enemyThreshold = enemyThreshold or 1
    return function()
        while settings.activeAbilities[abilityName] do
            local enemies = (range > 0) and getAllEnemies() or {}
            for part, data in pairs(towers) do
                if data.owned and data.name == towerName and data.hash and part.Parent then
                    local meets = false
                    if requiredPath == "top" then meets = data.topCount >= pathLevel
                    elseif requiredPath == "bottom" then meets = data.bottomCount >= pathLevel
                    elseif requiredPath == "any" then meets = data.topCount >= pathLevel or data.bottomCount >= pathLevel end
                    if meets then
                        local shouldUse = true
                        if range > 0 then
                            local nearby = 0
                            for _, enemy in ipairs(enemies) do
                                if (part.Position - enemy.Position).Magnitude <= range then
                                    nearby = nearby + 1
                                    if nearby >= enemyThreshold then break end
                                end
                            end
                            shouldUse = nearby >= enemyThreshold
                        end
                        if shouldUse then
                            task.spawn(function() sendAbilityNoPosition(part, slot) end)
                        end
                    end
                end
            end
            task.wait(0.05)
        end
    end
end

local function runSequentialClusterAbility(abilityName, towerName, requiredPath, pathLevel, slot, syncRange, cooldown, intervalFn)
    return function()
        local clusterStates = {}
        while settings.activeAbilities[abilityName] do
            local eligible = {}
            for part, data in pairs(towers) do
                if data.owned and data.name == towerName and data.hash and part.Parent then
                    local meets = false
                    if requiredPath == "top" then meets = data.topCount >= pathLevel
                    elseif requiredPath == "bottom" then meets = data.bottomCount >= pathLevel
                    elseif requiredPath == "any" then meets = data.topCount >= pathLevel or data.bottomCount >= pathLevel end
                    if meets then
                        table.insert(eligible, {part = part, pos = part.Position, hash = data.hash})
                    end
                end
            end
            if #eligible > 0 then
                local clusters = {}
                local visited = {}
                for i, tower in ipairs(eligible) do
                    if not visited[i] then
                        local cluster = {tower}
                        visited[i] = true
                        for j, other in ipairs(eligible) do
                            if not visited[j] and (tower.pos - other.pos).Magnitude <= syncRange then
                                table.insert(cluster, other)
                                visited[j] = true
                            end
                        end
                        table.insert(clusters, cluster)
                    end
                end
                for _, cluster in ipairs(clusters) do
                    local size = #cluster
                    if size >= 1 then
                        table.sort(cluster, function(a, b) return a.hash < b.hash end)
                        local clusterKey = ""
                        for _, t in ipairs(cluster) do clusterKey = clusterKey .. t.hash .. "_" end
                        local now = tick()
                        local interval = cooldown
                        if intervalFn then interval = intervalFn(size) end
                        local state = clusterStates[clusterKey]
                        if not state then
                            state = { lastUse = 0, nextIndex = 1 }
                            clusterStates[clusterKey] = state
                        end
                        if now - state.lastUse >= interval then
                            local target = cluster[state.nextIndex]
                            if target then
                                local hash = target.hash
                                abilityUsedQueue[hash] = nil
                                local results = {pcall(function()
                                    local req = getTowerUseAbilityRequest()
                                    if not req then return false end
                                    return req:InvokeServer(hash, slot)
                                end)}
                                local used = results[1] and results[2] == true
                                if not used then
                                    local start = tick()
                                    while tick() - start < 10 and settings.activeAbilities[abilityName] do
                                        if abilityUsedQueue[hash] then used = true break end
                                        task.wait(0.05)
                                    end
                                end
                                abilityUsedQueue[hash] = nil
                                state.lastUse = tick()
                                state.nextIndex = (state.nextIndex % size) + 1
                            end
                        end
                    end
                end
            end
            task.wait(0.3)
        end
    end
end

