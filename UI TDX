local function getPvPEnemiesFromGame()
    local enemies = {}
    local player = game:GetService("Players").LocalPlayer
    for i = 1, 12 do
        local name = player:GetAttribute("PVPEnemySlot" .. tostring(i))
        if name and name ~= "" then
            table.insert(enemies, name)
        end
    end
    if #enemies == 0 then
        return {"Normal Droid", "Heavy Droid", "Fallout"}
    end
    return enemies
end

