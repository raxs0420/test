local function getCurrentWave()
    local player = game:GetService("Players").LocalPlayer
    local waveText = player:FindFirstChild("PlayerGui")
        and player.PlayerGui:FindFirstChild("Interface")
        and player.PlayerGui.Interface:FindFirstChild("GameInfoBar")
        and player.PlayerGui.Interface.GameInfoBar:FindFirstChild("PVP")
