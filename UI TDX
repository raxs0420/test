local antiLagEnabled = true
local function trackCreation(instance)
    if not instance:GetAttribute("_created") then
        instance:SetAttribute("_created", tick())
    end
end

local function removeFolders()
    local tdxShared = ReplicatedStorage:FindFirstChild("TDX_Shared")
    if tdxShared then
        local common = tdxShared:FindFirstChild("Common")
        if common then
            local resources = common:FindFirstChild("Resources")
            if resources then
                local deathEffects = resources:FindFirstChild("DeathEffects")
                if deathEffects then
                    deathEffects:Destroy()
                end
            end
        end
    end

    local gameProjectiles = workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Projectiles")
    if gameProjectiles then
        gameProjectiles:Destroy()
    end

    if antiLagEnabled then
        local gameFolder = workspace:FindFirstChild("Game")
        if gameFolder then
            local enemies = gameFolder:FindFirstChild("Enemies")
            if enemies then
                local enemyParts = enemies:GetChildren()
                for _, part in ipairs(enemyParts) do
                    trackCreation(part)
                end
                
                if #enemyParts > 100 then
                    local excess = #enemyParts - 100
                    table.sort(enemyParts, function(a, b)
                        return (a:GetAttribute("_created") or 0) < (b:GetAttribute("_created") or 0)
                    end)
                    for i = 1, excess do
                        enemyParts[i]:Destroy()
                    end
                end
            end
        end
    end
end

antiLagBtn.MouseButton1Click:Connect(function()
    antiLagEnabled = not antiLagEnabled
    if antiLagEnabled then
        antiLagBtn.BackgroundColor3 = Color3.fromRGB(70,150,70)
        antiLagBtn.Text = "Anti Lag: ON"
    else
        antiLagBtn.BackgroundColor3 = Color3.fromRGB(70,70,70)
        antiLagBtn.Text = "Anti Lag: OFF"
    end
end)

task.delay(5, function()
    local lastCheck = 0
    RunService.Heartbeat:Connect(function(deltaTime)
        lastCheck = lastCheck + deltaTime
        if lastCheck >= 0.1 then
            lastCheck = 0
            removeFolders()
        end
    end)
end)

local function startCoinCollector()
    task.spawn(function()
        local remote = nil
        local function getRemote()
            if not remote or not remote.Parent then
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes then
                    remote = remotes:FindFirstChild("ClientsideCoinCollectedEvent")
                end
            end
            return remote
        end
        while true do
            local currentRemote = getRemote()
            if currentRemote then
                for i = 1, 250 do
                    pcall(function() currentRemote:FireServer(i) end)
                end
            end
            task.wait(2.5)
        end
    end)
end

