local function runPvPLoop()
    while PvP.active and PvP.selectedEnemy do
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes"):FindFirstChild("RequestSendPVPEnemy")
        if remote then
            pcall(function() remote:InvokeServer(PvP.selectedEnemy) end)
            PvP.lastSentName = PvP.selectedEnemy
            PvP.sentAt = tick()
        end
        task.wait(math.random() * 0.2 + 0.1)
    end
    PvP.active = false
    PvP.selectedEnemy = nil
end

local function getEquippedEnemies()
    local equipped = {}
    local player = game:GetService("Players").LocalPlayer
    for i = 1, 12 do
        local name = player:GetAttribute("PVPEnemySlot" .. tostring(i))
        if name and name ~= "" then equipped[name] = true end
    end
    return equipped
end

local function getCurrentWave()
    local player = game:GetService("Players").LocalPlayer
    local waveText = player:FindFirstChild("PlayerGui")
        and player.PlayerGui:FindFirstChild("Interface")
        and player.PlayerGui.Interface:FindFirstChild("GameInfoBar")
        and player.PlayerGui.Interface.GameInfoBar:FindFirstChild("PVP")
        and player.PlayerGui.Interface.GameInfoBar.PVP:FindFirstChild("Default")
        and player.PlayerGui.Interface.GameInfoBar.PVP.Default:FindFirstChild("Wave")
        and player.PlayerGui.Interface.GameInfoBar.PVP.Default.Wave:FindFirstChild("WaveText")
    if waveText and waveText:IsA("TextLabel") then
        local text = waveText.Text or ""
        return tonumber(text:match("%d+"))
    end
    return nil
end

