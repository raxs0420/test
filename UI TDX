local function getAllEnemies()
    local enemiesFolder = workspace.Game:FindFirstChild("Enemies")
    if not enemiesFolder then return {} end
    local enemies = {}
    for _, child in ipairs(enemiesFolder:GetChildren()) do
        if child:IsA("BasePart") and child.Name ~= "Arrow" then
            table.insert(enemies, child)
        end
    end
    return enemies
end

local function getClosestEnemy(position, enemies, blacklist)
    local best, bestDist = nil, math.huge
    for _, enemy in ipairs(enemies) do
        if not blacklist[enemy] then
            local dist = (position - enemy.Position).Magnitude
            if dist < bestDist then
                bestDist = dist
                best = enemy
            end
        end
    end
    return best
end

local globalHitBlacklist = {}
local towerPauseUntil = {}

local function updateGMIdDisplay()
    local ids = {}
    for id, data in pairs(towers) do
        if data.name == "Golden Mobster" then
            table.insert(ids, tostring(id))
        end
    end
    if #ids == 0 then
        gmIdLabel.Text = "Golden Mobsters: none placed"
    else
        gmIdLabel.Text = "Golden Mobsters: " .. table.concat(ids, ", ")
    end
end

local function sendOverloadAbility(id, slot, position)
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        local req = remote:FindFirstChild("TowerUseAbilityRequest")
        if req then
            local success, response = pcall(function()
                return req:InvokeServer(id, slot, position)
            end)
            if success then
                return response
            else
                warn("Invoke error:", response)
                return nil
            end
        end
    end
    return nil
end

local overloadLoop = nil
local function runOverloadSequential(slot)
    while activeAbilities["OVERLOAD"] do
        local gmIds = {}
        for id, data in pairs(towers) do
            if data.name == "Golden Mobster" and data.part and data.part.Parent then
                local pauseUntil = towerPauseUntil[id]
                if not pauseUntil or tick() >= pauseUntil then
                    table.insert(gmIds, id)
                end
            end
        end

        if #gmIds == 0 then
            task.wait(0.5)
            continue
        end

        local enemies = getAllEnemies()
        if #enemies == 0 then
            task.wait(0.5)
            continue
        end

        for _, id in ipairs(gmIds) do
            if not activeAbilities["OVERLOAD"] then break end

            local towerData = towers[id]
            if not towerData or not towerData.part then continue end

            local target = getClosestEnemy(towerData.part.Position, enemies, globalHitBlacklist)
            if not target then
                task.wait(0.1)
                continue
            end

            local response = sendOverloadAbility(id, slot, target.Position)

            if response == true then
                globalHitBlacklist[target] = true
                towerPauseUntil[id] = tick() + 2
                print(string.format("[G Mobster] Tower %d hit %s - pausing 2s", id, target.Name))
            elseif response == false then
                print(string.format("[G Mobster] Tower %d too far from %s", id, target.Name))
            elseif response == nil then
                print(string.format("[G Mobster] Tower %d cooldown or invalid", id))
                task.wait(0.3)
            end

            task.wait(0.1)
        end

        task.wait(0.5)
    end
end

local abilityLoops = {}

local function startAbilityLoop(abilityName)
    if abilityName == "OVERLOAD" then
        if overloadLoop then
            task.cancel(overloadLoop)
            overloadLoop = nil
        end
        if not activeAbilities["OVERLOAD"] then return false end
        overloadLoop = task.spawn(runOverloadSequential, abilityTargets["OVERLOAD"].slot)
        return true
    else
        if abilityLoops[abilityName] then
            task.cancel(abilityLoops[abilityName])
            abilityLoops[abilityName] = nil
            return false
        end
        local data = abilityTargets[abilityName]
        if not data then return false end
        abilityLoops[abilityName] = task.spawn(function()
            while activeAbilities[abilityName] do
                local targetIds = {}
                for id, towerData in pairs(towers) do
                    if towerData and towerData.name then
                        for _, towerName in ipairs(data.towers) do
                            if towerData.name == towerName then
                                targetIds[#targetIds + 1] = id
                                break
                            end
                        end
                    end
                end
                if #targetIds > 0 then
                    for _, id in ipairs(targetIds) do
                        if not activeAbilities[abilityName] then break end
                        local remote = ReplicatedStorage:FindFirstChild("Remotes")
                        if remote then
                            local req = remote:FindFirstChild("TowerUseAbilityRequest")
                            if req then
                                pcall(function() req:InvokeServer(id, data.slot) end)
                            end
                        end
                        task.wait(0.15)
                    end
                end
                task.wait(0.5)
            end
        end)
        return true
    end
end

