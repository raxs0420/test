            nameLabel.Position = UDim2.new(0, 20, 0, 6)
            nameLabel.Text = "     " .. name .. " (" .. #group .. ")"
            nameLabel.TextColor3 = Color3.fromRGB(200, 200, 205)
            nameLabel.TextSize = 11
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.BackgroundTransparency = 1
            nameLabel.Parent = block

            local innerLayout = Instance.new("UIListLayout", block)
            innerLayout.Padding = UDim.new(0, 3)
            innerLayout.SortOrder = Enum.SortOrder.LayoutOrder
            innerLayout.FillDirection = Enum.FillDirection.Vertical
            innerLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
            innerLayout.Parent = block

            for i, entry in ipairs(group) do
