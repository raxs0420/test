        pvp_1v1 = 1000, tbpart2voidmare = 1000, tbpart2hard = 1000,
        tbpart2casual = 1000, tbpart2nightmare = 1000,
    },
    data = { byMode = {}, blacklist = {}, priority = {}, normal = {}, loaded = false, loading = false },
    mode = nil,
}

function EnemyDB.parse()
    if EnemyDB.data.loading then return false end
    EnemyDB.data.loading = true
    local ok, response = pcall(game.HttpGet, game, EnemyDB.URL)
    if not ok or not response then
        EnemyDB.data.loading = false
        return false
    end
    local byMode = {}
    local curKey = nil
    for line in response:gmatch("[^\r\n]+") do
        local internal = line:match("%(Internal:%s*(.-)%)")
        if internal then
            curKey = string.lower(string.gsub(internal, " ", ""))
            if not byMode[curKey] then byMode[curKey] = {} end
        else
            local body = line:match("^%s*%-%s*(.+)")
            if body and curKey then
                local name, hp, speed, airUnit, isBoss = body:match(
                    "^([^|]+)%s*|%s*HP:%s*(%d+)%s*|%s*Speed:%s*([%d%.]+)%s*|%s*AirUnit:%s*(%w+)%s*|%s*IsBoss:%s*(%w+)"
                )
                if name then
                    name = string.gsub(name, "^%s+", "")
                    name = string.gsub(name, "%s+$", "")
                    byMode[curKey][name] = {
                        hp = tonumber(hp) or 0,
                        speed = tonumber(speed) or 0,
                        airUnit = (airUnit == "true"),
                        isBoss = (isBoss == "true"),
                    }
                end
            end
        end
    end
    EnemyDB.data.byMode = byMode
    EnemyDB.data.loaded = true
    EnemyDB.data.loading = false
    return true
end

function EnemyDB.info(name)
    if not EnemyDB.data.loaded then return nil end
    local m = EnemyDB.mode
    if m and EnemyDB.data.byMode[m] and EnemyDB.data.byMode[m][name] then
        return EnemyDB.data.byMode[m][name]
    end
    for _, md in pairs(EnemyDB.data.byMode) do
        if md[name] then return md[name] end
    end
    return nil
end

function EnemyDB.refresh()
    local src
    local m = EnemyDB.mode
    if m and EnemyDB.data.byMode[m] then
        src = EnemyDB.data.byMode[m]
    else
        src = {}
        for _, md in pairs(EnemyDB.data.byMode) do
            for n, info in pairs(md) do src[n] = info end
        end
    end
    local bl, pr, nm = {}, {}, {}
    for n, info in pairs(src) do
        if info.airUnit or info.speed <= 0 then
            bl[n] = true
        elseif info.isBoss then
            pr[n] = true
        else
            nm[n] = { hp = info.hp, speed = info.speed }
        end
    end
    EnemyDB.data.blacklist = bl
    EnemyDB.data.priority = pr
    EnemyDB.data.normal = nm
end

function EnemyDB.threshold()
    local m = EnemyDB.mode
    if not m then return 1000 end
    return EnemyDB.THRESHOLDS[m] or 1000
end

function EnemyDB.worth(enemy)
    if not enemy or not enemy.Parent then return false end
    local info = EnemyDB.info(enemy.Name)
    if not info then return true end
    if info.airUnit then return false end
    if info.speed <= 0 then return false end
    return info.hp >= EnemyDB.threshold()
end

