local function startAbilityLoop(abilityName)
    if abilityName == "BOUNTY" then
        if bountyLoop then task.cancel(bountyLoop) bountyLoop = nil end
        if not activeAbilities["BOUNTY"] then return false end
        bountyLoop = task.spawn(runBountySequential, abilityTargets["BOUNTY"].slot)
        return true
    elseif abilityName == "MEDIC_DRONE" then
        if medicDroneLoop then task.cancel(medicDroneLoop) medicDroneLoop = nil end
        if not activeAbilities["MEDIC_DRONE"] then return false end
        medicDroneLoop = task.spawn(runMedicDroneSequential, abilityTargets["MEDIC_DRONE"].slot)
        return true
    else
        if abilityLoops[abilityName] then
            task.cancel(abilityLoops[abilityName])
            abilityLoops[abilityName] = nil
            return false
        end
        local data = abilityTargets[abilityName]
        if not data then return false end
        abilityLoops[abilityName] = task.spawn(function()
            while activeAbilities[abilityName] do
                local targetParts = {}
                for part, towerData in pairs(towers) do
                    if towerData.owned and towerData.hash then
                        for _, towerName in ipairs(data.towers) do
                            if towerData.name == towerName then
                                local req = abilityLevelReqs[abilityName]
                                local qualifies = true
                                if req then
                                    local topOk = (not req.top) or (towerData.topCount >= req.top)
                                    local bottomOk = (not req.bottom) or (towerData.bottomCount >= req.bottom)
                                    qualifies = topOk or bottomOk
                                end
                                if qualifies then
                                    table.insert(targetParts, part)
                                end
                                break 
                            end
                        end
                    end
                end
                if #targetParts > 0 then
                    for _, part in ipairs(targetParts) do
                        if not activeAbilities[abilityName] then break end
                        local remote = ReplicatedStorage:FindFirstChild("Remotes")
                        if remote then
                            local req = remote:FindFirstChild("TowerUseAbilityRequest")
                            if req then
                                if data.slots then
                                    for _, slot in ipairs(data.slots) do
                                        if not activeAbilities[abilityName] then break end
                                        pcall(function() req:InvokeServer(towers[part].hash, slot) end)
                                    end
                                else
                                    pcall(function() req:InvokeServer(towers[part].hash, data.slot) end)
                                end
                            end
                        end
                        task.wait(0.02)
                    end
                end
                task.wait(0.5)
            end
        end)
        return true
    end
end

