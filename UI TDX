local SettingsFile = "TDXAuto_Settings.json"
local defaultSettings = { autoTargetMode = nil, autoSkip = false, emoteSpam = false, antiLagEnabled = true, activeAbilities = {}, towerLoadout = {} }
local settings = {}

local function loadSettings()
    local success, data = pcall(readfile, SettingsFile)
    if success and data then
        local decoded = game:GetService("HttpService"):JSONDecode(data)
        for k, v in pairs(defaultSettings) do if decoded[k] == nil then decoded[k] = v end end
        settings = decoded
        settings.activeAbilities = settings.activeAbilities or {}
        settings.towerLoadout = settings.towerLoadout or {}
    else
        settings = { autoTargetMode = nil, autoSkip = false, emoteSpam = false, antiLagEnabled = true, activeAbilities = {}, towerLoadout = {} }
    end
end

local function saveSettings()
    local encoded = game:GetService("HttpService"):JSONEncode(settings)
    pcall(writefile, SettingsFile, encoded)
end

