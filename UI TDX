local function startTowerTracking()
    local gameFolder = workspace:FindFirstChild("Game")
    if gameFolder then
        local towersFolder = gameFolder:FindFirstChild("Towers")
        if towersFolder then
            towersFolder.ChildAdded:Connect(function(part) if part:IsA("BasePart") then addTower(part) watchTower(part) end end)
            towersFolder.ChildRemoved:Connect(function(part) if part:IsA("BasePart") then removeTower(part) end end)
        else
            task.wait(2)
            startTowerTracking()
            return
        end
    else
        task.wait(2)
        startTowerTracking()
        return
    end
    scanForTowers()
