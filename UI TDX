local function setupGameInfo()
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("TowerToEquippedCountMapChanged")
    if not remote then
        addDebugLog("Game Info: remote not found")
        return
    end

    local configs = ReplicatedStorage:FindFirstChild("TDX_Shared")
        and ReplicatedStorage.TDX_Shared:FindFirstChild("Common")
        and ReplicatedStorage.TDX_Shared.Common:FindFirstChild("Resources")
        and ReplicatedStorage.TDX_Shared.Common.Resources:FindFirstChild("Towers")
        and ReplicatedStorage.TDX_Shared.Common.Resources.Towers:FindFirstChild("Configs")
    if not configs then
        addDebugLog("Game Info: configs folder not found")
        return
    end

    local function updateGameInfoUI(towerCounts)
        for _, child in ipairs(gameInfoScroll:GetChildren()) do
            if child:IsA("TextLabel") then child:Destroy() end
        end

        local names = {}
        for name in pairs(towerCounts) do
            table.insert(names, name)
        end
        table.sort(names)

        local labelCount = 0
        for _, towerName in ipairs(names) do
            local count = towerCounts[towerName]
            local limitStr = ""
            local module = configs:FindFirstChild(towerName)
            if module then
                local success, config = pcall(require, module)
                if success and type(config) == "table" then
                    local limitMap = config.LimitMap
                    if limitMap and #limitMap > 0 then
                        local index = math.min(count, #limitMap)
                        local limit = limitMap[index]
                        if limit then
                            limitStr = " (personal limit " .. tostring(limit) .. ")"
                        end
                    end
                end
            end
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -14, 0, 20)
            label.Text = towerName .. " = " .. tostring(count) .. limitStr
            label.TextColor3 = Color3.fromRGB(180, 180, 185)
            label.TextSize = 11
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.Gotham
            label.Parent = gameInfoScroll
            labelCount = labelCount + 1
        end

        if labelCount == 0 then
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -14, 0, 22)
            label.Text = "No tower data received yet"
            label.TextColor3 = Color3.fromRGB(140, 140, 145)
            label.TextSize = 11
            label.TextXAlignment = Enum.TextXAlignment.Center
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.Gotham
            label.Parent = gameInfoScroll
        end

        gameInfoScroll.CanvasSize = UDim2.new(0, 0, 0, gameInfoLayout.AbsoluteContentSize.Y + 10)
    end

    remote.OnClientEvent:Connect(function(towerCounts)
        updateGameInfoUI(towerCounts)
    end)

    addDebugLog("Game Info: listener ready")
end

task.spawn(setupGameInfo)