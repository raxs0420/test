local function sendUpgrade(id, path, level)
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        local req = remote:FindFirstChild("TowerUpgradeRequest")
        if req then
            pcall(function() req:FireServer(id, path, level) end)
        end
    end
end

local function upgradeTower(id)
    local data = towers[id]
    if not data or not data.placedAfterAuto then return end
    local mode = autoTargetMode
    if not mode then return end

    if mode == "top" then
        if data.topCount < 5 then
            sendUpgrade(id, 1, 5)
            data.topCount = 5
            task.wait(0.01)
        end
        if data.bottomCount < 2 then
            sendUpgrade(id, 2, 2)
            data.bottomCount = 2
            task.wait(0.01)
        end
    else
        if data.bottomCount < 5 then
            sendUpgrade(id, 2, 5)
            data.bottomCount = 5
            task.wait(0.01)
        end
        if data.topCount < 2 then
            sendUpgrade(id, 1, 2)
            data.topCount = 2
            task.wait(0.01)
        end
    end
end

local function allocateId()
    if #freeIds > 0 then
        return table.remove(freeIds)
    else
        local id = nextId
        nextId = nextId + 1
        return id
    end
end

local function freeId(id)
    if id and id > 0 then
        if not towers[id] then return end
        table.insert(freeIds, id)
        towers[id] = nil
    end
end

local function removeTower(part, reason)
    local id = partToId[part]
    if not id then return end
    local data = towers[id]
    if data and data.removed then return end
    if data then data.removed = true end
    freeId(id)
    partToId[part] = nil
end

local function getTowerBeamColor(towerPart)
    local ring = towerPart:FindFirstChild("Ring")
    if not ring then return nil end
    local beam = ring:FindFirstChildWhichIsA("Beam")
    if not beam then return nil end
    local seq = beam.Color
    if seq and seq.Keypoints and #seq.Keypoints > 0 then
        return seq.Keypoints[1].Value
    end
    return nil
end

local function isDeadColor(color)
    return color.R < 0.1 and color.G < 0.1 and color.B < 0.1
end

local function addTower(part, source)
    if partToId[part] then return end
    local beamColor = getTowerBeamColor(part)
    if beamColor and isDeadColor(beamColor) then return end
    local id = allocateId()
    partToId[part] = id
    towers[id] = {
        part = part,
        topCount = 0,
        bottomCount = 0,
        name = part.Name,
        placedAfterAuto = autoActive,
        removed = false
    }
    updateGMIdDisplay()
end

local function checkDeadTowers()
    for part, id in pairs(partToId) do
        local data = towers[id]
        if data and data.removed then
            removeTower(part, "ALREADY REMOVED")
        elseif part and part.Parent then
            local color = getTowerBeamColor(part)
            if color and isDeadColor(color) then
                if data then data.removed = true end
                removeTower(part, "BEAM DEATH")
            end
        else
            if data then data.removed = true end
            removeTower(part, "MISSING PART")
        end
    end
end

local function startDeathLoop()
    if deathLoop then task.cancel(deathLoop) end
    deathLoop = task.spawn(function()
        while true do
            checkDeadTowers()
            task.wait(0.05)
        end
    end)
end
startDeathLoop()

local function onTowerAdded(part)
    if not part:IsA("BasePart") then return end
    if partToId[part] then return end
    task.wait(0.05)
    if not part.Parent then return end
    addTower(part, "PLACED")
end

local function onTowerRemoved(part)
    local id = partToId[part]
    if not id then return end
    local data = towers[id]
    if data and data.removed then return end
    removeTower(part, "CHILD REMOVED")
    updateGMIdDisplay()
end

if TowersFolder then
    TowersFolder.ChildAdded:Connect(onTowerAdded)
    TowersFolder.ChildRemoved:Connect(onTowerRemoved)
end

local scanLoop = RunService.Heartbeat:Connect(function()
    if not TowersFolder then return end
    for _, part in ipairs(TowersFolder:GetChildren()) do
        if part:IsA("BasePart") and not partToId[part] then
            addTower(part, "SCAN")
        end
    end
end)

local function startAutoUpgrade()
    if upgradeLoop then task.cancel(upgradeLoop) end
    upgradeLoop = task.spawn(function()
        while autoActive do
            for id, data in pairs(towers) do
                if data.placedAfterAuto then
                    upgradeTower(id)
                end
                task.wait(0.01)
            end
            task.wait(0.05)
        end
        upgradeLoop = nil
    end)
end

local function setAutoMode(mode, btn)
    if autoActive and autoTargetMode == mode then
        autoActive = false
        autoTargetMode = nil
        btn.BackgroundColor3 = Color3.fromRGB(70,70,70)
    else
        if autoActive then
            if autoTargetMode == "top" then
                topBtn.BackgroundColor3 = Color3.fromRGB(70,70,70)
            else
                bottomBtn.BackgroundColor3 = Color3.fromRGB(70,70,70)
            end
        end
        autoActive = true
        autoTargetMode = mode
        btn.BackgroundColor3 = Color3.fromRGB(70,150,70)
        for id, data in pairs(towers) do
            data.placedAfterAuto = false
        end
        startAutoUpgrade()
    end
end

