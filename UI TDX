        if remote then
            pcall(function()
                remote:InvokeServer(pvpSelectedEnemy)
            end)
            pvpLastSentName = pvpSelectedEnemy
            pvpSentAt = tick()
        end
        task.wait(math.random() * 0.2 + 0.1)
