local function startTowerTracking()
    local gameFolder = workspace:FindFirstChild("Game")
    if gameFolder then
        local towersFolder = gameFolder:FindFirstChild("Towers")
        if towersFolder then
            towersFolder.ChildAdded:Connect(function(part)
                if part:IsA("BasePart") then
                    addTower(part)
                    task.defer(function()
                        if part and part.Parent then watchTower(part) end
                    end)
                end
            end)
            towersFolder.ChildRemoved:Connect(function(part)
                if part:IsA("BasePart") then removeTower(part) end
            end)
        else
            task.wait(2)
            startTowerTracking()
            return
        end
    else
        task.wait(2)
        startTowerTracking()
        return
    end
    scanForTowers()
    task.defer(function()
        for part, _ in pairs(towers) do
            if not watchedTowers[part] then watchTower(part) end
        end
    end)
    task.spawn(function() while true do cleanupDeadTowers() task.wait(1) end end)
end

