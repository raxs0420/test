local activeAbilities = {}
local abilityTargets = {}

for towerName, data in pairs(towerToAbilitySlot) do
    local abilityName = data.ability
    if not abilityTargets[abilityName] then
        abilityTargets[abilityName] = {towers = {}, slot = data.slot}
    end
    table.insert(abilityTargets[abilityName].towers, towerName)
end

local towers = {}
local partToId = {}

local function updateAbilityTargetIds(abilityName)
    local data = abilityTargets[abilityName]
    if not data then return {} end
    local ids = {}
    if type(towers) == "table" then
        for id, towerData in pairs(towers) do
            if towerData and towerData.name then
                for _, towerName in ipairs(data.towers) do
                    if towerData.name == towerName then
                        ids[#ids + 1] = id
                        break
                    end
                end
            end
        end
    end
    return ids
end

local function sendAbility(id, slot)
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        local req = remote:FindFirstChild("TowerUseAbilityRequest")
        if req then
            pcall(function() req:InvokeServer(id, slot) end)
        end
    end
end

local abilityLoops = {}

local function startAbilityLoop(abilityName)
    if abilityLoops[abilityName] then
        task.cancel(abilityLoops[abilityName])
        abilityLoops[abilityName] = nil
        return false
    end
    
    local data = abilityTargets[abilityName]
    if not data then return false end
    
    abilityLoops[abilityName] = task.spawn(function()
        while activeAbilities[abilityName] do
            local targetIds = updateAbilityTargetIds(abilityName)
            if #targetIds > 0 then
                for _, id in ipairs(targetIds) do
                    if not activeAbilities[abilityName] then break end
                    sendAbility(id, data.slot)
                    task.wait(0.15)
                end
            end
            task.wait(0.5)
        end
    end)
    return true
end

