local function updateTowersList()
    if not Scrolls.Towers then return end
    for _, child in ipairs(Scrolls.Towers:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 6)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.FillDirection = Enum.FillDirection.Vertical
    listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    listLayout.Parent = Scrolls.Towers

    local ownedTowers = {}
    for part, data in pairs(towers) do
        if data.owned and data.hash then
            table.insert(ownedTowers, {part = part, data = data})
        end
    end

    if #ownedTowers == 0 then
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -14, 0, 22)
        label.Text = "No owned towers detected yet"
