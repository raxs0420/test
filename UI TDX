local bountyLoop = nil
local function runBountySequential(slot)
    while settings.activeAbilities["BOUNTY"] do
        local gmParts = {}
        for part, data in pairs(towers) do
            if data.owned and data.name == "Golden Mobster" and part.Parent and data.hash and data.bottomCount >= 3 then
                local pauseUntil = towerPauseUntil[part]
                if not pauseUntil or tick() >= pauseUntil then
                    table.insert(gmParts, part)
                end
            end
        end
        if #gmParts == 0 then task.wait(0.5) continue end
        local enemies = getAllEnemies()
        if #enemies == 0 then task.wait(0.1) continue end
        for _, part in ipairs(gmParts) do
            if not settings.activeAbilities["BOUNTY"] then break end
            local target = getClosestEnemy(part.Position, enemies, globalHitBlacklist)
            if not target then task.wait(0.1) continue end
            local response = sendAbilityWithPosition(part, slot, target.Position)
            if response == true then
                globalHitBlacklist[target] = true
                towerPauseUntil[part] = tick() + 3
            elseif response == false then
                task.wait(0.15)
            elseif response == nil then
                task.wait(0.15)
            end
            task.wait(0.15)
        end
        task.wait(0.3)
    end
end

