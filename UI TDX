local towers = {}
local partToId = {}
local nextId = 1
local freeIds = {}

local function getAllEnemies()
    local enemiesFolder = workspace.Game:FindFirstChild("Enemies")
    if not enemiesFolder then return {} end
    local enemies = {}
    for _, child in ipairs(enemiesFolder:GetChildren()) do
        if child:IsA("BasePart") and child.Name ~= "Arrow" then
            table.insert(enemies, child)
        end
    end
    return enemies
end

local function getClosestEnemy(position, enemies, blacklist)
    local whitelistSet = {}
    for _, name in ipairs(enemyWhitelist) do
        whitelistSet[name] = true
    end
    
    local whitelistEnemies = {}
    for _, enemy in ipairs(enemies) do
        if not blacklist[enemy] and whitelistSet[enemy.Name] then
            local dist = (position - enemy.Position).Magnitude
            if dist <= 25 then
                table.insert(whitelistEnemies, enemy)
            end
        end
    end
    
    local candidates = whitelistEnemies
    if #candidates == 0 then
        candidates = {}
        for _, enemy in ipairs(enemies) do
            if not blacklist[enemy] then
                local blocked = false
                for _, blockedName in ipairs(enemyBlocklist) do
                    if enemy.Name == blockedName then
                        blocked = true
                        break
                    end
                end
                if not blocked then
                    table.insert(candidates, enemy)
                end
            end
        end
    end
    
    local best, bestDist = nil, math.huge
    for _, enemy in ipairs(candidates) do
        local dist = (position - enemy.Position).Magnitude
        if dist < bestDist then
            bestDist = dist
            best = enemy
        end
    end
    return best
end

local globalHitBlacklist = {}
local towerPauseUntil = {}

local function isTowerDead(part)
    if not part or not part.Parent then return true end
    local towersFolder = workspace.Game:FindFirstChild("Towers")
    if not towersFolder or part.Parent ~= towersFolder then return false end
    return false
end

local function allocateId()
    if #freeIds > 0 then
        return table.remove(freeIds)
    else
        local id = nextId
        nextId = nextId + 1
        return id
    end
end

local function freeId(id)
    if id and id > 0 then
        table.insert(freeIds, id)
    end
end

local function addTower(part)
    if partToId[part] then return end
    if isTowerDead(part) then return end
    local id = allocateId()
    partToId[part] = id
    towers[id] = {
        part = part,
        name = part.Name,
        topCount = 0,
        bottomCount = 0,
        placedAfterAuto = autoActive,
        removed = false
    }
end

local function removeTower(part)
    local id = partToId[part]
    if not id then return end
    partToId[part] = nil
    towers[id] = nil
    freeId(id)
end

local function cleanupDeadTowers()
    for part, id in pairs(partToId) do
        if isTowerDead(part) then
            partToId[part] = nil
            towers[id] = nil
            freeId(id)
        end
    end
end

local function fullResync()
    local towersFolder = workspace.Game:FindFirstChild("Towers")
    if not towersFolder then return end
    local liveParts = {}
    for _, part in ipairs(towersFolder:GetChildren()) do
        if part:IsA("BasePart") and not isTowerDead(part) then
            table.insert(liveParts, part)
        end
    end
    local newPartToId = {}
    local newTowers = {}
    local usedIds = {}
    for _, part in ipairs(liveParts) do
        local oldId = partToId[part]
        if oldId and towers[oldId] and towers[oldId].part == part then
            newPartToId[part] = oldId
            newTowers[oldId] = towers[oldId]
            usedIds[oldId] = true
        end
    end
    for _, part in ipairs(liveParts) do
        if not newPartToId[part] then
            local newId = allocateId()
            newPartToId[part] = newId
            usedIds[newId] = true
            newTowers[newId] = {
                part = part,
                name = part.Name,
                topCount = 0,
                bottomCount = 0,
                placedAfterAuto = autoActive,
                removed = false
            }
        end
    end
    for id, _ in pairs(towers) do
        if not usedIds[id] then
            freeId(id)
        end
    end
    partToId = newPartToId
    towers = newTowers
end

local function sendOverloadAbility(id, slot, position)
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        local req = remote:FindFirstChild("TowerUseAbilityRequest")
        if req then
            local success, response = pcall(function()
                return req:InvokeServer(id, slot, position)
            end)
            if success then
                return response
            else
                return nil
            end
        end
    end
    return nil
end

local overloadLoop = nil
local function runOverloadSequential(slot)
    while activeAbilities["OVERLOAD"] do
        local gmIds = {}
        for id, data in pairs(towers) do
            if data.name == "Golden Mobster" and data.part and data.part.Parent then
                local pauseUntil = towerPauseUntil[id]
                if not pauseUntil or tick() >= pauseUntil then
                    table.insert(gmIds, id)
                end
            end
        end
        if #gmIds == 0 then
            task.wait(0.5)
            continue
        end
        local enemies = getAllEnemies()
        if #enemies == 0 then
            task.wait(0.1)
            continue
        end
        for _, id in ipairs(gmIds) do
            if not activeAbilities["OVERLOAD"] then break end
            local towerData = towers[id]
            if not towerData or not towerData.part then continue end
            local target = getClosestEnemy(towerData.part.Position, enemies, globalHitBlacklist)
            if not target then
                task.wait(0.1)
                continue
            end
            local response = sendOverloadAbility(id, slot, target.Position)
            if response == true then
                globalHitBlacklist[target] = true
                towerPauseUntil[id] = tick() + 3
            elseif response == false then
                task.wait(0.15)
            elseif response == nil then
                task.wait(0.15)
            end
            task.wait(0.15)
        end
        task.wait(0.3)
    end
end

local abilityLoops = {}

local function startAbilityLoop(abilityName)
    if abilityName == "OVERLOAD" then
        if overloadLoop then
            task.cancel(overloadLoop)
            overloadLoop = nil
        end
        if not activeAbilities["OVERLOAD"] then return false end
        overloadLoop = task.spawn(runOverloadSequential, abilityTargets["OVERLOAD"].slot)
        return true
    else
        if abilityLoops[abilityName] then
            task.cancel(abilityLoops[abilityName])
            abilityLoops[abilityName] = nil
            return false
        end
        local data = abilityTargets[abilityName]
        if not data then return false end
        abilityLoops[abilityName] = task.spawn(function()
            while activeAbilities[abilityName] do
                local targetIds = {}
                for id, towerData in pairs(towers) do
                    if towerData and towerData.name then
                        for _, towerName in ipairs(data.towers) do
                            if towerData.name == towerName then
                                targetIds[#targetIds + 1] = id
                                break
                            end
                        end
                    end
                end
                if #targetIds > 0 then
                    for _, id in ipairs(targetIds) do
                        if not activeAbilities[abilityName] then break end
                        local remote = ReplicatedStorage:FindFirstChild("Remotes")
                        if remote then
                            local req = remote:FindFirstChild("TowerUseAbilityRequest")
                            if req then
                                pcall(function() req:InvokeServer(id, data.slot) end)
                            end
                        end
                        task.wait(0.2)
                    end
                end
                task.wait(0.3)
            end
        end)
        return true
    end
end

