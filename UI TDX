local function processEnemyVisuals(enemiesFolder, batchSize)
    local allEnemies = enemiesFolder:GetChildren()
    local processed = 0
    for _, enemy in ipairs(allEnemies) do
        if processed >= batchSize then break end
        if AntiLag.enemyProcessed[enemy] then continue end
        AntiLag.enemyProcessed[enemy] = true
        processed = processed + 1
        for _, desc in ipairs(enemy:GetDescendants()) do
            if desc:IsA("BasePart") then desc.CastShadow = false end
        end
        for _, desc in ipairs(enemy:GetDescendants()) do
            if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") or desc:IsA("Fire") or desc:IsA("Smoke") or desc:IsA("Sparkles") then
                pcall(function() desc:Destroy() end)
            end
        end
        for _, desc in ipairs(enemy:GetDescendants()) do
            if desc:IsA("Decal") or desc:IsA("Texture") then
                pcall(function() desc:Destroy() end)
            end
        end
    end
    return processed
end

