local function startCoinCollector()
    task.spawn(function()
        local remote = nil
        local function getRemote()
            if not remote or not remote.Parent then
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes then remote = remotes:FindFirstChild("ClientsideCoinCollectedEvent") end
            end
            return remote
        end
        while true do
            local currentRemote = getRemote()
            if currentRemote then
                for i = 1, 250 do pcall(function() currentRemote:FireServer(i) end) end
            end
            task.wait(2.5)
        end
    end)
end

