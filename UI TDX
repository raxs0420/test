local function getEquippedTowers()
    local equipped = {}
    local guiRoot = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("GUI")
    if guiRoot then
        local towersBar = guiRoot:FindFirstChild("TowersBar")
        if towersBar then
            for i = 1, 6 do
                local slot = towersBar:FindFirstChild(tostring(i))
                if slot then
                    local mainFrame = slot:FindFirstChild("MainFrame")
                    if mainFrame then
                        for _, child in ipairs(mainFrame:GetChildren()) do
                            if child:IsA("Frame") and child.Name ~= "Empty" then
                                equipped[child.Name] = true
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    return equipped
end

