local function updateTowersList()
    if not towersScroll or not towersLayout then return end
    for _, child in ipairs(towersScroll:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    local ownedTowers = {}
    for part, data in pairs(towers) do
        if data.owned and data.hash then
            table.insert(ownedTowers, {part = part, data = data})
        end
    end
    if #ownedTowers == 0 then
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -14, 0, 22)
        label.Text = "No owned towers detected yet"
        label.TextColor3 = Color3.fromRGB(140, 140, 145)
        label.TextSize = 11
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.Gotham
        label.Parent = towersScroll
    else
        table.sort(ownedTowers, function(a,b) return a.data.name < b.data.name end)
        for _, entry in ipairs(ownedTowers) do
            local data = entry.data
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -14, 0, 22)
            label.Text = string.format("%s | Hash: %d | Top: %d | Bottom: %d", 
                data.name, data.hash or 0, data.topCount or 0, data.bottomCount or 0)
            label.TextColor3 = Color3.fromRGB(180, 180, 185)
            label.TextSize = 11
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.Gotham
            label.Parent = towersScroll
        end
    end
    task.defer(function()
        if towersScroll then
            towersScroll.CanvasSize = UDim2.new(0, 0, 0, towersLayout.AbsoluteContentSize.Y + 10)
        end
    end)
end

local function isTowerDead(part)
    if not part then return true end
    if not part.Parent then return true end
    if part.Parent.Name ~= "Towers" then return true end
    return false
end

local function addTower(part)
    if not part or not part.Parent then return end
    if towers[part] then return end
    towers[part] = {
        name = part.Name,
        owned = false,
        hash = nil,
        topCount = 0,
        bottomCount = 0,
        currentLevel = 0,
        position = part.Position
    }
    addDebugLog(string.format("Tower added: %s", part.Name))
    updateTowersList()
end

local function removeTower(part)
    if towers[part] then
        addDebugLog(string.format("Tower removed: %s", towers[part].name))
        towers[part] = nil
        watchedTowers[part] = nil
        updateTowersList()
    end
end

local function cleanupDeadTowers()
    local changed = false
    for part, data in pairs(towers) do
        if isTowerDead(part) then
            towers[part] = nil
            watchedTowers[part] = nil
            changed = true
        end
    end
    if changed then
        updateTowersList()
    end
end

local function scanForTowers()
    local gameFolder = workspace:FindFirstChild("Game")
    if not gameFolder then return end
    local towersFolder = gameFolder:FindFirstChild("Towers")
    if not towersFolder then return end
    for _, part in ipairs(towersFolder:GetChildren()) do
        if part:IsA("BasePart") then
            addTower(part)
        end
    end
end

local watchedTowers = {}

local function onNumericAdded(child, part)
    if not part or not part.Parent then return end
    local num = tonumber(child.Name)
    if not num then return end
    local data = towers[part]
    if not data then return end
    local old = data.currentLevel
    if num > old then
        data.currentLevel = num
    end
end

local function watchTower(part)
    if not part or not part.Parent then return end
    if watchedTowers[part] then return end
    watchedTowers[part] = true

    local function safeCheckChildren(parent)
        local success, children = pcall(function() return parent:GetChildren() end)
        if not success or not children then return end
        for _, child in ipairs(children) do
            if tonumber(child.Name) then
                onNumericAdded(child, part)
            end
            if child:IsA("Model") then
                local success2, subChildren = pcall(function() return child:GetChildren() end)
                if success2 and subChildren then
                    for _, sub in ipairs(subChildren) do
                        if tonumber(sub.Name) then onNumericAdded(sub, part) end
                    end
                end
                task.defer(function()
                    if child and child.Parent then
                        pcall(function()
                            child.ChildAdded:Connect(function(sub)
                                if tonumber(sub.Name) then onNumericAdded(sub, part) end
                            end)
                        end)
                    end
                end)
            end
        end
    end

    task.defer(function()
        if part and part.Parent then
            safeCheckChildren(part)
        end
    end)

    pcall(function()
        part.ChildAdded:Connect(function(child)
            if tonumber(child.Name) then onNumericAdded(child, part) end
            if child:IsA("Model") then
                task.defer(function()
                    if child and child.Parent then
                        pcall(function()
                            child.ChildAdded:Connect(function(sub)
                                if tonumber(sub.Name) then onNumericAdded(sub, part) end
                            end)
                        end)
                        local success, subChildren = pcall(function() return child:GetChildren() end)
                        if success and subChildren then
                            for _, sub in ipairs(subChildren) do
                                if tonumber(sub.Name) then onNumericAdded(sub, part) end
                            end
                        end
                    end
                end)
            end
        end)
    end)
end

