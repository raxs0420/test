local function trackCreation(instance)
    if not instance:GetAttribute("_created") then instance:SetAttribute("_created", tick()) end
end

local function removeFolders()
    local tdxShared = ReplicatedStorage:FindFirstChild("TDX_Shared")
    if tdxShared then
        local common = tdxShared:FindFirstChild("Common")
        if common then
            local resources = common:FindFirstChild("Resources")
            if resources then
                local deathEffects = resources:FindFirstChild("DeathEffects")
                if deathEffects then deathEffects:Destroy() end
            end
        end
    end
    local gameProjectiles = workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Projectiles")
    if gameProjectiles then gameProjectiles:Destroy() end
    if antiLagEnabled then
        local gameFolder = workspace:FindFirstChild("Game")
        if gameFolder then
            local enemies = gameFolder:FindFirstChild("Enemies")
            if enemies then
                local enemyParts = enemies:GetChildren()
                for _, part in ipairs(enemyParts) do trackCreation(part) end
                if #enemyParts > 100 then
                    local excess = #enemyParts - 100
                    table.sort(enemyParts, function(a,b) return (a:GetAttribute("_created") or 0) < (b:GetAttribute("_created") or 0) end)
                    for i = 1, excess do enemyParts[i]:Destroy() end
                end
            end
            local pathEntities = gameFolder:FindFirstChild("PathEntities")
            if pathEntities then
                for _, child in ipairs(pathEntities:GetChildren()) do
                    if not string.find(child.Name, "WarMachine") then
                        child:Destroy()
                    end
                end
            end
        end
    end
end

