local originalFog = {start = nil, fin = nil}
local originalAtmosphere = {}

function applyAntiLagSettings()
    if settings.antiLagFog then
        if originalFog.start == nil then
            originalFog.start = Lighting.FogStart
            originalFog.fin = Lighting.FogEnd
            for _, child in ipairs(Lighting:GetChildren()) do
                if child:IsA("Atmosphere") then
                    originalAtmosphere[child] = {density = child.Density, haze = child.Haze, glare = child.Glare}
                end
            end
        end
        Lighting.FogStart = 100000
        Lighting.FogEnd = 100000
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("Atmosphere") then child.Density = 0 end
        end
    else
        if originalFog.start ~= nil then
            Lighting.FogStart = originalFog.start
            Lighting.FogEnd = originalFog.fin
        end
        for child, vals in pairs(originalAtmosphere) do
            if child and child.Parent then
                child.Density = vals.density
                child.Haze = vals.haze
                child.Glare = vals.glare
            end
        end
    end

    if settings.antiLagShadows then
        Lighting.GlobalShadows = false
        Lighting.ShadowSoftness = 0
    else
        Lighting.GlobalShadows = true
        Lighting.ShadowSoftness = 0.5
    end

    if settings.antiLagEffects then
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("BloomEffect") then child.Enabled = false end
            if child:IsA("SunRaysEffect") then child.Enabled = false end
            if child:IsA("ColorCorrectionEffect") then child.Enabled = false end
            if child:IsA("Atmosphere") then
                child.Density = 0
                child.Haze = 0
                child.Glare = 0
            end
        end
    else
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("BloomEffect") then child.Enabled = true end
            if child:IsA("SunRaysEffect") then child.Enabled = true end
            if child:IsA("ColorCorrectionEffect") then child.Enabled = true end
        end
    end

    if settings.antiLagWater then
        workspace.Terrain.WaterWaveSize = 0
        workspace.Terrain.WaterWaveSpeed = 0
        workspace.Terrain.WaterReflectance = 0
        workspace.Terrain.WaterTransparency = 1
    else
        workspace.Terrain.WaterWaveSize = 0.15
        workspace.Terrain.WaterWaveSpeed = 10
        workspace.Terrain.WaterReflectance = 1
        workspace.Terrain.WaterTransparency = 0.3
    end
end

