local autoTargetMode = settings.autoTargetMode
local autoActive = (autoTargetMode ~= nil)
local upgradeLoop = nil

local function sendUpgrade(id, path, level)
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        local req = remote:FindFirstChild("TowerUpgradeRequest")
        if req then pcall(function() req:FireServer(id, path, level) end) end
    end
end

local function upgradeTower(id)
    local data = towers[id]
    if not data or not data.placedAfterAuto then return end
    local mode = autoTargetMode
    if not mode then return end
    if mode == "top" then
        if data.topCount < 5 then sendUpgrade(id, 1, 5) data.topCount = 5 task.wait(0.01) end
        if data.bottomCount < 2 then sendUpgrade(id, 2, 2) data.bottomCount = 2 task.wait(0.01) end
    else
        if data.bottomCount < 5 then sendUpgrade(id, 2, 5) data.bottomCount = 5 task.wait(0.01) end
        if data.topCount < 2 then sendUpgrade(id, 1, 2) data.topCount = 2 task.wait(0.01) end
    end
end

local function startAutoUpgrade()
    if upgradeLoop then task.cancel(upgradeLoop) end
    upgradeLoop = task.spawn(function()
        while autoActive do
            for id, data in pairs(towers) do
                if data.placedAfterAuto then upgradeTower(id) end
                task.wait(0.01)
            end
            task.wait(0.05)
        end
        upgradeLoop = nil
    end)
end

local function setAutoMode(mode, btn)
    if autoActive and autoTargetMode == mode then
        autoActive = false
        autoTargetMode = nil
        btn.BackgroundColor3 = Color3.fromRGB(70,70,70)
    else
        if autoActive then
            if autoTargetMode == "top" then topBtn.BackgroundColor3 = Color3.fromRGB(70,70,70)
            else bottomBtn.BackgroundColor3 = Color3.fromRGB(70,70,70) end
        end
        autoActive = true
        autoTargetMode = mode
        btn.BackgroundColor3 = Color3.fromRGB(70,150,70)
        for id, data in pairs(towers) do data.placedAfterAuto = false end
        startAutoUpgrade()
    end
    settings.autoTargetMode = autoTargetMode
    saveSettings()
end

