local function getBestEcoEnemy(wave, equipped)
    wave = wave or 1
    if wave >= 26 and equipped["Heavy Metal"] then
        return "Heavy Metal"
    elseif wave >= 11 and equipped["Fallout"] then
        return "Fallout"
    elseif wave >= 4 and equipped["Heavy Droid"] then
        return "Heavy Droid"
    elseif equipped["Normal Droid"] then
        return "Normal Droid"
    end
    return nil
end

local function runPvPEco()
    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes"):FindFirstChild("RequestSendPVPEnemy")
    if not remote then
        addDebugLog("[PvP ECO] Remote not found")
        pvpEcoActive = false
        return
    end

    local equipped = getEquippedEnemies()
    local startWave = getCurrentWave() or 1
    pvpEcoCurrentEnemy = getBestEcoEnemy(startWave, equipped)

    if not pvpEcoCurrentEnemy then
        addDebugLog("[PvP ECO] No equipped enemies available, cannot start")
        pvpEcoActive = false
        return
    end

    addDebugLog(string.format("[PvP ECO] Started on wave %d - sending %s", startWave, pvpEcoCurrentEnemy))

    local switchEndTime = 0
    local switchTarget = nil
    local lastWave = startWave

    while pvpEcoActive do
        local currentWave = getCurrentWave()
        local currentEquipped = getEquippedEnemies()

        if currentWave and currentWave ~= lastWave then
            lastWave = currentWave
            addDebugLog(string.format("[PvP ECO] Wave changed to %d", currentWave))
        end

        if switchTarget and tick() >= switchEndTime then
            pvpEcoCurrentEnemy = switchTarget
            pvpEcoCompletedTransitions[switchTarget] = true
            switchTarget = nil
            switchEndTime = 0
            addDebugLog(string.format("[PvP ECO] Timer done, now sending %s", pvpEcoCurrentEnemy))
        end

        if currentWave then
            if currentWave >= 4 and currentWave < 11 and pvpEcoCurrentEnemy ~= "Heavy Droid" and not switchTarget then
                if not pvpEcoCompletedTransitions["Heavy Droid"] and currentEquipped["Heavy Droid"] then
                    switchEndTime = tick() + 10
                    switchTarget = "Heavy Droid"
                    addDebugLog("[PvP ECO] Wave 4+ detected, Heavy Droid in 10s")
                end
            end

            if currentWave >= 11 and currentWave < 25 and pvpEcoCurrentEnemy ~= "Fallout" and not switchTarget then
                if not pvpEcoCompletedTransitions["Fallout"] and currentEquipped["Fallout"] then
                    switchEndTime = tick() + 10
                    switchTarget = "Fallout"
                    addDebugLog("[PvP ECO] Wave 11+ detected, Fallout in 10s")
                end
            end

            if currentWave >= 25 and pvpEcoCurrentEnemy ~= "Heavy Metal" and not switchTarget then
                if not pvpEcoCompletedTransitions["Heavy Metal"] and currentEquipped["Heavy Metal"] then
                    switchEndTime = tick() + 10
                    switchTarget = "Heavy Metal"
                    addDebugLog("[PvP ECO] Wave 26+ detected, Heavy Metal in 10s")
                end
            end
        end

        if pvpEcoCurrentEnemy and currentEquipped[pvpEcoCurrentEnemy] then
            pcall(function()
                remote:InvokeServer(pvpEcoCurrentEnemy)
            end)
            pvpLastSentName = pvpEcoCurrentEnemy
            pvpSentAt = tick()
        end

        task.wait(math.random() * 0.2 + 0.1)
    end

    pvpEcoActive = false
    pvpEcoCurrentEnemy = nil
    addDebugLog("[PvP ECO] Stopped")
end

