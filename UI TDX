local function startCoinCollector()
    task.spawn(function()
        local remote = nil
        local function getRemote()
            if not remote or not remote.Parent then
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes then remote = remotes:FindFirstChild("ClientsideCoinCollectedEvent") end
            end
            return remote
        end
        local coinIndex = 0
        while true do
            local currentRemote = getRemote()
            if currentRemote then
                local batchSize = math.random(2, 4)
                for i = 1, batchSize do
                    coinIndex = coinIndex + 1
                    if coinIndex > 100 then coinIndex = 1 end
                    pcall(function() currentRemote:FireServer(coinIndex) end)
                end
                task.wait(math.random() * 0.7 + 0.3)
            else
                task.wait(2)
            end
        end
    end)
end
startCoinCollector()

local function setupUpgradeListener()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then
        return
    end
    local factoryRemote = remotes:FindFirstChild("TowerFactoryQueueUpdated")
    if factoryRemote then
        factoryRemote.OnClientEvent:Connect(function(...)
            task.defer(function(...)
                local args = {...}
                local events = (type(args[1]) == "table" and #args[1] > 0) and args[1] or args
                for _, ev in ipairs(events) do
                    if type(ev) ~= "table" then continue end
                    if ev.Creation == false then
                        local towerId = ev.Data
                        if type(towerId) == "table" then towerId = towerId[1] end
                        if type(towerId) == "number" then
                            pendingPlacements[towerId] = nil
                            for part, data in pairs(towers) do
                                if data.hash == towerId then
                                    removeTower(part)
                                    break
                                end
                            end
                        end
                    else
                        local towerInfo = ev.Data
                        if type(towerInfo) == "table" and towerInfo[1] and type(towerInfo[1]) == "table" then
                            towerInfo = towerInfo[1]
                        end
                        if type(towerInfo) == "table" and type(towerInfo[1]) == "number" then
                            local towerId = towerInfo[1]
                            local towerName = towerInfo[2]
                            local playerName = towerInfo[7]
                            local rawPos = towerInfo[4]
                            local position = nil
                            if type(rawPos) == "table" and rawPos[1] and rawPos[2] and rawPos[3] then
                                position = Vector3.new(rawPos[1], rawPos[2], rawPos[3])
                            elseif typeof(rawPos) == "Vector3" then
                                position = rawPos
                            end
                            if tostring(playerName) == LocalPlayer.Name then
                                pendingPlacements[towerId] = {
                                    name = towerName,
                                    time = tick(),
                                    position = position
                                }
                                task.defer(scanForTowers)
                            else
                                addDebugLog(string.format("Tower placed (other): %s, hash=%d", towerName, towerId))
                            end
                        end
                    end
                end
            end, ...)
        end)
    end
    local upgradeRemote = remotes:FindFirstChild("TowerUpgradeQueueUpdated")
    if upgradeRemote then
        upgradeRemote.OnClientEvent:Connect(function(data)
            task.defer(function(data)
                if type(data) ~= "table" then return end
                local entries = (#data > 0) and data or {data}
                for _, entry in ipairs(entries) do
                    local hash = entry.Hash or entry.hash or entry.Id or entry.id
                    if not hash then continue end
                    if type(hash) == "string" then hash = tonumber(hash) end
                    if not hash then continue end
                    local top = 0
                    local bottom = 0
                    if entry.LevelReplicationData and type(entry.LevelReplicationData) == "table" then
                        top = entry.LevelReplicationData[1] or 0
                        bottom = entry.LevelReplicationData[2] or 0
                    end
                    addDebugLog(string.format("Upgrade event: hash=%d top=%d bottom=%d", hash, top, bottom))
                    for part, data in pairs(towers) do
                        if data.hash == hash then
                            data.topCount = top
                            data.bottomCount = bottom
                            addDebugLog(string.format("Updated %s (hash %d)", part.Name, hash))
                            updateTowersList()
                            break
                        end
                    end
                end
            end, data)
        end)
    end
end

local function setupAbilityListener()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then
        return
    end
    local ev = remotes:FindFirstChild("TowerAbilityUsed")
    if not ev then
        return
    end
    ev.OnClientEvent:Connect(function(...)
        task.defer(function(...)
            local args = {...}
            local data = args[1]
            if type(data) == "table" and type(data[1]) == "table" then
                local hash = data[1][1]
                if type(hash) == "number" then
                    abilityUsedQueue[hash] = true
                end
            end
        end, ...)
    end)
end

local function startTowerTracking()
    local gameFolder = workspace:FindFirstChild("Game")
    if gameFolder then
        local towersFolder = gameFolder:FindFirstChild("Towers")
        if towersFolder then
            towersFolder.ChildAdded:Connect(function(part) 
                if part:IsA("BasePart") then 
                    addTower(part) 
                    task.defer(function()
                        if part and part.Parent then
                            watchTower(part)
                        end
                    end)
                end 
            end)
            towersFolder.ChildRemoved:Connect(function(part) if part:IsA("BasePart") then removeTower(part) end end)
        else
            task.wait(2)
            startTowerTracking()
            return
        end
    else
        task.wait(2)
        startTowerTracking()
        return
    end
    scanForTowers()
    task.defer(function()
        for part, _ in pairs(towers) do 
            if not watchedTowers[part] then
                watchTower(part) 
            end
        end
    end)
    task.spawn(function() while true do cleanupDeadTowers() task.wait(1) end end)
end

