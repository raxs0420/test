local SettingsFile = "TDXAuto_Settings.json"
local defaultSettings = { 
    autoTargetMode = nil, 
    autoSkip = false, 
    activeAbilities = {},
    axeEnemyThreshold = 3,
    antiLagFog = false,
    antiLagShadows = false,
    antiLagEffects = false,
    antiLagWater = false,
    removeAnimEnemies = false,
    removeAnimTowers = false,
    removeAnimPaths = false
}
local settings = {}

local function loadSettings()
    local success, data = pcall(readfile, SettingsFile)
    if success and data then
        local decoded = game:GetService("HttpService"):JSONDecode(data)
        if type(decoded) ~= "table" then decoded = {} end
        for k, v in pairs(defaultSettings) do
            if decoded[k] == nil then
                decoded[k] = v
            end
        end
        settings = decoded
        settings.activeAbilities = settings.activeAbilities or {}
        settings.axeEnemyThreshold = tonumber(settings.axeEnemyThreshold) or 3
        settings.antiLagFog = settings.antiLagFog == true
        settings.antiLagShadows = settings.antiLagShadows == true
        settings.antiLagEffects = settings.antiLagEffects == true
        settings.antiLagWater = settings.antiLagWater == true
        settings.removeAnimEnemies = settings.removeAnimEnemies == true
        settings.removeAnimTowers = settings.removeAnimTowers == true
        settings.removeAnimPaths = settings.removeAnimPaths == true
        settings.ghostDronePosition = nil
    else
        settings = {}
        for k, v in pairs(defaultSettings) do settings[k] = v end
        settings.ghostDronePosition = nil
    end
    addDebugLog(string.format("Settings loaded. Axe threshold: %s", tostring(settings.axeEnemyThreshold)))
end

local function saveSettings()
    local encoded = game:GetService("HttpService"):JSONEncode(settings)
    pcall(writefile, SettingsFile, encoded)
end

