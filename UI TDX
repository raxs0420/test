local towerPauseUntil = {}
local pendingHash = nil
local pendingTop = 0
local pendingBottom = 0
local pendingPlacements = {}

local function updateTowersList()
    if not towersScroll or not towersLayout then return end
    for _, child in ipairs(towersScroll:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    local ownedTowers = {}
    for part, data in pairs(towers) do
        if data.owned and data.hash then
            table.insert(ownedTowers, {part = part, data = data})
        end
    end
    if #ownedTowers == 0 then
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -14, 0, 22)
        label.Text = "No owned towers detected yet"
        label.TextColor3 = Color3.fromRGB(140, 140, 145)
        label.TextSize = 11
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.Gotham
        label.Parent = towersScroll
    else
        table.sort(ownedTowers, function(a,b) return a.data.name < b.data.name end)
        for _, entry in ipairs(ownedTowers) do
            local data = entry.data
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -14, 0, 22)
            label.Text = string.format("%s | Hash: %d | Top: %d | Bottom: %d", 
                data.name, data.hash or 0, data.topCount or 0, data.bottomCount or 0)
            label.TextColor3 = Color3.fromRGB(180, 180, 185)
            label.TextSize = 11
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.Gotham
            label.Parent = towersScroll
        end
    end
    task.defer(function()
        if towersScroll then
            towersScroll.CanvasSize = UDim2.new(0, 0, 0, towersLayout.AbsoluteContentSize.Y + 10)
        end
    end)
end

local function isTowerDead(part)
    if not part then return true end
    if not part.Parent then return true end
    if part.Parent.Name ~= "Towers" then return true end
    return false
end

local function addTower(part)
    if not part or not part.Parent then return end
    if towers[part] then return end
    towers[part] = {
        name = part.Name,
        owned = false,
        hash = nil,
        topCount = 0,
        bottomCount = 0,
        currentLevel = 0,
        position = part.Position
    }
    addDebugLog(string.format("Tower added: %s", part.Name))
    updateTowersList()
end

local function removeTower(part)
    if towers[part] then
        addDebugLog(string.format("Tower removed: %s", towers[part].name))
        towers[part] = nil
        updateTowersList()
    end
end

local function cleanupDeadTowers()
    local changed = false
    for part, data in pairs(towers) do
        if isTowerDead(part) then
            towers[part] = nil
            changed = true
        end
    end
    if changed then
        updateTowersList()
    end
end

local function scanForTowers()
    local gameFolder = workspace:FindFirstChild("Game")
    if not gameFolder then return end
    local towersFolder = gameFolder:FindFirstChild("Towers")
    if not towersFolder then return end
    for _, part in ipairs(towersFolder:GetChildren()) do
        if part:IsA("BasePart") then
            addTower(part)
        end
    end
end

local function onNumericAdded(child, part)
    if not part or not part.Parent then return end
    local num = tonumber(child.Name)
    if not num then return end
    local data = towers[part]
    if not data then return end
    local old = data.currentLevel
    if num > old then
        data.currentLevel = num
        addDebugLog(string.format("Level increase for %s: %d -> %d", part.Name, old, num))
        if pendingHash and pendingPlacements and pendingPlacements[pendingHash] and not data.owned then
            data.owned = true
            data.hash = pendingHash
            data.topCount = pendingTop
            data.bottomCount = pendingBottom
            addDebugLog(string.format("Assigned hash %d to %s", pendingHash, part.Name))
            updateTowersList()
            pendingHash = nil
            pendingTop = 0
            pendingBottom = 0
            pendingPlacements[pendingHash] = nil
        end
    end
end

local function watchTower(part)
    if not part or not part.Parent then return end
    local function checkExisting()
        for _, child in ipairs(part:GetChildren()) do
            if tonumber(child.Name) then
                onNumericAdded(child, part)
            end
            if child:IsA("Model") then
                for _, sub in ipairs(child:GetChildren()) do
                    if tonumber(sub.Name) then onNumericAdded(sub, part) end
                end
                child.ChildAdded:Connect(function(sub)
                    if tonumber(sub.Name) then onNumericAdded(sub, part) end
                end)
            end
        end
    end
    part.ChildAdded:Connect(function(child)
        if tonumber(child.Name) then onNumericAdded(child, part) end
        if child:IsA("Model") then
            child.ChildAdded:Connect(function(sub)
                if tonumber(sub.Name) then onNumericAdded(sub, part) end
            end)
            for _, sub in ipairs(child:GetChildren()) do
                if tonumber(sub.Name) then onNumericAdded(sub, part) end
            end
        end
    end)
    checkExisting()
end

local function getTowerUseAbilityRequest()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        return remotes:FindFirstChild("TowerUseAbilityRequest")
    end
    return nil
end

local function sendAbilityWithPosition(part, slot, position)
    local data = towers[part]
    if not data or not data.hash then return nil end
    local req = getTowerUseAbilityRequest()
    if req then
        local success, response = pcall(function() 
            return req:InvokeServer(data.hash, slot, position) 
        end)
        if success then return response end
    end
    return nil
end

local function sendAbilityNoPosition(part, slot)
    local data = towers[part]
    if not data or not data.hash then return nil end
    local req = getTowerUseAbilityRequest()
    if req then
        local success, response = pcall(function() 
            return req:InvokeServer(data.hash, slot) 
        end)
        if success then return response end
    end
    return nil
end

local function getAllEnemies()
    local gameFolder = workspace:FindFirstChild("Game")
    if not gameFolder then return {} end
    local enemiesFolder = gameFolder:FindFirstChild("Enemies")
    if not enemiesFolder then return {} end
    local enemies = {}
    for _, child in ipairs(enemiesFolder:GetChildren()) do
        if child:IsA("BasePart") and child.Name ~= "Arrow" then
            table.insert(enemies, child)
        end
    end
    return enemies
end

local function getClosestEnemy(position, enemies, blacklist)
    local whitelistSet = {}
    for _, name in ipairs(enemyWhitelist) do whitelistSet[name] = true end
    local whitelistEnemies = {}
    for _, enemy in ipairs(enemies) do
        if not blacklist[enemy] and whitelistSet[enemy.Name] then
            local dist = (position - enemy.Position).Magnitude
            if dist <= 25 then table.insert(whitelistEnemies, enemy) end
        end
    end
    local candidates = #whitelistEnemies > 0 and whitelistEnemies or {}
    if #candidates == 0 then
        for _, enemy in ipairs(enemies) do
            if not blacklist[enemy] then
                local blocked = false
                for _, blockedName in ipairs(enemyBlocklist) do
                    if enemy.Name == blockedName then blocked = true break end
                end
                if not blocked then table.insert(candidates, enemy) end
            end
        end
    end
    local best, bestDist = nil, math.huge
    for _, enemy in ipairs(candidates) do
        local dist = (position - enemy.Position).Magnitude
        if dist < bestDist then bestDist = dist best = enemy end
    end
    return best
end

