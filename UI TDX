local AnimScan = {
    cleanedTowers  = {},
    foldersToScan  = {},
    foldersScanned = {},
    scanIndex      = 1,
    batchSize      = 25,
    interval       = 0.5,
}

local function cleanAnimators(parent, cache)
    if not parent then return end
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("AnimationController") and not cache[child] then
            cache[child] = true
            pcall(function() child:Destroy() end)
        end
        if #child:GetChildren() > 0 then cleanAnimators(child, cache) end
    end
end

local function collectAnimFolders(parent, list)
    if not parent then return end
    for _, child in ipairs(parent:GetChildren()) do
        if child.Name == "Animations" and child:IsA("Folder") then
            table.insert(list, child)
        else
            collectAnimFolders(child, list)
        end
    end
end

local function shouldRemoveAnim(animName) return not animName:lower():find("death") end

local function isAnimationObject(obj)
    return obj:IsA("Animation") or obj:IsA("KeyframeSequence") or obj:IsA("CurveAnimation")
end

local function removeAnimationObject(anim)
    local ok = pcall(function() anim:Destroy() end)
    if not ok then pcall(function() anim.Parent = nil end) end
end

local function scanAnimFoldersBatch()
    if #AnimScan.foldersToScan == 0 then return 0 end
    local processed = 0
    local removed = 0
    while processed < AnimScan.batchSize and AnimScan.scanIndex <= #AnimScan.foldersToScan do
        local folder = AnimScan.foldersToScan[AnimScan.scanIndex]
        AnimScan.scanIndex = AnimScan.scanIndex + 1
        if folder and folder.Parent then
            local folderKey = tostring(folder)
            if not AnimScan.foldersScanned[folderKey] then
                for _, anim in ipairs(folder:GetChildren()) do
                    if isAnimationObject(anim) and shouldRemoveAnim(anim.Name) then
                        removeAnimationObject(anim)
                        removed = removed + 1
                    end
                end
                local hasRemovableLeft = false
                for _, child in ipairs(folder:GetChildren()) do
                    if isAnimationObject(child) and shouldRemoveAnim(child.Name) then
                        hasRemovableLeft = true
                        break
                    end
                end
                if not hasRemovableLeft then AnimScan.foldersScanned[folderKey] = true end
                processed = processed + 1
            end
        end
    end
    return removed
end

local function removeAnimationsFromFolder(folder, removedCount)
    removedCount = removedCount or 0
    if not folder then return removedCount end
    for _, desc in ipairs(folder:GetDescendants()) do
        if desc.Name == "DeathExplodePart" then
            pcall(function() desc:Destroy() end)
            removedCount = removedCount + 1
        end
    end
    for _, child in ipairs(folder:GetChildren()) do
        if child.Name == "Animations" and child:IsA("Folder") then
            for _, anim in ipairs(child:GetChildren()) do
                if isAnimationObject(anim) and shouldRemoveAnim(anim.Name) then
                    removeAnimationObject(anim)
                    removedCount = removedCount + 1
                end
            end
        end
        if child:IsA("Folder") or child:IsA("Model") or child:IsA("Configuration") then
            removedCount = removeAnimationsFromFolder(child, removedCount)
        end
    end
    return removedCount
end

