local antiLagEnabled = settings.antiLagEnabled
local originalSettings = {}
local antiLagApplied = false
local antiLagConnections = {}

local function storeOriginalSettings()
    pcall(function()
        originalSettings.globalShadows = Lighting.GlobalShadows
        originalSettings.fogStart = Lighting.FogStart
        originalSettings.fogEnd = Lighting.FogEnd
        originalSettings.fogColor = Lighting.FogColor
        originalSettings.brightness = Lighting.Brightness
        originalSettings.outdoorAmbient = Lighting.OutdoorAmbient
        originalSettings.ambient = Lighting.Ambient
    end)

    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        pcall(function()
            originalSettings.terrainWaterWaveSize = terrain.WaterWaveSize
            originalSettings.terrainWaterWaveSpeed = terrain.WaterWaveSpeed
            originalSettings.terrainWaterReflectance = terrain.WaterReflectance
            originalSettings.terrainWaterTransparency = terrain.WaterTransparency
        end)
    end
end

local function safeSetProperty(obj, prop, value)
    pcall(function() obj[prop] = value end)
end

local function isEnemyPart(v)
    local parent = v
    while parent do
        if parent.Name == "Enemies" then
            local gameFolder = workspace:FindFirstChild("Game")
            if gameFolder and parent.Parent == gameFolder then
                return true
            end
        end
        parent = parent.Parent
    end
    return false
end

local function processPart(v)
    if not v or not v.Parent then return end
    if isEnemyPart(v) then return end
    pcall(function()
        if v:IsA("BasePart") or v:IsA("UnionOperation") or v:IsA("MeshPart") or v:IsA("CornerWedgePart") or v:IsA("TrussPart") then
            if not v:GetAttribute("_al_origMat") then
                v:SetAttribute("_al_origMat", tostring(v.Material))
            end
            if settings.antiLagMaterialOverride then
                if v.Material ~= Enum.Material.SmoothPlastic and v.Material ~= Enum.Material.Neon and v.Material ~= Enum.Material.ForceField then
                    v.Material = Enum.Material.Plastic
                end
                v.Reflectance = 0
            end
            if settings.antiLagDisableCastShadows then
                v.CastShadow = false
            end
        end
        if (v:IsA("Decal") or v:IsA("Texture")) and settings.antiLagDisableDecals then
            if not v:GetAttribute("_al_origTrans") then
                v:SetAttribute("_al_origTrans", v.Transparency)
            end
            v.Transparency = 1
        end
        if (v:IsA("ParticleEmitter") or v:IsA("Trail")) and settings.antiLagDisableParticles then
            if not v:GetAttribute("_al_origEnabled") then
                v:SetAttribute("_al_origEnabled", v.Enabled)
            end
            v.Enabled = false
        end
        if v:IsA("Trail") and settings.antiLagDisableTrails then
            if not v:GetAttribute("_al_origEnabled") then
                v:SetAttribute("_al_origEnabled", v.Enabled)
            end
            v.Enabled = false
        end
    end)
end

local function applyAntiLagOnce()
    if antiLagApplied then return end
    antiLagApplied = true

    if settings.antiLagRemoveFog then
        safeSetProperty(Lighting, "FogStart", 0)
        safeSetProperty(Lighting, "FogEnd", 9e9)
        safeSetProperty(Lighting, "FogColor", Color3.fromRGB(180, 180, 180))
    end

    if settings.antiLagRemoveShadows then
        safeSetProperty(Lighting, "GlobalShadows", false)
    end

    if settings.antiLagReduceTextures then
        pcall(function() settings().Rendering.QualityLevel = 1 end)
    end

    if settings.antiLagReduceWater then
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            pcall(function()
                terrain.WaterWaveSize = 0
                terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0
                terrain.WaterTransparency = 0
            end)
        end
    end

    if settings.antiLagDisableLightingEffects then
        for _, v in ipairs(Lighting:GetDescendants()) do
            pcall(function()
                if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
                    if not v:GetAttribute("_al_origEnabled") then
                        v:SetAttribute("_al_origEnabled", v.Enabled)
                    end
                    v.Enabled = false
                end
            end)
        end
    end

    task.spawn(function()
        local descendants = workspace:GetDescendants()
        local batchSize = 200
        for i = 1, #descendants, batchSize do
            for j = i, math.min(i + batchSize - 1, #descendants) do
                if not isEnemyPart(descendants[j]) then
                    processPart(descendants[j])
                end
            end
            task.wait(0.05)
        end
    end)
end

local function setupAntiLagConnections()
    for _, conn in ipairs(antiLagConnections) do
        pcall(function() conn:Disconnect() end)
    end
    antiLagConnections = {}

    table.insert(antiLagConnections, workspace.DescendantAdded:Connect(function(v)
        task.wait(0.1)
        if antiLagEnabled and not isEnemyPart(v) then
            processPart(v)
        end
    end))

    table.insert(antiLagConnections, Lighting.DescendantAdded:Connect(function(v)
        task.wait(0.1)
        if antiLagEnabled and settings.antiLagDisableLightingEffects then
            pcall(function()
                if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
                    if not v:GetAttribute("_al_origEnabled") then
                        v:SetAttribute("_al_origEnabled", v.Enabled)
                    end
                    v.Enabled = false
                end
            end)
        end
    end))
end

local function restoreOriginalSettings()
    pcall(function()
        if originalSettings.globalShadows ~= nil then Lighting.GlobalShadows = originalSettings.globalShadows end
        if originalSettings.fogStart ~= nil then Lighting.FogStart = originalSettings.fogStart end
        if originalSettings.fogEnd ~= nil then Lighting.FogEnd = originalSettings.fogEnd end
        if originalSettings.fogColor ~= nil then Lighting.FogColor = originalSettings.fogColor end
        if originalSettings.brightness ~= nil then Lighting.Brightness = originalSettings.brightness end
    end)

    pcall(function() settings().Rendering.QualityLevel = 10 end)

    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        pcall(function()
            if originalSettings.terrainWaterWaveSize ~= nil then terrain.WaterWaveSize = originalSettings.terrainWaterWaveSize end
            if originalSettings.terrainWaterWaveSpeed ~= nil then terrain.WaterWaveSpeed = originalSettings.terrainWaterWaveSpeed end
            if originalSettings.terrainWaterReflectance ~= nil then terrain.WaterReflectance = originalSettings.terrainWaterReflectance end
            if originalSettings.terrainWaterTransparency ~= nil then terrain.WaterTransparency = originalSettings.terrainWaterTransparency end
        end)   
    end

    task.spawn(function()
        for _, v in ipairs(workspace:GetDescendants()) do
            if isEnemyPart(v) then continue end
            pcall(function()
                if v:IsA("BasePart") or v:IsA("UnionOperation") or v:IsA("MeshPart") or v:IsA("CornerWedgePart") or v:IsA("TrussPart") then
                    local origMat = v:GetAttribute("_al_origMat")
                    if origMat then
                        local success, mat = pcall(function() return Enum.Material[origMat] end)
                        if success then v.Material = mat end
                    end
                end
                if v:IsA("Decal") or v:IsA("Texture") then
                    local origTrans = v:GetAttribute("_al_origTrans")
                    if origTrans ~= nil then v.Transparency = origTrans end
                end
                if v:IsA("ParticleEmitter") or v:IsA("Trail") then
                    local origEnabled = v:GetAttribute("_al_origEnabled")
                    if origEnabled ~= nil then v.Enabled = origEnabled end
                end
            end)
        end
        for _, v in ipairs(Lighting:GetDescendants()) do
            pcall(function()
                if v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
                    local origEnabled = v:GetAttribute("_al_origEnabled")
                    if origEnabled ~= nil then v.Enabled = origEnabled end
                end
            end) 
        end
    end)  

    for _, conn in ipairs(antiLagConnections) do
        pcall(function() conn:Disconnect() end)
    end
    antiLagConnections = {}
    antiLagApplied = false
end

local function removeFolders()
    local tdxShared = ReplicatedStorage:FindFirstChild("TDX_Shared")
    if tdxShared then
        local common = tdxShared:FindFirstChild("Common")
        if common then
            local resources = common:FindFirstChild("Resources")
            if resources then
                local deathEffects = resources:FindFirstChild("DeathEffects")
                if deathEffects then deathEffects:Destroy() end
            end
        end
    end
    local gameProjectiles = workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Projectiles")
    if gameProjectiles then gameProjectiles:Destroy() end
    if antiLagEnabled then
        local gameFolder = workspace:FindFirstChild("Game")
        if gameFolder then
            local enemies = gameFolder:FindFirstChild("Enemies")
            if enemies then
                local enemyParts = enemies:GetChildren()
                for _, part in ipairs(enemyParts) do
                    if not part:GetAttribute("_created") then part:SetAttribute("_created", tick()) end
                end
                local limit = settings.antiLagEnemyLimit or 100
                if #enemyParts > limit then
                    local excess = #enemyParts - limit
                    table.sort(enemyParts, function(a,b) return (a:GetAttribute("_created") or 0) < (b:GetAttribute("_created") or 0) end)
                    for i = 1, excess do enemyParts[i]:Destroy() end
                end
            end
            local pathEntities = gameFolder:FindFirstChild("PathEntities")
            if pathEntities then
                if settings.antiLagRemoveEnemies then
                    for _, child in ipairs(pathEntities:GetChildren()) do
                        if not string.find(child.Name, "WarMachine") then
                            child:Destroy()
                        end
                    end
                end
            end
        end
    end
end

