    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        local req = remote:FindFirstChild("TowerUseAbilityRequest")
        if req then
            local success, response = pcall(function() return req:InvokeServer(data.hash, slot) end)
            if success then return response else return nil end
        end
    end
    return nil
end

local function makeFastSpamLoop(abilityName, towerName, requiredPath, pathLevel, slot)
    return function()
        while settings.activeAbilities[abilityName] do
            local targets = {}
            for part, data in pairs(towers) do
                if data.owned and data.name == towerName and data.hash and part.Parent then
                    local meets = false
                    if requiredPath == "top" then
                        meets = data.topCount >= pathLevel
                    elseif requiredPath == "bottom" then
                        meets = data.bottomCount >= pathLevel
                    elseif requiredPath == "any" then
                        meets = data.topCount >= pathLevel or data.bottomCount >= pathLevel
                    end
                    if meets then
                        table.insert(targets, part)
                    end
                end
            end
            if #targets > 0 then
                for _, part in ipairs(targets) do
                    if not settings.activeAbilities[abilityName] then break end
                    sendAbilityNoPosition(part, slot)
                    task.wait(0.05)
