        if not queueFrame then return 99 end
        local c = 0
        for _, child in ipairs(queueFrame:GetChildren()) do
            if not child:IsA("UIListLayout") and child.Visible then c = c + 1 end
        end
        return c
    end)
    return ok and count or 99
end

local function runPvPEco()
    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes"):FindFirstChild("RequestSendPVPEnemy")
    if not remote then pvpEcoActive = false return end
    local equipped = getEquippedEnemies()
    local startWave = getCurrentWave() or 0
    pvpEcoCurrentEnemy = getBestEcoEnemy(startWave, equipped)
    while pvpEcoActive do
        local currentWave = getCurrentWave() or 1
        local currentEquipped = getEquippedEnemies()
        local queueCount = getQueueEnemyCount()
        local bestEnemy = getBestEcoEnemy(currentWave, currentEquipped)
        if bestEnemy then
            pvpEcoCurrentEnemy = bestEnemy
            if queueCount < 2 then
                pcall(function() remote:InvokeServer(pvpEcoCurrentEnemy) end)
                pvpLastSentName = pvpEcoCurrentEnemy
                pvpSentAt = tick()
            end
        else
            pvpEcoCurrentEnemy = "WAITING"
        end
        task.wait(math.random() * 0.2 + 0.1)
    end
    pvpEcoActive = false
    pvpEcoCurrentEnemy = nil
end

