local function runCallToArms()
    local SYNC_RANGE = 15
    local groupThreads = {}

    local function posKey(pos)
        return string.format("%.0f_%.0f_%.0f", pos.X, pos.Y, pos.Z)
    end

    local function getCommanders()
        local list = {}
        for part, data in pairs(towers) do
            if data.owned and data.name == "Commander" and data.hash and part.Parent and data.topCount >= 3 then
                table.insert(list, {part = part, pos = part.Position, hash = data.hash})
            end
        end
        return list
    end

    local function formGroups(commanders)
        local groups = {}
        local ungrouped = {}
        for i, c in ipairs(commanders) do ungrouped[i] = c end
        table.sort(ungrouped, function(a, b)
            if a.pos.X ~= b.pos.X then return a.pos.X < b.pos.X end
            if a.pos.Z ~= b.pos.Z then return a.pos.Z < b.pos.Z end
            return a.pos.Y < b.pos.Y
        end)
        while #ungrouped >= 3 do
            local anchor = table.remove(ungrouped, 1)
            local nearest = {}
            for i, c in ipairs(ungrouped) do
                local d = (anchor.pos - c.pos).Magnitude
                if d <= SYNC_RANGE then
                    table.insert(nearest, {idx = i, dist = d})
                end
            end
            table.sort(nearest, function(a, b) return a.dist < b.dist end)
            if #nearest >= 2 then
                local group = {anchor, ungrouped[nearest[1].idx], ungrouped[nearest[2].idx]}
                local toRemove = {nearest[1].idx, nearest[2].idx}
                table.sort(toRemove, function(a, b) return a > b end)
                for _, r in ipairs(toRemove) do table.remove(ungrouped, r) end
                table.insert(groups, group)
            else
                break
            end
        end
        return groups
    end

    local function groupKey(positions)
        local keys = {}
        for _, p in ipairs(positions) do table.insert(keys, posKey(p)) end
        table.sort(keys)
        return table.concat(keys, "|")
    end

    local function getGapForSize(size)
        if size >= 3 then return 15.5 end
        if size == 2 then return 23 end
        return 0.5
    end

    local function fireMember(part, hash)
        if not part or not part.Parent or not hash then return false end
        abilityUsedQueue[hash] = nil
        if sendAbilityNoPosition(part, 1) == true then return true end
        local start = tick()
        while tick() - start < 0.5 do
            if abilityUsedQueue[hash] then
                abilityUsedQueue[hash] = nil
                return true
            end
            task.wait(0.02)
        end
        abilityUsedQueue[hash] = nil
        return false
    end

    local function startGroupThread(key, positions)
        local state = {
            key = key,
            positions = positions,
            liveRefs = {},
            lastSeenAlive = tick(),
        }
        groupThreads[key] = state

        task.spawn(function()
            task.wait(1)
            while settings.activeAbilities["CALL_TO_ARMS"] and groupThreads[key] == state do
                for idx = 1, #positions do
                    if not settings.activeAbilities["CALL_TO_ARMS"] then return end
                    if groupThreads[key] ~= state then return end

                    local pk = posKey(positions[idx])
                    local ref = state.liveRefs[pk]
                    if ref and ref.part and ref.part.Parent and ref.hash then
                        local attempts = 0
                        while attempts < 7 and settings.activeAbilities["CALL_TO_ARMS"] do
                            if groupThreads[key] ~= state then return end
                            if fireMember(ref.part, ref.hash) then break end
                            attempts = attempts + 1
                            task.wait(0.3)
                        end
                    end

                    local gap = getGapForSize(#positions)
                    local start = tick()
                    while tick() - start < gap and settings.activeAbilities["CALL_TO_ARMS"] do
                        if groupThreads[key] ~= state then return end
                        task.wait(0.1)
                    end
                end
            end
        end)
    end

    local function refreshLiveRefs()
        local live = {}
        for part, data in pairs(towers) do
            if data.owned and data.name == "Commander" and data.hash and part.Parent and data.topCount >= 3 then
                live[posKey(part.Position)] = {part = part, hash = data.hash}
            end
        end
        for _, state in pairs(groupThreads) do
            local anyAlive = false
            for _, p in ipairs(state.positions) do
                local pk = posKey(p)
                if live[pk] then
                    state.liveRefs[pk] = live[pk]
                    anyAlive = true
                else
                    state.liveRefs[pk] = nil
                end
            end
            if anyAlive then
                state.lastSeenAlive = tick()
            end
        end
    end

    while settings.activeAbilities["CALL_TO_ARMS"] do
        refreshLiveRefs()

        local commanders = getCommanders()
        local groups = formGroups(commanders)

        local seenKeys = {}
        for _, group in ipairs(groups) do
            local positions = {}
            for _, c in ipairs(group) do table.insert(positions, c.pos) end
            local key = groupKey(positions)
            seenKeys[key] = true
            if not groupThreads[key] then
                startGroupThread(key, positions)
            end
        end

        local now = tick()
        for key, state in pairs(groupThreads) do
            if not seenKeys[key] and (now - state.lastSeenAlive) > 60 then
                groupThreads[key] = nil
            end
        end

        task.wait(0.5)
    end

    for key in pairs(groupThreads) do
        groupThreads[key] = nil
    end
end

local function runEncore()
    local SYNC_RANGE = 15
    local groupStates = {}
    local hashLastFire = {}
    while settings.activeAbilities["ENCORE"] do
        local edjs = {}
        for part, data in pairs(towers) do
            if data.owned and data.name == "EDJ" and data.hash and part.Parent and data.topCount >= 3 then
                table.insert(edjs, {part = part, pos = part.Position, hash = data.hash})
            end
        end
        if #edjs > 0 then
            table.sort(edjs, function(a, b) return a.hash < b.hash end)
            local groups = {}
            local ungrouped = {}
            for i, c in ipairs(edjs) do ungrouped[i] = c end
            while #ungrouped > 0 do
                local anchor = table.remove(ungrouped, 1)
                local nearby = {}
                for i, c in ipairs(ungrouped) do
                    local d = (anchor.pos - c.pos).Magnitude
                    if d <= SYNC_RANGE then table.insert(nearby, {idx = i, dist = d}) end
                end
                table.sort(nearby, function(a, b) return a.dist < b.dist end)
                local group = {anchor}
                local toRemove = {}
                for k = 1, math.min(2, #nearby) do
                    table.insert(group, ungrouped[nearby[k].idx])
                    table.insert(toRemove, nearby[k].idx)
                end
                table.sort(toRemove, function(a, b) return a > b end)
                for _, r in ipairs(toRemove) do table.remove(ungrouped, r) end
                table.insert(groups, group)
            end

            local activeKeys = {}
            for _, group in ipairs(groups) do
                local key = ""
                for _, c in ipairs(group) do key = key .. c.hash .. "_" end
                activeKeys[key] = true
            end
            for key, state in pairs(groupStates) do
                if not activeKeys[key] and not state.pending then groupStates[key] = nil end
            end

            local now = tick()
            for _, group in ipairs(groups) do
                local key = ""
                for _, c in ipairs(group) do key = key .. c.hash .. "_" end
                local size = #group
                local gap = (size == 1) and 0.5 or 10
                local state = groupStates[key]
                if not state then
                    state = { lastFire = 0, index = 1, pending = false }
                    groupStates[key] = state
                end
                if not state.pending and (now - state.lastFire >= gap) then
                    local attempts = 0
                    while attempts < size do
                        if state.index > size then state.index = 1 end
                        local member = group[state.index]
                        if member and member.part and member.part.Parent then
                            local hash = member.hash
                            local lastH = hashLastFire[hash] or 0
                            if now - lastH >= gap - 0.5 then
                                state.pending = true
                                local part = member.part
                                task.spawn(function()
                                    local used = false
                                    while settings.activeAbilities["ENCORE"] and not used do
                                        if not part or not part.Parent then break end
                                        abilityUsedQueue[hash] = nil
                                        if sendAbilityNoPosition(part, 1) == true then used = true break end
                                        local waitStart = tick()
                                        while tick() - waitStart < 0.5 and settings.activeAbilities["ENCORE"] do
                                            if abilityUsedQueue[hash] then used = true break end
                                            task.wait(0.02)
                                        end
                                        if not used then task.wait(0.15) end
                                    end
                                    abilityUsedQueue[hash] = nil
                                    local t = tick()
                                    hashLastFire[hash] = t
                                    state.lastFire = t
                                    state.index = (state.index % size) + 1
                                    state.pending = false
                                end)
                                break
                            end
                        end
                        state.index = (state.index % size) + 1
                        attempts = attempts + 1
                    end
                end
            end
        end
        task.wait(0.3)
    end
end

