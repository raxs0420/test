local MEDIC_TARGET_PRIORITY = {
    ["Phaser"] = 1,
    ["Refractor"] = 2,
    ["Golden Juggernaut"] = 3,
    ["Juggernaut"] = 4,
}

local MEDIC_RANGE = 25

local function getMedicsForBuff(topPath)
    local medics = {}
    for part, data in pairs(towers) do
        if data.owned and data.name == "Medic" and data.hash and part.Parent then
            local lvl = topPath and (data.topCount or 0) or (data.bottomCount or 0)
            if lvl >= 4 then
                table.insert(medics, {
                    part = part,
                    pos = part.Position,
                    hash = data.hash,
                })
            end
        end
    end
    return medics
end

local function getBuffTargets(allowedNames)
    local targets = {}
    for part, data in pairs(towers) do
        if data.owned and data.hash and part.Parent then
            local prio = MEDIC_TARGET_PRIORITY[data.name]
            if prio and (not allowedNames or allowedNames[data.name]) then
                table.insert(targets, {
                    part = part,
                    pos = part.Position,
                    hash = data.hash,
                    name = data.name,
                    prio = prio,
                    level = (data.bottomCount or 0) + 1,
                    topLevel = data.topCount or 0,
                })
            end
        end
    end
    table.sort(targets, function(a, b)
        if a.prio ~= b.prio then return a.prio < b.prio end
        if a.level ~= b.level then return a.level > b.level end
        if a.topLevel ~= b.topLevel then return a.topLevel > b.topLevel end
        return a.hash < b.hash
    end)
    return targets
end

local function fireMedicAndWait(abilityName, medicPart, slot, targetHash)
    local medicData = towers[medicPart]
    if not medicData or not medicData.hash then return false end
    local medicHash = medicData.hash

    while settings.activeAbilities[abilityName] do
        if not medicPart.Parent or not towers[medicPart] then return false end

        abilityUsedQueue[medicHash] = nil
        local result = sendMedicAbility(medicPart, slot, targetHash)

        if result == true then
            abilityUsedQueue[medicHash] = nil
            return true
        end

        if result == nil then
            local start = tick()
            while tick() - start < 0.5 do
                if abilityUsedQueue[medicHash] then
                    abilityUsedQueue[medicHash] = nil
                    return true
                end
                task.wait(0.02)
            end
        end

        task.wait(0.3)
    end

    abilityUsedQueue[medicHash] = nil
    return false
end

local function formMedicGroups(medics, groupSize)
    local groups = {}
    local pool = {}
    for _, m in ipairs(medics) do table.insert(pool, m) end

    table.sort(pool, function(a, b)
        if a.pos.X ~= b.pos.X then return a.pos.X < b.pos.X end
        if a.pos.Z ~= b.pos.Z then return a.pos.Z < b.pos.Z end
        return a.pos.Y < b.pos.Y
    end)

    while #pool >= groupSize do
        local anchor = table.remove(pool, 1)
        local candidates = {}
        for i, m in ipairs(pool) do
            table.insert(candidates, { idx = i, dist = (anchor.pos - m.pos).Magnitude, medic = m })
        end
        table.sort(candidates, function(a, b) return a.dist < b.dist end)

        local group = { anchor }
        local toRemove = {}
        for k = 1, groupSize - 1 do
            if candidates[k] then
                table.insert(group, candidates[k].medic)
                table.insert(toRemove, candidates[k].idx)
            end
        end
        table.sort(toRemove, function(a, b) return a > b end)
        for _, r in ipairs(toRemove) do table.remove(pool, r) end

        if #group == groupSize then
            table.insert(groups, group)
        end
    end

    return groups
end

local function groupMembersInRange(group, target, range)
    for _, m in ipairs(group) do
        if (m.pos - target.pos).Magnitude > range then return false end
    end
    return true
end

local function runMedicBuff(abilityName, slot, topPath, cycleTime, modeKey, allowedNames, range)
    range = range or MEDIC_RANGE
    local groupSize = topPath and 2 or 3
    local groupStates = {}

    return function()
        while settings.activeAbilities[abilityName] do
            local mode = settings[modeKey]

            if mode == "strongest" then
                local medics = getMedicsForBuff(topPath)
                local targets = getBuffTargets(allowedNames)

                if #medics >= groupSize and #targets > 0 then
                    local groups = formMedicGroups(medics, groupSize)

                    local activeKeys = {}
                    local orderedKeys = {}
                    for _, group in ipairs(groups) do
                        local hashes = {}
                        for _, m in ipairs(group) do table.insert(hashes, m.hash) end
                        table.sort(hashes)
                        local key = table.concat(hashes, "_")
                        activeKeys[key] = true
                        table.insert(orderedKeys, key)

                        if not groupStates[key] then
                            groupStates[key] = {
                                nextFireAt = tick(),
                                members = group,
                                targetHash = nil,
                                memberIndex = 1,
                                pending = false,
                            }
                        else
                            groupStates[key].members = group
                            if groupStates[key].memberIndex > #group then
                                groupStates[key].memberIndex = 1
                            end
                        end
                    end

                    for key in pairs(groupStates) do
                        if not activeKeys[key] then
                            groupStates[key] = nil
                        end
                    end

                    local now = tick()

                    local claimed = {}
                    for _, state in pairs(groupStates) do
                        if state.targetHash and now < state.nextFireAt then
                            claimed[state.targetHash] = true
                        end
                    end

                    for _, key in ipairs(orderedKeys) do
                        local state = groupStates[key]
                        if state and not state.pending and now >= state.nextFireAt then
                            local picked = nil
                            for _, t in ipairs(targets) do
                                if not claimed[t.hash] and groupMembersInRange(state.members, t, range) then
                                    picked = t
                                    break
                                end
                            end

                            if picked then
                                state.targetHash = picked.hash
                                claimed[picked.hash] = true
                                state.pending = true

                                local medicIdx = state.memberIndex
                                if medicIdx > #state.members then medicIdx = 1 end
                                local medic = state.members[medicIdx]

                                if medic then
                                    local mPart = medic.part
                                    local tHash = picked.hash
                                    task.spawn(function()
                                        if settings.activeAbilities[abilityName] and settings[modeKey] == "strongest" then
                                            local ok = fireMedicAndWait(abilityName, mPart, slot, tHash)
                                            if ok then
                                                state.nextFireAt = tick() + cycleTime
                                                state.memberIndex = medicIdx + 1
                                                if state.memberIndex > #state.members then state.memberIndex = 1 end
                                            else
                                                state.nextFireAt = tick() + 0.3
                                            end
                                        end
                                        state.pending = false
                                    end)
                                else
                                    state.pending = false
                                end
                            else
                                state.nextFireAt = now + 1
                            end
                        end
                    end
                end

                task.wait(0.3)
            else
                local medics = getMedicsForBuff(topPath)
                local targets = getBuffTargets(allowedNames)

                if not distributeThreads[abilityName] then
                    distributeThreads[abilityName] = {}
                end
                local threads = distributeThreads[abilityName]

                local activeIds = {}

                if #medics > 0 and #targets > 0 then
                    local usedTargets = {}
                    local assignments = {}

                    for _, m in ipairs(medics) do
                        local bestT, bestD = nil, math.huge
                        for _, t in ipairs(targets) do
                            if not usedTargets[t.hash] then
                                local d = (m.pos - t.pos).Magnitude
                                if d <= range and d < bestD then
                                    bestD = d
                                    bestT = t
                                end
                            end
                        end
                        if bestT then
                            usedTargets[bestT.hash] = true
                            table.insert(assignments, { medic = m, target = bestT })
                        end
                    end

                    for _, a in ipairs(assignments) do
                        local mPart = a.medic.part
                        local tHash = a.target.hash
                        local id = tostring(mPart)

                        activeIds[id] = true

                        if not threads[id] or not threads[id].running then
                            local threadState = { hash = tHash, running = true, part = mPart }
                            threads[id] = threadState
                            task.spawn(function()
                                while settings.activeAbilities[abilityName]
                                    and settings[modeKey] == "distribute"
                                    and threadState.running do
                                    if not mPart.Parent or not towers[mPart] then break end
                                    if not fireMedicAndWait(abilityName, mPart, slot, threadState.hash) then
                                        task.wait(0.1)
                                    end
                                end
                                if threads[id] == threadState then
                                    threads[id] = nil
                                end
                            end)
                        else
                            threads[id].hash = tHash
                            threads[id].part = mPart
                        end
                    end
                end

                for id, state in pairs(threads) do
                    if not activeIds[id] then
                        state.running = false
                        threads[id] = nil
                    end
                end

                task.wait(1)
            end
        end
    end
end

