local function updateTowersList()
    if not towersScroll then return end
    for _, child in ipairs(towersScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 6)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.FillDirection = Enum.FillDirection.Vertical
    listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    listLayout.Parent = towersScroll

    local ownedTowers = {}
    for part, data in pairs(towers) do
        if data.owned and data.hash then
            table.insert(ownedTowers, {part = part, data = data})
        end
    end

    if #ownedTowers == 0 then
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -14, 0, 22)
        label.Text = "No owned towers detected yet"
        label.TextColor3 = Color3.fromRGB(140, 140, 145)
        label.TextSize = 11
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.Gotham
        label.Parent = towersScroll
    else
        local groups = {}
        for _, entry in ipairs(ownedTowers) do
            local name = entry.data.name or "Unknown"
            if not groups[name] then groups[name] = {} end
            table.insert(groups[name], entry)
        end

        local sortedNames = {}
        for name, _ in pairs(groups) do table.insert(sortedNames, name) end
        table.sort(sortedNames)

        for _, name in ipairs(sortedNames) do
            local group = groups[name]
            table.sort(group, function(a, b) return (a.data.hash or 0) < (b.data.hash or 0) end)

            local block = Instance.new("Frame")
            block.Size = UDim2.new(1, -16, 0, 0)
            block.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
            block.BorderSizePixel = 0
            block.Parent = towersScroll
            Instance.new("UICorner", block).CornerRadius = UDim.new(0, 10)
            local blockStroke = Instance.new("UIStroke", block)
            blockStroke.Color = Color3.fromRGB(45, 45, 50)
            blockStroke.Thickness = 1

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, -40, 0, 18)
            nameLabel.Position = UDim2.new(0, 20, 0, 6)
            nameLabel.Text = "     " .. name .. " (" .. #group .. ")"
            nameLabel.TextColor3 = Color3.fromRGB(200, 200, 205)
            nameLabel.TextSize = 11
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.BackgroundTransparency = 1
            nameLabel.Parent = block

            local innerLayout = Instance.new("UIListLayout", block)
            innerLayout.Padding = UDim.new(0, 3)
            innerLayout.SortOrder = Enum.SortOrder.LayoutOrder
            innerLayout.FillDirection = Enum.FillDirection.Vertical
            innerLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
            innerLayout.Parent = block

            for i, entry in ipairs(group) do
                local data = entry.data
                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, -40, 0, 20)
                row.BackgroundTransparency = 1
                row.LayoutOrder = i
                row.Parent = block

                local infoLabel = Instance.new("TextLabel")
                infoLabel.Size = UDim2.new(1, -8, 1, 0)
                infoLabel.Position = UDim2.new(0, 20, 0, 0)
                infoLabel.Text = string.format("Hash: %d | Top: %d | Bottom: %d",
                    data.hash or 0, data.topCount or 0, data.bottomCount or 0)
                infoLabel.TextColor3 = Color3.fromRGB(170, 170, 175)
                infoLabel.TextSize = 10
                infoLabel.Font = Enum.Font.Gotham
                infoLabel.TextXAlignment = Enum.TextXAlignment.Left
                infoLabel.BackgroundTransparency = 1
                infoLabel.Parent = row
            end

            local contentHeight = (#group * 20) + ((#group - 1) * 3)
            block.Size = UDim2.new(1, -16, 0, 6 + 18 + contentHeight + 5)
        end
    end

    task.defer(function()
        if towersScroll and listLayout then
            towersScroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
        end
    end)
end

