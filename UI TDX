local function cleanAnimators(parent, cache)
    if not parent then return end
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("AnimationController") and not cache[child] then
            cache[child] = true
            pcall(function() child:Destroy() end)
        end
        if #child:GetChildren() > 0 then
            cleanAnimators(child, cache)
        end
    end
end

local animFoldersToScan = {}
local animFoldersScanned = {}
local animScanIndex = 1
local animScanBatchSize = 25
local animScanInterval = 0.5

local function collectAnimFolders(parent, list)
    if not parent then return end
    for _, child in ipairs(parent:GetChildren()) do
        if child.Name == "Animations" and child:IsA("Folder") then
            table.insert(list, child)
        else
            collectAnimFolders(child, list)
        end
    end
end

local function shouldRemoveAnim(animName)
    local lower = animName:lower()
    if lower:find("death") then return false end
    return true
end

local function isAnimationObject(obj)
    return obj:IsA("Animation") or obj:IsA("KeyframeSequence") or obj:IsA("CurveAnimation")
end

local function removeAnimationObject(anim)
    local success, err = pcall(function()
        anim:Destroy()
    end)
    if not success then
        local success2, err2 = pcall(function()
            anim.Parent = nil
        end)
        if success2 then
            return true, "parented_to_nil"
        else
            return false, tostring(err)
        end
    end
    return true, "destroyed"
end

local function scanAnimFoldersBatch()
    if #animFoldersToScan == 0 then return 0 end
    local processed = 0
    local removed = 0

    while processed < animScanBatchSize and animScanIndex <= #animFoldersToScan do
        local folder = animFoldersToScan[animScanIndex]
        animScanIndex = animScanIndex + 1

        if folder and folder.Parent then
            local folderKey = tostring(folder)
            if not animFoldersScanned[folderKey] then
                for _, anim in ipairs(folder:GetChildren()) do
                    if isAnimationObject(anim) then
                        if shouldRemoveAnim(anim.Name) then
                            local ok, method = removeAnimationObject(anim)
                            if ok then
                                removed = removed + 1
                            else
                            end
                        end
                    end
                end

                local hasRemovableLeft = false
                for _, child in ipairs(folder:GetChildren()) do
                    if isAnimationObject(child) and shouldRemoveAnim(child.Name) then
                        hasRemovableLeft = true
                        break
                    end
                end

                if not hasRemovableLeft then
                    animFoldersScanned[folderKey] = true
                end

                processed = processed + 1
            end
        end
    end

    return removed
end

local function removeAnimationsFromFolder(folder, removedCount)
    removedCount = removedCount or 0
    if not folder then return removedCount end

    for _, child in ipairs(folder:GetChildren()) do
        if child.Name == "Animations" and child:IsA("Folder") then
            for _, anim in ipairs(child:GetChildren()) do
                if isAnimationObject(anim) and shouldRemoveAnim(anim.Name) then
                    local ok, _ = removeAnimationObject(anim)
                    if ok then
                        removedCount = removedCount + 1
                    end
                end
            end
        elseif child.Name == "ModelSkins" and child:IsA("Folder") then
            for _, modelSkin in ipairs(child:GetChildren()) do
                removedCount = removeAnimationsFromFolder(modelSkin, removedCount)
            end
        elseif child:IsA("Folder") or child:IsA("Model") or child:IsA("Configuration") then
            removedCount = removeAnimationsFromFolder(child, removedCount)
        end
    end

    return removedCount
end

