                infoLabel.Size = UDim2.new(1, -8, 1, 0)
                infoLabel.Position = UDim2.new(0, 20, 0, 0)
                infoLabel.Text = string.format("Hash: %d | Top: %d | Bottom: %d",
                    data.hash or 0, data.topCount or 0, data.bottomCount or 0)
