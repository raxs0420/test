local function getBestEcoEnemy(wave, equipped)
    wave = wave or 1
    for _, entry in ipairs(ecoPriority) do
        if wave >= entry.wave and equipped[entry.name] then
            return entry.name
        end
    end
    return nil
end

local function getQueueEnemyCount()
    local success, count = pcall(function()
        local player = game:GetService("Players").LocalPlayer
        local gui = player:FindFirstChild("PlayerGui")
        if not gui then return 99 end
        local interface = gui:FindFirstChild("Interface")
        if not interface then return 99 end
        local bottomBar = interface:FindFirstChild("BottomBar")
        if not bottomBar then return 99 end
        local pvpTowersBar = bottomBar:FindFirstChild("PVPTowersBar")
        if not pvpTowersBar then return 99 end
        local queueFrame = pvpTowersBar:FindFirstChild("QueueFrame")
        if not queueFrame then return 99 end
        local c = 0
        for _, child in ipairs(queueFrame:GetChildren()) do
            if not child:IsA("UIListLayout") and child.Visible then
                c = c + 1
            end
        end
        return c
    end)
    if success then
        return count
    else
        return 99
    end
end

local function runPvPEco()
    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes"):FindFirstChild("RequestSendPVPEnemy")
    if not remote then
        pvpEcoActive = false
        return
    end

    local equipped = getEquippedEnemies()
    local startWave = getCurrentWave() or 0
    pvpEcoCurrentEnemy = getBestEcoEnemy(startWave, equipped)

    if not pvpEcoCurrentEnemy then
    else
    end

    while pvpEcoActive do
        local currentWave = getCurrentWave() or 1
        local currentEquipped = getEquippedEnemies()
        local queueCount = getQueueEnemyCount()

        local bestEnemy = getBestEcoEnemy(currentWave, currentEquipped)

        if bestEnemy then
            if bestEnemy ~= pvpEcoCurrentEnemy then
                pvpEcoCurrentEnemy = bestEnemy
            end

            if queueCount < 2 then
                pcall(function()
                    remote:InvokeServer(pvpEcoCurrentEnemy)
                end)
                pvpLastSentName = pvpEcoCurrentEnemy
                pvpSentAt = tick()
            else
            end
        else
            if pvpEcoCurrentEnemy ~= "WAITING" then
                pvpEcoCurrentEnemy = "WAITING"
            end
        end

        task.wait(math.random() * 0.2 + 0.1)
    end

    pvpEcoActive = false
    pvpEcoCurrentEnemy = nil
end

