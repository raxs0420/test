}
local settings = {}

local function loadSettings()
    local success, data = pcall(readfile, SettingsFile)
    if success and data then
        local decoded = game:GetService("HttpService"):JSONDecode(data)
        if type(decoded) ~= "table" then decoded = {} end
        for k, v in pairs(defaultSettings) do
            if decoded[k] == nil then
                decoded[k] = v
            end
        end
        settings = decoded
        settings.activeAbilities = settings.activeAbilities or {}
        settings.axeEnemyThreshold = tonumber(settings.axeEnemyThreshold) or 3
    else
        settings = {}
        for k, v in pairs(defaultSettings) do settings[k] = v end
    end
    addDebugLog(string.format("Settings loaded. Axe threshold: %s", tostring(settings.axeEnemyThreshold)))
end

local function saveSettings()
    local encoded = game:GetService("HttpService"):JSONEncode(settings)
    pcall(writefile, SettingsFile, encoded)
end

