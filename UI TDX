    end

    local function buildGameInfoUI()
        for _, child in ipairs(gameInfoScroll:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
        end

        local allPlayers = Players:GetPlayers()
        if #allPlayers == 0 then
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -14, 0, 30)
            label.Text = "No players found"
            label.TextColor3 = Color3.fromRGB(140, 140, 145)
            label.TextSize = 12
            label.TextXAlignment = Enum.TextXAlignment.Center
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.Gotham
            label.Parent = gameInfoScroll
            gameInfoScroll.CanvasSize = UDim2.new(0, 0, 0, 40)
            return false
        end

        local teams = {}
        local noTeamPlayers = {}
        for _, player in ipairs(allPlayers) do
            local tc = getPlayerTeamColor(player)
            if tc then
                local tn = player.Team.Name
                if not teams[tn] then teams[tn] = {color = tc, players = {}} end
                table.insert(teams[tn].players, player)
            else
                table.insert(noTeamPlayers, player)
            end
        end

        local yOffset = 8
        local sectionSpacing = 16
        local anyDataFound = false
        local hasAnyTeamFlag = next(teams) ~= nil

        local allTowerTypes = {}
        local playerTowerSets = {}

        local function collectPlayerData(player)
            local tw = getPlayerTowers(player)
            local en = getPlayerEnemies(player)
            local pu = getPlayerPowerUps(player)
            local set = {}
            local aliases = {["Oil Derrick"] = "Farm"}
            for _, t in ipairs(tw) do
                if t then
                    set[t] = true
                    allTowerTypes[t] = true
                    local a = aliases[t]
                    if a then set[a] = true allTowerTypes[a] = true end
                end
            end
            playerTowerSets[player] = {towers = tw, enemies = en, powerUps = pu, towerSet = set}
        end

        for _, player in ipairs(allPlayers) do collectPlayerData(player) end

        local orderedTowerTypes = {}
        for t, _ in pairs(allTowerTypes) do table.insert(orderedTowerTypes, t) end
        table.sort(orderedTowerTypes)

        local sharedTowerTypes = {}
        for _, tt in ipairs(orderedTowerTypes) do
            local count = 0
            for _, pdata in pairs(playerTowerSets) do
                if pdata.towerSet[tt] then count = count + 1 end
            end
            if count >= 2 then sharedTowerTypes[tt] = true end
        end

        local function renderPlayerBlock(player, teamColor, isLocal)
            local pdata = playerTowerSets[player]
            if not pdata then return end
            local tw = pdata.towers
            local en = pdata.enemies
            local pu = pdata.powerUps

            local hasTowerData, hasEnemyData = false, false
            for _, t in ipairs(tw) do if t then hasTowerData = true break end end
            for _, e in ipairs(en) do if e then hasEnemyData = true break end end
            if hasTowerData or hasEnemyData then anyDataFound = true end

            local blockHeight = hasAnyTeamFlag and 148 or 76

            local block = Instance.new("Frame")
            block.Size = UDim2.new(1, -16, 0, blockHeight)
            block.Position = UDim2.new(0, 8, 0, yOffset)
            block.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
            block.BorderSizePixel = 0
            block.Parent = gameInfoScroll
            Instance.new("UICorner", block).CornerRadius = UDim.new(0, 10)
            local bs = Instance.new("UIStroke", block)
            bs.Color = Color3.fromRGB(45, 45, 50)
            bs.Thickness = 1

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, -12, 0, 18)
            nameLabel.Position = UDim2.new(0, 6, 0, 4)
            nameLabel.Text = isLocal and (player.Name .. " (You)") or player.Name
            nameLabel.TextColor3 = isLocal and Color3.fromRGB(130, 220, 130) or (teamColor or Color3.fromRGB(200, 200, 205))
            nameLabel.TextSize = 11
            nameLabel.Font = Enum.Font.Gotham
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.BackgroundTransparency = 1
            nameLabel.Parent = block

            if hasAnyTeamFlag and pu then
                local offName = pu.offensive
                local defName = pu.defensive
                if offName then
                    local offBtn = Instance.new("TextButton")
                    offBtn.Size = UDim2.new(0, 86, 0, 24)
                    offBtn.Position = UDim2.new(1, -178, 0, 2)
                    offBtn.Text = offName
                    offBtn.BackgroundColor3 = Color3.fromRGB(170, 80, 115)
                    offBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
                    offBtn.TextSize = 9
                    offBtn.Font = Enum.Font.Gotham
                    offBtn.AutoButtonColor = false
                    offBtn.TextStrokeTransparency = 0.5
                    offBtn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    offBtn.Parent = block
                    Instance.new("UICorner", offBtn).CornerRadius = UDim.new(0, 6)
                    local offStroke = Instance.new("UIStroke", offBtn)
                    offStroke.Color = Color3.fromRGB(60, 60, 65)
                    offStroke.Thickness = 1
                end
                if defName then
                    local defBtn = Instance.new("TextButton")
                    defBtn.Size = UDim2.new(0, 86, 0, 24)
                    defBtn.Position = UDim2.new(1, -88, 0, 2)
                    defBtn.Text = defName
                    defBtn.BackgroundColor3 = Color3.fromRGB(80, 130, 175)
                    defBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
                    defBtn.TextSize = 9
                    defBtn.Font = Enum.Font.Gotham
                    defBtn.AutoButtonColor = false
                    defBtn.TextStrokeTransparency = 0.5
                    defBtn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    defBtn.Parent = block
                    Instance.new("UICorner", defBtn).CornerRadius = UDim.new(0, 6)
                    local defStroke = Instance.new("UIStroke", defBtn)
                    defStroke.Color = Color3.fromRGB(60, 60, 65)
                    defStroke.Thickness = 1
                end
            end

            local towersLabel = Instance.new("TextLabel")
            towersLabel.Size = UDim2.new(0, 50, 0, 14)
            towersLabel.Position = UDim2.new(0, 6, 0, 22)
            towersLabel.Text = "Towers"
            towersLabel.TextColor3 = Color3.fromRGB(140, 140, 145)
            towersLabel.TextSize = 9
            towersLabel.Font = Enum.Font.Gotham
            towersLabel.TextXAlignment = Enum.TextXAlignment.Left
            towersLabel.BackgroundTransparency = 1
            towersLabel.Parent = block

            local towerColor = teamColor or Color3.fromRGB(80, 80, 85)
            for i = 1, 6 do
                local col = (i - 1) % 6
                local towerName = tw[i]
                createSlotButton(block, towerName or "",
                    towerName and towerColor or Color3.fromRGB(35, 35, 40),
                    towerName and Color3.fromRGB(235, 235, 235) or Color3.fromRGB(100, 100, 105),
                    UDim2.new(0, 6 + col * 76, 0, 38), UDim2.new(0, 72, 0, 24))
            end

            if hasAnyTeamFlag then
                local enemiesLabel = Instance.new("TextLabel")
                enemiesLabel.Size = UDim2.new(0, 50, 0, 14)
                enemiesLabel.Position = UDim2.new(0, 6, 0, 68)
                enemiesLabel.Text = "Enemies"
                enemiesLabel.TextColor3 = Color3.fromRGB(160, 100, 220)
                enemiesLabel.TextSize = 9
                enemiesLabel.Font = Enum.Font.Gotham
                enemiesLabel.TextXAlignment = Enum.TextXAlignment.Left
                enemiesLabel.BackgroundTransparency = 1
                enemiesLabel.Parent = block

                local enemyColor = Color3.fromRGB(140, 80, 200)
                for i = 1, 12 do
                    local col = (i - 1) % 6
                    local row = math.floor((i - 1) / 6)
                    local enemyName = en[i]
                    createSlotButton(block, enemyName or "",
                        enemyName and enemyColor or Color3.fromRGB(35, 35, 40),
                        enemyName and Color3.fromRGB(235, 220, 255) or Color3.fromRGB(100, 100, 105),
                        UDim2.new(0, 6 + col * 76, 0, 84 + row * 28), UDim2.new(0, 72, 0, 24))
                end
            end

            yOffset = yOffset + blockHeight + 8
        end

        local localInNoTeam = false
        for _, p in ipairs(noTeamPlayers) do
            if p == LocalPlayer then localInNoTeam = true break end
        end

        local teamOrder = {}
        for tn, _ in pairs(teams) do table.insert(teamOrder, tn) end
        table.sort(teamOrder, function(a, b)
            local aHasLocal, bHasLocal = false, false
            for _, p in ipairs(teams[a].players) do if p == LocalPlayer then aHasLocal = true break end end
            for _, p in ipairs(teams[b].players) do if p == LocalPlayer then bHasLocal = true break end end
            if aHasLocal ~= bHasLocal then return not aHasLocal end
            return a < b
        end)

        local function renderTeamsSection()
            for _, tn in ipairs(teamOrder) do
                local td = teams[tn]
                local th = Instance.new("TextLabel")
                th.Size = UDim2.new(1, -16, 0, 22)
                th.Position = UDim2.new(0, 8, 0, yOffset)
                th.Text = "Team: " .. tn
                th.TextColor3 = td.color
                th.TextSize = 12
                th.Font = Enum.Font.Gotham
                th.TextXAlignment = Enum.TextXAlignment.Left
                th.BackgroundTransparency = 1
                th.Parent = gameInfoScroll
                yOffset = yOffset + 24

                local others, localP = {}, nil
                for _, p in ipairs(td.players) do
                    if p == LocalPlayer then localP = p else table.insert(others, p) end
                end
                for _, p in ipairs(others) do renderPlayerBlock(p, td.color, false) end
                if localP then renderPlayerBlock(localP, td.color, true) end
                yOffset = yOffset + sectionSpacing
            end
        end

        local function renderNoTeamSection()
            if #noTeamPlayers > 0 then
                if next(teams) then
                    local divider = Instance.new("Frame")
                    divider.Size = UDim2.new(1, -20, 0, 1)
                    divider.Position = UDim2.new(0, 10, 0, yOffset)
                    divider.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
                    divider.BorderSizePixel = 0
                    divider.Parent = gameInfoScroll
                    yOffset = yOffset + 12
                end
                local others, localP = {}, nil
                for _, p in ipairs(noTeamPlayers) do
                    if p == LocalPlayer then localP = p else table.insert(others, p) end
                end
                for _, p in ipairs(others) do renderPlayerBlock(p, nil, false) end
                if localP then renderPlayerBlock(localP, nil, true) end
            end
        end

        if localInNoTeam then
            renderTeamsSection()
            renderNoTeamSection()
        else
            renderNoTeamSection()
            renderTeamsSection()
        end
        gameInfoScroll.CanvasSize = UDim2.new(0, 0, 0, yOffset + 10)
        return anyDataFound
    end

    local function tryBuild()
        if not buildGameInfoUI() then
            task.delay(3, tryBuild)
        end
    end
    tryBuild()

    task.spawn(function()
        while true do
            if gameInfoFrame.Visible then buildGameInfoUI() end
            task.wait(1)
        end
    end)

    Players.PlayerAdded:Connect(function()
        if gameInfoFrame.Visible then task.wait(0.5) buildGameInfoUI() end
    end)
    Players.PlayerRemoving:Connect(function()
        if gameInfoFrame.Visible then task.wait(0.5) buildGameInfoUI() end
    end)
end

task.spawn(function()
    while true do
        local now = tick()
        for hash, placement in pairs(pendingPlacements) do
            if now - placement.time <= 5 then
                local matchPart = nil
                local bestDist = math.huge
                for part, data in pairs(towers) do
                    if not data.owned and data.hash == nil then
                        if placement.position and typeof(placement.position) == "Vector3" then
                            local dist = (part.Position - placement.position).Magnitude
                            if dist < bestDist and dist < 0.5 then
                                bestDist = dist
                                matchPart = part
                            end
                        end
                    end
                end
                if matchPart then
                    local data = towers[matchPart]
                    data.owned = true
                    data.hash = hash
                    pendingPlacements[hash] = nil
                    TDX:Register(data.name, matchPart.Position, hash, settings.autoReviveTypes[data.name] == true)
                    updateTowersList()
                    if updateAutoReviveList then updateAutoReviveList() end
                end
            else
                pendingPlacements[hash] = nil
            end
        end
        task.wait(0.2)
    end
end)

