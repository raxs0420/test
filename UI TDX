local function getClosestEnemy(position, enemies, blacklist)
    local whitelistSet = {}
    for _, name in ipairs(enemyWhitelist) do whitelistSet[name] = true end
    local whitelistEnemies = {}
    for _, enemy in ipairs(enemies) do
        if not blacklist[enemy] and whitelistSet[enemy.Name] then
            local dist = (position - enemy.Position).Magnitude
            if dist <= 25 then table.insert(whitelistEnemies, enemy) end
        end
    end
    local candidates = #whitelistEnemies > 0 and whitelistEnemies or {}
    if #candidates == 0 then
        for _, enemy in ipairs(enemies) do
            if not blacklist[enemy] then
                local blocked = false
                for _, blockedName in ipairs(enemyBlocklist) do
                    if enemy.Name == blockedName then blocked = true break end
                end
                if not blocked then table.insert(candidates, enemy) end
            end
        end
    end
    local best, bestDist = nil, math.huge
    for _, enemy in ipairs(candidates) do
        local dist = (position - enemy.Position).Magnitude
        if dist < bestDist then bestDist = dist best = enemy end
    end
    return best
end

