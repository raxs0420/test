local debugEnabled = true
local debugLogs = {}
local maxDebugLogs = 150
local debugLogFrameRef = nil
local debugLogLayoutRef = nil
local abilityUsedQueue = {}

local function addDebugLog(message)
    if not debugEnabled then return end
    local timestamp = os.date("%H:%M:%S")
    local logEntry = string.format("[%s] %s", timestamp, message)
    table.insert(debugLogs, logEntry)
    if #debugLogs > maxDebugLogs then
        table.remove(debugLogs, 1)
    end
    task.spawn(function()
        if debugLogFrameRef and debugLogLayoutRef then
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -14, 0, 16)
            label.Text = logEntry
            label.TextColor3 = Color3.fromRGB(170, 170, 175)
            label.TextSize = 10
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.TextWrapped = true
            label.Font = Enum.Font.Gotham
            label.Parent = debugLogFrameRef
            local children = debugLogFrameRef:GetChildren()
            local textChildren = {}
            for _, c in ipairs(children) do
                if c:IsA("TextLabel") then table.insert(textChildren, c) end
            end
            while #textChildren > 50 do
                textChildren[1]:Destroy()
                table.remove(textChildren, 1)
            end
            debugLogFrameRef.CanvasSize = UDim2.new(0, 0, 0, debugLogLayoutRef.AbsoluteContentSize.Y + 10)
            debugLogFrameRef.CanvasPosition = Vector2.new(0, debugLogFrameRef.CanvasSize.Y.Offset)
        end
    end)
end

local function debugPrint(message, level)
    level = level or "INFO"
    addDebugLog(string.format("[%s] %s", level, message))
end

