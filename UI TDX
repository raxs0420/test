local pendingBottom = 0

local function updateTowersList()
    if not towersScroll or not towersLayout then return end
    for _, child in ipairs(towersScroll:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    local ownedTowers = {}
    for part, data in pairs(towers) do
        if data.owned and data.hash then
            table.insert(ownedTowers, {part = part, data = data})
        end
    end
    table.sort(ownedTowers, function(a,b) return a.data.name < b.data.name end)
    for _, entry in ipairs(ownedTowers) do
        local data = entry.data
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -10, 0, 20)
        label.Text = string.format("%s | Hash: %d | Top: %d | Bottom: %d", data.name, data.hash, data.topCount or 0, data.bottomCount or 0)
        label.TextColor3 = Color3.fromRGB(200,200,200)
        label.TextSize = 11
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.BackgroundTransparency = 1
        label.Parent = towersScroll
    end
    task.defer(function()
        if towersScroll then
            towersScroll.CanvasSize = UDim2.new(0, 0, 0, towersLayout.AbsoluteContentSize.Y + 10)
        end
    end)
end

local function isTowerDead(part)
    return not part or not part.Parent or (part.Parent and part.Parent.Name ~= "Towers")
end

local function addTower(part)
    if not part or not part.Parent then return end
    if towers[part] then return end
    towers[part] = {
        name = part.Name,
        owned = false,
        hash = nil,
        topCount = 0,
        bottomCount = 0,
        currentLevel = 0
    }
    addDebugLog(string.format("Tower placed: %s", part.Name))
end

local function removeTower(part)
    if towers[part] then
        addDebugLog(string.format("Tower removed: %s (hash %s)", towers[part].name, tostring(towers[part].hash)))
        towers[part] = nil
        updateTowersList()
    end
end

local function cleanupDeadTowers()
    local changed = false
    for part, _ in pairs(towers) do
        if isTowerDead(part) then
            towers[part] = nil
            changed = true
        end
    end
    if changed then
        updateTowersList()
    end
end

local function getNumericLevel(part)
    if not part then return 0 end
    for _, child in ipairs(part:GetChildren()) do
        local num = tonumber(child.Name)
        if num then return num end
        if child:IsA("Model") then
            for _, sub in ipairs(child:GetChildren()) do
                local subNum = tonumber(sub.Name)
                if subNum then return subNum end
            end
        end
    end
    return 0
end

local function onNumericAdded(child, part)
    local num = tonumber(child.Name)
    if not num then return end
    if not towers[part] then return end
    local old = towers[part].currentLevel
    if num > old then
        towers[part].currentLevel = num
        addDebugLog(string.format("Level increase for %s: %d -> %d", part.Name, old, num))
        if pendingHash and not towers[part].owned then
            towers[part].owned = true
            towers[part].hash = pendingHash
            towers[part].topCount = pendingTop
            towers[part].bottomCount = pendingBottom
            addDebugLog(string.format("Assigned hash %d to %s (level %d) top=%d bottom=%d", pendingHash, part.Name, num, pendingTop, pendingBottom))
            updateTowersList()
            pendingHash = nil
            pendingTop = 0
            pendingBottom = 0
        end
    end
end

local function watchTower(part)
    local function checkExisting()
        for _, child in ipairs(part:GetChildren()) do
            if tonumber(child.Name) then
                onNumericAdded(child, part)
            end
            if child:IsA("Model") then
                for _, sub in ipairs(child:GetChildren()) do
                    if tonumber(sub.Name) then onNumericAdded(sub, part) end
                end
                child.ChildAdded:Connect(function(sub)
                    if tonumber(sub.Name) then onNumericAdded(sub, part) end
                end)
            end
        end
    end
    part.ChildAdded:Connect(function(child)
        if tonumber(child.Name) then onNumericAdded(child, part) end
        if child:IsA("Model") then
            child.ChildAdded:Connect(function(sub)
                if tonumber(sub.Name) then onNumericAdded(sub, part) end
            end)
            for _, sub in ipairs(child:GetChildren()) do
                if tonumber(sub.Name) then onNumericAdded(sub, part) end
            end
        end
    end)
    checkExisting()
end

local function setupUpgradeListener()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then
        addDebugLog("Remotes folder not found")
        return
    end
    local queueRemote = remotes:FindFirstChild("TowerUpgradeQueueUpdated")
    if not queueRemote then
        addDebugLog("TowerUpgradeQueueUpdated not found")
        return
    end
    queueRemote.OnClientEvent:Connect(function(data)
        if type(data) ~= "table" then return end
        local entries = (#data > 0) and data or {data}
        for _, entry in ipairs(entries) do
            local hash = entry.Hash or entry.hash or entry.Id or entry.id
            if not hash then continue end
            if type(hash) == "string" then hash = tonumber(hash) end
            if not hash then continue end
            
            local top = 0
            local bottom = 0
            if entry.LevelReplicationData and type(entry.LevelReplicationData) == "table" then
                top = entry.LevelReplicationData[1] or 0
                bottom = entry.LevelReplicationData[2] or 0
            end
            
            addDebugLog(string.format("Upgrade event: hash=%d top=%d bottom=%d", hash, top, bottom))
            pendingHash = hash
            pendingTop = top
            pendingBottom = bottom
            
            for part, data in pairs(towers) do
                if data.hash == hash then
                    data.topCount = top
                    data.bottomCount = bottom
                    addDebugLog(string.format("Updated %s (hash %d) top/bottom: %d/%d", part.Name, hash, top, bottom))
                    updateTowersList()
                    pendingHash = nil
                    break
                end
            end
        end
    end)
    addDebugLog("Upgrade listener ready (waits for numeric level increase)")
end

local function getAllEnemies()
    local enemiesFolder = workspace.Game:FindFirstChild("Enemies")
    if not enemiesFolder then return {} end
    local enemies = {}
    for _, child in ipairs(enemiesFolder:GetChildren()) do
        if child:IsA("BasePart") and child.Name ~= "Arrow" then
            table.insert(enemies, child)
        end
    end
    return enemies
end

local function getClosestEnemy(position, enemies, blacklist)
    local whitelistSet = {}
    for _, name in ipairs(enemyWhitelist) do whitelistSet[name] = true end
    local whitelistEnemies = {}
    for _, enemy in ipairs(enemies) do
        if not blacklist[enemy] and whitelistSet[enemy.Name] then
            local dist = (position - enemy.Position).Magnitude
            if dist <= 25 then table.insert(whitelistEnemies, enemy) end
        end
    end
    local candidates = #whitelistEnemies > 0 and whitelistEnemies or {}
    if #candidates == 0 then
        for _, enemy in ipairs(enemies) do
            if not blacklist[enemy] then
                local blocked = false
                for _, blockedName in ipairs(enemyBlocklist) do
                    if enemy.Name == blockedName then blocked = true break end
                end
                if not blocked then table.insert(candidates, enemy) end
            end
        end
    end
    local best, bestDist = nil, math.huge
    for _, enemy in ipairs(candidates) do
        local dist = (position - enemy.Position).Magnitude
        if dist < bestDist then bestDist = dist best = enemy end
    end
    return best
end

local function sendAbilityWithPosition(part, slot, position)
    local data = towers[part]
    if not data or not data.hash then return nil end
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if remote then
        local req = remote:FindFirstChild("TowerUseAbilityRequest")
        if req then
            local success, response = pcall(function() return req:InvokeServer(data.hash, slot, position) end)
            if success then return response else return nil end
        end
    end
    return nil
end

local function sendAbilityNoPosition(part, slot)
