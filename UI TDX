local function updateEcoOverlay()
    if not ecoOverlayGui then createEcoOverlay() end

    local function hideAll()
        ecoOverlayEnemyLabel.Visible = false
        ecoOverlayDiffLabel.Visible = false
        ecoOverlayMoneyLabel.Visible = false
    end

    local hasAnyTeamFlag = false
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Team then hasAnyTeamFlag = true break end
    end
    if not hasAnyTeamFlag then hideAll() return end

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then hideAll() return end

    local interface = playerGui:FindFirstChild("Interface")
    if not interface then hideAll() return end

    local gameInfoBar = interface:FindFirstChild("GameInfoBar")
    if not gameInfoBar then hideAll() return end

    local pvp = gameInfoBar:FindFirstChild("PVP")
    if not pvp then hideAll() return end

    local friendlyBar = pvp:FindFirstChild("FriendlyBar")
    if not friendlyBar then hideAll() return end

    local cashFrame = friendlyBar:FindFirstChild("CashPerSecondFrame")
    if not cashFrame then hideAll() return end

    local cashTextLabel = cashFrame:FindFirstChild("Text")

    local baseSize = 18
    local baseFont = Enum.Font.GothamBold
    
    if cashTextLabel and cashTextLabel:IsA("TextLabel") then
        baseFont = cashTextLabel.Font or Enum.Font.GothamBold
        local boundsY = cashTextLabel.TextBounds and cashTextLabel.TextBounds.Y or 0
        if boundsY and boundsY >= 8 then
            baseSize = math.floor(boundsY)
        elseif cashTextLabel.TextScaled then
            baseSize = math.floor(cashTextLabel.AbsoluteSize.Y * 0.75)
        else
            baseSize = cashTextLabel.TextSize
        end
    end

    ecoOverlayEnemyLabel.TextSize = baseSize
    ecoOverlayDiffLabel.TextSize = baseSize
    ecoOverlayMoneyLabel.TextSize = baseSize
    ecoOverlayEnemyLabel.Font = baseFont
    ecoOverlayDiffLabel.Font = baseFont
    ecoOverlayMoneyLabel.Font = baseFont

    local cashPos = cashFrame.AbsolutePosition
    local cashSize = cashFrame.AbsoluteSize

    local rightX = cashPos.X + cashSize.X + 14
    local row1Y = cashPos.Y
    local row2Y = cashPos.Y + cashSize.Y + 3

    ecoOverlayEnemyLabel.Position = UDim2.new(0, rightX, 0, row1Y)
    ecoOverlayMoneyLabel.Position = UDim2.new(0, rightX, 0, row2Y)
    ecoOverlayDiffLabel.Position = UDim2.new(0, cashPos.X + 12, 0, row2Y)

    local myCashText = getMyCashText()
    local myCashNum = parseCashValue(myCashText)
    local mySendDelta = LocalPlayer:GetAttribute("PVPSendEcoDelta") or 0

    local enemyPlayer = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then enemyPlayer = plr break end
    end

    local enemySendDelta = 0
    local enemyName = "Enemy"
    local enemyCash = 0
    if enemyPlayer then
        enemySendDelta = enemyPlayer:GetAttribute("PVPSendEcoDelta") or 0
        enemyName = enemyPlayer.Name
        local ls = enemyPlayer:FindFirstChild("leaderstats")
        if ls then
            local cashVal = ls:FindFirstChild("Cash")
            if cashVal then enemyCash = cashVal.Value end
        end
    end

    if myCashNum then
        local enemyEco = (myCashNum - mySendDelta) + enemySendDelta

        ecoOverlayEnemyLabel.Text = enemyName .. ": $" .. formatNumber(enemyEco) .. "/7s"
        ecoOverlayEnemyLabel.Visible = true

        local diff = myCashNum - enemyEco
        local sign = diff >= 0 and "+" or "-"
        ecoOverlayDiffLabel.Text = sign .. "$" .. formatNumber(math.abs(diff))
        ecoOverlayDiffLabel.TextColor3 = diff >= 0 and Color3.fromRGB(130, 220, 130) or Color3.fromRGB(220, 130, 130)
        ecoOverlayDiffLabel.Visible = true

        ecoOverlayMoneyLabel.Text = "Money:" .. formatNumber(enemyCash)
        ecoOverlayMoneyLabel.Visible = true
    else
        hideAll()
    end
end

