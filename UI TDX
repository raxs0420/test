local function setupUpgradeListener()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return end
    local factoryRemote = remotes:FindFirstChild("TowerFactoryQueueUpdated")
    if factoryRemote then
        factoryRemote.OnClientEvent:Connect(function(...)
            task.defer(function(...)
                local args = {...}
                local events = (type(args[1]) == "table" and #args[1] > 0) and args[1] or args
                for _, ev in ipairs(events) do
                    if type(ev) ~= "table" then continue end
                    if ev.Creation == false then
                        local towerId = ev.Data
                        if type(towerId) == "table" then towerId = towerId[1] end
                        if type(towerId) == "number" then
                            pendingPlacements[towerId] = nil
                            for part, data in pairs(towers) do
                                if data.hash == towerId then
                                    removeTower(part)
                                    break
                                end
                            end
                        end
                    else
                        local towerInfo = ev.Data
                        if type(towerInfo) == "table" and towerInfo[1] and type(towerInfo[1]) == "table" then
                            towerInfo = towerInfo[1]
                        end
                        if type(towerInfo) == "table" and type(towerInfo[1]) == "number" then
                            local towerId = towerInfo[1]
                            local towerName = towerInfo[2]
                            local playerName = towerInfo[7]
                            local rawPos = towerInfo[4]
                            local position = nil
                            if type(rawPos) == "table" and rawPos[1] and rawPos[2] and rawPos[3] then
                                position = Vector3.new(rawPos[1], rawPos[2], rawPos[3])
                            elseif typeof(rawPos) == "Vector3" then
                                position = rawPos
                            end
                            if tostring(playerName) == LocalPlayer.Name then
                                pendingPlacements[towerId] = {
                                    name = towerName,
                                    time = tick(),
                                    position = position
                                }
                                task.defer(scanForTowers)
                            end
                        end
                    end
                end
            end, ...)
        end)
    end
    local upgradeRemote = remotes:FindFirstChild("TowerUpgradeQueueUpdated")
    if upgradeRemote then
        upgradeRemote.OnClientEvent:Connect(function(data)
            task.defer(function(data)
                if type(data) ~= "table" then return end
                local entries = (#data > 0) and data or {data}
                for _, entry in ipairs(entries) do
                    local hash = entry.Hash or entry.hash or entry.Id or entry.id
                    if not hash then continue end
                    if type(hash) == "string" then hash = tonumber(hash) end
                    if not hash then continue end
                    local top = 0
                    local bottom = 0
                    if entry.LevelReplicationData and type(entry.LevelReplicationData) == "table" then
                        top = entry.LevelReplicationData[1] or 0
                        bottom = entry.LevelReplicationData[2] or 0
                    end
                    for part, data in pairs(towers) do
                        if data.hash == hash then
                            data.topCount = top
                            data.bottomCount = bottom
                            updateTowersList()
                            break
                        end
                    end
                end
            end, data)
        end)
    end
end

