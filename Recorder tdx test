    copyBtn.Text = "COPY SCRIPT"
    copyBtn.BackgroundColor3 = Color3.fromRGB(52,152,219)
    copyBtn.Visible = true
    Instance.new("UICorner", copyBtn)
    
    local logBox = Instance.new("ScrollingFrame", frame)
    logBox.Size = UDim2.new(1, -20, 1, -100)
    logBox.Position = UDim2.new(0, 10, 0, 90)
    logBox.BackgroundColor3 = Color3.fromRGB(20,20,20)
    logBox.ScrollBarThickness = 4
    Instance.new("UICorner", logBox)
    local logLayout = Instance.new("UIListLayout", logBox)
    logLayout.Padding = UDim.new(0, 2)
    
    local drag = Instance.new("TextButton", frame)
    drag.Size = UDim2.new(1,0,0,30)
    drag.BackgroundTransparency = 1
    drag.Text = ""
    drag.Draggable = true
    drag.Active = true
    
    TDX._gui = gui
    TDX._logBox = logBox
    TDX._logLayout = logLayout
    
    TDX._addLog = function(msg, color)
        if not TDX._logBox then return end
        local label = Instance.new("TextLabel", TDX._logBox)
        label.Size = UDim2.new(1, -10, 0, 18)
        label.Text = "> " .. msg
        label.TextColor3 = color or Color3.fromRGB(200,200,200)
        label.TextSize = 11
        label.BackgroundTransparency = 1
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Font = Enum.Font.Code
        task.wait()
        TDX._logBox.CanvasSize = UDim2.new(0,0,0, TDX._logLayout.AbsoluteContentSize.Y)
        TDX._logBox.CanvasPosition = Vector2.new(0, TDX._logBox.CanvasSize.Y.Offset)
    end
    
    local function startRecording()
        if TDX._recording then return end
        TDX._recording = true
        TDX._recordedActions = {}
        TDX._nextId = 1
        recordBtn.Text = "STOP RECORDING"
        recordBtn.BackgroundColor3 = Color3.fromRGB(231,76,60)
        TDX._addLog("Recording started", Color3.fromRGB(100,255,100))
    end
    
    local function stopRecording()
        if not TDX._recording then return end
        TDX._recording = false
        recordBtn.Text = "START RECORDING"
        recordBtn.BackgroundColor3 = Color3.fromRGB(46,204,113)
        if #TDX._recordedActions > 0 then
            TDX._addLog(string.format("Recording stopped. %d actions recorded.", #TDX._recordedActions), Color3.fromRGB(100,255,100))
        else
            TDX._addLog("Recording stopped. No actions recorded.", Color3.fromRGB(255,200,100))
        end
    end
    
    local function generateScript()
        local lines = {
            "local TDX = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/raxs0420/test/refs/heads/main/library%20new/tdx%20test\"))()",
            ""
        }
        for _, cmd in ipairs(TDX._recordedActions) do
            table.insert(lines, cmd)
        end
        return table.concat(lines, "\n")
    end
    
    local function copyScript()
        local scriptText = generateScript()
        if setclipboard then
            setclipboard(scriptText)
            TDX._addLog("Script copied to clipboard!", Color3.fromRGB(100,255,100))
            local oldColor = copyBtn.BackgroundColor3
            copyBtn.BackgroundColor3 = Color3.fromRGB(39,174,96)
            copyBtn.Text = "COPIED!"
            task.wait(0.5)
            copyBtn.BackgroundColor3 = oldColor
            copyBtn.Text = "COPY SCRIPT"
        else
            TDX._addLog("No clipboard access. Script printed to console.", Color3.fromRGB(255,100,100))
            print(scriptText)
        end
    end
    
    recordBtn.MouseButton1Click:Connect(function()
        if TDX._recording then stopRecording() else startRecording() end
    end)
    copyBtn.MouseButton1Click:Connect(copyScript)
    closeBtn.MouseButton1Click:Connect(function()
        TDX._recording = false
        gui:Destroy()
        TDX._gui = nil
    end)
    
    return gui
end

-- Public recording methods
function TDX:ShowRecorder()
    createGUI()
end

function TDX:StartRecording()
    if TDX._recording then return end
    TDX._recording = true
    TDX._recordedActions = {}
    TDX._nextId = 1
    if TDX._gui then
        -- update button state if gui exists
        local recordBtn = TDX._gui:FindFirstChild("Frame"):FindFirstChild("START RECORDING")
        if recordBtn then
            recordBtn.Text = "STOP RECORDING"
            recordBtn.BackgroundColor3 = Color3.fromRGB(231,76,60)
        end
    end
    TDX._addLog("Recording started", Color3.fromRGB(100,255,100))
end

function TDX:StopRecording()
    if not TDX._recording then return end
    TDX._recording = false
    if TDX._gui then
        local recordBtn = TDX._gui:FindFirstChild("Frame"):FindFirstChild("START RECORDING")
        if recordBtn then
            recordBtn.Text = "START RECORDING"
            recordBtn.BackgroundColor3 = Color3.fromRGB(46,204,113)
        end
    end
    if #TDX._recordedActions > 0 then
        TDX._addLog(string.format("Recording stopped. %d actions recorded.", #TDX._recordedActions), Color3.fromRGB(100,255,100))
    else
        TDX._addLog("Recording stopped. No actions recorded.", Color3.fromRGB(255,200,100))
    end
end

function TDX:IsRecording()
    return TDX._recording
end

function TDX:GetRecordedScript()
    local lines = {
        "local TDX = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/raxs0420/test/refs/heads/main/library%20new/tdx%20test\"))()",
        ""
    }
    for _, cmd in ipairs(TDX._recordedActions) do
        table.insert(lines, cmd)
    end
    return table.concat(lines, "\n")
end

function TDX:CopyRecordedScript()
    local scriptText = TDX:GetRecordedScript()
    if setclipboard then
        setclipboard(scriptText)
        TDX._addLog("Script copied to clipboard!", Color3.fromRGB(100,255,100))
    else
        TDX._addLog("No clipboard access. Script printed to console.", Color3.fromRGB(255,100,100))
        print(scriptText)
    end
end

-- Auto-detect tower placements via ChildAdded (for when you don't use TDX:Place)
local TowersFolder = Workspace:FindFirstChild("Game") and Workspace.Game:FindFirstChild("Towers")
if TowersFolder then
    TowersFolder.ChildAdded:Connect(function(part)
        if not TDX._recording then return end
        if not part:IsA("BasePart") then return end
        task.wait(0.05)
        local name = part.Name
        local pos = part.Position
        local id = TDX._nextId
        TDX._nextId = TDX._nextId + 1
        local cmd = string.format('TDX:Place("%s", %.6f, %.6f, %.6f, 0)', name, pos.X, pos.Y, pos.Z)
        table.insert(TDX._recordedActions, cmd)
        TDX._addLog(string.format("Placed %s [ID:%d] at (%.2f, %.2f, %.2f)", name, id, pos.X, pos.Y, pos.Z), Color3.fromRGB(100,255,100))
    end)
end

return TDX